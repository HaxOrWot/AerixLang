// ==============================================================================
// Aerix Language Tutorial: 25_GENERICS_AND_MONOMORPHISM.arx
// Phase 18: First-Class Systems Generics & Static Compile-Time Monomorphization
// ==============================================================================
//
// Systems Philosophy:
// Aerix generics provide first-class compile-time abstraction with ZERO runtime
// overhead. Unlike managed languages (Java/Python) that box primitives into objects
// or use virtual dispatch tables, Aerix uses static monomorphization (like Rust
// and modern C++):
//   1. Generic templates are analyzed and specialized for each concrete type used.
//   2. `Box<i64>` generates a dedicated, packed C99 `struct Arx_Box_i64`.
//   3. `Box<str>` generates a dedicated C99 `struct Arx_Box_str`.
//   4. Zero void* pointers, zero runtime reflection, 100% cache locality!
// ==============================================================================

// ------------------------------------------------------------------------------
// 1. Generic Functions: Compile-Time Specialization
// ------------------------------------------------------------------------------
fn identity<T>(val: T) -> T {
    return val
}

fn select_primary<T>(first: T, second: T, choose_first: bool) -> T {
    if choose_first {
        return first
    }
    return second
}

// ------------------------------------------------------------------------------
// 2. Single-Parameter Generic Container: Box<T>
// ------------------------------------------------------------------------------
class Box<T> {
    pub value: T

    init(val: T) {
        self.value = val
    }

    pub fn get() -> T {
        return self.value
    }

    pub fn set(new_val: T) {
        self.value = new_val
    }
}

// ------------------------------------------------------------------------------
// 3. Multi-Parameter Generic Type: Pair<K, V>
// ------------------------------------------------------------------------------
class Pair<K, V> {
    pub key: K
    pub value: V

    init(k: K, v: V) {
        self.key = k
        self.value = v
    }

    pub fn get_key() -> K {
        return self.key
    }

    pub fn get_value() -> V {
        return self.value
    }
}

// ------------------------------------------------------------------------------
// 4. Practical High-Performance Generic Data Structure: Stack<T>
// ------------------------------------------------------------------------------
class StackSlot<T> {
    pub item: T
    pub is_occupied: bool

    init(initial: T) {
        self.item = initial
        self.is_occupied = true
    }

    pub fn read() -> T {
        return self.item
    }

    pub fn update(new_item: T) {
        self.item = new_item
        self.is_occupied = true
    }
}

// ------------------------------------------------------------------------------
// Main Entrypoint Demonstrating Zero-Cost Monomorphization
// ------------------------------------------------------------------------------
fn main() {
    println("==================================================")
    println(" Aerix Lang — Phase 18: Generics & Monomorphism   ")
    println("==================================================")

    // A. Generic Functions
    println("\n[1] Generic Function Specialization:")
    let num_sample = identity<i64>(42)
    let float_sample = identity<f64>(3.14159)
    let text_sample = identity<str>("Aerix Monomorphization Engine")

    println(" - identity<i64>:  {num_sample}")
    println(" - identity<f64>:  {float_sample}")
    println(" - identity<str>:  {text_sample}")

    let chosen_num = select_primary<i64>(999, 111, true)
    let chosen_str = select_primary<str>("Alpha", "Omega", false)
    println(" - select_primary<i64>: {chosen_num}")
    println(" - select_primary<str>: {chosen_str}")

    // B. Generic Single-Type Container: Box<T>
    println("\n[2] Generic Class Specialization (Box<T>):")
    mut int_box = Box<i64>(1000)
    println(" - int_box initial: {int_box.get()}")
    int_box.set(2048)
    println(" - int_box updated: {int_box.get()}")

    mut str_box = Box<str>("Initial Payload")
    println(" - str_box initial: {str_box.get()}")
    str_box.set("Upgraded High-Throughput Payload")
    println(" - str_box updated: {str_box.get()}")

    // C. Generic Multi-Parameter Struct: Pair<K, V>
    println("\n[3] Heterogeneous Multi-Type Generics (Pair<K, V>):")
    let metric1 = Pair<str, i64>("CPU_CORES_ACTIVE", 16)
    let metric2 = Pair<str, f64>("NETWORK_GIGABITS_SEC", 39.85)

    println(" - Metric 1: {metric1.get_key()} => {metric1.get_value()}")
    println(" - Metric 2: {metric2.get_key()} => {metric2.get_value()}")

    // D. Generic Data Structure Slot
    println("\n[4] Specialized Container State:")
    mut slot = StackSlot<i64>(77)
    println(" - Slot item: {slot.read()}")
    slot.update(88)
    println(" - Slot updated: {slot.read()}")

    println("\n==================================================")
    println(" [SUCCESS] Zero-Cost Generics Verified!")
    println("==================================================")
}
