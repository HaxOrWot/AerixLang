// Aerix CLI Expression Calculator
// Demonstrates: Lexing, recursive-descent parsing, string manipulation, and input loops.

fn is_digit(c: str) -> bool {
    return c == "0" || c == "1" || c == "2" || c == "3" || c == "4" ||
           c == "5" || c == "6" || c == "7" || c == "8" || c == "9"
}

class CalcParser {
    pub src: str
    pub pos: i64
    pub len: i64

    init(input_expr: str) {
        self.src = input_expr.trim()
        self.pos = 0
        self.len = self.src.len()
    }

    fn skip_whitespace() {
        while self.pos < self.len {
            let ch = self.src.slice(self.pos, self.pos + 1)
            if ch == " " || ch == "\t" || ch == "\r" || ch == "\n" {
                self.pos = self.pos + 1
            } else {
                break
            }
        }
    }

    fn peek() -> str {
        self.skip_whitespace()
        if self.pos >= self.len { return "" }
        return self.src.slice(self.pos, self.pos + 1)
    }

    fn get_char() -> str {
        self.skip_whitespace()
        if self.pos >= self.len { return "" }
        let ch = self.src.slice(self.pos, self.pos + 1)
        self.pos = self.pos + 1
        return ch
    }

    fn parse_factor() -> i64 {
        self.skip_whitespace()
        let next_ch = self.peek()
        if next_ch == "(" {
            let _lparen = self.get_char()
            let val = self.parse_expr()
            let rparen = self.peek()
            if rparen == ")" {
                let _r = self.get_char()
            }
            return val
        }
        if next_ch == "-" {
            let _neg = self.get_char()
            return 0 - self.parse_factor()
        }
        mut num_str = ""
        while self.pos < self.len {
            let ch = self.src.slice(self.pos, self.pos + 1)
            if is_digit(ch) {
                num_str = num_str + ch
                self.pos = self.pos + 1
            } else {
                break
            }
        }
        if num_str.len() == 0 {
            return 0
        }
        return num_str.to_i64()
    }

    fn parse_term() -> i64 {
        mut left = self.parse_factor()
        while self.pos < self.len {
            self.skip_whitespace()
            let oper = self.peek()
            if oper == "*" {
                let _star = self.get_char()
                let right = self.parse_factor()
                left = left * right
            } else if oper == "/" {
                let _slash = self.get_char()
                let right = self.parse_factor()
                if right == 0 {
                    print("Error: division by zero\n")
                    return 0
                }
                left = left / right
            } else if oper == "%" {
                let _pct = self.get_char()
                let right = self.parse_factor()
                if right == 0 {
                    print("Error: modulo by zero\n")
                    return 0
                }
                left = left % right
            } else {
                break
            }
        }
        return left
    }

    pub fn parse_expr() -> i64 {
        mut left = self.parse_term()
        while self.pos < self.len {
            self.skip_whitespace()
            let oper = self.peek()
            if oper == "+" {
                let _plus = self.get_char()
                let right = self.parse_term()
                left = left + right
            } else if oper == "-" {
                let _minus = self.get_char()
                let right = self.parse_term()
                left = left - right
            } else {
                break
            }
        }
        return left
    }
}

fn eval_expr(expr: str) -> i64 {
    let parser = CalcParser(expr)
    return parser.parse_expr()
}

fn main() {
    print("=== Aerix Expression Calculator ===\n")
    let t1 = eval_expr("2 + 3 * 4")
    print("2 + 3 * 4 = {t1}\n")
    if t1 != 14 { panic("Test 1 failed") }

    let t2 = eval_expr("(2 + 3) * 4")
    print("(2 + 3) * 4 = {t2}\n")
    if t2 != 20 { panic("Test 2 failed") }

    let t3 = eval_expr("100 - 25 / 5")
    print("100 - 25 / 5 = {t3}\n")
    if t3 != 95 { panic("Test 3 failed") }

    let t4 = eval_expr("10 / 2 + 3 * (8 - 4)")
    print("10 / 2 + 3 * (8 - 4) = {t4}\n")
    if t4 != 17 { panic("Test 4 failed") }

    let t5 = eval_expr("50 % 7 + 2 * (10 - 3)")
    print("50 % 7 + 2 * (10 - 3) = {t5}\n")
    if t5 != 15 { panic("Test 5 failed") }

    print("ALL CALCULATOR TESTS PASSED\n")
}
