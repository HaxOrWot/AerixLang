// Aerix Tic-Tac-Toe Console Game
// Demonstrates: Mutable game state, List<str> grid, loops, functions, and simulated moves.

class TicTacToe {
    pub board: List<str>
    pub current_player: str
    pub moves_count: i64

    init() {
        self.board = List<str>()
        mut i = 0
        while i < 9 {
            self.board.push(" ")
            i = i + 1
        }
        self.current_player = "X"
        self.moves_count = 0
    }

    pub fn print_board() {
        let b0 = self.board.get(0)
        let b1 = self.board.get(1)
        let b2 = self.board.get(2)
        let b3 = self.board.get(3)
        let b4 = self.board.get(4)
        let b5 = self.board.get(5)
        let b6 = self.board.get(6)
        let b7 = self.board.get(7)
        let b8 = self.board.get(8)

        print("\n {b0} | {b1} | {b2} \n")
        print("---+---+---\n")
        print(" {b3} | {b4} | {b5} \n")
        print("---+---+---\n")
        print(" {b6} | {b7} | {b8} \n\n")
    }

    pub fn make_move(cell: i64) -> bool {
        if cell < 0 || cell >= 9 {
            return false
        }
        if self.board.get(cell) != " " {
            return false
        }
        self.board.set(cell, self.current_player)
        self.moves_count = self.moves_count + 1
        return true
    }

    pub fn switch_player() {
        if self.current_player == "X" {
            self.current_player = "O"
        } else {
            self.current_player = "X"
        }
    }

    fn check_line(a: i64, b: i64, c: i64) -> bool {
        let p = self.current_player
        return self.board.get(a) == p && self.board.get(b) == p && self.board.get(c) == p
    }

    pub fn check_win() -> bool {
        // Rows
        if self.check_line(0, 1, 2) { return true }
        if self.check_line(3, 4, 5) { return true }
        if self.check_line(6, 7, 8) { return true }
        // Columns
        if self.check_line(0, 3, 6) { return true }
        if self.check_line(1, 4, 7) { return true }
        if self.check_line(2, 5, 8) { return true }
        // Diagonals
        if self.check_line(0, 4, 8) { return true }
        if self.check_line(2, 4, 6) { return true }
        return false
    }

    pub fn is_draw() -> bool {
        return self.moves_count >= 9 && !self.check_win()
    }
}

fn test_game_win() {
    print("[Game Test] Testing Win Condition (X diagonal)...\n")
    let game = TicTacToe()
    // Moves: X=0, O=1, X=4, O=2, X=8 (X wins diagonal 0-4-8)
    let m1 = game.make_move(0)
    if !m1 { panic("Move 0 failed") }
    game.switch_player()

    let m2 = game.make_move(1)
    if !m2 { panic("Move 1 failed") }
    game.switch_player()

    let m3 = game.make_move(4)
    if !m3 { panic("Move 4 failed") }
    game.switch_player()

    let m4 = game.make_move(2)
    if !m4 { panic("Move 2 failed") }
    game.switch_player()

    let m5 = game.make_move(8)
    if !m5 { panic("Move 8 failed") }

    let won = game.check_win()
    if !won { panic("Expected X to win") }
    print("X won successfully!\n")
    game.print_board()
}

fn test_game_draw() {
    print("[Game Test] Testing Draw Condition...\n")
    let game = TicTacToe()
    // Grid:
    // X O X
    // X O O
    // O X X
    let moves = List<i64>()
    moves.push(0); moves.push(1); moves.push(2)
    moves.push(4); moves.push(3); moves.push(5)
    moves.push(7); moves.push(6); moves.push(8)

    mut i = 0
    while i < moves.len() {
        let cell = moves.get(i)
        let ok = game.make_move(cell)
        if !ok { panic("Move failed in draw test") }
        if game.check_win() {
            panic("Unexpected win in draw sequence")
        }
        game.switch_player()
        i = i + 1
    }

    if !game.is_draw() {
        panic("Expected draw state")
    }
    print("Draw state verified successfully!\n")
    game.print_board()
}

fn main() {
    print("=== Aerix Tic-Tac-Toe Game Engine Test ===\n")
    test_game_win()
    test_game_draw()
    print("ALL TIC-TAC-TOE TESTS PASSED\n")
}
