// Aerix Mini-Grep Pattern Search Utility
// Demonstrates: File I/O (File.read, File.exists), string splitting, searching, and formatted output.

fn search_in_file(path: str, pattern: str) -> i64 {
    if !File.exists(path) {
        print("Error: file '{path}' does not exist\n")
        return 0
    }

    let content = File.read(path)
    let lines = content.split("\n")
    mut matches: i64 = 0
    mut i: i64 = 0
    while i < lines.len() {
        let line = lines.get(i)
        if line.contains(pattern) {
            let line_num = i + 1
            print("  {path}:{line_num}: {line}\n")
            matches = matches + 1
        }
        i = i + 1
    }
    print("[minigrep] Found {matches} match(es) across {lines.len()} lines in '{path}'.\n")
    return matches
}

fn test_minigrep() {
    print("=== Aerix Mini-Grep Test ===\n")
    let test_file = "C:/Users/NOTPHOENIX/.gemini/antigravity/brain/1cec161c-af74-498f-a315-a53900b5d4bd/scratch/grep_sample.txt"
    let sample_text = "Apple pie is sweet\nBanana bread is tasty\nCherry tart with sweet cream\nDate palm trees\nElderberry sweet syrup\n"
    let ok = File.write(test_file, sample_text)
    if !ok { panic("Failed to write grep_sample.txt") }

    let count1 = search_in_file(test_file, "sweet")
    if count1 != 3 { panic("Expected 3 matches for 'sweet'") }

    let count2 = search_in_file(test_file, "Banana")
    if count2 != 1 { panic("Expected 1 match for 'Banana'") }

    let count3 = search_in_file(test_file, "Grapefruit")
    if count3 != 0 { panic("Expected 0 matches for 'Grapefruit'") }

    print("ALL MINIGREP TESTS PASSED\n")
}

fn main() {
    test_minigrep()
}
