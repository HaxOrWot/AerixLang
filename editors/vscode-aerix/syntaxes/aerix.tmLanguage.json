{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aerix",
  "scopeName": "source.aerix",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#imports" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#calls" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.aerix",
          "match": "//[/!].*$"
        },
        {
          "name": "comment.line.double-slash.aerix",
          "match": "//.*$"
        },
        {
          "name": "comment.block.documentation.aerix",
          "begin": "/\\*\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.block.aerix",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.aerix",
          "begin": "#!?\\[",
          "beginCaptures": { "0": { "name": "punctuation.definition.attribute.aerix" } },
          "end": "\\]",
          "endCaptures": { "0": { "name": "punctuation.definition.attribute.aerix" } },
          "patterns": [
            { "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "entity.name.function.decorator.aerix" },
            { "include": "#strings" },
            { "include": "#numbers" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.double.aerix",
          "begin": "\"\"\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.aerix" } },
          "end": "\"\"\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.aerix" } },
          "patterns": [
            { "name": "constant.character.escape.aerix", "match": "\\\\." },
            {
              "name": "meta.embedded.expression.aerix",
              "begin": "\\{",
              "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.aerix" } },
              "end": "\\}",
              "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.aerix" } },
              "patterns": [ { "include": "$self" } ]
            }
          ]
        },
        {
          "name": "string.quoted.double.interpolated.aerix",
          "begin": "\\$\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.interpolated.aerix" } },
          "end": "\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.aerix" } },
          "patterns": [
            { "name": "constant.character.escape.aerix", "match": "\\\\." },
            {
              "name": "meta.embedded.expression.aerix",
              "begin": "\\{",
              "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.aerix" } },
              "end": "\\}",
              "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.aerix" } },
              "patterns": [ { "include": "$self" } ]
            }
          ]
        },
        {
          "name": "string.quoted.double.raw.aerix",
          "begin": "\\br\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.raw.aerix" } },
          "end": "\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.aerix" } }
        },
        {
          "name": "string.quoted.double.aerix",
          "begin": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.aerix" } },
          "end": "\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.aerix" } },
          "patterns": [
            { "name": "constant.character.escape.aerix", "match": "\\\\." },
            {
              "name": "meta.embedded.expression.aerix",
              "begin": "\\{",
              "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.aerix" } },
              "end": "\\}",
              "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.aerix" } },
              "patterns": [ { "include": "$self" } ]
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.char.aerix",
          "match": "'(\\\\.|[^'\\\\])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.aerix",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.aerix",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.aerix",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.aerix",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d[\\d_]*)?\\b"
        },
        {
          "name": "constant.numeric.integer.aerix",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(pub|priv|prot)?\\s*(fn|init|drop|prop|op)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.aerix" },
            "2": { "name": "keyword.declaration.function.aerix" },
            "3": { "name": "entity.name.function.aerix" }
          }
        },
        {
          "match": "\\b(pub|priv|prot)?\\s*(class|struct|trait|extend|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.aerix" },
            "2": { "name": "storage.type.aerix" },
            "3": { "name": "entity.name.type.class.aerix" }
          }
        },
        {
          "match": "\\b(pub|priv|prot)?\\s*(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.aerix" },
            "2": { "name": "storage.type.enum.aerix" },
            "3": { "name": "entity.name.type.enum.aerix" }
          }
        },
        {
          "match": "\\b(let|mut)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.variable.aerix" },
            "2": { "name": "variable.other.readwrite.aerix" }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.aerix" },
            "2": { "name": "variable.other.constant.aerix" }
          }
        },
        {
          "match": "\\b(pub|priv|prot)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=:)",
          "captures": {
            "1": { "name": "storage.modifier.aerix" },
            "2": { "name": "variable.other.property.aerix" }
          }
        },
        {
          "match": "(:)\\s*([A-Za-z_][A-Za-z0-9_]*(?:<[^>]+>)?)",
          "captures": {
            "1": { "name": "punctuation.separator.type.aerix" },
            "2": { "name": "entity.name.type.aerix" }
          }
        },
        {
          "match": "(->|=>)\\s*([A-Za-z_][A-Za-z0-9_]*(?:<[^>]+>)?)",
          "captures": {
            "1": { "name": "keyword.operator.arrow.aerix" },
            "2": { "name": "entity.name.type.aerix" }
          }
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "meta.import.from.aerix",
          "begin": "\\b(from)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*|\"[^\"]*\")\\s+(import)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.from.aerix" },
            "2": { "name": "entity.name.namespace.aerix" },
            "3": { "name": "keyword.control.import.aerix" }
          },
          "end": "(?=[;\\n]|$)",
          "patterns": [
            {
              "match": "\\b(as)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
              "captures": {
                "1": { "name": "keyword.control.as.aerix" },
                "2": { "name": "variable.other.constant.aerix" }
              }
            },
            {
              "name": "entity.name.type.class.aerix",
              "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
            },
            {
              "name": "entity.name.function.aerix",
              "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.comma.aerix",
              "match": ","
            },
            {
              "include": "#comments"
            }
          ]
        },
        {
          "name": "meta.import.selective.aerix",
          "begin": "\\b(import)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.aerix" },
            "2": { "name": "punctuation.definition.block.aerix" }
          },
          "end": "(\\})\\s*(?:(from)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*|\"[^\"]*\"))?",
          "endCaptures": {
            "1": { "name": "punctuation.definition.block.aerix" },
            "2": { "name": "keyword.control.import.from.aerix" },
            "3": { "name": "entity.name.namespace.aerix" }
          },
          "patterns": [
            {
              "match": "\\b(as)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
              "captures": {
                "1": { "name": "keyword.control.as.aerix" },
                "2": { "name": "variable.other.constant.aerix" }
              }
            },
            {
              "name": "entity.name.type.class.aerix",
              "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
            },
            {
              "name": "entity.name.function.aerix",
              "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.comma.aerix",
              "match": ","
            },
            {
              "include": "#comments"
            }
          ]
        },
        {
          "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)(?:\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.control.import.aerix" },
            "2": { "name": "entity.name.namespace.aerix" },
            "3": { "name": "keyword.control.as.aerix" },
            "4": { "name": "entity.name.namespace.alias.aerix" }
          }
        },
        {
          "match": "\\b(use)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.control.import.aerix" },
            "2": { "name": "entity.name.namespace.aerix" }
          }
        },
        {
          "name": "keyword.control.import.aerix",
          "match": "\\b(import|from|use)\\b"
        },
        {
          "name": "keyword.control.as.aerix",
          "match": "\\b(as)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.import.aerix",
          "match": "\\b(import|from)\\b"
        },
        {
          "name": "keyword.control.as.aerix",
          "match": "\\b(as)\\b"
        },
        {
          "name": "keyword.control.aerix",
          "match": "\\b(if|else|elif|match|case|for|in|while|loop|break|continue|return|guard|defer|try|catch|finally|throw|spawn|yield|async|await)\\b"
        },
        {
          "name": "keyword.declaration.aerix",
          "match": "\\b(fn|let|mut|const|class|struct|enum|trait|type|init|drop|prop|op|extend|get|set)\\b"
        },
        {
          "name": "storage.modifier.aerix",
          "match": "\\b(pub|priv|prot|static|virtual|override|abstract|extends|implements|unsafe)\\b"
        },
        {
          "name": "keyword.other.aerix",
          "match": "\\b(use|cinclude|cextern|new|delete|sizeof|typeof|is)\\b"
        },
        {
          "name": "variable.language.aerix",
          "match": "\\b(self|super)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.aerix",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.aerix",
          "match": "\\bnull\\b"
        },
        {
          "name": "variable.other.constant.aerix",
          "match": "\\b[A-Z_][A-Z0-9_]{2,}\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.aerix",
          "match": "\\b(i8|i16|i32|i64|int|u8|u16|u32|u64|uint|usize|isize|f32|f64|float|f32x4|f64x2|bool|char|str|void)\\b"
        },
        {
          "name": "support.class.aerix",
          "match": "\\b(List|Map|Set|Stack|Queue|Deque|ByteBuffer|String|Channel|LinearArena|File|Directory|Env|Process|Math|Random|Time|Socket|Window|Canvas|Clipboard|Application|Gui)\\b"
        },
        {
          "name": "entity.name.type.class.aerix",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.aerix",
          "match": "\\b(println|print|eprintln|input|read_line|to_string|parse_int|parse_float|chr|ord|len|abs|min|max|sqrt|sin|cos|tan|pow|floor|ceil|round|log|exp|assert|assert_eq|panic|abort|exit|typeof|enumerate|rgb|RGB|colorRed|colorGreen|colorBlue|colorYellow|colorCyan|colorMagenta|colorWhite|colorBlack|colorGray|arx_free|arx_time_now|arx_sleep_ms|arx_thread_join|arx_channel_new|arx_channel_send|arx_channel_recv|arx_channel_close|arx_channel_free|arx_prng_seed|arx_prng_next_i64|arx_prng_next_f64)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.cascade.aerix", "match": "~>" },
        { "name": "keyword.operator.pipeline.aerix", "match": "\\|>" },
        { "name": "keyword.operator.arrow.aerix", "match": "=>|->" },
        { "name": "keyword.operator.range.aerix", "match": "\\.\\.=|\\.\\." },
        { "name": "keyword.operator.optional.aerix", "match": "\\?\\.|\\?\\?" },
        { "name": "keyword.operator.comparison.aerix", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.logical.aerix", "match": "&&|\\|\\||!|\\b(and|or|not)\\b" },
        { "name": "keyword.operator.assignment.aerix", "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|=" },
        { "name": "keyword.operator.bitwise.aerix", "match": "<<|>>>|>>|&|\\||\\^|~" },
        { "name": "keyword.operator.arithmetic.aerix", "match": "\\+\\*?|-|\\*\\*|\\*|/|%" }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "(\\.(?!\\d)|~>|\\?\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(<[^>]*>)?\\s*\\()",
          "captures": {
            "2": { "name": "entity.name.function.method.aerix" }
          }
        },
        {
          "match": "(\\.(?!\\d)|~>|\\?\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "2": { "name": "variable.other.property.aerix" }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(<[^>]*>)?\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.aerix" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.constant.aerix",
          "match": "\\b[A-Z_][A-Z0-9_]{2,}\\b"
        },
        {
          "name": "variable.other.readwrite.aerix",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
