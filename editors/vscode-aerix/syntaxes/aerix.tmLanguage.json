{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aerix",
  "scopeName": "source.aerix",
  "patterns": [
    { "include": "#comments" },
    { "include": "#imports" },
    { "include": "#labels" },
    { "include": "#attributes" },
    { "include": "#pipeline" },
    { "include": "#cascade" },
    { "include": "#closures" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#cinterop" },
    { "include": "#function_definition" },
    { "include": "#constructor_definition" },
    { "include": "#class_definition" },
    { "include": "#extend_definition" },
    { "include": "#property_definition" },
    { "include": "#operator_definition" },
    { "include": "#class_field" },
    { "include": "#qualified_access" },
    { "include": "#member_access" },
    { "include": "#named_args" },
    { "include": "#variable_declaration" },
    { "include": "#keywords_control" },
    { "include": "#keywords_decl" },
    { "include": "#math_functions" },
    { "include": "#builtins" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#enum_access" },
    { "include": "#function_call" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.aerix",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.aerix",
          "match": "//.*$"
        },
        {
          "name": "comment.block.aerix",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "match": "\\b(from)\\s+(\"[^\"]+\")\\s+(import)\\s*(\\{)([^}]+)(\\})\\s*(;)?",
          "captures": {
            "1": { "name": "keyword.control.import.from.aerix" },
            "2": { "name": "string.quoted.double.aerix" },
            "3": { "name": "keyword.control.import.aerix" },
            "4": { "name": "punctuation.brackets.curly.aerix" },
            "5": { "name": "variable.other.readwrite.import.aerix" },
            "6": { "name": "punctuation.brackets.curly.aerix" },
            "7": { "name": "punctuation.terminator.aerix" }
          }
        },
        {
          "match": "\\b(from)\\s+(\"[^\"]+\")\\s+(import)\\s+([^;\\n]+)\\s*(;)?",
          "captures": {
            "1": { "name": "keyword.control.import.from.aerix" },
            "2": { "name": "string.quoted.double.aerix" },
            "3": { "name": "keyword.control.import.aerix" },
            "4": { "name": "variable.other.readwrite.import.aerix" },
            "5": { "name": "punctuation.terminator.aerix" }
          }
        },
        {
          "match": "\\b(from)\\s+([A-Z][a-zA-Z0-9_]*)\\s+(import)\\s*(\\{)([^}]+)(\\})\\s*(;)?",
          "captures": {
            "1": { "name": "keyword.control.import.from.aerix" },
            "2": { "name": "entity.name.namespace.aerix" },
            "3": { "name": "keyword.control.import.aerix" },
            "4": { "name": "punctuation.brackets.curly.aerix" },
            "5": { "name": "variable.other.readwrite.import.aerix" },
            "6": { "name": "punctuation.brackets.curly.aerix" },
            "7": { "name": "punctuation.terminator.aerix" }
          }
        },
        {
          "match": "\\b(from)\\s+([A-Z][a-zA-Z0-9_]*)\\s+(import)\\s+([^;\\n]+)\\s*(;)?",
          "captures": {
            "1": { "name": "keyword.control.import.from.aerix" },
            "2": { "name": "entity.name.namespace.aerix" },
            "3": { "name": "keyword.control.import.aerix" },
            "4": { "name": "variable.other.readwrite.import.aerix" },
            "5": { "name": "punctuation.terminator.aerix" }
          }
        },
        {
          "match": "\\b(import)\\s+([A-Z][a-zA-Z0-9_]*)\\s*(;)?",
          "captures": {
            "1": { "name": "keyword.control.import.aerix" },
            "2": { "name": "entity.name.namespace.aerix" },
            "3": { "name": "punctuation.terminator.aerix" }
          }
        },
        {
          "match": "\\b(import)\\s*(\\{)([^}]+)(\\})\\s*(from)\\s*(\"[^\"]+\")\\s*(;)?",
          "captures": {
            "1": { "name": "keyword.control.import.aerix" },
            "2": { "name": "punctuation.brackets.curly.aerix" },
            "3": { "name": "variable.other.readwrite.import.aerix" },
            "4": { "name": "punctuation.brackets.curly.aerix" },
            "5": { "name": "keyword.control.import.from.aerix" },
            "6": { "name": "string.quoted.double.aerix" },
            "7": { "name": "punctuation.terminator.aerix" }
          }
        },
        {
          "match": "\\b(import)\\s*(\"[^\"]+\")\\s*(;)?",
          "captures": {
            "1": { "name": "keyword.control.import.aerix" },
            "2": { "name": "string.quoted.double.aerix" },
            "3": { "name": "punctuation.terminator.aerix" }
          }
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "('[a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)",
          "captures": {
            "1": { "name": "entity.name.label.aerix" },
            "2": { "name": "punctuation.separator.colon.aerix" }
          }
        },
        {
          "match": "\\b(break|continue)\\s+('[a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.aerix" },
            "2": { "name": "entity.name.label.aerix" }
          }
        }
      ]
    },
    "closures": {
      "patterns": [
        {
          "match": "(\\|)([a-zA-Z0-9_,\\s]*?)(\\|)(?=\\s*(?:=>|\\{|[a-zA-Z0-9_]))",
          "captures": {
            "1": { "name": "punctuation.definition.parameters.begin.aerix" },
            "2": { "name": "variable.parameter.closure.aerix" },
            "3": { "name": "punctuation.definition.parameters.end.aerix" }
          }
        }
      ]
    },
    "pipeline": {
      "patterns": [
        {
          "name": "keyword.operator.pipeline.aerix",
          "match": "\\|>"
        }
      ]
    },
    "cascade": {
      "patterns": [
        {
          "name": "keyword.operator.cascade.aerix",
          "match": "~>"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.aerix",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.aerix" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.aerix" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.aerix",
              "match": "\\\\([nrt\\\\\"'0]|x[0-9a-fA-F]{2})"
            },
            {
              "name": "meta.template.expression.aerix",
              "begin": "(\\$?\\{)",
              "beginCaptures": {
                "1": { "name": "punctuation.definition.template-expression.begin.aerix" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.definition.template-expression.end.aerix" }
              },
              "contentName": "source.aerix.embedded.expression",
              "patterns": [
                { "include": "#pipeline" },
                { "include": "#cascade" },
                { "include": "#strings" },
                { "include": "#numbers" },
                { "include": "#qualified_access" },
                { "include": "#member_access" },
                { "include": "#enum_access" },
                { "include": "#math_functions" },
                { "include": "#builtins" },
                { "include": "#constants" },
                { "include": "#function_call" },
                { "include": "#operators" },
                {
                  "name": "variable.other.readwrite.aerix",
                  "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.aerix",
          "match": "'(\\\\.|[^'\\\\])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.aerix",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.aerix",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.aerix",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.integer.aerix",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "cinterop": {
      "patterns": [
        {
          "name": "keyword.control.directive.aerix",
          "match": "\\b(cinclude|cextern)\\b"
        }
      ]
    },
    "function_definition": {
      "patterns": [
        {
          "begin": "\\b(?:(pub|priv|prot)\\s+)?(?:(static|virtual|override)\\s+)?(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)(?:<([^>]+)>)?\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "storage.modifier.aerix" },
            "2": { "name": "storage.modifier.aerix" },
            "3": { "name": "keyword.other.fn.aerix" },
            "4": { "name": "entity.name.function.aerix" },
            "5": { "name": "entity.name.type.type-parameter.aerix" },
            "6": { "name": "punctuation.definition.parameters.begin.aerix" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.definition.parameters.end.aerix" }
          },
          "patterns": [
            { "include": "#function_parameters" }
          ]
        }
      ]
    },
    "constructor_definition": {
      "patterns": [
        {
          "begin": "\\b(?:(pub|priv|prot)\\s+)?(init|drop)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "storage.modifier.aerix" },
            "2": { "name": "entity.name.function.constructor.aerix" },
            "3": { "name": "punctuation.definition.parameters.begin.aerix" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.definition.parameters.end.aerix" }
          },
          "patterns": [
            { "include": "#function_parameters" }
          ]
        }
      ]
    },
    "function_parameters": {
      "patterns": [
        { "include": "#comments" },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)(?!:)\\s*\\b(i8|i16|i32|i64|int|u8|u16|u32|u64|uint|usize|isize|f32|f64|float|f32x4|f64x2|bool|char|str|void|null)\\b(\\?)?",
          "captures": {
            "1": { "name": "variable.parameter.aerix" },
            "2": { "name": "punctuation.separator.colon.aerix" },
            "3": { "name": "storage.type.primitive.aerix" },
            "4": { "name": "storage.type.nullable.aerix" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)(?!:)\\s*([A-Z][a-zA-Z0-9_]*(?:<[a-zA-Z0-9_,\\s]+>)?\\??)",
          "captures": {
            "1": { "name": "variable.parameter.aerix" },
            "2": { "name": "punctuation.separator.colon.aerix" },
            "3": { "name": "entity.name.type.class.aerix" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)(?!:)",
          "captures": {
            "1": { "name": "variable.parameter.aerix" },
            "2": { "name": "punctuation.separator.colon.aerix" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b(?=\\s*[,\\)])",
          "captures": {
            "1": { "name": "variable.parameter.aerix" }
          }
        },
        { "include": "#types" },
        {
          "name": "punctuation.separator.comma.aerix",
          "match": ","
        }
      ]
    },
    "class_definition": {
      "patterns": [
        {
          "match": "\\b(class|trait|enum)\\s+([a-zA-Z_][a-zA-Z0-9_]*)(?:<([^>]+)>)?",
          "captures": {
            "1": { "name": "storage.type.class.aerix" },
            "2": { "name": "entity.name.type.class.aerix" },
            "3": { "name": "entity.name.type.type-parameter.aerix" }
          }
        }
      ]
    },
    "extend_definition": {
      "patterns": [
        {
          "match": "\\b(extend)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.class.aerix" },
            "2": { "name": "entity.name.type.class.aerix" }
          }
        }
      ]
    },
    "property_definition": {
      "patterns": [
        {
          "match": "\\b(?:(pub|priv)\\s+)?(prop)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.aerix" },
            "2": { "name": "keyword.control.property.aerix" },
            "3": { "name": "variable.other.property.aerix" }
          }
        },
        {
          "begin": "\\b(set)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "keyword.other.set.aerix" },
            "2": { "name": "punctuation.definition.parameters.begin.aerix" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.definition.parameters.end.aerix" }
          },
          "patterns": [
            { "include": "#function_parameters" }
          ]
        }
      ]
    },
    "operator_definition": {
      "patterns": [
        {
          "begin": "\\b(?:(pub|priv)\\s+)?(op)\\s+([+\\-*/%^&|~!<>=]+|==|!=|<=|>=)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "storage.modifier.aerix" },
            "2": { "name": "keyword.control.operator.aerix" },
            "3": { "name": "entity.name.function.operator.aerix" },
            "4": { "name": "punctuation.definition.parameters.begin.aerix" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.definition.parameters.end.aerix" }
          },
          "patterns": [
            { "include": "#function_parameters" }
          ]
        }
      ]
    },
    "class_field": {
      "match": "\\b(?:(pub|priv|prot)\\s+)?(?:(static)\\s+)?([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)(?!:)\\s*([a-zA-Z0-9_?<>]+)",
      "captures": {
        "1": { "name": "storage.modifier.aerix" },
        "2": { "name": "storage.modifier.aerix" },
        "3": { "name": "variable.other.property.aerix" },
        "4": { "name": "punctuation.separator.colon.aerix" },
        "5": { "name": "storage.type.primitive.aerix" }
      }
    },
    "qualified_access": {
      "patterns": [
        {
          "match": "\\b([A-Z][a-zA-Z0-9_]*)\\s*(\\.)\\s*([A-Z][A-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.namespace.aerix" },
            "2": { "name": "punctuation.accessor.aerix" },
            "3": { "name": "constant.other.caps.aerix" }
          }
        },
        {
          "match": "\\b([A-Z][a-zA-Z0-9_]*)\\s*(\\.)\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.namespace.aerix" },
            "2": { "name": "punctuation.accessor.aerix" },
            "3": { "name": "entity.name.function.member.aerix" }
          }
        },
        {
          "match": "\\b([A-Z][a-zA-Z0-9_]*)\\s*(\\.)\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.type.class.aerix" },
            "2": { "name": "punctuation.accessor.aerix" },
            "3": { "name": "variable.other.property.aerix" }
          }
        }
      ]
    },
    "member_access": {
      "patterns": [
        {
          "match": "\\b(self)\\s*(\\.)\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "variable.language.self.aerix" },
            "2": { "name": "punctuation.accessor.aerix" },
            "3": { "name": "entity.name.function.member.aerix" }
          }
        },
        {
          "match": "\\b(self)\\s*(\\.)\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "variable.language.self.aerix" },
            "2": { "name": "punctuation.accessor.aerix" },
            "3": { "name": "variable.other.property.aerix" }
          }
        },
        {
          "match": "(\\b[a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\.)\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "variable.other.object.aerix" },
            "2": { "name": "punctuation.accessor.aerix" },
            "3": { "name": "entity.name.function.member.aerix" }
          }
        },
        {
          "match": "(\\b[a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\.)\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "variable.other.object.aerix" },
            "2": { "name": "punctuation.accessor.aerix" },
            "3": { "name": "variable.other.property.aerix" }
          }
        }
      ]
    },
    "named_args": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(=)(?!>|=)",
          "captures": {
            "1": { "name": "variable.parameter.named.aerix" },
            "2": { "name": "keyword.operator.assignment.aerix" }
          }
        }
      ]
    },
    "variable_declaration": {
      "patterns": [
        {
          "match": "\\b(let)\\s+(?:(mut)\\s+)?([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)(?!:)\\s*\\b(i8|i16|i32|i64|int|u8|u16|u32|u64|uint|usize|isize|f32|f64|float|f32x4|f64x2|bool|char|str|void|null)\\b",
          "captures": {
            "1": { "name": "keyword.other.let.aerix" },
            "2": { "name": "storage.modifier.mut.aerix" },
            "3": { "name": "variable.other.readwrite.aerix" },
            "4": { "name": "punctuation.separator.colon.aerix" },
            "5": { "name": "storage.type.primitive.aerix" }
          }
        },
        {
          "match": "\\b(let)\\s+(?:(mut)\\s+)?([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)(?!:)\\s*([A-Z][a-zA-Z0-9_]*(?:<[a-zA-Z0-9_,\\s]+>)?\\??)",
          "captures": {
            "1": { "name": "keyword.other.let.aerix" },
            "2": { "name": "storage.modifier.mut.aerix" },
            "3": { "name": "variable.other.readwrite.aerix" },
            "4": { "name": "punctuation.separator.colon.aerix" },
            "5": { "name": "entity.name.type.class.aerix" }
          }
        },
        {
          "match": "\\b(let)\\s+(?:(mut)\\s+)?([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.let.aerix" },
            "2": { "name": "storage.modifier.mut.aerix" },
            "3": { "name": "variable.other.readwrite.aerix" }
          }
        },
        {
          "match": "\\b(mut)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.mut.aerix" },
            "2": { "name": "variable.other.readwrite.aerix" }
          }
        },
        {
          "match": "\\b(const)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)(?!:)\\s*([a-zA-Z0-9_?<>]+)",
          "captures": {
            "1": { "name": "storage.modifier.const.aerix" },
            "2": { "name": "constant.other.caps.aerix" },
            "3": { "name": "punctuation.separator.colon.aerix" },
            "4": { "name": "storage.type.primitive.aerix" }
          }
        }
      ]
    },
    "keywords_control": {
      "patterns": [
        {
          "name": "keyword.control.import.aerix",
          "match": "\\b(import|from)\\b"
        },
        {
          "name": "keyword.control.aerix",
          "match": "\\b(try|catch|finally|throw)\\b"
        },
        {
          "name": "keyword.control.pattern.aerix",
          "match": "\\b(if\\s+let|guard\\s+let)\\b"
        },
        {
          "name": "keyword.control.match.aerix",
          "match": "\\bmatch\\b"
        },
        {
          "name": "keyword.control.guard.aerix",
          "match": "\\bguard\\b"
        },
        {
          "name": "keyword.control.spawn.aerix",
          "match": "\\bspawn\\b"
        },
        {
          "name": "keyword.control.defer.aerix",
          "match": "\\bdefer\\b"
        },
        {
          "name": "keyword.control.property.aerix",
          "match": "\\bprop\\b"
        },
        {
          "name": "keyword.control.operator.aerix",
          "match": "\\bop\\b"
        },
        {
          "name": "keyword.other.get.aerix",
          "match": "\\bget\\b"
        },
        {
          "name": "keyword.other.set.aerix",
          "match": "\\bset\\b"
        },
        {
          "name": "keyword.control.aerix",
          "match": "\\b(if|else|elif|while|for|in|loop|return|break|continue|try|catch|finally|throw)\\b"
        }
      ]
    },
    "keywords_decl": {
      "patterns": [
        {
          "name": "keyword.other.let.aerix",
          "match": "\\blet\\b"
        },
        {
