          "name": "support.function.math.aerix",
          "match": "\\b(abs|min|max|clamp|sign|is_even|is_odd|floor|ceil|round|trunc|fract|lerp|smoothstep|sqrt|cbrt|hypot|pow|factorial|nPr|nCr|gcd|lcm|is_prime|next_prime|deg_to_rad|rad_to_deg|sin|cos|tan|cot|sec|csc|exp|ln|log10|log2|pow_f64)\\b(?=\\s*\\()"
