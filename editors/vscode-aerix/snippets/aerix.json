{
  "Aerix Main Function": {
    "prefix": "main",
    "body": [
      "fn main() {",
      "\t${0}",
      "}"
    ],
    "description": "Create the main entry point function"
  },
  "Aerix Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}) -> ${3:i64} {",
      "\t${0}",
      "}"
    ],
    "description": "Standard block function"
  },
  "Aerix Expression Function": {
    "prefix": "fn_expr",
    "body": [
      "fn ${1:name}(${2:params}) -> ${3:i64} => ${0}"
    ],
    "description": "Concise single-expression function (=>)"
  },
  "Aerix Variable Let": {
    "prefix": "let",
    "body": [
      "let ${1:name} = ${0}"
    ],
    "description": "Declare an immutable variable"
  },
  "Aerix Variable Mut": {
    "prefix": "mut",
    "body": [
      "mut ${1:name} = ${0}"
    ],
    "description": "Declare a mutable variable"
  },
  "Aerix Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "\tpub ${2:field}: ${3:str}",
      "",
      "\tinit(${2:field}: ${3:str}) {",
      "\t\tself.${2:field} = ${2:field}",
      "\t}",
      "",
      "\t${0}",
      "}"
    ],
    "description": "Declare an OOP class with fields and constructor"
  },
  "Aerix Class Extends": {
    "prefix": "class_extends",
    "body": [
      "class ${1:Derived} extends ${2:Base} {",
      "\tinit(${3:args}) {",
      "\t\tsuper.init(${3:args})",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Declare an inherited subclass"
  },
  "Aerix Trait": {
    "prefix": "trait",
    "body": [
      "trait ${1:Name} {",
      "\tfn ${2:method_name}(${3:params}) -> ${4:void}",
      "}"
    ],
    "description": "Declare an abstract trait contract"
  },
  "Aerix If": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t${0}",
      "}"
    ],
    "description": "Conditional if block"
  },
  "Aerix If Else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition} {",
      "\t${2}",
      "} else {",
      "\t${0}",
      "}"
    ],
    "description": "If-else conditional block"
  },
  "Aerix For Range": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:0}..${3:10} {",
      "\t${0}",
      "}"
    ],
    "description": "Range-based for loop"
  },
  "Aerix While Loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t${0}",
      "}"
    ],
    "description": "While loop"
  },
  "Aerix Infinite Loop": {
    "prefix": "loop",
    "body": [
      "loop {",
      "\t${0}",
      "}"
    ],
    "description": "Infinite loop"
  },
  "Aerix Defer Cleanup": {
    "prefix": "defer",
    "body": [
      "defer ${0}"
    ],
    "description": "Scoped LIFO deferred statement"
  },
  "Aerix Println": {
    "prefix": "println",
    "body": [
      "println(\"${1:{var\\}}\")"
    ],
    "description": "Print formatted line to stdout"
  },
  "Aerix Input": {
    "prefix": "input",
    "body": [
      "mut ${1:name} = input(\"${2:Enter: }\")"
    ],
    "description": "Read console input as a string"
  },
  "Aerix Typed Input": {
    "prefix": "input_typed",
    "body": [
      "mut ${1:name}: ${2|i32,i64,u8,u16,u32,u64,uint,f64,f32,bool,str|} = input(\"${3:Enter: }\")"
    ],
    "description": "Read console input parsed directly into a specific data type"
  },
  "Aerix Typeof": {
    "prefix": "typeof",
    "body": [
      "typeof(${1:expr})"
    ],
    "description": "Query the data type of any variable or expression"
  },
  "Aerix Type Cast": {
    "prefix": "as",
    "body": [
      "${1:expr} as ${2|i32,i64,u8,u16,u32,u64,uint,f64,f32,str,bool|}"
    ],
    "description": "Cast expression to another data type"
  },
  "Aerix Pipeline": {
    "prefix": "pipe",
    "body": [
      "|> ${1:func}()"
    ],
    "description": "Pipe result into function call"
  },
  "Aerix Cascade": {
    "prefix": "cascade",
    "body": [
      "~> ${1:method}()"
    ],
    "description": "Fluent cascade mutation (~>)"
  },
  "Aerix Thread Spawn": {
    "prefix": "spawn",
    "body": [
      "let ${1:t} = spawn ${2:worker}(${3:args})"
    ],
    "description": "Spawn a function asynchronously on a native OS thread"
  },
  "Aerix Channel": {
    "prefix": "channel",
    "body": [
      "let ${1:ch} = arx_channel_new(${2:8})"
    ],
    "description": "Create a thread-safe bounded communication channel"
  },
  "Aerix Guard": {
    "prefix": "guard",
    "body": [
      "guard ${1:condition} else {",
      "\t${2:return}",
      "}"
    ],
    "description": "Early exit guard statement"
  },
  "Aerix Match": {
    "prefix": "match",
    "body": [
      "match ${1:expr} {",
      "\t${2:Variant} => ${3},",
      "\t_ => ${0}",
      "}"
    ],
    "description": "Exhaustive pattern matching on enums"
  },
  "Aerix Enum Tagged Union": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t${2:Variant1},",
      "\t${3:Variant2}(${4:payload}: ${5:i64})",
      "}"
    ],
    "description": "Declare an enum or tagged union"
  },
  "Aerix Property": {
    "prefix": "prop",
    "body": [
      "pub prop ${1:name}: ${2:i64} {",
      "\tget => ${3:self._field}",
      "}"
    ],
    "description": "Declare a reactive property with getter/setter"
  },
  "Aerix Generic Class": {
    "prefix": "class_generic",
    "body": [
      "class ${1:Name}<${2:T}> {",
      "\tpub ${3:value}: ${2:T}",
      "",
      "\tinit(${3:value}: ${2:T}) {",
      "\t\tself.${3:value} = ${3:value}",
      "\t}",
      "}"
    ],
    "description": "Declare a monomorphized generic class"
  },
  "Aerix Generic Function": {
    "prefix": "fn_generic",
    "body": [
      "fn ${1:name}<${2:T}>(${3:arg}: ${2:T}) -> ${2:T} {",
      "\treturn ${3:arg}",
      "}"
    ],
    "description": "Declare a monomorphized generic function"
  },
  "Aerix Canvas Fill Rect (WASM)": {
    "prefix": "canvas_rect",
    "body": [
      "arx_canvas_fill_rect(${1:x}, ${2:y}, ${3:width}, ${4:height}, ${5:r}, ${6:g}, ${7:b}, ${8:255});"
    ],
    "description": "Fill a rectangular region on HTML5 Canvas in WebAssembly"
  },
  "Aerix Canvas Pixel (WASM)": {
    "prefix": "canvas_pixel",
    "body": [
      "arx_canvas_set_pixel(${1:x}, ${2:y}, ${3:r}, ${4:g}, ${5:b}, ${6:255});"
    ],
    "description": "Draw a single pixel onto HTML5 Canvas in WebAssembly"
  },
  "Aerix Canvas Clear (WASM)": {
    "prefix": "canvas_clear",
    "body": [
      "arx_canvas_clear(${1:13}, ${2:17}, ${3:23}, ${4:255});"
    ],
    "description": "Clear HTML5 Canvas in WebAssembly with RGBA background color"
  },
  "Aerix WebAssembly Canvas App": {
    "prefix": "wasm_app",
    "body": [
      "fn main() {",
      "\tprintln(\"Initializing Aerix WebAssembly Engine...\");",
      "\tarx_canvas_clear(13, 17, 23, 255);",
      "\tarx_canvas_fill_rect(50, 50, 200, 100, 0, 220, 255, 255);",
      "\tprintln(\"Rendered successfully.\");",
      "}"
    ],
    "description": "WebAssembly Canvas starter application"
  },
  "Aerix Import File": {
    "prefix": "import_file",
    "body": [
      "import \"./${1:module}.arx\""
    ],
    "description": "Import a local .arx module file"
  },
  "Aerix Import Module": {
    "prefix": "import",
    "body": [
      "import ${1:Module}"
    ],
    "description": "Import an Aerix standard or local module"
  },
  "Aerix Import Module As": {
    "prefix": "import_as",
    "body": [
      "import ${1:Module} as ${2:Alias}"
    ],
    "description": "Import a module with an alias"
  },
  "Aerix Import Submodule": {
    "prefix": "import_sub",
    "body": [
      "import ${1:Window.Gui}"
    ],
    "description": "Import a dotted submodule"
  },
  "Aerix From Import": {
    "prefix": "from",
    "body": [
      "from ${1:Module} import ${2:item}"
    ],
    "description": "Selectively import symbols from a module"
  },
  "Aerix From Import As": {
    "prefix": "from_as",
    "body": [
      "from ${1:Module} import ${2:item} as ${3:alias}"
    ],
    "description": "Selectively import symbols from a module with an alias"
  },
  "Aerix From Submodule Import": {
    "prefix": "from_sub",
    "body": [
      "from ${1:Window.Gui} import ${2:create_window}"
    ],
    "description": "Selectively import from a dotted submodule"
  },
  "Aerix Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\tpub ${2:field}: ${3:i64}${0}",
      "}"
    ],
    "description": "Declare a lightweight aggregate struct"
  },
  "Aerix Extend Type": {
    "prefix": "extend",
    "body": [
      "extend ${1:TargetType} {",
      "\tpub fn ${2:method}(${3:params}) -> ${4:void} {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Add extension methods to an existing class or primitive"
  },
  "Aerix Method": {
    "prefix": "method",
    "body": [
      "pub fn ${1:name}(${2:params}) -> ${3:void} {",
      "\t${0}",
      "}"
    ],
    "description": "Declare a public class method"
  },
  "Aerix Try Catch": {
    "prefix": "try",
    "body": [
      "try {",
      "\t${1}",
      "} catch ${2:err} {",
      "\teprintln(${2:err})",
      "\t${0}",
      "}"
    ],
    "description": "Structured exception handling frame"
  },
  "Aerix For-In Collection": {
    "prefix": "for_in",
    "body": [
      "for ${1:item} in ${2:collection} {",
      "\t${0}",
      "}"
    ],
    "description": "Iterate over items in a List or collection"
  },
  "Aerix Doc Comment": {
    "prefix": "doc",
    "body": [
      "/// ${1:Summary description of this symbol.}",
      "///"
    ],
    "description": "Insert triple-slash doc comment shown in Hover and IntelliSense"
  },
  "Aerix Unit Test": {
    "prefix": "test",
    "body": [
      "#[test]",
      "fn test_${1:behavior}() {",
      "\tassert_eq(${2:actual}, ${0:expected})",
      "}"
    ],
    "description": "Declare a unit test function"
  }
}
