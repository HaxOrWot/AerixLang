{
  "name": "aerix",
  "displayName": "Aerix Language & IntelliSense Support",
  "description": "Official language support, LSP IntelliSense completions, hover documentation, semantic syntax highlighting, code navigation, and file icons for Aerix (.arx).",
  "version": "2.2.25",
  "publisher": "aerix-lang",
  "icon": "icons/aerix-icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aerix-lang/aerix"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "aerix",
    "arx",
    "systems",
    "compiler",
    "c",
    "performance",
    "intellisense"
  ],
  "contributes": {
    "languages": [
      {
        "id": "aerix",
        "aliases": [
          "Aerix",
          "arx"
        ],
        "extensions": [
          ".arx"
        ],
        "filenamePatterns": [
          "*.arx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/aerix-icon.svg",
          "dark": "./icons/aerix-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "aerix",
        "scopeName": "source.aerix",
        "path": "./syntaxes/aerix.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "files.associations": {
        "*.arx": "aerix"
      },
      "[aerix]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        },
        "editor.suggest.showStatusBar": true,
        "editor.parameterHints.enabled": true,
        "editor.suggestOnTriggerCharacters": true,
        "editor.acceptSuggestionOnEnter": "on",
        "editor.snippetSuggestions": "top"
      }
    },
    "semanticTokenScopes": [
      {
        "language": "aerix",
        "scopes": {
          "comment.documentation": ["comment.block.documentation.aerix", "comment.line.documentation.aerix"],
          "keyword.controlFlow": ["keyword.control.aerix"],
          "keyword.abstract": ["storage.modifier.aerix"],
          "keyword.readonly": ["constant.language.boolean.aerix", "constant.language.null.aerix"],
          "variable.readonly": ["variable.other.constant.aerix"],
          "variable.readonly.static": ["variable.other.constant.aerix"],
          "parameter": ["variable.parameter.aerix"],
          "parameter.readonly": ["variable.parameter.aerix"],
          "property.readonly": ["variable.other.property.aerix"],
          "enumMember.static": ["variable.other.enummember.aerix"],
          "typeParameter": ["entity.name.type.parameter.aerix"],
          "class.declaration": ["entity.name.type.class.aerix"],
          "enum.declaration": ["entity.name.type.enum.aerix"],
          "function.declaration": ["entity.name.function.aerix"],
          "function.defaultLibrary": ["support.function.builtin.aerix"],
          "method.declaration": ["entity.name.function.method.aerix"],
          "method.defaultLibrary": ["support.function.aerix"],
          "method.static.defaultLibrary": ["support.function.aerix"],
          "namespace.defaultLibrary": ["support.class.aerix"],
          "type.defaultLibrary": ["support.type.primitive.aerix", "storage.type.aerix"],
          "class.defaultLibrary": ["support.class.aerix"],
          "macro": ["meta.attribute.aerix", "entity.name.function.decorator.aerix"]
        }
      }
    ],
    "configuration": {
      "title": "Aerix",
      "properties": {
        "aerix.executablePath": {
          "type": "string",
          "default": "",
          "description": "Path to the Aerix compiler/LSP binary (arx / arxc). Leave empty to auto-detect on AERIX_HOME, PATH, %LOCALAPPDATA%\\Programs\\Aerix\\bin, C:\\Aerix\\bin, or ~/.aerix/bin."
        },
        "aerix.autoUpdate": {
          "type": "string",
          "enum": ["auto", "prompt", "off"],
          "default": "auto",
          "description": "Automatically check for and install the latest stable Aerix release from GitHub."
        }
      }
    },
    "snippets": [
      {
        "language": "aerix",
        "path": "./snippets/aerix.json"
      }
    ],
    "iconThemes": [
      {
        "id": "aerix-icons",
        "label": "Aerix File Icons (X Symbol)",
        "path": "./icons/aerix-icons.json"
      }
    ],
    "commands": [
      {
        "command": "aerix.runFile",
        "title": "Run Aerix Program",
        "category": "Aerix",
        "icon": "$(play)"
      },
      {
        "command": "aerix.checkFile",
        "title": "Check Syntax & Types",
        "category": "Aerix",
        "icon": "$(pass)"
      },
      {
        "command": "aerix.buildWasm",
        "title": "Compile to WebAssembly (WASM)",
        "category": "Aerix",
        "icon": "$(globe)"
      },
      {
        "command": "aerix.serveWasm",
        "title": "Run WebAssembly in Browser (Live)",
        "category": "Aerix",
        "icon": "$(browser)"
      },
      {
        "command": "aerix.checkUpdates",
        "title": "Check for Updates (Latest Stable)",
        "category": "Aerix",
        "icon": "$(cloud-download)"
      },
      {
        "command": "aerix.switchVersion",
        "title": "Switch Toolchain Version (Version Manager)",
        "category": "Aerix",
        "icon": "$(versions)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "aerix.runFile",
          "when": "resourceExtname == .arx",
          "group": "navigation@1"
        },
        {
          "command": "aerix.checkFile",
          "when": "resourceExtname == .arx",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "aerix.runFile",
          "when": "resourceExtname == .arx",
          "group": "aerix@1"
        },
        {
          "command": "aerix.checkFile",
          "when": "resourceExtname == .arx",
          "group": "aerix@2"
        },
        {
          "command": "aerix.buildWasm",
          "when": "resourceExtname == .arx",
          "group": "aerix@3"
        },
        {
          "command": "aerix.serveWasm",
          "when": "resourceExtname == .arx",
          "group": "aerix@4"
        }
      ]
    }
  }
}

