// Aerix Native LSP — Language Intelligence Providers
// Provides diagnostics, completions, hover, signature help, definition, symbols, inlay hints, codeLens, and formatting.

import "../frontend/tokens.arx"
import "../frontend/lexer.arx"
import "../frontend/ast.arx"
import "../frontend/parser.arx"
import "../middle/paths.arx"
import "../middle/types.arx"
import "../middle/analyzer.arx"
import "./json.arx"
import "./docs.arx"

// LSP CompletionItemKind constants
pub fn CKIND_METHOD() -> i64 { return 2 }
pub fn CKIND_FUNCTION() -> i64 { return 3 }
pub fn CKIND_FIELD() -> i64 { return 5 }
pub fn CKIND_VARIABLE() -> i64 { return 6 }
pub fn CKIND_CLASS() -> i64 { return 7 }
pub fn CKIND_MODULE() -> i64 { return 9 }
pub fn CKIND_ENUM() -> i64 { return 13 }
pub fn CKIND_KEYWORD() -> i64 { return 14 }
pub fn CKIND_SNIPPET() -> i64 { return 15 }
pub fn CKIND_FILE() -> i64 { return 17 }
pub fn CKIND_FOLDER() -> i64 { return 19 }
pub fn CKIND_ENUM_MEM() -> i64 { return 20 }
pub fn CKIND_CONSTANT() -> i64 { return 21 }

// LSP SymbolKind constants
pub fn SKIND_CLASS() -> i64 { return 5 }
pub fn SKIND_METHOD() -> i64 { return 6 }
pub fn SKIND_FIELD() -> i64 { return 8 }
pub fn SKIND_CTOR() -> i64 { return 9 }
pub fn SKIND_ENUM() -> i64 { return 10 }
pub fn SKIND_FUNCTION() -> i64 { return 12 }
pub fn SKIND_VAR() -> i64 { return 13 }
pub fn SKIND_ENUM_MEM() -> i64 { return 22 }

pub fn lsp_analyze_document(doc_path: str, source: str, docs_by_path: Map<str, str>) -> Analyzer {
    let norm = bpath_normalize(doc_path)
    mut p = Parser(norm)
    p.recover_mode = true
    p.virtual_docs = docs_by_path
    p.load_source(source, norm)
    mut az = Analyzer(p)
    az.analyze()
    return az
}

pub fn lsp_get_line_text(source: str, target_line0: i64) -> str {
    let n = source.len()
    mut ln = 0
    mut i = 0
    while ln < target_line0 && i < n {
        if source.byte_at(i) == 10 { ln = ln + 1 }
        i = i + 1
    }
    let st = i
    while i < n && source.byte_at(i) != 10 && source.byte_at(i) != 13 {
        i = i + 1
    }
    return source.slice(st, i)
}

pub fn lsp_count_lines(source: str) -> i64 {
    let n = source.len()
    mut cnt = 1
    mut i = 0
    while i < n {
        if source.byte_at(i) == 10 { cnt = cnt + 1 }
        i = i + 1
    }
    return cnt
}

pub fn lsp_word_start_at(source: str, line0: i64, char0: i64) -> i64 {
    let line = lsp_get_line_text(source, line0)
    let len = line.len()
    if len == 0 { return -1 }
    mut idx = char0
    if idx >= len { idx = len - 1 }
    if idx < 0 { return -1 }

    if !lsp_is_ident_char(line.byte_at(idx)) && idx > 0 && lsp_is_ident_char(line.byte_at(idx - 1)) {
        idx = idx - 1
    }
    if !lsp_is_ident_char(line.byte_at(idx)) {
        return -1
    }
    mut st = idx
    while st > 0 && lsp_is_ident_char(line.byte_at(st - 1)) {
        st = st - 1
    }
    return st
}

fn lsp_lbrace() -> str {
    let bb = ByteBuffer()
    bb.write_u8(123)
    let s = bb.to_str()
    bb.free()
    return s
}

pub fn lsp_word_at(source: str, line0: i64, char0: i64) -> str {
    let line = lsp_get_line_text(source, line0)
    let len = line.len()
    let st = lsp_word_start_at(source, line0, char0)
    if st < 0 { return "" }
    mut ed = st + 1
    while ed < len && lsp_is_ident_char(line.byte_at(ed)) {
        ed = ed + 1
    }
    return line.slice(st, ed)
}

fn lsp_find_node_col0(source: str, ln1: i64, name: str) -> i64 {
    if ln1 <= 0 || name == "" { return 0 }
    let line = lsp_get_line_text(source, ln1 - 1)
    let n = line.len()
    let m = name.len()
    mut start = 0
    while start <= n - m {
        let pos = lsp_str_find(line, name, start)
        if pos < 0 { break }
        let left_ok = pos == 0 || !lsp_is_ident_char(line.byte_at(pos - 1))
        let right_idx = pos + m
        let right_ok = right_idx >= n || !lsp_is_ident_char(line.byte_at(right_idx))
        if left_ok && right_ok { return pos }
        start = pos + 1
    }
    let fallback = lsp_str_find(line, name, 0)
    if fallback >= 0 { return fallback }
    return 0
}

fn lsp_read_target_source(source: str, doc_path: str, tfile: str) -> str {
    if tfile == doc_path { return source }
    if tfile != "" && File.exists(tfile) {
        return File.read_to_string(tfile)
    }
    return ""
}

fn lsp_format_doc_line(line: str) -> str {
    let t = line.trim()
    if t.starts_with("@param ") {
        let rest = t.slice(7, t.len()).trim()
        let sp = lsp_str_find(rest, " ", 0)
        if sp > 0 {
            let pname = rest.slice(0, sp).trim()
            let pdesc = rest.slice(sp + 1, rest.len()).trim()
            return "- `" + pname + "` — " + pdesc
        }
        return "- `" + rest + "`"
    }
    if t.starts_with("@returns ") {
        return "**Returns:** " + t.slice(9, t.len()).trim()
    }
    if t.starts_with("@return ") {
        return "**Returns:** " + t.slice(8, t.len()).trim()
    }
    if t.starts_with("@note ") {
        return "> **Note:** " + t.slice(6, t.len()).trim()
    }
    if t == "@example" || t.starts_with("@example ") {
        let ex = t.slice(8, t.len()).trim()
        if ex != "" { return "**Example:** `" + ex + "`" }
        return "**Example:**"
    }
    return line
}

fn lsp_extract_doc_comments(source: str, doc_path: str, tfile: str, ln1: i64) -> str {
    let fsrc = lsp_read_target_source(source, doc_path, tfile)
    if fsrc == "" || ln1 <= 1 { return "" }
    let collected = List<str>()
    mut cur_ln0 = ln1 - 2
    mut steps = 0
    while cur_ln0 >= 0 && steps < 24 {
        let raw = lsp_get_line_text(fsrc, cur_ln0).trim()
        if raw.starts_with("///") {
            mut c = raw.slice(3, raw.len())
            if c.starts_with(" ") { c = c.slice(1, c.len()) }
            collected.push(lsp_format_doc_line(c))
        } else if raw.starts_with("//") {
            mut c = raw.slice(2, raw.len())
            if c.starts_with(" ") { c = c.slice(1, c.len()) }
            collected.push(lsp_format_doc_line(c))
        } else if raw.starts_with("#[") && collected.len() == 0 {
            // Skip attribute lines right above declaration
        } else {
            break
        }
        cur_ln0 = cur_ln0 - 1
        steps = steps + 1
    }
    if collected.len() == 0 { return "" }
    let bb = ByteBuffer()
    mut idx = collected.len() - 1
    while idx >= 0 {
        if idx < collected.len() - 1 { bb.write_str("\n") }
        bb.write_str(collected.get(idx))
        idx = idx - 1
    }
    let out = bb.to_str()
    bb.free()
    return out
}

fn lsp_block_end_line1(source: str, decl_ln1: i64) -> i64 {
    if decl_ln1 <= 0 { return 1000000 }
    let n = source.len()
    mut cur_ln = 1
    mut i = 0
    while cur_ln < decl_ln1 && i < n {
        if source.byte_at(i) == 10 { cur_ln = cur_ln + 1 }
        i = i + 1
    }
    mut seen_brace = false
    mut depth = 0
    mut in_str = false
    mut in_line_com = false
    mut in_blk_com = false
    while i < n {
        let b = source.byte_at(i)
        if b == 10 {
            in_line_com = false
            if !seen_brace && depth == 0 && i > 0 && source.byte_at(i - 1) != 123 {
                // Single-line expression body `fn f() => x` without braces
                mut j = i - 1
                while j >= 0 && source.byte_at(j) != 10 {
                    if j >= 1 && source.byte_at(j - 1) == 61 && source.byte_at(j) == 62 {
                        return cur_ln
                    }
                    j = j - 1
                }
            }
            cur_ln = cur_ln + 1
            i = i + 1
            continue
        }
        if in_line_com { i = i + 1; continue }
        if in_blk_com {
            if b == 42 && i + 1 < n && source.byte_at(i + 1) == 47 {
                in_blk_com = false
                i = i + 2
                continue
            }
            i = i + 1
            continue
        }
        if in_str {
            if b == 92 && i + 1 < n { i = i + 2; continue }
            if b == 34 { in_str = false }
            i = i + 1
            continue
        }
        if b == 47 && i + 1 < n {
            let nb = source.byte_at(i + 1)
            if nb == 47 { in_line_com = true; i = i + 2; continue }
            if nb == 42 { in_blk_com = true; i = i + 2; continue }
        }
        if b == 34 { in_str = true; i = i + 1; continue }
        if b == 123 {
            seen_brace = true
            depth = depth + 1
        } else if b == 125 {
            depth = depth - 1
            if seen_brace && depth <= 0 {
                return cur_ln
            }
        }
        i = i + 1
    }
    return cur_ln
}

fn lsp_format_params(az: Analyzer, fn_nid: i64) -> str {
    let pg = az.la.get(fn_nid)
    if pg < 0 { return "" }
    let pc = az.ll.get(pg)
    let bb = ByteBuffer()
    mut i = 0
    while i < pc {
        if i > 0 { bb.write_str(", ") }
        let pid = az.ch.get(az.ls.get(pg) + i)
        if has_flag(az.ia.get(pid), FLAG_MUT()) {
            bb.write_str("mut ")
        }
        bb.write_str(az.sa.get(pid))
        bb.write_str(": ")
        bb.write_str(btype_norm(az.sb.get(pid)))
        i = i + 1
    }
    let out = bb.to_str()
    bb.free()
    return out
}

fn lsp_fn_signature_str(az: Analyzer, fn_nid: i64) -> str {
    let k = az.nk.get(fn_nid)
    let params = lsp_format_params(az, fn_nid)
    if k == NK_INIT_DEF() {
        return "init(" + params + ")"
    }
    if k == NK_DROP_DEF() {
        return "drop()"
    }
    let nm = az.sa.get(fn_nid)
    let rt = btype_norm(az.sb.get(fn_nid))
    mut prefix = ""
    if has_flag(az.ia.get(fn_nid), FLAG_PUB()) { prefix = "pub " }
    if has_flag(az.ia.get(fn_nid), FLAG_STATIC()) { prefix = prefix + "static " }
    if rt == "" || rt == "void" {
        return prefix + "fn " + nm + "(" + params + ")"
    }
    return prefix + "fn " + nm + "(" + params + ") -> " + rt
}

fn lsp_find_class_node(az: Analyzer, cname: str) -> i64 {
    if !az.cls_idx_map.has_key(cname) { return -1 }
    return az.cls_nodes.get(az.cls_idx_map.get(cname))
}

fn lsp_find_enum_node(az: Analyzer, ename: str) -> i64 {
    if !az.enum_idx_map.has_key(ename) { return -1 }
    return az.enum_nodes.get(az.enum_idx_map.get(ename))
}

fn lsp_enclosing_class_at(az: Analyzer, doc_path: str, line1: i64) -> str {
    mut best_cls = ""
    mut best_line = -1
    mut ci = 0
    while ci < az.cls_count {
        let cid = az.cls_nodes.get(ci)
        if az.nf.get(cid) == doc_path {
            let cln = az.ln.get(cid)
            if cln <= line1 && cln > best_line {
                best_line = cln
                best_cls = az.sa.get(cid)
            }
        }
        ci = ci + 1
    }
    if best_cls == "" { return "" }
    // Ensure no later top-level fn or enum started between best_line and line1
    mut fi = 0
    while fi < az.fn_count {
        let fid = az.fn_nodes.get(fi)
        if az.nf.get(fid) == doc_path {
            let fln = az.ln.get(fid)
            if fln > best_line && fln <= line1 {
                return ""
            }
        }
        fi = fi + 1
    }
    mut ei = 0
    while ei < az.enum_count {
        let eid = az.enum_nodes.get(ei)
        if az.nf.get(eid) == doc_path {
            let eln = az.ln.get(eid)
            if eln > best_line && eln <= line1 {
                return ""
            }
        }
        ei = ei + 1
    }
    return best_cls
}

fn lsp_enclosing_fn_bounds(source: str, az: Analyzer, doc_path: str, line1: i64) -> List<i64> {
    let res = List<i64>()
    mut best_nid = -1
    mut best_start = -1
    mut best_end = 1000000
    mut i = 0
    while i < az.ncount {
        let k = az.nk.get(i)
        if (k == NK_FN_DEF() || k == NK_INIT_DEF() || k == NK_DROP_DEF()) && az.nf.get(i) == doc_path {
            let st = az.ln.get(i)
            if st <= line1 && st > best_start {
                best_start = st
                best_nid = i
            }
        }
        i = i + 1
    }
    if best_nid >= 0 && source != "" {
        best_end = lsp_block_end_line1(source, best_start)
        if line1 > best_end {
            best_nid = -1
            best_start = -1
            best_end = -1
        }
    }
    res.push(best_nid)
    res.push(best_start)
    res.push(best_end)
    return res
}

fn lsp_resolve_scoped_var_node(az: Analyzer, doc_path: str, line1: i64, fn_start: i64, name: str) -> i64 {
    mut best_nid = -1
    mut best_ln = -1
    mut min_ln = 1
    if fn_start > 0 { min_ln = fn_start }
    mut i = 0
    while i < az.ncount {
        let k = az.nk.get(i)
        if (k == NK_VAR_DECL() || k == NK_PARAM() || k == NK_FOR()) && az.nf.get(i) == doc_path {
            let nln = az.ln.get(i)
            if nln >= min_ln && nln <= line1 && nln >= best_ln {
                if az.sa.get(i) == name || (k == NK_FOR() && az.sb.get(i) == name) {
                    best_ln = nln
                    best_nid = i
                }
            }
        }
        i = i + 1
    }
    return best_nid
}

fn lsp_unwrap_optional_type(t: str) -> str {
    let tr = t.trim()
    if tr.ends_with("?") && tr.len() > 1 { return tr.slice(0, tr.len() - 1).trim() }
    if tr.starts_with("Option<") && tr.ends_with(">") {
        let inner = lsp_generic_inner_arg(tr, 0)
        if inner != "" { return inner }
    }
    return tr
}

fn lsp_unwrap_iterable_type(iter_t: str) -> str {
    if iter_t == "" { return "" }
    if iter_t == "str" { return "u8" }
    let elem = lsp_unwrap_indexed_type(iter_t)
    if elem != "" {
        let base_lt = lsp_str_find(iter_t, "<", 0)
        if base_lt > 0 && iter_t.slice(0, base_lt).trim() == "Map" {
            return lsp_generic_inner_arg(iter_t, 0)
        }
        return elem
    }
    return ""
}

fn lsp_resolve_var_type(az: Analyzer, doc_path: str, line1: i64, name: str, source: str = "") -> str {
    if name == "self" {
        return lsp_enclosing_class_at(az, doc_path, line1)
    }
    if name == "super" {
        let ec = lsp_enclosing_class_at(az, doc_path, line1)
        if ec != "" && az.cls_base_map.has_key(ec) {
            return az.cls_base_map.get(ec)
        }
        return ""
    }
    // Check locals/params inside enclosing function (or top-level if none)
    mut min_ln = 1
    if source != "" {
        let fb = lsp_enclosing_fn_bounds(source, az, doc_path, line1)
        if fb.get(1) > 0 { min_ln = fb.get(1) }
    }
    mut best_type = ""
    mut best_ln = -1
    mut best_nid = -1
    mut i = 0
    while i < az.ncount {
        let k = az.nk.get(i)
        if (k == NK_VAR_DECL() || k == NK_PARAM() || k == NK_FOR()) && az.nf.get(i) == doc_path {
            if az.sa.get(i) == name || (k == NK_FOR() && az.sb.get(i) == name) {
                let nln = az.ln.get(i)
                if nln >= min_ln && nln <= line1 && nln >= best_ln {
                    best_ln = nln
                    best_nid = i
                    mut t = btype_norm(az.node_types.get(i))
                    if (t == "" || t == "void") && k != NK_FOR() {
                        t = btype_norm(az.sb.get(i))
                    }
                    if t != "" && t != "void" {
                        best_type = t
                    }
                }
            }
        }
        i = i + 1
    }
    if best_type != "" && (best_nid < 0 || az.nk.get(best_nid) != NK_FOR() || best_type != "i64") {
        return lsp_unwrap_optional_type(best_type)
    }

    // Fallback RHS inference on declaration line when AST node type is unresolved (or default i64 on for-in)
    if best_nid >= 0 {
        let fsrc = lsp_read_target_source(source, doc_path, doc_path)
        if fsrc != "" {
            let dline = lsp_get_line_text(fsrc, best_ln - 1).trim()
            if az.nk.get(best_nid) == NK_FOR() {
                let in_pos = lsp_str_find(dline, " in ", 0)
                if in_pos > 0 {
                    mut rhs_iter = dline.slice(in_pos + 4, dline.len()).trim()
                    let brace_p = lsp_str_find(rhs_iter, lsp_lbrace(), 0)
                    if brace_p > 0 { rhs_iter = rhs_iter.slice(0, brace_p).trim() }
                    if lsp_str_find(rhs_iter, "..", 0) >= 0 { return "i64" }
                    let it = lsp_infer_expr_receiver_type(az, doc_path, best_ln, rhs_iter, fsrc)
                    let elem = lsp_unwrap_iterable_type(it)
                    if elem != "" { return elem }
                }
            } else {
                let eq_pos = lsp_str_find(dline, "=", 0)
                if eq_pos > 0 && (eq_pos + 1 >= dline.len() || dline.byte_at(eq_pos + 1) != 61) {
                    let rhs_e = dline.slice(eq_pos + 1, dline.len()).trim()
                    if rhs_e != "" && rhs_e != name {
                        let rt = lsp_infer_expr_receiver_type(az, doc_path, best_ln, rhs_e, fsrc)
                        if rt != "" { return lsp_unwrap_optional_type(rt) }
                    }
                }
            }
        }
    }
    if best_type != "" { return lsp_unwrap_optional_type(best_type) }

    // Enclosing class fields (implicit self)
    let ec2 = lsp_enclosing_class_at(az, doc_path, line1)
    if ec2 != "" {
        mut walk = ec2
        mut hops = 0
        while walk != "" && hops < 8 {
            let fk = walk + "::" + name
            if az.cls_field_types.has_key(fk) {
                return lsp_unwrap_optional_type(az.cls_field_types.get(fk))
            }
            if az.cls_base_map.has_key(walk) {
                walk = az.cls_base_map.get(walk)
            } else {
                walk = ""
            }
            hops = hops + 1
        }
    }
    // Check module globals
    if az.global_types.has_key(name) {
        return lsp_unwrap_optional_type(az.global_types.get(name))
    }
    return ""
}

fn lsp_generic_inner_arg(t: str, arg_idx: i64) -> str {
    let lt = lsp_str_find(t, "<", 0)
    if lt < 0 { return "" }
    let n = t.len()
    mut gt = n - 1
    while gt > lt && t.byte_at(gt) != 62 {
        gt = gt - 1
    }
    if gt <= lt + 1 { return "" }
    let inner = t.slice(lt + 1, gt)
    mut depth = 0
    mut start = 0
    mut cur_idx = 0
    mut i = 0
    while i <= inner.len() {
        mut at_end = (i == inner.len())
        mut is_sep = false
        if !at_end {
            let b = inner.byte_at(i)
            if b == 60 || b == 40 { depth = depth + 1 }
            else if b == 62 || b == 41 { depth = depth - 1 }
            else if b == 44 && depth == 0 { is_sep = true }
        }
        if at_end || is_sep {
            if cur_idx == arg_idx {
                return inner.slice(start, i).trim()
            }
            cur_idx = cur_idx + 1
            start = i + 1
        }
        i = i + 1
    }
    return ""
}

fn lsp_infer_builtin_member_ret(recv_t: str, mname: str) -> str {
    if recv_t == "str" {
        if mname == "slice" || mname == "replace" || mname == "trim" || mname == "to_upper" || mname == "to_lower" { return "str" }
        if mname == "split" { return "List<str>" }
        if mname == "len" || mname == "byte_at" || mname == "to_i64" { return "i64" }
        if mname == "to_f64" { return "f64" }
        if mname == "is_empty" || mname == "contains" || mname == "starts_with" || mname == "ends_with" { return "bool" }
        return ""
    }
    if recv_t == "ByteBuffer" {
        if mname == "to_str" { return "str" }
        if mname == "read_u8" || mname == "read_i32_le" || mname == "read_i32_be" || mname == "pos" || mname == "len" { return "i64" }
        return ""
    }
    if recv_t == "String" {
        if mname == "as_str" { return "str" }
        if mname == "trim" || mname == "to_upper" || mname == "to_lower" || mname == "replace" { return "String" }
        if mname == "split" { return "List<str>" }
        if mname == "len" { return "i64" }
        if mname == "contains" || mname == "starts_with" || mname == "ends_with" { return "bool" }
        return ""
    }
    if recv_t.starts_with("List<") {
        let t_elem = lsp_generic_inner_arg(recv_t, 0)
        if mname == "get" || mname == "pop" || mname == "remove_at" || mname == "swap_remove" { return t_elem }
        if mname == "slice" { return recv_t }
        if mname == "len" || mname == "index_of" { return "i64" }
        if mname == "is_empty" || mname == "contains" { return "bool" }
        return ""
    }
    if recv_t.starts_with("Map<") {
        let k_elem = lsp_generic_inner_arg(recv_t, 0)
        let v_elem = lsp_generic_inner_arg(recv_t, 1)
        if mname == "get" { return v_elem }
        if mname == "keys" { return "List<" + k_elem + ">" }
        if mname == "values" { return "List<" + v_elem + ">" }
        if mname == "has_key" || mname == "remove" || mname == "is_empty" { return "bool" }
        if mname == "len" { return "i64" }
        return ""
    }
    if recv_t.starts_with("Set<") {
        let t_elem = lsp_generic_inner_arg(recv_t, 0)
        if mname == "to_list" { return "List<" + t_elem + ">" }
        if mname == "union" || mname == "intersection" || mname == "difference" { return recv_t }
        if mname == "len" { return "i64" }
        if mname == "add" || mname == "has" || mname == "remove" || mname == "is_empty" { return "bool" }
        return ""
    }
    if recv_t.starts_with("Stack<") || recv_t.starts_with("Queue<") || recv_t.starts_with("Deque<") {
        let t_elem = lsp_generic_inner_arg(recv_t, 0)
        if mname == "pop" || mname == "peek" || mname == "pop_back" || mname == "pop_front" || mname == "peek_front" || mname == "peek_back" { return t_elem }
        if mname == "len" { return "i64" }
        if mname == "is_empty" { return "bool" }
        return ""
    }
    if recv_t == "File" {
        if mname == "read_to_string" { return "str" }
        if mname == "exists" || mname == "write_string" || mname == "append_string" || mname == "remove" || mname == "copy" { return "bool" }
        return ""
    }
    if recv_t == "Directory" {
        if mname == "list_files" || mname == "list_dirs" { return "List<str>" }
        if mname == "exists" || mname == "create" { return "bool" }
        return ""
    }
    if recv_t == "Env" {
        if mname == "args" { return "List<str>" }
        if mname == "get" || mname == "cwd" || mname == "os_name" { return "str" }
        if mname == "arg_count" { return "i64" }
        if mname == "set" { return "bool" }
        return ""
    }
    if recv_t == "Process" {
        if mname == "run_capture" { return "str" }
        if mname == "execute" { return "i64" }
        return ""
    }
    if recv_t.starts_with("Channel<") || recv_t == "Channel" {
        if mname == "recv" {
            let elem = lsp_generic_inner_arg(recv_t, 0)
            if elem != "" { return elem }
            return "i64"
        }
        return ""
    }
    if recv_t == "LinearArena" {
        if mname == "alloc" { return "usize" }
        if mname == "used" { return "i64" }
        return ""
    }
    if recv_t == "Math" {
        return "f64"
    }
    if recv_t == "Random" {
        if mname == "next_f64" { return "f64" }
        if mname == "next_i64" || mname == "range" { return "i64" }
        return ""
    }
    return ""
}

fn lsp_extract_receiver_start_before_dot(line: str, dot_pos: i64) -> i64 {
    if dot_pos <= 0 { return 0 }
    mut p = dot_pos
    // Handle cascade operator `~>` and optional chaining `?.`
    if p > 0 && line.byte_at(p) == 62 && line.byte_at(p - 1) == 126 {
        p = p - 1
    } else if p > 0 && line.byte_at(p - 1) == 63 {
        p = p - 1
    }
    mut i = p
    mut paren_d = 0
    mut brack_d = 0
    mut in_str = false
    while i > 0 {
        let b = line.byte_at(i - 1)
        if in_str {
            if b == 34 {
                if i < 2 || line.byte_at(i - 2) != 92 { in_str = false }
            }
            i = i - 1
            continue
        }
        if b == 34 {
            in_str = true
            i = i - 1
            continue
        }
        if b == 41 { paren_d = paren_d + 1; i = i - 1; continue }
        if b == 40 {
            if paren_d > 0 { paren_d = paren_d - 1; i = i - 1; continue }
            break
        }
        if b == 93 { brack_d = brack_d + 1; i = i - 1; continue }
        if b == 91 {
            if brack_d > 0 { brack_d = brack_d - 1; i = i - 1; continue }
            break
        }
        if paren_d > 0 || brack_d > 0 {
            i = i - 1
            continue
        }
        if lsp_is_ident_char(b) || b == 46 || b == 63 || b == 60 || b == 62 {
            i = i - 1
            continue
        }
        break
    }
    while i < p && (line.byte_at(i) == 32 || line.byte_at(i) == 9) {
        i = i + 1
    }
    return i
}

fn lsp_extract_receiver_before_dot(line: str, dot_pos: i64) -> str {
    if dot_pos <= 0 { return "" }
    mut p = dot_pos
    if p > 0 && line.byte_at(p) == 62 && line.byte_at(p - 1) == 126 {
        p = p - 1
    } else if p > 0 && line.byte_at(p - 1) == 63 {
        p = p - 1
    }
    let st = lsp_extract_receiver_start_before_dot(line, dot_pos)
    if st >= p { return "" }
    return line.slice(st, p).trim()
}

fn lsp_split_dot_chain(expr: str) -> List<str> {
    let parts = List<str>()
    let n = expr.len()
    mut p = 0
    mut s = 0
    mut pd = 0
    mut bd = 0
    mut ad = 0
    mut in_str = false
    while p < n {
        let b = expr.byte_at(p)
        if in_str {
            if b == 92 && p + 1 < n { p = p + 2; continue }
            if b == 34 { in_str = false }
            p = p + 1
            continue
        }
        if b == 34 { in_str = true; p = p + 1; continue }
        if b == 40 { pd = pd + 1 }
        else if b == 41 && pd > 0 { pd = pd - 1 }
        else if b == 91 { bd = bd + 1 }
        else if b == 93 && bd > 0 { bd = bd - 1 }
        else if b == 60 { ad = ad + 1 }
        else if b == 62 && ad > 0 { ad = ad - 1 }
        else if b == 46 && pd == 0 && bd == 0 && ad == 0 {
            mut seg_end = p
            if seg_end > s && expr.byte_at(seg_end - 1) == 63 { seg_end = seg_end - 1 }
            parts.push(expr.slice(s, seg_end).trim())
            s = p + 1
        }
        p = p + 1
    }
    if s <= n {
        parts.push(expr.slice(s, n).trim())
    }
    return parts
}

fn lsp_unwrap_indexed_type(container_t: str) -> str {
    if container_t == "" { return "" }
    if container_t == "str" { return "u8" }
    if container_t.ends_with("[]") { return container_t.slice(0, container_t.len() - 2) }
    mut base = container_t
    let lt = lsp_str_find(container_t, "<", 0)
    if lt > 0 { base = container_t.slice(0, lt).trim() }
    if base == "Map" { return lsp_generic_inner_arg(container_t, 1) }
    if base == "List" || base == "Array" || base == "ArenaList" || base == "Queue" || base == "Stack" || base == "Channel" || base == "Set" {
        return lsp_generic_inner_arg(container_t, 0)
    }
    return ""
}

fn lsp_infer_array_lit_type(lit: str) -> str {
    let inner = lit.slice(1, lit.len() - 1).trim()
    if inner == "" { return "List<any>" }
    mut first_el = inner
    let cm = lsp_str_find(inner, ",", 0)
    if cm >= 0 { first_el = inner.slice(0, cm).trim() }
    if first_el.starts_with("\"") && first_el.ends_with("\"") { return "List<str>" }
    if first_el == "true" || first_el == "false" { return "List<bool>" }
    if lsp_str_find(first_el, ".", 0) >= 0 { return "List<f64>" }
    let fb = first_el.byte_at(0)
    if (fb >= 48 && fb <= 57) || fb == 45 { return "List<i64>" }
    return "List<any>"
}

fn lsp_infer_expr_receiver_type(az: Analyzer, doc_path: str, line1: i64, expr: str, source: str = "") -> str {
    mut trimmed = expr.trim()
    if trimmed == "" { return "" }
    if trimmed.starts_with("new ") { trimmed = trimmed.slice(4, trimmed.len()).trim() }
    if trimmed.starts_with("\"") && trimmed.ends_with("\"") { return "str" }
    if trimmed.starts_with("[") && trimmed.ends_with("]") && trimmed.len() >= 2 {
        return lsp_infer_array_lit_type(trimmed)
    }
    if trimmed == "true" || trimmed == "false" { return "bool" }
    if trimmed == "self" {
        return lsp_enclosing_class_at(az, doc_path, line1)
    }
    if trimmed == "super" {
        let ec = lsp_enclosing_class_at(az, doc_path, line1)
        if ec != "" && az.cls_base_map.has_key(ec) { return az.cls_base_map.get(ec) }
        return ""
    }
    if lsp_is_static_runtime(trimmed) || az.cls_idx_map.has_key(trimmed) || az.enum_idx_map.has_key(trimmed) {
        return trimmed
    }

    // Handle top-level chain a.b().c or a[i].b
    let parts = lsp_split_dot_chain(trimmed)
    if parts.len() > 1 {
        mut cur_t = lsp_unwrap_optional_type(lsp_infer_expr_receiver_type(az, doc_path, line1, parts.get(0), source))
        mut pi = 1
        while pi < parts.len() && cur_t != "" {
            cur_t = lsp_unwrap_optional_type(cur_t)
            mut mem = parts.get(pi).trim()
            mut had_index = false
            if mem.ends_with("]") {
                mut bi = mem.len() - 1
                mut bd = 0
                while bi >= 0 {
                    let cb = mem.byte_at(bi)
                    if cb == 93 { bd = bd + 1 }
                    else if cb == 91 {
                        bd = bd - 1
                        if bd == 0 {
                            mem = mem.slice(0, bi).trim()
                            had_index = true
                            break
                        }
                    }
                    bi = bi - 1
                }
            }
            mut mname = mem
            let p_idx = lsp_str_find(mname, "(", 0)
            if p_idx > 0 { mname = mname.slice(0, p_idx).trim() }

            // Builtin / container method return type first
            let bi_ret = lsp_infer_builtin_member_ret(cur_t, mname)
            if bi_ret != "" {
                cur_t = bi_ret
                if had_index { cur_t = lsp_unwrap_indexed_type(cur_t) }
                pi = pi + 1
                continue
            }

            // Walk user class inheritance chain
            mut found_t = ""
            mut walk = cur_t
            mut hops = 0
            while walk != "" && hops < 8 {
                let fkey = walk + "::" + mname
                if az.cls_field_types.has_key(fkey) {
                    found_t = az.cls_field_types.get(fkey)
                    break
                }
                let sig_k = "m::" + walk + "::" + mname
                if az.sig_by_key.has_key(sig_k) {
                    let sidx = az.sig_by_key.get(sig_k).split(",").get(0).to_i64()
                    found_t = az.sig_rets.get(sidx)
                    break
                }
                if az.cls_base_map.has_key(walk) {
                    walk = az.cls_base_map.get(walk)
                } else {
                    walk = ""
                }
                hops = hops + 1
            }
            if had_index { found_t = lsp_unwrap_indexed_type(found_t) }
            cur_t = found_t
            pi = pi + 1
        }
        return lsp_unwrap_optional_type(cur_t)
    }

    // Handle trailing indexing: arr[idx] / map[key]
    if trimmed.ends_with("]") {
        mut bi2 = trimmed.len() - 1
        mut bd2 = 0
        while bi2 >= 0 {
            let cb2 = trimmed.byte_at(bi2)
            if cb2 == 93 { bd2 = bd2 + 1 }
            else if cb2 == 91 {
                bd2 = bd2 - 1
                if bd2 == 0 {
                    let base_expr = trimmed.slice(0, bi2).trim()
                    if base_expr != "" {
                        let bt = lsp_infer_expr_receiver_type(az, doc_path, line1, base_expr, source)
                        let elem_t = lsp_unwrap_indexed_type(bt)
                        if elem_t != "" { return lsp_unwrap_optional_type(elem_t) }
                    }
                    break
                }
            }
            bi2 = bi2 - 1
        }
    }

    // Check function / constructor call head e.g. Parser(p) or foo(x) or List<str>()
    let p_idx2 = lsp_str_find(trimmed, "(", 0)
    if p_idx2 > 0 {
        mut head = trimmed.slice(0, p_idx2).trim()
        let lt2 = lsp_str_find(head, "<", 0)
        mut base_head = head
        if lt2 > 0 { base_head = head.slice(0, lt2).trim() }
        if lsp_is_container_type(base_head) { return head }
        if az.cls_idx_map.has_key(base_head) { return head }
        mut fi = 0
        while fi < az.fn_count {
            let fid = az.fn_nodes.get(fi)
            if az.sa.get(fid) == base_head {
                return lsp_unwrap_optional_type(btype_norm(az.sb.get(fid)))
            }
            fi = fi + 1
        }
        // Enclosing class method call foo()
        let ec3 = lsp_enclosing_class_at(az, doc_path, line1)
        if ec3 != "" {
            let sig_k2 = "m::" + ec3 + "::" + base_head
            if az.sig_by_key.has_key(sig_k2) {
                let sidx2 = az.sig_by_key.get(sig_k2).split(",").get(0).to_i64()
                return lsp_unwrap_optional_type(az.sig_rets.get(sidx2))
            }
        }
        return ""
    }

    return lsp_resolve_var_type(az, doc_path, line1, trimmed, source)
}

// --- 1. Diagnostics ---

pub fn lsp_build_diagnostics_json(az: Analyzer, doc_path: str, source: str) -> str {
    let jb = JsonBuf()
    jb.lbrack()
    mut first = true
    mut i = 0
    while i < az.err_count {
        let ef = az.err_files.get(i)
        mut ln0 = az.err_lines.get(i) - 1
        mut cl0 = az.err_cols.get(i) - 1
        mut msg = az.err_msgs.get(i)
        mut code = ""
        if i < az.err_codes.len() { code = az.err_codes.get(i) }
        mut hmsg = ""
        if i < az.err_helps.len() { hmsg = az.err_helps.get(i) }
        mut sev = 1
        if i < az.err_sevs.len() { sev = az.err_sevs.get(i) }
        mut elen_diag = 1
        if i < az.err_lens.len() { elen_diag = az.err_lens.get(i) }
        if elen_diag < 1 { elen_diag = 1 }

        let in_cur = (ef == doc_path)
        if !in_cur {
            ln0 = 0
            cl0 = 0
            msg = "[" + bpath_basename(ef) + ":" + az.err_lines.get(i) + "] " + msg
        }
        if hmsg != "" {
            msg = msg + "\nhelp: " + hmsg
        }
        if ln0 < 0 { ln0 = 0 }
        if cl0 < 0 { cl0 = 0 }
        mut end_cl0 = cl0 + elen_diag
        if in_cur && source != "" {
            let eline = lsp_get_line_text(source, ln0)
            let elen = eline.len()
            if cl0 < elen && lsp_is_ident_char(eline.byte_at(cl0)) {
                mut ep = cl0 + 1
                while ep < elen && lsp_is_ident_char(eline.byte_at(ep)) {
                    ep = ep + 1
                }
                if ep > end_cl0 { end_cl0 = ep }
            }
            if end_cl0 > elen && elen > cl0 { end_cl0 = elen }
        }

        if !first { jb.comma() }
        first = false
        jb.lbrace()
        jb.key("range")
        jb.lbrace()
        jb.key("start"); jb.lbrace(); jb.kv_int("line", ln0, true); jb.kv_int("character", cl0, false); jb.rbrace()
        jb.comma()
        jb.key("end"); jb.lbrace(); jb.kv_int("line", ln0, true); jb.kv_int("character", end_cl0, false); jb.rbrace()
        jb.rbrace()
        jb.kv_int("severity", sev, false)
        if code != "" {
            jb.kv_str("code", code, false)
        }
        jb.kv_str("source", "aerix", false)
        jb.kv_str("message", msg, false)
        jb.rbrace()
        i = i + 1
    }
    jb.rbrack()
    return jb.finish()
}

fn lsp_extract_quoted_after(text: str, marker: str) -> str {
    let idx = lsp_str_find(text, marker, 0)
    if idx < 0 { return "" }
    let start = idx + marker.len()
    let q2 = lsp_str_find(text, "'", start)
    if q2 <= start { return "" }
    return text.slice(start, q2)
}

pub fn lsp_build_code_action_json(source: str, az: Analyzer, doc_path: str, doc_uri: str, start_line0: i64, end_line0: i64) -> str {
    let jb = JsonBuf()
    jb.lbrack()
    mut first = true
    mut i = 0
    while i < az.err_count {
        if az.err_files.get(i) != doc_path {
            i = i + 1
            continue
        }
        let ln0 = az.err_lines.get(i) - 1
        let cl0 = az.err_cols.get(i) - 1
        if ln0 < start_line0 - 1 || ln0 > end_line0 + 1 {
            i = i + 1
            continue
        }
        mut code = ""
        if i < az.err_codes.len() { code = az.err_codes.get(i) }
        mut hmsg = ""
        if i < az.err_helps.len() { hmsg = az.err_helps.get(i) }
        let msg = az.err_msgs.get(i)

        // Quick Fix 1: Replace typo with suggested identifier ("did you mean 'X'?")
        let sug = lsp_extract_quoted_after(hmsg, "did you mean '")
        if sug != "" && ln0 >= 0 && cl0 >= 0 {
            mut end_cl0 = cl0 + 1
            if i < az.err_lens.len() && az.err_lens.get(i) > 1 {
                end_cl0 = cl0 + az.err_lens.get(i)
            }
            let eline = lsp_get_line_text(source, ln0)
            if cl0 < eline.len() && lsp_is_ident_char(eline.byte_at(cl0)) {
                mut ep = cl0 + 1
                while ep < eline.len() && lsp_is_ident_char(eline.byte_at(ep)) { ep = ep + 1 }
                if ep > end_cl0 { end_cl0 = ep }
            }
            if !first { jb.comma() }
            first = false
            jb.lbrace()
            jb.kv_str("title", "Replace with '" + sug + "'", true)
            jb.kv_str("kind", "quickfix", false)
            jb.kv_bool("isPreferred", true, false)
            jb.comma(); jb.key("edit"); jb.lbrace()
            jb.key("changes"); jb.lbrace()
            jb.key(doc_uri); jb.lbrack(); jb.lbrace()
            jb.key("range"); jb.lbrace()
            jb.key("start"); jb.lbrace(); jb.kv_int("line", ln0, true); jb.kv_int("character", cl0, false); jb.rbrace()
            jb.comma()
            jb.key("end"); jb.lbrace(); jb.kv_int("line", ln0, true); jb.kv_int("character", end_cl0, false); jb.rbrace()
            jb.rbrace()
            jb.kv_str("newText", sug, false)
            jb.rbrace(); jb.rbrack()
            jb.rbrace(); jb.rbrace()
            jb.rbrace()
        }

        // Quick Fix 2: Convert 'let v' to 'mut v' on E0204 immutable variable assignment
        if code == "E0204" {
            let vname = lsp_extract_quoted_after(msg, "immutable variable '")
            if vname != "" && source != "" {
                mut scan_ln = ln0 - 1
                mut found_let_ln = -1
                mut found_let_cl = -1
                while scan_ln >= 0 {
                    let sline = lsp_get_line_text(source, scan_ln)
                    let pos_let = lsp_str_find(sline, "let ", 0)
                    if pos_let >= 0 {
                        let after = sline.slice(pos_let + 4, sline.len()).trim()
                        if after.starts_with(vname) {
                            let rem = after.slice(vname.len(), after.len())
                            if rem == "" || rem.starts_with(":") || rem.starts_with("=") || rem.starts_with(" ") || rem.starts_with("\t") {
                                found_let_ln = scan_ln
                                found_let_cl = pos_let
                                break
                            }
                        }
                    }
                    scan_ln = scan_ln - 1
                }
                if found_let_ln >= 0 && found_let_cl >= 0 {
                    if !first { jb.comma() }
                    first = false
                    jb.lbrace()
                    jb.kv_str("title", "Change 'let " + vname + "' to 'mut " + vname + "'", true)
                    jb.kv_str("kind", "quickfix", false)
                    jb.kv_bool("isPreferred", true, false)
                    jb.comma(); jb.key("edit"); jb.lbrace()
                    jb.key("changes"); jb.lbrace()
                    jb.key(doc_uri); jb.lbrack(); jb.lbrace()
                    jb.key("range"); jb.lbrace()
                    jb.key("start"); jb.lbrace(); jb.kv_int("line", found_let_ln, true); jb.kv_int("character", found_let_cl, false); jb.rbrace()
                    jb.comma()
                    jb.key("end"); jb.lbrace(); jb.kv_int("line", found_let_ln, true); jb.kv_int("character", found_let_cl + 3, false); jb.rbrace()
                    jb.rbrace()
                    jb.kv_str("newText", "mut", false)
                    jb.rbrace(); jb.rbrack()
                    jb.rbrace(); jb.rbrace()
                    jb.rbrace()
                }
            }
        }

        // Quick Fix 3: Remove unreachable statement (W0001)
        if code == "W0001" && ln0 >= 0 {
            if !first { jb.comma() }
            first = false
            jb.lbrace()
            jb.kv_str("title", "Remove unreachable statement", true)
            jb.kv_str("kind", "quickfix", false)
            jb.comma(); jb.key("edit"); jb.lbrace()
            jb.key("changes"); jb.lbrace()
            jb.key(doc_uri); jb.lbrack(); jb.lbrace()
            jb.key("range"); jb.lbrace()
            jb.key("start"); jb.lbrace(); jb.kv_int("line", ln0, true); jb.kv_int("character", 0, false); jb.rbrace()
            jb.comma()
            jb.key("end"); jb.lbrace(); jb.kv_int("line", ln0 + 1, true); jb.kv_int("character", 0, false); jb.rbrace()
            jb.rbrace()
            jb.kv_str("newText", "", false)
            jb.rbrace(); jb.rbrack()
            jb.rbrace(); jb.rbrace()
            jb.rbrace()
        }

        i = i + 1
    }
    jb.rbrack()
    return jb.finish()
}

// --- 2. Completions ---

fn emit_comp_item_ex(jb: JsonBuf, label: str, label_detail: str, label_desc: str, kind: i64,
                      detail: str, doc: str, insert_txt: str, sort_txt: str, filter_txt: str,
                      te_ln0: i64, te_s0: i64, te_e0: i64, te_text: str,
                      preselect: bool, first: bool) {
    if !first { jb.comma() }
    jb.lbrace()
    jb.kv_str("label", label, true)
    if label_detail != "" || label_desc != "" {
        jb.comma()
        jb.key("labelDetails")
        jb.lbrace()
        mut ld_first = true
        if label_detail != "" {
            jb.kv_str("detail", label_detail, true)
            ld_first = false
        }
        if label_desc != "" {
            jb.kv_str("description", label_desc, ld_first)
        }
        jb.rbrace()
    }
    jb.kv_int("kind", kind, false)
    if sort_txt != "" { jb.kv_str("sortText", sort_txt, false) }
    if filter_txt != "" { jb.kv_str("filterText", filter_txt, false) }
    if preselect { jb.kv_bool("preselect", true, false) }
    if detail != "" { jb.kv_str("detail", detail, false) }
    if doc != "" {
        jb.comma()
        jb.key("documentation")
        jb.lbrace()
        jb.kv_str("kind", "markdown", true)
        jb.kv_str("value", doc, false)
        jb.rbrace()
    }
    if te_ln0 >= 0 {
        jb.comma()
        jb.key("textEdit")
        jb.lbrace()
        jb.key("range")
        jb.lbrace()
        jb.key("start"); jb.lbrace(); jb.kv_int("line", te_ln0, true); jb.kv_int("character", te_s0, false); jb.rbrace()
        jb.comma()
        jb.key("end"); jb.lbrace(); jb.kv_int("line", te_ln0, true); jb.kv_int("character", te_e0, false); jb.rbrace()
        jb.rbrace()
        jb.comma()
        jb.kv_str("newText", te_text, true)
        jb.rbrace()
        jb.kv_int("insertTextFormat", 2, false)
    } else if insert_txt != "" {
        jb.kv_str("insertText", insert_txt, false)
        jb.kv_int("insertTextFormat", 2, false)
    }
    jb.rbrace()
}

fn emit_comp_item(jb: JsonBuf, label: str, kind: i64, detail: str, doc: str, insert_txt: str, sort_txt: str, first: bool) {
    emit_comp_item_ex(jb, label, "", "", kind, detail, doc, insert_txt, sort_txt, "", -1, 0, 0, "", false, first)
}

fn lsp_extract_sig_params_from_str(sig_label: str) -> List<str> {
    let out = List<str>()
    let open_p = lsp_str_find(sig_label, "(", 0)
    if open_p < 0 { return out }
    let n = sig_label.len()
    mut cl = open_p + 1
    mut depth = 1
    while cl < n && depth > 0 {
        let b = sig_label.byte_at(cl)
        if b == 40 { depth = depth + 1 }
        else if b == 41 { depth = depth - 1 }
        if depth > 0 { cl = cl + 1 }
    }
    let inner = sig_label.slice(open_p + 1, cl).trim()
    if inner == "" { return out }
    mut d = 0
    mut start = 0
    mut i = 0
    while i <= inner.len() {
        let at_end = (i == inner.len())
        mut sep = false
        if !at_end {
            let b = inner.byte_at(i)
            if b == 60 || b == 40 { d = d + 1 }
            else if b == 62 || b == 41 { d = d - 1 }
            else if b == 44 && d == 0 { sep = true }
        }
        if at_end || sep {
            let part = inner.slice(start, i).trim()
            if part != "" { out.push(part) }
            start = i + 1
        }
        i = i + 1
    }
    return out
}

fn lsp_resolve_call_site_sig(source: str, az: Analyzer, doc_path: str, line0: i64, char0: i64,
                             sig_params: List<str>, meta: List<str>) -> i64 {
    let curoff = lsp_line_col_to_offset(source, line0, char0)
    if curoff <= 0 { return -1 }

    // Walk backward across lines (bounded to 4096 bytes) tracking balanced () and strings
    mut floor_off = curoff - 4096
    if floor_off < 0 { floor_off = 0 }
    mut depth = 0
    mut commas = 0
    mut in_str = false
    mut open_idx = -1
    mut i = curoff - 1
    while i >= floor_off {
        let b = source.byte_at(i)
        if b == 34 && (i == 0 || source.byte_at(i - 1) != 92) {
            in_str = !in_str
        } else if !in_str {
            if b == 41 {
                depth = depth + 1
            } else if b == 40 {
                if depth == 0 {
                    open_idx = i
                    break
                }
                depth = depth - 1
            } else if b == 44 && depth == 0 {
                commas = commas + 1
            } else if b == 123 || b == 125 || b == 59 {
                break
            }
        }
        i = i - 1
    }
    if open_idx <= 0 { return -1 }

    mut end_name = open_idx
    while end_name > 0 && (source.byte_at(end_name - 1) == 32 || source.byte_at(end_name - 1) == 9) {
        end_name = end_name - 1
    }
    mut start_name = end_name
    while start_name > 0 && lsp_is_ident_char(source.byte_at(start_name - 1)) {
        start_name = start_name - 1
    }
    let callee = source.slice(start_name, end_name)
    if callee == "" { return -1 }

    mut sig_label = ""
    mut sig_doc = ""
    mut fn_nid = -1

    let has_dot = start_name > 0 && source.byte_at(start_name - 1) == 46
    let has_cascade = start_name >= 2 && source.byte_at(start_name - 1) == 62 && source.byte_at(start_name - 2) == 126
    if has_dot || has_cascade {
        let op_pos = start_name - 1
        mut ls = start_name - 1
        while ls > 0 && source.byte_at(ls - 1) != 10 { ls = ls - 1 }
        let line_before = source.slice(ls, op_pos + 1)
        let rname = lsp_extract_receiver_before_dot(line_before, line_before.len() - 1)
        let rt = lsp_infer_expr_receiver_type(az, doc_path, line0 + 1, rname, source)
        if rt != "" {
            let owner = lsp_find_class_method_sidx(az, rt, callee)
            if owner >= 0 {
                fn_nid = az.sig_nodes.get(owner)
            } else {
                let bmethods = lsp_builtin_methods_for(rt)
                mut bi = 0
                while bi < bmethods.len() {
                    let msig = bmethods.get(bi)
                    if msig.starts_with(callee + ":") {
                        sig_label = lsp_subst_generic_sig(msig, rt)
                        sig_doc = lsp_lookup_member_doc(rt, callee)
                        break
                    }
                    bi = bi + 1
                }
            }
        }
    } else if az.cls_idx_map.has_key(callee) {
        let ctor_k = "ctor::" + callee
        if az.sig_by_key.has_key(ctor_k) {
            let sidx = az.sig_by_key.get(ctor_k).split(",").get(0).to_i64()
            fn_nid = az.sig_nodes.get(sidx)
        }
    } else {
        let fn_k = "fn::" + callee
        if az.sig_by_key.has_key(fn_k) {
            let sidx = az.sig_by_key.get(fn_k).split(",").get(0).to_i64()
            fn_nid = az.sig_nodes.get(sidx)
        } else {
            let ec_c = lsp_enclosing_class_at(az, doc_path, line0 + 1)
            if ec_c != "" {
                let msidx = lsp_find_class_method_sidx(az, ec_c, callee)
                if msidx >= 0 { fn_nid = az.sig_nodes.get(msidx) }
            }
        }
        if fn_nid < 0 {
            let bsig = lsp_builtin_fn_sig(callee)
            if bsig != "" {
                sig_label = bsig
                sig_doc = lsp_lookup_doc(callee)
            }
        }
    }

    if fn_nid >= 0 {
        sig_label = lsp_fn_signature_str(az, fn_nid)
        sig_doc = lsp_extract_doc_comments(source, doc_path, az.nf.get(fn_nid), az.ln.get(fn_nid))
        let pg = az.la.get(fn_nid)
        if pg >= 0 {
            let pc = az.ll.get(pg)
            mut pi = 0
            while pi < pc {
                let pid = az.ch.get(az.ls.get(pg) + pi)
                sig_params.push(az.sa.get(pid) + ": " + btype_norm(az.sb.get(pid)))
                pi = pi + 1
            }
        }
    } else if sig_label != "" {
        let parsed_p = lsp_extract_sig_params_from_str(sig_label)
        mut pi = 0
        while pi < parsed_p.len() {
            sig_params.push(parsed_p.get(pi))
            pi = pi + 1
        }
    }

    if sig_label == "" { return -1 }
    meta.push(sig_label)
    meta.push(sig_doc)
    return commas
}

fn lsp_sig_to_label_parts(sig: str) -> List<str> {
    let out = List<str>()
    let open_p = lsp_str_find(sig, "(", 0)
    if open_p < 0 {
        out.push(""); out.push("")
        return out
    }
    let n = sig.len()
    mut cl = open_p + 1
    mut depth = 1
    while cl < n && depth > 0 {
        let b = sig.byte_at(cl)
        if b == 40 { depth = depth + 1 }
        else if b == 41 { depth = depth - 1 }
        if depth > 0 { cl = cl + 1 }
    }
    let params_paren = sig.slice(open_p, cl + 1)
    mut ret = "void"
    let arrow = lsp_str_find(sig, "->", cl)
    if arrow >= 0 {
        ret = sig.slice(arrow + 2, n).trim()
    }
    out.push(params_paren)
    out.push(ret)
    return out
}

fn lsp_build_call_snippet(name: str, param_paren: str, insert_parens: bool) -> str {
    if !insert_parens || param_paren == "" { return "" }
    if param_paren == "()" { return name + "()$0" }
    let plist = lsp_extract_sig_params_from_str(name + param_paren)
    if plist.len() == 0 { return name + "()$0" }
    let bb = ByteBuffer()
    bb.write_str(name)
    bb.write_str("(")
    mut i = 0
    while i < plist.len() {
        if i > 0 { bb.write_str(", ") }
        mut seg = plist.get(i).trim()
        if seg.starts_with("mut ") { seg = seg.slice(4, seg.len()).trim() }
        let col_i = lsp_str_find(seg, ":", 0)
        mut pname = seg
        if col_i > 0 { pname = seg.slice(0, col_i).trim() }
        let eq_i = lsp_str_find(pname, "=", 0)
        if eq_i > 0 { pname = pname.slice(0, eq_i).trim() }
        if pname == "" { pname = "arg" + (i + 1) }
        bb.write_str("$")
        bb.write_u8(123)
        bb.write_str("" + (i + 1))
        bb.write_str(":")
        bb.write_str(pname)
        bb.write_str("}")
        i = i + 1
    }
    bb.write_str(")$0")
    let out = bb.to_str()
    bb.free()
    return out
}

fn lsp_type_matches(cand_t: str, expected_t: str) -> bool {
    if expected_t == "" || cand_t == "" { return false }
    let cn = btype_norm(lsp_unwrap_optional_type(cand_t))
    let en = btype_norm(lsp_unwrap_optional_type(expected_t))
    if en == "any" || cn == "any" { return false }
    if cn == en { return true }
    if (en == "int" && cn == "i64") || (en == "i64" && cn == "int") { return true }
    if (en == "float" && cn == "f64") || (en == "f64" && cn == "float") { return true }
    return false
}

fn lsp_infer_expected_type(source: str, az: Analyzer, doc_path: str, line0: i64, cpos: i64, before_word: str) -> str {
    // 1. Inside call arguments -> active parameter type
    let sig_params = List<str>()
    let meta = List<str>()
    let arg_idx = lsp_resolve_call_site_sig(source, az, doc_path, line0, cpos, sig_params, meta)
    if arg_idx >= 0 && arg_idx < sig_params.len() {
        let p = sig_params.get(arg_idx)
        let col_i = lsp_str_find(p, ":", 0)
        if col_i > 0 {
            mut pt = p.slice(col_i + 1, p.len()).trim()
            let eq_i = lsp_str_find(pt, "=", 0)
            if eq_i > 0 { pt = pt.slice(0, eq_i).trim() }
            if pt != "" && pt != "any" && pt != "T" && pt != "K" && pt != "V" {
                return btype_norm(pt)
            }
        }
    }

    // 2. Return statement -> enclosing function return type
    if before_word == "return" || before_word.ends_with(" return") {
        let fb = lsp_enclosing_fn_bounds(source, az, doc_path, line0 + 1)
        let fn_nid = fb.get(0)
        if fn_nid >= 0 {
            let rt = btype_norm(az.sb.get(fn_nid))
            if rt != "" && rt != "void" { return rt }
        }
    }

    // 3. Typed declaration RHS: `let x: Type = ...` or `mut x: Type = ...`
    if before_word.ends_with("=") && !before_word.ends_with("==") && !before_word.ends_with("!=") && !before_word.ends_with("<=") && !before_word.ends_with(">=") {
        let lhs = before_word.slice(0, before_word.len() - 1).trim()
        let col_i2 = lsp_str_find(lhs, ":", 0)
        if col_i2 > 0 {
            let decl_t = btype_norm(lhs.slice(col_i2 + 1, lhs.len()).trim())
            if decl_t != "" { return decl_t }
        }
    }
    return ""
}

fn lsp_is_type_position(before_word: str) -> bool {
    if before_word == "" { return false }
    if before_word.ends_with("->") || before_word.ends_with("extends") || before_word.ends_with("implements") || before_word.ends_with("as") {
        return true
    }
    if before_word.ends_with(":") && !before_word.ends_with("::") && !before_word.ends_with("?:") {
        return true
    }
    // Unclosed generic `<` after identifier (e.g., `List<`, `Map<str, `)
    mut i = before_word.len() - 1
    mut ad = 0
    while i >= 0 {
        let b = before_word.byte_at(i)
        if b == 62 { ad = ad + 1 }
        else if b == 60 {
            if ad == 0 {
                return i > 0 && lsp_is_ident_char(before_word.byte_at(i - 1))
            }
            ad = ad - 1
        } else if b == 40 || b == 41 || b == 123 || b == 125 || b == 61 || b == 59 {
            return false
        }
        i = i - 1
    }
    return false
}

fn lsp_emit_import_completions(doc_path: str, line0: i64, prefix: str, cpos: i64, jb: JsonBuf, is_first: List<i64>) -> bool {
    let tr = prefix.trim()
    if !tr.starts_with("import ") && !tr.starts_with("use ") && !tr.starts_with("from ") && tr != "import" && tr != "use" && tr != "from" { return false }
    let qpos = lsp_str_find(prefix, "\"", 0)
    if qpos < 0 {
        // Unquoted import completion: suggest standard modules, selective import snippet, and local files
        let mods = List<str>()
        mods.push("Math"); mods.push("Random"); mods.push("Socket"); mods.push("Time"); mods.push("Window")
        mut mi = 0
        while mi < mods.len() {
            let mnm = mods.get(mi)
            let fst = is_first.get(0) == 1
            is_first.set(0, 0)
            emit_comp_item_ex(jb, mnm, "", "stdlib", CKIND_MODULE(), "Aerix stdlib module `" + mnm + "`",
                              "Standard library module `" + mnm + "`.", "", "0_" + mnm, "",
                              -1, 0, 0, "", false, fst)
            mi = mi + 1
        }

        let fst_snip = is_first.get(0) == 1
        is_first.set(0, 0)
        let lb_snip = lsp_lbrace()
        emit_comp_item_ex(jb, lb_snip + " ... } from \"...\"", "", "selective", CKIND_SNIPPET(), "Selective import",
                          "Import specific symbols from a module or file.", lb_snip + " $1 } from \"$2\"", "0a_selective", "",
                          -1, 0, 0, "", false, fst_snip)

        let fst_from = is_first.get(0) == 1
        is_first.set(0, 0)
        emit_comp_item_ex(jb, "from ... import ...", "", "from_import", CKIND_SNIPPET(), "From import statement",
                          "Import symbols from a module or file.", "from $1 import $2", "0b_from", "",
                          -1, 0, 0, "", false, fst_from)

        let base_dir = bpath_dirname(doc_path)
        if base_dir != "" && Directory.exists(base_dir) {
            let files = Directory.list_files(base_dir)
            mut fi = 0
            while fi < files.len() {
                let f = bpath_basename(files.get(fi))
                if str_ends_with_arx(f) && bpath_join(base_dir, f) != bpath_normalize(doc_path) {
                    let ins = "\"./" + f + "\""
                    let fst = is_first.get(0) == 1
                    is_first.set(0, 0)
                    emit_comp_item_ex(jb, f, "", "file", CKIND_FILE(), "Aerix source file", "Import `" + ins + "`",
                                      ins, "1_" + f, "", -1, 0, 0, "", false, fst)
                }
                fi = fi + 1
            }
        }
        return true
    }

    // Inside quotes: ensure cursor is inside unclosed quote
    let after_q = prefix.slice(qpos + 1, prefix.len())
    if lsp_str_find(after_q, "\"", 0) >= 0 { return false }

    let slash_pos = after_q.replace("\\", "/")
    mut last_sl = -1
    mut si = 0
    while si < slash_pos.len() {
        if slash_pos.byte_at(si) == 47 { last_sl = si }
        si = si + 1
    }
    mut dir_rel = ""
    if last_sl >= 0 { dir_rel = slash_pos.slice(0, last_sl + 1) }

    // Suggest built-in stdlib modules at root quote level
    if dir_rel == "" {
        let mods = List<str>()
        mods.push("Math"); mods.push("Random"); mods.push("Socket"); mods.push("Time"); mods.push("Window")
        mut mi = 0
        while mi < mods.len() {
            let mnm = mods.get(mi)
            let fst = is_first.get(0) == 1
            is_first.set(0, 0)
            emit_comp_item_ex(jb, mnm, "", "stdlib", CKIND_MODULE(), "Aerix stdlib module `" + mnm + "`",
                              "Standard library module `" + mnm + "`.", "", "0_" + mnm, "",
                              line0, qpos + 1, cpos, mnm, false, fst)
            mi = mi + 1
        }
    }

    // Suggest real relative files & folders in current document directory
    let base_dir = bpath_dirname(doc_path)
    if base_dir != "" {
        mut scan_dir = base_dir
        if dir_rel != "" { scan_dir = bpath_join(base_dir, dir_rel) }
        if Directory.exists(scan_dir) {
            let files = Directory.list_files(scan_dir)
            mut fi = 0
            while fi < files.len() {
                let f = bpath_basename(files.get(fi))
                if str_ends_with_arx(f) && bpath_join(scan_dir, f) != bpath_normalize(doc_path) {
                    let ins = dir_rel + f
                    let fst = is_first.get(0) == 1
                    is_first.set(0, 0)
                    emit_comp_item_ex(jb, f, "", dir_rel, CKIND_FILE(), "Aerix module", "Import `" + ins + "`",
                                      "", "1_" + f, ins, line0, qpos + 1, cpos, ins, false, fst)
                }
                fi = fi + 1
            }
            let dirs = Directory.list_dirs(scan_dir)
            mut di = 0
            while di < dirs.len() {
                let d = bpath_basename(dirs.get(di))
                if !d.starts_with(".") && d != "dist" && d != "seed" {
                    let ins = dir_rel + d + "/"
                    let fst = is_first.get(0) == 1
                    is_first.set(0, 0)
                    emit_comp_item_ex(jb, d + "/", "", "folder", CKIND_FOLDER(), "Directory", "Browse `" + ins + "`",
                                      "", "2_" + d, ins, line0, qpos + 1, cpos, ins, false, fst)
                }
                di = di + 1
            }
        }
    }
    return true
}

fn lsp_emit_type_completions(az: Analyzer, source: str, doc_path: str, line0: i64, before_word: str,
                             jb: JsonBuf, seen: Map<str, i64>, is_first: List<i64>) {
    mut ci = 0
    while ci < az.cls_count {
        let cid = az.cls_nodes.get(ci)
        let cnm = az.cls_names.get(ci)
        if !seen.has_key("c::" + cnm) {
            seen.insert("c::" + cnm, 1)
            let same_file = az.nf.get(cid) == doc_path
            mut stxt = "2_" + cnm
            if same_file { stxt = "0_" + cnm }
            mut cdoc = ""
            if same_file { cdoc = lsp_extract_doc_comments(source, doc_path, doc_path, az.ln.get(cid)) }
            let src_note = "*Defined in* `" + bpath_basename(az.nf.get(cid)) + ":" + az.ln.get(cid) + "`"
            if cdoc != "" { cdoc = cdoc + "\n\n" + src_note } else { cdoc = src_note }
            let fst = is_first.get(0) == 1
            is_first.set(0, 0)
            emit_comp_item_ex(jb, cnm, "", bpath_basename(az.nf.get(cid)), CKIND_CLASS(), "class " + cnm, cdoc,
                              "", stxt, "", -1, 0, 0, "", false, fst)
        }
        ci = ci + 1
    }

    mut ei = 0
    while ei < az.enum_count {
        let eid = az.enum_nodes.get(ei)
        let enm = az.enum_names.get(ei)
        if !seen.has_key("e::" + enm) {
            seen.insert("e::" + enm, 1)
            let same_file = az.nf.get(eid) == doc_path
            mut edoc = ""
            if same_file { edoc = lsp_extract_doc_comments(source, doc_path, doc_path, az.ln.get(eid)) }
            let src_note = "*Defined in* `" + bpath_basename(az.nf.get(eid)) + ":" + az.ln.get(eid) + "`"
            if edoc != "" { edoc = edoc + "\n\n" + src_note } else { edoc = src_note }
            let fst = is_first.get(0) == 1
            is_first.set(0, 0)
            emit_comp_item_ex(jb, enm, "", bpath_basename(az.nf.get(eid)), CKIND_ENUM(), "enum " + enm, edoc,
                              "", "1_" + enm, "", -1, 0, 0, "", false, fst)
        }
        ei = ei + 1
    }

    let in_fn_ret = before_word.ends_with("->")
    let ts = lsp_type_list()
    mut ti = 0
    while ti < ts.len() {
        let tnm = ts.get(ti)
        if !seen.has_key("c::" + tnm) {
            seen.insert("c::" + tnm, 1)
            mut stxt = "3_" + tnm
            if tnm == "i64" || tnm == "f64" || tnm == "str" || tnm == "bool" || tnm == "List" || tnm == "Map" || (in_fn_ret && tnm == "void") {
                stxt = "0_" + tnm
            }
            let lb = lsp_lbrace()
            mut snip = ""
            if tnm == "List" { snip = "List<$" + lb + "1:T}>" }
            else if tnm == "Map" { snip = "Map<$" + lb + "1:K}, $" + lb + "2:V}>" }
            else if tnm == "Set" { snip = "Set<$" + lb + "1:T}>" }
            else if tnm == "Queue" { snip = "Queue<$" + lb + "1:T}>" }
            else if tnm == "Stack" { snip = "Stack<$" + lb + "1:T}>" }
            else if tnm == "Deque" { snip = "Deque<$" + lb + "1:T}>" }
            else if tnm == "Channel" { snip = "Channel<$" + lb + "1:T}>" }
            let fst = is_first.get(0) == 1
            is_first.set(0, 0)
            emit_comp_item_ex(jb, tnm, "", "type", CKIND_CLASS(), "type " + tnm, lsp_lookup_doc(tnm),
                              snip, stxt, "", -1, 0, 0, "", false, fst)
        }
        ti = ti + 1
    }
}

fn lsp_emit_postfix_completions(line0: i64, recv_start0: i64, dot_col0: i64, cpos: i64, line: str,
                                clean_recv: str, recv_t: str, jb: JsonBuf, is_first: List<i64>) {
    if clean_recv == "" || lsp_is_static_runtime(clean_recv) { return }
    if recv_start0 < 0 || recv_start0 >= dot_col0 { return }
    let raw_recv = line.slice(recv_start0, dot_col0)
    if raw_recv == "" { return }

    let is_iter = recv_t == "str" || recv_t.starts_with("List<") || recv_t.starts_with("Map<") || recv_t.starts_with("Set<") || recv_t.ends_with("[]")

    let triggers = List<str>()
    let descs = List<str>()
    let templates = List<str>()
    let sorts = List<str>()

    let lb = lsp_lbrace()
    triggers.push("let");     descs.push("let name = expr");      templates.push("let $" + lb + "1:name} = " + clean_recv + "$0"); sorts.push("9_let")
    triggers.push("mut");     descs.push("mut name = expr");      templates.push("mut $" + lb + "1:name} = " + clean_recv + "$0"); sorts.push("9_mut")
    triggers.push("print");   descs.push("print(expr)");          templates.push("print(" + clean_recv + ")$0");            sorts.push("9_print")
    triggers.push("println"); descs.push("println(expr)");        templates.push("println(" + clean_recv + ")$0");          sorts.push("9_println")
    triggers.push("return");  descs.push("return expr");          templates.push("return " + clean_recv + "$0");            sorts.push("9_return")
    triggers.push("if");      descs.push("if expr " + lb + " ... }"); templates.push("if " + clean_recv + " " + lb + "\n\t$0\n}"); sorts.push("9_if")
    let for_sort = "9_for"
    mut fsort = for_sort
    if is_iter { fsort = "8_for" }
    triggers.push("for");     descs.push("for item in expr");     templates.push("for $" + lb + "1:item} in " + clean_recv + " " + lb + "\n\t$0\n}"); sorts.push(fsort)
    triggers.push("not");     descs.push("!expr");                templates.push("!" + clean_recv);                         sorts.push("9_not")

    mut pi = 0
    while pi < triggers.len() {
        let trg = triggers.get(pi)
        let fst = is_first.get(0) == 1
        is_first.set(0, 0)
        emit_comp_item_ex(jb, "." + trg, "", descs.get(pi), CKIND_SNIPPET(), "Postfix ." + trg,
                          "Wraps `" + clean_recv + "` into `" + descs.get(pi) + "`.",
                          "", sorts.get(pi), raw_recv + "." + trg,
                          line0, recv_start0, cpos, templates.get(pi), false, fst)
        pi = pi + 1
    }
}

fn lsp_file_matches_mod(file_path: str, mod_name: str) -> bool {
    if mod_name == "" || file_path == "" { return false }
    let norm = file_path.replace("\\", "/")
    let low_f = norm.to_lower()
    let low_m = mod_name.to_lower()
    if low_f.contains("/modules/" + low_m + "/") || low_f.contains("/modules/" + low_m + ".arx") {
        return true
    }
    let base = bpath_basename(norm)
    let low_b = base.to_lower()
    if low_b == low_m + ".arx" || low_b == low_m {
        return true
    }
    if low_b.ends_with(".arx") && low_b.len() > 4 {
        let stem = low_b.slice(0, low_b.len() - 4)
        if stem == low_m { return true }
    }
    return false
}

fn lsp_source_module_label(file_path: str, doc_path: str) -> str {
    if file_path == "" || file_path == doc_path { return "" }
    let norm = file_path.replace("\\", "/")
    let m_idx = lsp_str_find(norm, "/modules/", 0)
    if m_idx >= 0 {
        let sub = norm.slice(m_idx + 9, norm.len())
        let sl_idx = lsp_str_find(sub, "/", 0)
        if sl_idx > 0 { return sub.slice(0, sl_idx) }
        if sub.ends_with(".arx") && sub.len() > 4 { return sub.slice(0, sub.len() - 4) }
        return sub
    }
    let base = bpath_basename(norm)
    if base.ends_with(".arx") && base.len() > 4 { return base.slice(0, base.len() - 4) }
    return base
}

fn collect_module_or_file_completions(az: Analyzer, source: str, doc_path: str, mod_name: str,
                                      insert_parens: bool, expected_t: str,
                                      jb: JsonBuf, seen: Map<str, i64>, is_first_box: List<i64>) -> bool {
    mut matched_any = false
    mut target_mod = mod_name
    if az.mod_aliases.has_key(mod_name) {
        target_mod = az.mod_aliases.get(mod_name)
    }
    let is_static_prelude = lsp_is_static_runtime(mod_name) || lsp_is_static_runtime(target_mod)

    // 1. All functions declared in that module or file
    mut fi = 0
    while fi < az.fn_count {
        let fid = az.fn_nodes.get(fi)
        let fn_file = az.nf.get(fid)
        if lsp_file_matches_mod(fn_file, mod_name) || lsp_file_matches_mod(fn_file, target_mod) {
            let fnm = az.sa.get(fid)
            let skey = "mfn::" + fnm
            if !seen.has_key(skey) {
                seen.insert(skey, 1)
                let sig = lsp_fn_signature_str(az, fid)
                let lparts = lsp_sig_to_label_parts(sig)
                let snip = lsp_build_call_snippet(fnm, lparts.get(0), insert_parens)
                let rt = lparts.get(1)
                mut fdoc = lsp_extract_doc_comments(source, doc_path, fn_file, az.ln.get(fid))
                let src_note = "*Defined in* `" + bpath_basename(fn_file) + ":" + az.ln.get(fid) + "`"
                if fdoc != "" { fdoc = fdoc + "\n\n" + src_note } else { fdoc = src_note }
                let matched = lsp_type_matches(rt, expected_t)
                mut stxt = "0_" + fnm
                if matched { stxt = "00_" + fnm }
                let fst = is_first_box.get(0) == 1
                is_first_box.set(0, 0)
                emit_comp_item_ex(jb, fnm, lparts.get(0), rt, CKIND_FUNCTION(), sig, fdoc,
                                  snip, stxt, "", -1, 0, 0, "", matched, fst)
                matched_any = true
            }
        }
        fi = fi + 1
    }

    // 2. All classes declared in that module or file
    mut ci = 0
    while ci < az.cls_count {
        let cid = az.cls_nodes.get(ci)
        let c_file = az.nf.get(cid)
        if lsp_file_matches_mod(c_file, mod_name) || lsp_file_matches_mod(c_file, target_mod) {
            let cnm = az.cls_names.get(ci)
            let skey = "mc::" + cnm
            if !seen.has_key(skey) {
                seen.insert(skey, 1)
                mut cdoc = lsp_extract_doc_comments(source, doc_path, c_file, az.ln.get(cid))
                let src_note = "*Defined in* `" + bpath_basename(c_file) + ":" + az.ln.get(cid) + "`"
                if cdoc != "" { cdoc = cdoc + "\n\n" + src_note } else { cdoc = src_note }
                let fst = is_first_box.get(0) == 1
                is_first_box.set(0, 0)
                emit_comp_item_ex(jb, cnm, "", "class", CKIND_CLASS(), "class " + cnm, cdoc,
                                  "", "1_" + cnm, "", -1, 0, 0, "", false, fst)
                matched_any = true
            }
        }
        ci = ci + 1
    }

    // 3. All enums declared in that module or file
    mut ei = 0
    while ei < az.enum_count {
        let eid = az.enum_nodes.get(ei)
        let e_file = az.nf.get(eid)
        if lsp_file_matches_mod(e_file, mod_name) || lsp_file_matches_mod(e_file, target_mod) {
            let enm = az.enum_names.get(ei)
            let skey = "me::" + enm
            if !seen.has_key(skey) {
                seen.insert(skey, 1)
                mut edoc = lsp_extract_doc_comments(source, doc_path, e_file, az.ln.get(eid))
                let src_note = "*Defined in* `" + bpath_basename(e_file) + ":" + az.ln.get(eid) + "`"
                if edoc != "" { edoc = edoc + "\n\n" + src_note } else { edoc = src_note }
                let fst = is_first_box.get(0) == 1
                is_first_box.set(0, 0)
                emit_comp_item_ex(jb, enm, "", "enum", CKIND_ENUM(), "enum " + enm, edoc,
                                  "", "1_" + enm, "", -1, 0, 0, "", false, fst)
                matched_any = true
            }
        }
        ei = ei + 1
    }

    // 4. All constants / globals declared in that module or file
    mut gi = 0
    while gi < az.global_count {
        let gid = az.global_nodes.get(gi)
        let g_file = az.nf.get(gid)
        if lsp_file_matches_mod(g_file, mod_name) || lsp_file_matches_mod(g_file, target_mod) {
            let gnm = az.sa.get(gid)
            let skey = "mg::" + gnm
            if !seen.has_key(skey) {
                seen.insert(skey, 1)
                let gt = az.global_types.get(gnm)
                mut gdoc = lsp_extract_doc_comments(source, doc_path, g_file, az.ln.get(gid))
                let src_note = "*Defined in* `" + bpath_basename(g_file) + ":" + az.ln.get(gid) + "`"
                if gdoc != "" { gdoc = gdoc + "\n\n" + src_note } else { gdoc = src_note }
                let fst = is_first_box.get(0) == 1
                is_first_box.set(0, 0)
                emit_comp_item_ex(jb, gnm, "", gt, CKIND_CONSTANT(), "const " + gnm + ": " + gt, gdoc,
                                  "", "0_" + gnm, "", -1, 0, 0, "", false, fst)
                matched_any = true
            }
        }
        gi = gi + 1
    }

    // 5. Merge built-in methods if this is a static runtime / stdlib module (e.g. Math, Random, File, etc.)
    if is_static_prelude {
        let bms = lsp_builtin_methods_for(target_mod)
        mut bi = 0
        while bi < bms.len() {
            let entry = bms.get(bi)
            let colon_i = lsp_str_find(entry, ":", 0)
            let mnm = entry.slice(0, colon_i)
            let skey = "mfn::" + mnm
            if !seen.has_key(skey) {
                seen.insert(skey, 1)
                let msig = lsp_subst_generic_sig(entry, mod_name)
                let lparts = lsp_sig_to_label_parts(msig)
                let snip = lsp_build_call_snippet(mnm, lparts.get(0), insert_parens)
                let rt = lparts.get(1)
                mut mdoc = lsp_lookup_member_doc(mod_name, mnm)
                if mdoc == "" { mdoc = "Standard `" + mod_name + "` function" }
                let matched = lsp_type_matches(rt, expected_t)
                mut stxt = "0_" + mnm
                if matched { stxt = "00_" + mnm }
                let fst = is_first_box.get(0) == 1
                is_first_box.set(0, 0)
                emit_comp_item_ex(jb, mnm, lparts.get(0), rt, CKIND_FUNCTION(), msig, mdoc,
                                  snip, stxt, "", -1, 0, 0, "", matched, fst)
                matched_any = true
            }
            bi = bi + 1
        }
    }

    return matched_any
}

fn collect_class_member_completions(az: Analyzer, source: str, doc_path: str, cname: str,
                                    insert_parens: bool, expected_t: str,
                                    jb: JsonBuf, seen: Map<str, i64>, is_first_box: List<i64>) {
    mut cur = cname
    mut depth = 0
    while cur != "" && depth < 16 {
        let cid = lsp_find_class_node(az, cur)
        if cid >= 0 {
            let fg = az.la.get(cid)
            let fc = az.ll.get(fg)
            mut fi = 0
            while fi < fc {
                let fid = az.ch.get(az.ls.get(fg) + fi)
                let fnm = az.sa.get(fid)
                if !seen.has_key("f::" + fnm) {
                    seen.insert("f::" + fnm, 1)
                    let ft = btype_norm(az.sb.get(fid))
                    mut fdoc = ""
                    if az.nf.get(fid) == doc_path {
                        fdoc = lsp_extract_doc_comments(source, doc_path, doc_path, az.ln.get(fid))
                    }
                    if fdoc == "" { fdoc = "Field on `" + cur + "`" }
                    let matched = lsp_type_matches(ft, expected_t)
                    mut stxt = "0_" + fnm
                    if matched { stxt = "00_" + fnm }
                    let fst = is_first_box.get(0) == 1
                    is_first_box.set(0, 0)
                    emit_comp_item_ex(jb, fnm, "", ft, CKIND_FIELD(), fnm + ": " + ft, fdoc,
                                      "", stxt, "", -1, 0, 0, "", matched, fst)
                }
                fi = fi + 1
            }
            let mg = az.ea.get(cid)
            let mc = az.ll.get(mg)
            mut mi = 0
            while mi < mc {
                let mid = az.ch.get(az.ls.get(mg) + mi)
                let mnm = az.sa.get(mid)
                if !seen.has_key("m::" + mnm) {
                    seen.insert("m::" + mnm, 1)
                    let sig = lsp_fn_signature_str(az, mid)
                    let lparts = lsp_sig_to_label_parts(sig)
                    let snip = lsp_build_call_snippet(mnm, lparts.get(0), insert_parens)
                    let rt = lparts.get(1)
                    mut mdoc = ""
                    if az.nf.get(mid) == doc_path {
                        mdoc = lsp_extract_doc_comments(source, doc_path, doc_path, az.ln.get(mid))
                    }
                    if mdoc == "" { mdoc = "Method on `" + cur + "`" }
                    let matched = lsp_type_matches(rt, expected_t)
                    mut stxt = "1_" + mnm
                    if matched { stxt = "00_" + mnm }
                    let fst = is_first_box.get(0) == 1
                    is_first_box.set(0, 0)
                    emit_comp_item_ex(jb, mnm, lparts.get(0), rt, CKIND_METHOD(), sig, mdoc,
                                      snip, stxt, "", -1, 0, 0, "", matched, fst)
                }
                mi = mi + 1
            }
        }
        if az.cls_base_map.has_key(cur) {
            cur = az.cls_base_map.get(cur)
        } else {
            cur = ""
        }
        depth = depth + 1
    }

    // Extend methods targeting this type
    mut ei = 0
    while ei < az.ext_count {
        let eid = az.ext_nodes.get(ei)
        if btype_norm(az.sa.get(eid)) == cname {
            let mc = az.ll.get(eid)
            mut mi = 0
            while mi < mc {
                let mid = az.ch.get(az.ls.get(eid) + mi)
                let mnm = az.sa.get(mid)
                if !seen.has_key("m::" + mnm) {
                    seen.insert("m::" + mnm, 1)
                    let sig = lsp_fn_signature_str(az, mid)
                    let lparts = lsp_sig_to_label_parts(sig)
                    let snip = lsp_build_call_snippet(mnm, lparts.get(0), insert_parens)
                    let rt = lparts.get(1)
                    let matched = lsp_type_matches(rt, expected_t)
                    mut stxt = "1_" + mnm
                    if matched { stxt = "00_" + mnm }
                    let fst = is_first_box.get(0) == 1
                    is_first_box.set(0, 0)
                    emit_comp_item_ex(jb, mnm, lparts.get(0), rt, CKIND_METHOD(), sig, "Extension method on `" + cname + "`",
                                      snip, stxt, "", -1, 0, 0, "", matched, fst)
                }
                mi = mi + 1
            }
        }
        ei = ei + 1
    }
}

pub fn lsp_build_completion_json(source: str, az: Analyzer, doc_path: str, line0: i64, char0: i64) -> str {
    let line = lsp_get_line_text(source, line0)
    mut cpos = char0
    if cpos > line.len() { cpos = line.len() }
    if cpos < 0 { cpos = 0 }
    let prefix = line.slice(0, cpos)
    let insert_parens = (cpos >= line.len() || line.byte_at(cpos) != 40)

    // Strip partial identifier being typed at cursor end
    mut scan = prefix.len()
    while scan > 0 && lsp_is_ident_char(prefix.byte_at(scan - 1)) {
        scan = scan - 1
    }
    let before_word = prefix.slice(0, scan).trim()

    let jb = JsonBuf()
    jb.lbrace()
    jb.kv_bool("isIncomplete", false, true)
    jb.comma()
    jb.key("items")
    jb.lbrack()

    let seen = Map<str, i64>()
    let is_first = List<i64>()
    is_first.push(1)

    // Case 0: Import / Use file & stdlib path completion inside quotes
    if lsp_emit_import_completions(doc_path, line0, prefix, cpos, jb, is_first) {
        jb.rbrack()
        jb.rbrace()
        return jb.finish()
    }

    let expected_t = lsp_infer_expected_type(source, az, doc_path, line0, cpos, before_word)

    // Case 1: Member / Cascade completion after '.' / '?.' / '~>' + Postfix transforms
    mut is_member = false
    mut is_plain_dot = false
    mut dot_col0 = -1
    if before_word.ends_with("?.") || before_word.ends_with("~>") {
        is_member = true
        dot_col0 = before_word.len() - 2
    } else if before_word.ends_with(".") {
        is_member = true
        is_plain_dot = true
        dot_col0 = before_word.len() - 1
    }

    if is_member {
        // Compute dot position in un-trimmed `prefix` so `textEdit` ranges align identically
        mut raw_dot_col = scan - 1
        while raw_dot_col > 0 && (prefix.byte_at(raw_dot_col) == 32 || prefix.byte_at(raw_dot_col) == 9) {
            raw_dot_col = raw_dot_col - 1
        }
        let clean_recv = lsp_extract_receiver_before_dot(before_word, before_word.len() - 1)
        if collect_module_or_file_completions(az, source, doc_path, clean_recv, insert_parens, expected_t, jb, seen, is_first) {
            jb.rbrack()
            jb.rbrace()
            return jb.finish()
        }
        let recv_t = lsp_infer_expr_receiver_type(az, doc_path, line0 + 1, clean_recv, source)

        if recv_t != "" {
            if az.enum_idx_map.has_key(recv_t) {
                let eid = lsp_find_enum_node(az, recv_t)
                if eid >= 0 {
                    let vc = az.ll.get(eid)
                    mut vi = 0
                    while vi < vc {
                        let vid = az.ch.get(az.ls.get(eid) + vi)
                        let vnm = az.sa.get(vid)
                        let vfmt = lsp_format_enum_variant(az, vid)
                        let matched = lsp_type_matches(recv_t, expected_t)
                        mut stxt = "0_" + vnm
                        if matched { stxt = "00_" + vnm }
                        let fst = is_first.get(0) == 1
                        is_first.set(0, 0)
                        emit_comp_item_ex(jb, vnm, "", recv_t, CKIND_ENUM_MEM(), recv_t + "." + vfmt,
                                          "Enum variant of `" + recv_t + "`", "", stxt, "", -1, 0, 0, "", matched, fst)
                        vi = vi + 1
                    }
                }
            } else if az.cls_idx_map.has_key(recv_t) {
                collect_class_member_completions(az, source, doc_path, recv_t, insert_parens, expected_t, jb, seen, is_first)
            } else {
                let bms = lsp_builtin_methods_for(recv_t)
                mut bi = 0
                while bi < bms.len() {
                    let entry = bms.get(bi)
                    let colon_i = lsp_str_find(entry, ":", 0)
                    let mnm = entry.slice(0, colon_i)
                    let msig = lsp_subst_generic_sig(entry, recv_t)
                    let lparts = lsp_sig_to_label_parts(msig)
                    let snip = lsp_build_call_snippet(mnm, lparts.get(0), insert_parens)
                    let rt = lparts.get(1)
                    mut mdoc = lsp_lookup_member_doc(recv_t, mnm)
                    if mdoc == "" { mdoc = "Built-in `" + recv_t + "` method" }
                    let matched = lsp_type_matches(rt, expected_t)
                    mut stxt = "0_" + mnm
                    if matched { stxt = "00_" + mnm }
                    let fst = is_first.get(0) == 1
                    is_first.set(0, 0)
                    emit_comp_item_ex(jb, mnm, lparts.get(0), rt, CKIND_METHOD(), msig, mdoc,
                                      snip, stxt, "", -1, 0, 0, "", matched, fst)
                    bi = bi + 1
                }
            }
        }

        if is_plain_dot && raw_dot_col > 0 && !az.enum_idx_map.has_key(clean_recv) {
            let recv_start0 = lsp_extract_receiver_start_before_dot(line, raw_dot_col)
            lsp_emit_postfix_completions(line0, recv_start0, raw_dot_col, cpos, line, clean_recv, recv_t, jb, is_first)
        }

        jb.rbrack()
        jb.rbrace()
        return jb.finish()
    }

    // Case 2A: Type annotation context (after `:`, `->`, `extends`, `implements`, `as`, or inside `<...>`)
    if lsp_is_type_position(before_word) {
        lsp_emit_type_completions(az, source, doc_path, line0, before_word, jb, seen, is_first)
        jb.rbrack()
        jb.rbrace()
        return jb.finish()
    }

    // Case 2B: Scope + Enclosing Class + Project Symbols + Builtins + Keywords
    let line1 = line0 + 1
    let fbounds = lsp_enclosing_fn_bounds(source, az, doc_path, line1)
    let fn_start = fbounds.get(1)
    let in_fn = (fn_start > 0)
    let enc_cls = lsp_enclosing_class_at(az, doc_path, line1)

    // Scoped local, parameter, for-loop variables & module globals in current file
    mut ni = 0
    while ni < az.ncount {
        let k = az.nk.get(ni)
        let nln = az.ln.get(ni)
        if az.nf.get(ni) == doc_path && nln <= line1 {
            mut is_in_scope = false
            if k == NK_VAR_DECL_GLOBAL() {
                is_in_scope = true
            } else if k == NK_VAR_DECL() || k == NK_PARAM() || k == NK_FOR() {
                if in_fn {
                    is_in_scope = (nln >= fn_start)
                } else {
                    is_in_scope = false
                }
            }
            if is_in_scope {
                mut vnm = az.sa.get(ni)
                if k == NK_FOR() && az.sb.get(ni) != "" && vnm == "" { vnm = az.sb.get(ni) }
                if vnm != "" && !seen.has_key("v::" + vnm) {
                    seen.insert("v::" + vnm, 1)
                    mut vt = btype_norm(az.node_types.get(ni))
                    if (vt == "" || vt == "void") && k != NK_FOR() { vt = btype_norm(az.sb.get(ni)) }
                    if vt == "" || vt == "void" { vt = lsp_resolve_var_type(az, doc_path, line1, vnm, source) }
                    let matched = lsp_type_matches(vt, expected_t)
                    mut stxt = "0_" + vnm
                    if matched { stxt = "00_" + vnm }
                    let fst = is_first.get(0) == 1
                    is_first.set(0, 0)
                    emit_comp_item_ex(jb, vnm, "", vt, CKIND_VARIABLE(), vnm + ": " + vt, "",
                                      "", stxt, "", -1, 0, 0, "", matched, fst)
                }
            }
        }
        ni = ni + 1
    }

    // Enclosing class implicit self members when inside a class
    if enc_cls != "" {
        collect_class_member_completions(az, source, doc_path, enc_cls, insert_parens, expected_t, jb, seen, is_first)
    }

    // Functions
    mut fi = 0
    while fi < az.fn_count {
        let fid = az.fn_nodes.get(fi)
        let fnm = az.sa.get(fid)
        if fnm != "" && !seen.has_key("fn::" + fnm) {
            seen.insert("fn::" + fnm, 1)
            let sig = lsp_fn_signature_str(az, fid)
            let lparts = lsp_sig_to_label_parts(sig)
            let snip = lsp_build_call_snippet(fnm, lparts.get(0), insert_parens)
            let rt = lparts.get(1)
            let fn_file = az.nf.get(fid)
            let same_file = fn_file == doc_path
            mut fdoc = lsp_extract_doc_comments(source, doc_path, fn_file, az.ln.get(fid))
            let mod_lbl = lsp_source_module_label(fn_file, doc_path)
            mut src_note = "*Defined in* `" + bpath_basename(fn_file) + ":" + az.ln.get(fid) + "`"
            if mod_lbl != "" {
                src_note = "*Imported from module/file* `" + mod_lbl + "` (" + bpath_basename(fn_file) + ":" + az.ln.get(fid) + ")"
            }
            if fdoc != "" { fdoc = fdoc + "\n\n" + src_note } else { fdoc = src_note }
            let matched = lsp_type_matches(rt, expected_t)
            mut desc = rt
            if mod_lbl != "" { desc = rt + " (" + mod_lbl + ")" }
            mut stxt = "2_" + fnm
            if same_file { stxt = "1_" + fnm }
            else if mod_lbl != "" { stxt = "1a_" + fnm }
            if matched { stxt = "00_" + fnm }
            let fst = is_first.get(0) == 1
            is_first.set(0, 0)
            emit_comp_item_ex(jb, fnm, lparts.get(0), desc, CKIND_FUNCTION(), sig, fdoc,
                              snip, stxt, "", -1, 0, 0, "", matched, fst)
        }
        fi = fi + 1
    }

    // Classes (with ctor signature hint when available)
    mut ci = 0
    while ci < az.cls_count {
        let cid = az.cls_nodes.get(ci)
        let cnm = az.cls_names.get(ci)
        if !seen.has_key("c::" + cnm) {
            seen.insert("c::" + cnm, 1)
            let c_file = az.nf.get(cid)
            let same_file = c_file == doc_path
            mut cdetail = ""
            mut csnip = ""
            let ctor_k = "ctor::" + cnm
            if az.sig_by_key.has_key(ctor_k) {
                let sidx = az.sig_by_key.get(ctor_k).split(",").get(0).to_i64()
                let csig = lsp_fn_signature_str(az, az.sig_nodes.get(sidx))
                let cparts = lsp_sig_to_label_parts(csig)
                cdetail = cparts.get(0)
                csnip = lsp_build_call_snippet(cnm, cdetail, insert_parens && in_fn)
            }
            mut cdoc = lsp_extract_doc_comments(source, doc_path, c_file, az.ln.get(cid))
            let mod_lbl = lsp_source_module_label(c_file, doc_path)
            mut src_note = "*Defined in* `" + bpath_basename(c_file) + ":" + az.ln.get(cid) + "`"
            if mod_lbl != "" {
                src_note = "*Imported from module/file* `" + mod_lbl + "` (" + bpath_basename(c_file) + ":" + az.ln.get(cid) + ")"
            }
            if cdoc != "" { cdoc = cdoc + "\n\n" + src_note } else { cdoc = src_note }
            let matched = lsp_type_matches(cnm, expected_t)
            mut cdesc = "class"
            if mod_lbl != "" { cdesc = "class (" + mod_lbl + ")" }
            mut stxt = "2_" + cnm
            if same_file { stxt = "1_" + cnm }
            else if mod_lbl != "" { stxt = "1a_" + cnm }
            if matched { stxt = "00_" + cnm }
            let fst = is_first.get(0) == 1
            is_first.set(0, 0)
            emit_comp_item_ex(jb, cnm, cdetail, cdesc, CKIND_CLASS(), "class " + cnm, cdoc,
                              csnip, stxt, "", -1, 0, 0, "", matched, fst)
        }
        ci = ci + 1
    }

    // Enums
    mut ei = 0
    while ei < az.enum_count {
        let eid = az.enum_nodes.get(ei)
        let enm = az.enum_names.get(ei)
        if !seen.has_key("e::" + enm) {
            seen.insert("e::" + enm, 1)
            let e_file = az.nf.get(eid)
            let same_file = e_file == doc_path
            mut edoc = lsp_extract_doc_comments(source, doc_path, e_file, az.ln.get(eid))
            let mod_lbl = lsp_source_module_label(e_file, doc_path)
            mut src_note = "*Defined in* `" + bpath_basename(e_file) + ":" + az.ln.get(eid) + "`"
            if mod_lbl != "" {
                src_note = "*Imported from module/file* `" + mod_lbl + "` (" + bpath_basename(e_file) + ":" + az.ln.get(eid) + ")"
            }
            if edoc != "" { edoc = edoc + "\n\n" + src_note } else { edoc = src_note }
            let matched = lsp_type_matches(enm, expected_t)
            mut edesc = "enum"
            if mod_lbl != "" { edesc = "enum (" + mod_lbl + ")" }
            mut stxt = "2_" + enm
            if same_file { stxt = "1_" + enm }
            else if mod_lbl != "" { stxt = "1a_" + enm }
            if matched { stxt = "00_" + enm }
            let fst = is_first.get(0) == 1
            is_first.set(0, 0)
            emit_comp_item_ex(jb, enm, "", edesc, CKIND_ENUM(), "enum " + enm, edoc,
                              "", stxt, "", -1, 0, 0, "", matched, fst)
        }
        ei = ei + 1
    }

    // Modules and imported file namespaces (e.g. Math, Random, Socket, Time, Window, helper)
    mut nfi = 0
    while nfi < az.nf.len() {
        let fpath = az.nf.get(nfi)
        let mlbl = lsp_source_module_label(fpath, doc_path)
        if mlbl != "" && !seen.has_key("mod::" + mlbl) {
            seen.insert("mod::" + mlbl, 1)
            let fst = is_first.get(0) == 1
            is_first.set(0, 0)
            emit_comp_item_ex(jb, mlbl, "", "module", CKIND_MODULE(), "module " + mlbl,
                              "Imported module or source file `" + mlbl + "`.\n\nType `" + mlbl + ".` to access all its functions and members.",
                              "", "1b_" + mlbl, "", -1, 0, 0, "", false, fst)
        }
        nfi = nfi + 1
    }

    // Builtin Functions (only relevant inside function/expression bodies or untyped positions)
    let bfns = lsp_builtin_fn_list()
    mut bfi = 0
    while bfi < bfns.len() {
        let bnm = bfns.get(bfi)
        if !seen.has_key("fn::" + bnm) {
            seen.insert("fn::" + bnm, 1)
            mut bsig = lsp_builtin_fn_sig(bnm)
            if bsig == "" { bsig = "builtin " + bnm }
            let lparts = lsp_sig_to_label_parts(bsig)
            let snip = lsp_build_call_snippet(bnm, lparts.get(0), insert_parens)
            let matched = lsp_type_matches(lparts.get(1), expected_t)
            mut stxt = "3_" + bnm
            if matched { stxt = "00_" + bnm }
            let fst = is_first.get(0) == 1
            is_first.set(0, 0)
            emit_comp_item_ex(jb, bnm, lparts.get(0), lparts.get(1), CKIND_FUNCTION(), bsig, lsp_lookup_doc(bnm),
                              snip, stxt, "", -1, 0, 0, "", matched, fst)
        }
        bfi = bfi + 1
    }

    // Primitive & Container Types & Static Stdlib Modules
    let ts = lsp_type_list()
    mut ti = 0
    while ti < ts.len() {
        let tnm = ts.get(ti)
        if !seen.has_key("c::" + tnm) {
            seen.insert("c::" + tnm, 1)
            mut stxt = "4_" + tnm
            mut desc = "type"
            if lsp_is_static_runtime(tnm) {
                stxt = "2_" + tnm
                desc = "stdlib"
            }
            let fst = is_first.get(0) == 1
            is_first.set(0, 0)
            emit_comp_item_ex(jb, tnm, "", desc, CKIND_CLASS(), "type " + tnm, lsp_lookup_doc(tnm),
                              "", stxt, "", -1, 0, 0, "", false, fst)
        }
        ti = ti + 1
    }

    // Context-ranked Keywords
    let ks = lsp_keyword_list()
    mut ki = 0
    while ki < ks.len() {
        let knm = ks.get(ki)
        mut ksort = "5b_" + knm
        if in_fn {
            if knm == "let" || knm == "mut" || knm == "if" || knm == "else" || knm == "elif" || knm == "for" || knm == "while" || knm == "match" || knm == "return" || knm == "guard" || knm == "defer" || knm == "true" || knm == "false" || knm == "null" {
                ksort = "5a_" + knm
            }
        } else {
            if knm == "fn" || knm == "pub" || knm == "class" || knm == "struct" || knm == "enum" || knm == "trait" || knm == "extend" || knm == "const" || knm == "import" || knm == "use" {
                ksort = "5a_" + knm
            }
        }
        let fst = is_first.get(0) == 1
        is_first.set(0, 0)
        emit_comp_item_ex(jb, knm, "", "keyword", CKIND_KEYWORD(), "keyword " + knm, lsp_lookup_doc(knm),
                          "", ksort, "", -1, 0, 0, "", false, fst)
        ki = ki + 1
    }

    jb.rbrack()
    jb.rbrace()
    return jb.finish()
}

// --- 3. Hover ---

fn lsp_subst_generic_sig(raw_sig: str, recv_t: str) -> str {
    let colon_i = lsp_str_find(raw_sig, ":", 0)
    mut mname = raw_sig
    mut params_ret = ""
    if colon_i >= 0 {
        mname = raw_sig.slice(0, colon_i)
        params_ret = raw_sig.slice(colon_i + 1, raw_sig.len())
    }
    if recv_t.starts_with("List<") || recv_t.starts_with("Set<") || recv_t.starts_with("Stack<") || recv_t.starts_with("Queue<") || recv_t.starts_with("Deque<") {
        let elem = lsp_generic_inner_arg(recv_t, 0)
        if elem != "" {
            params_ret = params_ret.replace(": T)", ": " + elem + ")").replace(": T,", ": " + elem + ",").replace("-> T", "-> " + elem).replace("<T>", "<" + elem + ">")
        }
    } else if recv_t.starts_with("Map<") {
        let k_elem = lsp_generic_inner_arg(recv_t, 0)
        let v_elem = lsp_generic_inner_arg(recv_t, 1)
        if k_elem != "" {
            params_ret = params_ret.replace(": K)", ": " + k_elem + ")").replace(": K,", ": " + k_elem + ",").replace("<K>", "<" + k_elem + ">")
        }
        if v_elem != "" {
            params_ret = params_ret.replace("-> V", "-> " + v_elem).replace(": V)", ": " + v_elem + ")").replace("<V>", "<" + v_elem + ">")
        }
    }
    return "fn " + mname + params_ret
}

fn lsp_find_class_field_node(az: Analyzer, cls_name: str, field_name: str) -> i64 {
    mut walk = cls_name
    mut hops = 0
    while walk != "" && hops < 8 {
        let cid = lsp_find_class_node(az, walk)
        if cid >= 0 {
            let fg = az.la.get(cid)
            if fg >= 0 {
                mut fi = 0
                while fi < az.ll.get(fg) {
                    let fid = az.ch.get(az.ls.get(fg) + fi)
                    if az.sa.get(fid) == field_name { return fid }
                    fi = fi + 1
                }
            }
        }
        if az.cls_base_map.has_key(walk) { walk = az.cls_base_map.get(walk) } else { walk = "" }
        hops = hops + 1
    }
    return -1
}

fn lsp_find_class_method_cls(az: Analyzer, cls_name: str, mname: str) -> str {
    mut walk = cls_name
    mut hops = 0
    while walk != "" && hops < 8 {
        let sig_k = "m::" + walk + "::" + mname
        if az.sig_by_key.has_key(sig_k) {
            return walk
        }
        if az.cls_base_map.has_key(walk) { walk = az.cls_base_map.get(walk) } else { walk = "" }
        hops = hops + 1
    }
    return cls_name
}

fn lsp_find_class_method_sidx(az: Analyzer, cls_name: str, mname: str) -> i64 {
    mut walk = cls_name
    mut hops = 0
    while walk != "" && hops < 8 {
        let sig_k = "m::" + walk + "::" + mname
        if az.sig_by_key.has_key(sig_k) {
            return az.sig_by_key.get(sig_k).split(",").get(0).to_i64()
        }
        if az.cls_base_map.has_key(walk) { walk = az.cls_base_map.get(walk) } else { walk = "" }
        hops = hops + 1
    }
    return -1
}

fn lsp_format_enum_variant(az: Analyzer, vid: i64) -> str {
    let bb = ByteBuffer()
    bb.write_str(az.sa.get(vid))
    let fc = az.ll.get(vid)
    if fc > 0 {
        bb.write_str("(")
        mut i = 0
        while i < fc {
            if i > 0 { bb.write_str(", ") }
            let pid = az.ch.get(az.ls.get(vid) + i)
            bb.write_str(az.sa.get(pid) + ": " + btype_norm(az.sb.get(pid)))
            i = i + 1
        }
        bb.write_str(")")
    }
    let out = bb.to_str()
    bb.free()
    return out
}

fn lsp_resolve_import_at_cursor(source: str, doc_path: str, line0: i64, char0: i64) -> str {
    let line = lsp_get_line_text(source, line0)
    let trim_l = line.trim()
    if !trim_l.starts_with("import ") && !trim_l.starts_with("use ") { return "" }
    let n = line.len()
    // Check quoted path containing cursor
    mut q1 = -1
    mut q2 = -1
    mut i = 0
    while i < n {
        if line.byte_at(i) == 34 {
            if q1 < 0 {
                q1 = i
            } else {
                q2 = i
                if char0 >= q1 && char0 <= q2 {
                    let rel = line.slice(q1 + 1, q2)
                    mut resolved = rel
                    if !bpath_is_abs(resolved) {
                        resolved = bpath_join(bpath_dirname(doc_path), rel)
                    } else {
                        resolved = bpath_normalize(resolved)
                    }
                    if !File.exists(resolved) && !str_ends_with_arx(resolved) {
                        if File.exists(resolved + ".arx") { resolved = resolved + ".arx" }
                    }
                    if File.exists(resolved) { return resolved }
                    return ""
                }
                q1 = -1
                q2 = -1
            }
        }
        i = i + 1
    }
    // Check module name import Mod
    let w = lsp_word_at(source, line0, char0)
    if w != "" && w != "import" && w != "use" && w != "from" {
        let mdir = find_module_dir(w, bpath_dirname(doc_path))
        if mdir != "" {
            let c1 = bpath_join(mdir, w + ".arx")
            if File.exists(c1) { return c1 }
            let c2 = bpath_join(mdir, "mod.arx")
            if File.exists(c2) { return c2 }
            let c3 = bpath_join(mdir, "main.arx")
            if File.exists(c3) { return c3 }
        }
    }
    return ""
}

fn lsp_format_hover_block(code: str, doc: str, loc_file: str, loc_line: i64) -> str {
    let bb = ByteBuffer()
    bb.write_str("```aerix\n")
    bb.write_str(code)
    bb.write_str("\n```")
    if doc != "" {
        bb.write_str("\n---\n")
        bb.write_str(doc)
    }
    if loc_file != "" && loc_line > 0 {
        bb.write_str("\n\n*Defined at* [`")
        bb.write_str(bpath_basename(loc_file))
        bb.write_str(":")
        bb.write_str("" + loc_line)
        bb.write_str("`](")
        bb.write_str(lsp_path_to_uri(loc_file))
        bb.write_str("#L")
        bb.write_str("" + loc_line)
        bb.write_str(")")
    }
    let out = bb.to_str()
    bb.free()
    return out
}

pub fn lsp_build_hover_json(source: str, az: Analyzer, doc_path: str, line0: i64, char0: i64) -> str {
    let line = lsp_get_line_text(source, line0)
    mut md = ""

    // 0. Import path hover
    let imp_target = lsp_resolve_import_at_cursor(source, doc_path, line0, char0)
    if imp_target != "" {
        md = "```aerix\nmodule \"" + bpath_basename(imp_target) + "\"\n```\n\nResolved path: [`" + imp_target + "`](" + lsp_path_to_uri(imp_target) + ")"
    }

    let word = lsp_word_at(source, line0, char0)
    if md == "" && word == "" { return "null" }

    let wpos = lsp_word_start_at(source, line0, char0)
    let line1 = line0 + 1

    // 1. Receiver member hover (expr.member / expr?.member / expr~>member)
    let is_dot = wpos >= 2 && line.byte_at(wpos - 1) == 46
    let is_cascade = wpos >= 3 && line.byte_at(wpos - 1) == 62 && line.byte_at(wpos - 2) == 126
    if md == "" && (is_dot || is_cascade) {
        let rname = lsp_extract_receiver_before_dot(line, wpos - 1)
        if is_dot && az.enum_idx_map.has_key(rname) {
            let vkey = rname + "::" + word
            if az.enum_var_node.has_key(vkey) {
                let vid = az.enum_var_node.get(vkey)
                let vfile = az.nf.get(vid)
                let vln = az.ln.get(vid)
                let doc = lsp_extract_doc_comments(source, doc_path, vfile, vln)
                let tag = az.ia.get(vid)
                md = lsp_format_hover_block("(enum variant) " + rname + "." + lsp_format_enum_variant(az, vid) + " = " + tag, doc, vfile, vln)
            } else {
                md = "**Enum Variant** `" + rname + "." + word + "`"
            }
        }
        if md == "" {
            let rt = lsp_infer_expr_receiver_type(az, doc_path, line1, rname)
            if rt != "" {
                // Builtin / container / static module methods
                let bmethods = lsp_builtin_methods_for(rt)
                mut bi = 0
                while bi < bmethods.len() {
                    let msig = bmethods.get(bi)
                    if msig.starts_with(word + ":") {
                        let fmt_sig = lsp_subst_generic_sig(msig, rt)
                        mut mdoc = lsp_lookup_member_doc(rt, word)
                        if mdoc != "" {
                            mdoc = mdoc + "\n\n*Stdlib method on* `" + rt + "`"
                        } else {
                            mdoc = "*Stdlib method on* `" + rt + "`"
                        }
                        md = lsp_format_hover_block(fmt_sig, mdoc, "", 0)
                        break
                    }
                    bi = bi + 1
                }
                // User class field (with inheritance walk)
                if md == "" {
                    let fid = lsp_find_class_field_node(az, rt, word)
                    if fid >= 0 {
                        let ffile = az.nf.get(fid)
                        let fln = az.ln.get(fid)
                        let doc = lsp_extract_doc_comments(source, doc_path, ffile, fln)
                        mut fhdr = "(field) "
                        if has_flag(az.ia.get(fid), FLAG_PUB()) { fhdr = fhdr + "pub " }
                        if has_flag(az.ia.get(fid), FLAG_STATIC()) { fhdr = fhdr + "static " }
                        if has_flag(az.ia.get(fid), FLAG_MUT()) { fhdr = fhdr + "mut " } else { fhdr = fhdr + "let " }
                        fhdr = fhdr + rt + "." + word + ": " + btype_norm(az.sb.get(fid))
                        md = lsp_format_hover_block(fhdr, doc, ffile, fln)
                    }
                }
                // User class / extend method (with inheritance walk)
                if md == "" {
                    let sidx = lsp_find_class_method_sidx(az, rt, word)
                    if sidx >= 0 {
                        let mid = az.sig_nodes.get(sidx)
                        let mfile = az.nf.get(mid)
                        let mln = az.ln.get(mid)
                        let doc = lsp_extract_doc_comments(source, doc_path, mfile, mln)
                        let owner_cls = lsp_find_class_method_cls(az, rt, word)
                        md = lsp_format_hover_block("(method on " + owner_cls + ") " + lsp_fn_signature_str(az, mid), doc, mfile, mln)
                    }
                }
            }
        }
    }

    // 2. self / super keywords
    if md == "" && (word == "self" || word == "super") {
        let ec = lsp_enclosing_class_at(az, doc_path, line1)
        if ec != "" {
            if word == "self" {
                md = lsp_format_hover_block("(self) " + ec, "Reference to the current `" + ec + "` instance.", "", 0)
            } else if az.cls_base_map.has_key(ec) {
                let base_c = az.cls_base_map.get(ec)
                md = lsp_format_hover_block("(super) " + base_c, "Parent class of `" + ec + "`.", "", 0)
            }
        }
    }

    // 3. Scoped Local / Parameter / For variable (inside enclosing function bounds)
    if md == "" {
        let fbounds = lsp_enclosing_fn_bounds(source, az, doc_path, line1)
        let fstart = fbounds.get(1)
        if fstart > 0 {
            let vnid = lsp_resolve_scoped_var_node(az, doc_path, line1, fstart, word)
            if vnid >= 0 {
                let vk = az.nk.get(vnid)
                mut vt = btype_norm(az.node_types.get(vnid))
                if vt == "" || vt == "void" { vt = btype_norm(az.sb.get(vnid)) }
                if vt == "" { vt = "<inferred>" }
                mut kind_lbl = "let"
                if vk == NK_PARAM() {
                    if has_flag(az.ia.get(vnid), FLAG_MUT()) { kind_lbl = "mut param" } else { kind_lbl = "param" }
                } else if vk == NK_FOR() {
                    kind_lbl = "for var"
                } else if az.ia.get(vnid) != 0 {
                    kind_lbl = "mut"
                }
                let vln = az.ln.get(vnid)
                let doc = lsp_extract_doc_comments(source, doc_path, doc_path, vln)
                md = lsp_format_hover_block("(" + kind_lbl + ") " + word + ": " + vt, doc, doc_path, vln)
            }
        }
    }

    // 4. Implicit self field or method when inside a class
    if md == "" {
        let ec2 = lsp_enclosing_class_at(az, doc_path, line1)
        if ec2 != "" {
            let fid = lsp_find_class_field_node(az, ec2, word)
            if fid >= 0 {
                let ffile = az.nf.get(fid)
                let fln = az.ln.get(fid)
                let doc = lsp_extract_doc_comments(source, doc_path, ffile, fln)
                mut fhdr = "(field) "
                if has_flag(az.ia.get(fid), FLAG_MUT()) { fhdr = fhdr + "mut " } else { fhdr = fhdr + "let " }
                fhdr = fhdr + ec2 + "." + word + ": " + btype_norm(az.sb.get(fid))
                md = lsp_format_hover_block(fhdr, doc, ffile, fln)
            } else {
                let sidx = lsp_find_class_method_sidx(az, ec2, word)
                if sidx >= 0 {
                    let mid = az.sig_nodes.get(sidx)
                    let mfile = az.nf.get(mid)
                    let mln = az.ln.get(mid)
                    let doc = lsp_extract_doc_comments(source, doc_path, mfile, mln)
                    let owner_cls2 = lsp_find_class_method_cls(az, ec2, word)
                    md = lsp_format_hover_block("(method on " + owner_cls2 + ") " + lsp_fn_signature_str(az, mid), doc, mfile, mln)
                }
            }
        }
    }

    // 5. User Class / Struct
    if md == "" && az.cls_idx_map.has_key(word) {
        let cid = lsp_find_class_node(az, word)
        let cfile = az.nf.get(cid)
        let cln = az.ln.get(cid)
        let doc = lsp_extract_doc_comments(source, doc_path, cfile, cln)
        let bb = ByteBuffer()
        mut hdr = ""
        if has_flag(az.ia.get(cid), FLAG_PUB()) { hdr = "pub " }
        if has_flag(az.ia.get(cid), FLAG_PACKED()) { hdr = hdr + "#[packed] " }
        hdr = hdr + "class " + word
        let base_c = btype_norm(az.sb.get(cid))
        if base_c != "" { hdr = hdr + " extends " + base_c }
        bb.write_str(lsp_format_hover_block(hdr, doc, cfile, cln))

        let fg = az.la.get(cid)
        let fc = az.ll.get(fg)
        if fc > 0 {
            bb.write_str("\n\n**Fields**\n")
            mut fi = 0
            mut shown_f = 0
            while fi < fc && shown_f < 12 {
                let fid = az.ch.get(az.ls.get(fg) + fi)
                mut flbl = ""
                if has_flag(az.ia.get(fid), FLAG_MUT()) { flbl = "mut " }
                bb.write_str("- `" + flbl + az.sa.get(fid) + ": " + btype_norm(az.sb.get(fid)) + "`\n")
                shown_f = shown_f + 1
                fi = fi + 1
            }
            if fc > 12 { bb.write_str("- *...and " + (fc - 12) + " more*\n") }
        }
        let cg = az.ra.get(cid)
        if cg >= 0 && az.ll.get(cg) > 0 {
            bb.write_str("\n**Constructors**\n")
            mut ki = 0
            while ki < az.ll.get(cg) {
                let kid = az.ch.get(az.ls.get(cg) + ki)
                bb.write_str("- `" + lsp_fn_signature_str(az, kid) + "`\n")
                ki = ki + 1
            }
        }
        let mg = az.ea.get(cid)
        let mc = az.ll.get(mg)
        if mc > 0 {
            bb.write_str("\n**Methods**\n")
            mut mi = 0
            mut shown_m = 0
            while mi < mc && shown_m < 14 {
                let mid = az.ch.get(az.ls.get(mg) + mi)
                bb.write_str("- `" + lsp_fn_signature_str(az, mid) + "`\n")
                shown_m = shown_m + 1
                mi = mi + 1
            }
            if mc > 14 { bb.write_str("- *...and " + (mc - 14) + " more*\n") }
        }
        md = bb.to_str()
        bb.free()
    }

    // 6. User Enum
    if md == "" && az.enum_idx_map.has_key(word) {
        let eid = lsp_find_enum_node(az, word)
        let efile = az.nf.get(eid)
        let eln = az.ln.get(eid)
        let doc = lsp_extract_doc_comments(source, doc_path, efile, eln)
        let bb = ByteBuffer()
        bb.write_str(lsp_format_hover_block("enum " + word, doc, efile, eln))
        bb.write_str("\n\n**Variants**\n")
        let vc = az.ll.get(eid)
        mut vi = 0
        while vi < vc {
            let vid = az.ch.get(az.ls.get(eid) + vi)
            bb.write_str("- `" + lsp_format_enum_variant(az, vid) + "`\n")
            vi = vi + 1
        }
        md = bb.to_str()
        bb.free()
    }

    // 7. User Function (prefer current file if duplicated)
    if md == "" {
        mut best_fid = -1
        mut fi = 0
        while fi < az.fn_count {
            let fid = az.fn_nodes.get(fi)
            if az.sa.get(fid) == word {
                if best_fid < 0 || az.nf.get(fid) == doc_path {
                    best_fid = fid
                    if az.nf.get(fid) == doc_path { break }
                }
            }
            fi = fi + 1
        }
        if best_fid >= 0 {
            let ffile = az.nf.get(best_fid)
            let fln = az.ln.get(best_fid)
            let doc = lsp_extract_doc_comments(source, doc_path, ffile, fln)
            md = lsp_format_hover_block(lsp_fn_signature_str(az, best_fid), doc, ffile, fln)
        }
    }

    // 8. Global declaration
    if md == "" {
        mut gi = 0
        while gi < az.global_count {
            let gid = az.global_nodes.get(gi)
            if az.sa.get(gid) == word {
                mut gt = btype_norm(az.node_types.get(gid))
                if gt == "" || gt == "void" { gt = btype_norm(az.sb.get(gid)) }
                if gt == "" && az.global_types.has_key(word) { gt = az.global_types.get(word) }
                let gfile = az.nf.get(gid)
                let gln = az.ln.get(gid)
                let doc = lsp_extract_doc_comments(source, doc_path, gfile, gln)
                mut gkind = "global let"
                if az.ia.get(gid) != 0 { gkind = "global mut" }
                md = lsp_format_hover_block("(" + gkind + ") " + word + ": " + gt, doc, gfile, gln)
                break
            }
            gi = gi + 1
        }
    }

    // 9. Enum variant match without prefix
    if md == "" {
        mut ei = 0
        while ei < az.enum_count && md == "" {
            let eid = az.enum_nodes.get(ei)
            let ename = az.enum_names.get(ei)
            let vc = az.ll.get(eid)
            mut vi = 0
            while vi < vc {
                let vid = az.ch.get(az.ls.get(eid) + vi)
                if az.sa.get(vid) == word {
                    let vfile = az.nf.get(vid)
                    let vln = az.ln.get(vid)
                    let doc = lsp_extract_doc_comments(source, doc_path, vfile, vln)
                    md = lsp_format_hover_block("(enum variant) " + ename + "." + lsp_format_enum_variant(az, vid) + " = " + az.ia.get(vid), doc, vfile, vln)
                    break
                }
                vi = vi + 1
            }
            ei = ei + 1
        }
    }

    // 10. Builtin signature & doc fallback
    if md == "" {
        let bdoc = lsp_lookup_doc(word)
        let bsig = lsp_builtin_fn_sig(word)
        if bsig != "" {
            md = lsp_format_hover_block(bsig, bdoc, "", 0)
        } else {
            md = bdoc
        }
    }

    if md == "" { return "null" }
    let jb = JsonBuf()
    jb.lbrace()
    jb.key("contents")
    jb.lbrace()
    jb.kv_str("kind", "markdown", true)
    jb.kv_str("value", md, false)
    jb.rbrace()
    jb.rbrace()
    return jb.finish()
}

// --- 4. Signature Help ---

fn lsp_line_col_to_offset(source: str, line0: i64, char0: i64) -> i64 {
    let n = source.len()
    mut ln = 0
    mut i = 0
    while ln < line0 && i < n {
        if source.byte_at(i) == 10 { ln = ln + 1 }
        i = i + 1
    }
    mut col = 0
    while col < char0 && i < n && source.byte_at(i) != 10 && source.byte_at(i) != 13 {
        col = col + 1
        i = i + 1
    }
    return i
}

pub fn lsp_build_signature_help_json(source: str, az: Analyzer, doc_path: str, line0: i64, char0: i64) -> str {
    let sig_params = List<str>()
    let meta = List<str>()
    let commas = lsp_resolve_call_site_sig(source, az, doc_path, line0, char0, sig_params, meta)
    if commas < 0 || meta.len() < 2 { return "null" }
    let sig_label = meta.get(0)
    let sig_doc = meta.get(1)

    let jb = JsonBuf()
    jb.lbrace()
    jb.key("signatures")
    jb.lbrack()
    jb.lbrace()
    jb.kv_str("label", sig_label, true)
    if sig_doc != "" {
        jb.comma()
        jb.key("documentation")
        jb.lbrace()
        jb.kv_str("kind", "markdown", true)
        jb.kv_str("value", sig_doc, false)
        jb.rbrace()
    }
    jb.comma()
    jb.key("parameters")
    jb.lbrack()
    mut pi = 0
    while pi < sig_params.len() {
        if pi > 0 { jb.comma() }
        jb.lbrace()
        jb.kv_str("label", sig_params.get(pi), true)
        jb.rbrace()
        pi = pi + 1
    }
    jb.rbrack()
    jb.rbrace()
    jb.rbrack()
    jb.kv_int("activeSignature", 0, false)
    jb.kv_int("activeParameter", commas, false)
    jb.rbrace()
    return jb.finish()
}

// --- 5. Go-to-Definition (F12) & Type Definition ---

fn lsp_emit_location_obj(jb: JsonBuf, tfile: str, tline0: i64, tcol0: i64, tlen: i64) {
    mut end_col = tcol0 + tlen
    if end_col < tcol0 { end_col = tcol0 }
    jb.lbrace()
    jb.kv_str("uri", lsp_path_to_uri(tfile), true)
    jb.comma()
    jb.key("range")
    jb.lbrace()
    jb.key("start"); jb.lbrace(); jb.kv_int("line", tline0, true); jb.kv_int("character", tcol0, false); jb.rbrace()
    jb.comma()
    jb.key("end"); jb.lbrace(); jb.kv_int("line", tline0, true); jb.kv_int("character", end_col, false); jb.rbrace()
    jb.rbrace()
    jb.rbrace()
}

fn lsp_location_from_node(source: str, doc_path: str, az: Analyzer, target_nid: i64, word: str) -> str {
    if target_nid < 0 { return "null" }
    let tfile = az.nf.get(target_nid)
    let tline1 = az.ln.get(target_nid)
    mut tline0 = tline1 - 1
    if tline0 < 0 { tline0 = 0 }
    mut tcol0 = az.nc.get(target_nid) - 1
    if tcol0 < 0 { tcol0 = 0 }
    let fsrc = lsp_read_target_source(source, doc_path, tfile)
    if fsrc != "" {
        tcol0 = lsp_find_node_col0(fsrc, tline1, word)
    }
    let jb = JsonBuf()
    lsp_emit_location_obj(jb, tfile, tline0, tcol0, word.len())
    return jb.finish()
}

pub fn lsp_build_definition_json(source: str, az: Analyzer, doc_path: str, line0: i64, char0: i64) -> str {
    // 0. Check import path / module navigation first
    let imp_target = lsp_resolve_import_at_cursor(source, doc_path, line0, char0)
    if imp_target != "" {
        let jb = JsonBuf()
        lsp_emit_location_obj(jb, imp_target, 0, 0, 0)
        return jb.finish()
    }

    let word = lsp_word_at(source, line0, char0)
    if word == "" { return "null" }

    let line = lsp_get_line_text(source, line0)
    let wpos = lsp_word_start_at(source, line0, char0)
    let line1 = line0 + 1
    mut target_nid = -1

    // 1. self / super navigation
    if word == "self" {
        let ec = lsp_enclosing_class_at(az, doc_path, line1)
        if ec != "" {
            let cid = lsp_find_class_node(az, ec)
            if cid >= 0 { return lsp_location_from_node(source, doc_path, az, cid, ec) }
        }
        return "null"
    }
    if word == "super" {
        let ec = lsp_enclosing_class_at(az, doc_path, line1)
        if ec != "" && az.cls_base_map.has_key(ec) {
            let bc = az.cls_base_map.get(ec)
            let cid = lsp_find_class_node(az, bc)
            if cid >= 0 { return lsp_location_from_node(source, doc_path, az, cid, bc) }
        }
        return "null"
    }

    // 2. Qualified member access: receiver.member / receiver?.member / receiver~>member
    let is_dot = wpos >= 2 && line.byte_at(wpos - 1) == 46
    let is_cascade = wpos >= 3 && line.byte_at(wpos - 1) == 62 && line.byte_at(wpos - 2) == 126
    let is_member_access = is_dot || is_cascade
    if is_member_access {
        mut sep_pos = wpos - 1
        if is_cascade { sep_pos = wpos - 2 }
        let rname = lsp_extract_receiver_before_dot(line, sep_pos)
        if az.enum_idx_map.has_key(rname) {
            let vkey = rname + "::" + word
            if az.enum_var_node.has_key(vkey) {
                target_nid = az.enum_var_node.get(vkey)
                return lsp_location_from_node(source, doc_path, az, target_nid, word)
            }
        }
        let rt = lsp_infer_expr_receiver_type(az, doc_path, line1, rname)
        if rt != "" {
            let fid = lsp_find_class_field_node(az, rt, word)
            if fid >= 0 {
                return lsp_location_from_node(source, doc_path, az, fid, word)
            }
            let sidx = lsp_find_class_method_sidx(az, rt, word)
            if sidx >= 0 {
                return lsp_location_from_node(source, doc_path, az, az.sig_nodes.get(sidx), word)
            }
        }
    }

    // 3. Scope-bounded Local / Parameter / For variable in current function
    if !is_member_access {
        let fbounds = lsp_enclosing_fn_bounds(source, az, doc_path, line1)
        let fstart = fbounds.get(1)
        if fstart > 0 {
            target_nid = lsp_resolve_scoped_var_node(az, doc_path, line1, fstart, word)
            if target_nid >= 0 {
                return lsp_location_from_node(source, doc_path, az, target_nid, word)
            }
        }
    }

    // 4. Implicit self field/method inside enclosing class
    if !is_member_access {
        let ec2 = lsp_enclosing_class_at(az, doc_path, line1)
        if ec2 != "" {
            let fid = lsp_find_class_field_node(az, ec2, word)
            if fid >= 0 { return lsp_location_from_node(source, doc_path, az, fid, word) }
            let sidx = lsp_find_class_method_sidx(az, ec2, word)
            if sidx >= 0 { return lsp_location_from_node(source, doc_path, az, az.sig_nodes.get(sidx), word) }
        }
    }

    // 5. Globals (current file first, then cross-file)
    if !is_member_access {
        mut best_gid = -1
        mut gi = 0
        while gi < az.global_count {
            let gid = az.global_nodes.get(gi)
            if az.sa.get(gid) == word {
                if best_gid < 0 || az.nf.get(gid) == doc_path {
                    best_gid = gid
                    if az.nf.get(gid) == doc_path { break }
                }
            }
            gi = gi + 1
        }
        if best_gid >= 0 {
            return lsp_location_from_node(source, doc_path, az, best_gid, word)
        }
    }

    // 6. Top-level Functions (collect all matches; prefer same-file or return array if multiple)
    if !is_member_access {
        let fn_matches = List<i64>()
        mut same_file_fid = -1
        mut fi = 0
        while fi < az.fn_count {
            let fid = az.fn_nodes.get(fi)
            if az.sa.get(fid) == word {
                fn_matches.push(fid)
                if az.nf.get(fid) == doc_path && same_file_fid < 0 {
                    same_file_fid = fid
                }
            }
            fi = fi + 1
        }
        if fn_matches.len() == 1 {
            return lsp_location_from_node(source, doc_path, az, fn_matches.get(0), word)
        }
        if fn_matches.len() > 1 {
            if same_file_fid >= 0 {
                return lsp_location_from_node(source, doc_path, az, same_file_fid, word)
            }
            let jb = JsonBuf()
            jb.lbrack()
            mut mi = 0
            while mi < fn_matches.len() {
                if mi > 0 { jb.comma() }
                let mnid = fn_matches.get(mi)
                let tfile = az.nf.get(mnid)
                let tline1 = az.ln.get(mnid)
                mut tline0 = tline1 - 1
                if tline0 < 0 { tline0 = 0 }
                let fsrc = lsp_read_target_source(source, doc_path, tfile)
                mut tcol0 = 0
                if fsrc != "" { tcol0 = lsp_find_node_col0(fsrc, tline1, word) }
                lsp_emit_location_obj(jb, tfile, tline0, tcol0, word.len())
                mi = mi + 1
            }
            jb.rbrack()
            return jb.finish()
        }
    }

    // 7. Classes & Structs
    if az.cls_idx_map.has_key(word) {
        let cid = lsp_find_class_node(az, word)
        if cid >= 0 { return lsp_location_from_node(source, doc_path, az, cid, word) }
    }

    // 8. Enums
    if az.enum_idx_map.has_key(word) {
        let eid = lsp_find_enum_node(az, word)
        if eid >= 0 { return lsp_location_from_node(source, doc_path, az, eid, word) }
    }

    // 9. Unqualified Enum variant fallback
    mut ei = 0
    while ei < az.enum_count {
        let eid = az.enum_nodes.get(ei)
        let vc = az.ll.get(eid)
        mut vi = 0
        while vi < vc {
            let vid = az.ch.get(az.ls.get(eid) + vi)
            if az.sa.get(vid) == word {
                return lsp_location_from_node(source, doc_path, az, vid, word)
            }
            vi = vi + 1
        }
        ei = ei + 1
    }

    // 10. Project-wide class field/method fallback (for unresolved receiver types)
    let mem_matches = List<i64>()
    mut ci = 0
    while ci < az.cls_count {
        let cid = az.cls_nodes.get(ci)
        let fg = az.la.get(cid)
        mut j = 0
        while j < az.ll.get(fg) {
            let fid = az.ch.get(az.ls.get(fg) + j)
            if az.sa.get(fid) == word { mem_matches.push(fid) }
            j = j + 1
        }
        let mg = az.ea.get(cid)
        mut m = 0
        while m < az.ll.get(mg) {
            let mid = az.ch.get(az.ls.get(mg) + m)
            if az.sa.get(mid) == word { mem_matches.push(mid) }
            m = m + 1
        }
        ci = ci + 1
    }
    if mem_matches.len() == 1 {
        return lsp_location_from_node(source, doc_path, az, mem_matches.get(0), word)
    }
    if mem_matches.len() > 1 {
        let jb = JsonBuf()
        jb.lbrack()
        mut mi = 0
        while mi < mem_matches.len() && mi < 16 {
            if mi > 0 { jb.comma() }
            let mnid = mem_matches.get(mi)
            let tfile = az.nf.get(mnid)
            let tline1 = az.ln.get(mnid)
            mut tline0 = tline1 - 1
            if tline0 < 0 { tline0 = 0 }
            let fsrc = lsp_read_target_source(source, doc_path, tfile)
            mut tcol0 = 0
            if fsrc != "" { tcol0 = lsp_find_node_col0(fsrc, tline1, word) }
            lsp_emit_location_obj(jb, tfile, tline0, tcol0, word.len())
            mi = mi + 1
        }
        jb.rbrack()
        return jb.finish()
    }

    return "null"
}

fn lsp_extract_named_type_base(t: str) -> str {
    mut cur = btype_norm(t).trim()
    // Unwrap container generics like List<Parser>, Map<str, Token>, etc.
    if cur.starts_with("List<") || cur.starts_with("Set<") || cur.starts_with("Stack<") || cur.starts_with("Queue<") || cur.starts_with("Deque<") {
        let inner = lsp_generic_inner_arg(cur, 0)
        if inner != "" { return lsp_extract_named_type_base(inner) }
    }
    if cur.starts_with("Map<") {
        let val_t = lsp_generic_inner_arg(cur, 1)
        if val_t != "" { return lsp_extract_named_type_base(val_t) }
    }
    let lt = lsp_str_find(cur, "<", 0)
    if lt > 0 { cur = cur.slice(0, lt).trim() }
    return cur
}

pub fn lsp_build_type_definition_json(source: str, az: Analyzer, doc_path: str, line0: i64, char0: i64) -> str {
    let word = lsp_word_at(source, line0, char0)
    if word == "" { return "null" }
    let line = lsp_get_line_text(source, line0)
    let wpos = lsp_word_start_at(source, line0, char0)
    let line1 = line0 + 1

    mut tname = ""
    if wpos >= 2 && line.byte_at(wpos - 1) == 46 {
        let rname = lsp_extract_receiver_before_dot(line, wpos - 1)
        let rt = lsp_infer_expr_receiver_type(az, doc_path, line1, rname)
        if rt != "" {
            let fid = lsp_find_class_field_node(az, rt, word)
            if fid >= 0 {
                tname = btype_norm(az.sb.get(fid))
            } else {
                let sidx = lsp_find_class_method_sidx(az, rt, word)
                if sidx >= 0 { tname = az.sig_rets.get(sidx) }
            }
        }
    } else {
        tname = lsp_infer_expr_receiver_type(az, doc_path, line1, word)
    }

    if tname == "" { return "null" }
    let base = lsp_extract_named_type_base(tname)
    if az.cls_idx_map.has_key(base) {
        let cid = lsp_find_class_node(az, base)
        if cid >= 0 { return lsp_location_from_node(source, doc_path, az, cid, base) }
    }
    if az.enum_idx_map.has_key(base) {
        let eid = lsp_find_enum_node(az, base)
        if eid >= 0 { return lsp_location_from_node(source, doc_path, az, eid, base) }
    }
    return "null"
}

// --- 6. Document Symbols ---

fn emit_symbol_range(jb: JsonBuf, ln1: i64) {
    mut ln0 = ln1 - 1
    if ln0 < 0 { ln0 = 0 }
    jb.lbrace()
    jb.key("start"); jb.lbrace(); jb.kv_int("line", ln0, true); jb.kv_int("character", 0, false); jb.rbrace()
    jb.comma()
    jb.key("end"); jb.lbrace(); jb.kv_int("line", ln0, true); jb.kv_int("character", 80, false); jb.rbrace()
    jb.rbrace()
}

pub fn lsp_build_document_symbols_json(az: Analyzer, doc_path: str) -> str {
    let jb = JsonBuf()
    jb.lbrack()
    mut first = true

    mut ri = 0
    while ri < az.root_count {
        let nid = az.root_decls.get(ri)
        if az.nf.get(nid) != doc_path {
            ri = ri + 1
            continue
        }
        let k = az.nk.get(nid)
        let nm = az.sa.get(nid)
        let ln1 = az.ln.get(nid)

        if k == NK_FN_DEF() || k == NK_CEXTERN() {
            if !first { jb.comma() }
            first = false
            jb.lbrace()
            jb.kv_str("name", nm, true)
            jb.kv_str("detail", lsp_fn_signature_str(az, nid), false)
            jb.kv_int("kind", SKIND_FUNCTION(), false)
            jb.comma(); jb.key("range"); emit_symbol_range(jb, ln1)
            jb.comma(); jb.key("selectionRange"); emit_symbol_range(jb, ln1)
            jb.rbrace()
        } else if k == NK_CLASS_DEF() {
            if !first { jb.comma() }
            first = false
            jb.lbrace()
            jb.kv_str("name", nm, true)
            jb.kv_str("detail", "class", false)
            jb.kv_int("kind", SKIND_CLASS(), false)
            jb.comma(); jb.key("range"); emit_symbol_range(jb, ln1)
            jb.comma(); jb.key("selectionRange"); emit_symbol_range(jb, ln1)
            jb.comma(); jb.key("children"); jb.lbrack()
            mut cfirst = true
            let fg = az.la.get(nid)
            mut fi = 0
            while fi < az.ll.get(fg) {
                let fid = az.ch.get(az.ls.get(fg) + fi)
                if !cfirst { jb.comma() }
                cfirst = false
                jb.lbrace()
                jb.kv_str("name", az.sa.get(fid), true)
                jb.kv_str("detail", btype_norm(az.sb.get(fid)), false)
                jb.kv_int("kind", SKIND_FIELD(), false)
                jb.comma(); jb.key("range"); emit_symbol_range(jb, az.ln.get(fid))
                jb.comma(); jb.key("selectionRange"); emit_symbol_range(jb, az.ln.get(fid))
                jb.rbrace()
                fi = fi + 1
            }
            let cg = az.ra.get(nid)
            mut ci = 0
            while ci < az.ll.get(cg) {
                let cid = az.ch.get(az.ls.get(cg) + ci)
                if !cfirst { jb.comma() }
                cfirst = false
                jb.lbrace()
                jb.kv_str("name", "init", true)
                jb.kv_str("detail", lsp_fn_signature_str(az, cid), false)
                jb.kv_int("kind", SKIND_CTOR(), false)
                jb.comma(); jb.key("range"); emit_symbol_range(jb, az.ln.get(cid))
                jb.comma(); jb.key("selectionRange"); emit_symbol_range(jb, az.ln.get(cid))
                jb.rbrace()
                ci = ci + 1
            }
            let mg = az.ea.get(nid)
            mut mi = 0
            while mi < az.ll.get(mg) {
                let mid = az.ch.get(az.ls.get(mg) + mi)
                if !cfirst { jb.comma() }
                cfirst = false
                jb.lbrace()
                jb.kv_str("name", az.sa.get(mid), true)
                jb.kv_str("detail", lsp_fn_signature_str(az, mid), false)
                jb.kv_int("kind", SKIND_METHOD(), false)
                jb.comma(); jb.key("range"); emit_symbol_range(jb, az.ln.get(mid))
                jb.comma(); jb.key("selectionRange"); emit_symbol_range(jb, az.ln.get(mid))
                jb.rbrace()
                mi = mi + 1
            }
            jb.rbrack()
            jb.rbrace()
        } else if k == NK_ENUM_DEF() {
            if !first { jb.comma() }
            first = false
            jb.lbrace()
            jb.kv_str("name", nm, true)
            jb.kv_str("detail", "enum", false)
            jb.kv_int("kind", SKIND_ENUM(), false)
            jb.comma(); jb.key("range"); emit_symbol_range(jb, ln1)
            jb.comma(); jb.key("selectionRange"); emit_symbol_range(jb, ln1)
            jb.comma(); jb.key("children"); jb.lbrack()
            mut vfirst = true
            let vc = az.ll.get(nid)
            mut vi = 0
            while vi < vc {
                let vid = az.ch.get(az.ls.get(nid) + vi)
                if !vfirst { jb.comma() }
                vfirst = false
                jb.lbrace()
                jb.kv_str("name", az.sa.get(vid), true)
                jb.kv_int("kind", SKIND_ENUM_MEM(), false)
                jb.comma(); jb.key("range"); emit_symbol_range(jb, az.ln.get(vid))
                jb.comma(); jb.key("selectionRange"); emit_symbol_range(jb, az.ln.get(vid))
                jb.rbrace()
                vi = vi + 1
            }
            jb.rbrack()
            jb.rbrace()
        } else if k == NK_VAR_DECL_GLOBAL() {
            if !first { jb.comma() }
            first = false
            jb.lbrace()
            jb.kv_str("name", nm, true)
            jb.kv_str("detail", btype_norm(az.node_types.get(nid)), false)
            jb.kv_int("kind", SKIND_VAR(), false)
            jb.comma(); jb.key("range"); emit_symbol_range(jb, ln1)
            jb.comma(); jb.key("selectionRange"); emit_symbol_range(jb, ln1)
            jb.rbrace()
        }

        ri = ri + 1
    }

    jb.rbrack()
    return jb.finish()
}

// --- 7. Inlay Hints ---

pub fn lsp_build_inlay_hints_json(source: str, az: Analyzer, doc_path: str) -> str {
    let jb = JsonBuf()
    jb.lbrack()
    mut first = true

    mut i = 0
    while i < az.ncount {
        let k = az.nk.get(i)
        if (k == NK_VAR_DECL() || k == NK_VAR_DECL_GLOBAL()) && az.nf.get(i) == doc_path {
            // Only emit inferred type hint when explicit `: Type` was omitted
            if az.sb.get(i) == "" {
                let vnm = az.sa.get(i)
                let vt = btype_norm(az.node_types.get(i))
                let ln1 = az.ln.get(i)
                if vnm != "" && vnm != "_" && vt != "" && vt != "void" && ln1 > 0 {
                    let col0 = lsp_find_node_col0(source, ln1, vnm)
                    if col0 >= 0 {
                        if !first { jb.comma() }
                        first = false
                        jb.lbrace()
                        jb.key("position"); jb.lbrace(); jb.kv_int("line", ln1 - 1, true); jb.kv_int("character", col0 + vnm.len(), false); jb.rbrace()
                        jb.kv_str("label", ": " + vt, false)
                        jb.kv_int("kind", 1, false)
                        jb.kv_bool("paddingLeft", false, false)
                        jb.kv_bool("paddingRight", true, false)
                        jb.rbrace()
                    }
                }
            }
        }
        i = i + 1
    }

    jb.rbrack()
    return jb.finish()
}

// --- 8. CodeLens ---

pub fn lsp_build_code_lens_json(az: Analyzer, doc_path: str) -> str {
    let jb = JsonBuf()
    jb.lbrack()
    mut first = true
    mut fi = 0
    while fi < az.fn_count {
        let fid = az.fn_nodes.get(fi)
        if az.nf.get(fid) == doc_path && az.sa.get(fid) == "main" {
            mut ln0 = az.ln.get(fid) - 1
            if ln0 < 0 { ln0 = 0 }
            if !first { jb.comma() }
            first = false
            jb.lbrace()
            jb.key("range"); jb.lbrace()
            jb.key("start"); jb.lbrace(); jb.kv_int("line", ln0, true); jb.kv_int("character", 0, false); jb.rbrace()
            jb.comma()
            jb.key("end"); jb.lbrace(); jb.kv_int("line", ln0, true); jb.kv_int("character", 0, false); jb.rbrace()
            jb.rbrace()
            jb.comma()
            jb.key("command"); jb.lbrace()
            jb.kv_str("title", "▶ Run", true)
            jb.kv_str("command", "aerix.runFile", false)
            jb.rbrace()
            jb.rbrace()
            jb.comma()
            jb.lbrace()
            jb.key("range"); jb.lbrace()
            jb.key("start"); jb.lbrace(); jb.kv_int("line", ln0, true); jb.kv_int("character", 0, false); jb.rbrace()
            jb.comma()
            jb.key("end"); jb.lbrace(); jb.kv_int("line", ln0, true); jb.kv_int("character", 0, false); jb.rbrace()
            jb.rbrace()
            jb.comma()
            jb.key("command"); jb.lbrace()
            jb.kv_str("title", "✓ Check", true)
            jb.kv_str("command", "aerix.checkFile", false)
            jb.rbrace()
            jb.rbrace()
        }
        fi = fi + 1
    }
    jb.rbrack()
    return jb.finish()
}

// --- 9. Document Formatting ---

pub fn lsp_format_source(source: str) -> str {
    let lines = source.replace("\r\n", "\n").split("\n")
    let n = lines.len()
    let bb = ByteBuffer()
    mut indent = 0
    mut prev_blank = false

    mut i = 0
    while i < n {
        let trimmed = lines.get(i).trim()
        if trimmed == "" {
            if !prev_blank && i + 1 < n {
                bb.write_u8(10)
            }
            prev_blank = true
            i = i + 1
            continue
        }
        prev_blank = false

        if trimmed.starts_with("}") || trimmed.starts_with(")") || trimmed.starts_with("]") {
            if indent > 0 { indent = indent - 1 }
        }

        mut k = 0
        while k < indent {
            bb.write_str("    ")
            k = k + 1
        }
        bb.write_str(trimmed)
        bb.write_u8(10)

        // Count trailing brace delta outside quotes/comments
        mut in_str = false
        mut delta = 0
        let tlen = trimmed.len()
        mut j = 0
        while j < tlen {
            let b = trimmed.byte_at(j)
            if b == 92 && in_str {
                j = j + 2
                continue
            }
            if b == 34 {
                in_str = !in_str
            } else if !in_str {
                if b == 47 && j + 1 < tlen && trimmed.byte_at(j + 1) == 47 {
                    break
                }
                if b == 123 { delta = delta + 1 } else if b == 125 { delta = delta - 1 }
            }
            j = j + 1
        }
        if trimmed.starts_with("}") && delta < 0 {
            delta = delta + 1
        }
        indent = indent + delta
        if indent < 0 { indent = 0 }
        i = i + 1
    }
    let out = bb.to_str()
    bb.free()
    return out
}

pub fn lsp_build_formatting_json(source: str) -> str {
    let formatted = lsp_format_source(source)
    let line_cnt = lsp_count_lines(source)
    let jb = JsonBuf()
    jb.lbrack()
    jb.lbrace()
    jb.key("range")
    jb.lbrace()
    jb.key("start"); jb.lbrace(); jb.kv_int("line", 0, true); jb.kv_int("character", 0, false); jb.rbrace()
    jb.comma()
    jb.key("end"); jb.lbrace(); jb.kv_int("line", line_cnt + 1, true); jb.kv_int("character", 0, false); jb.rbrace()
    jb.rbrace()
    jb.comma()
    jb.kv_str("newText", formatted, true)
    jb.rbrace()
    jb.rbrack()
    return jb.finish()
}

// --- 10. Document Highlight, References, Rename & Folding ---

fn lsp_emit_range_obj(jb: JsonBuf, ln0: i64, start_col0: i64, end_col0: i64) {
    jb.key("range")
    jb.lbrace()
    jb.key("start"); jb.lbrace(); jb.kv_int("line", ln0, true); jb.kv_int("character", start_col0, false); jb.rbrace()
    jb.comma()
    jb.key("end"); jb.lbrace(); jb.kv_int("line", ln0, true); jb.kv_int("character", end_col0, false); jb.rbrace()
    jb.rbrace()
}

fn lsp_is_valid_ident_name(s: str) -> bool {
    if s == "" { return false }
    if lsp_is_keyword(s) { return false }
    let b0 = s.byte_at(0)
    let first_ok = (b0 >= 65 && b0 <= 90) || (b0 >= 97 && b0 <= 122) || b0 == 95
    if !first_ok { return false }
    mut i = 1
    while i < s.len() {
        if !lsp_is_ident_char(s.byte_at(i)) { return false }
        i = i + 1
    }
    return true
}

fn lsp_is_ident_token_at(source: str, line0: i64, char0: i64, word: str) -> bool {
    if word == "" { return false }
    let line = lsp_get_line_text(source, line0)
    if line == "" { return false }
    mut lx = Lexer(line, "<line>")
    lx.recover_mode = true
    let ts = lx.tokenize()
    mut i = 0
    while i < ts.count {
        let k = ts.kinds.get(i)
        if k == TK_IDENT() && ts.vals.get(i) == word {
            let st0 = ts.cols.get(i) - 1
            let ed0 = st0 + ts.lens.get(i)
            if char0 >= st0 && char0 <= ed0 { return true }
        }
        if k == TK_STR() {
            let st0 = ts.cols.get(i) - 1
            let ed0 = st0 + ts.lens.get(i)
            if char0 >= st0 && char0 <= ed0 {
                // Inside string token: only true if inside \{...} interpolation
                let s_sub = line.slice(st0, ed0)
                if lsp_str_find(s_sub, lsp_lbrace(), 0) >= 0 { return true }
            }
        }
        i = i + 1
    }
    return false
}

fn lsp_resolve_symbol_scope(source: str, az: Analyzer, doc_path: str, line0: i64, char0: i64) -> List<i64> {
    // Returns [valid, start_ln1, end_ln1, member_mode, wpos0, wlen]
    let res = List<i64>()
    let word = lsp_word_at(source, line0, char0)
    let wpos = lsp_word_start_at(source, line0, char0)
    if word == "" || wpos < 0 || !lsp_is_valid_ident_name(word) || !lsp_is_ident_token_at(source, line0, char0, word) {
        res.push(0); res.push(1); res.push(1); res.push(0); res.push(0); res.push(0)
        return res
    }
    let line = lsp_get_line_text(source, line0)
    let line1 = line0 + 1
    let is_dot = wpos >= 1 && line.byte_at(wpos - 1) == 46
    let is_cascade = wpos >= 2 && line.byte_at(wpos - 1) == 62 && line.byte_at(wpos - 2) == 126
    mut member_mode = 0
    if is_dot || is_cascade { member_mode = 1 }

    mut start_ln1 = 1
    mut end_ln1 = 1000000
    if member_mode == 0 {
        let fbounds = lsp_enclosing_fn_bounds(source, az, doc_path, line1)
        let fstart = fbounds.get(1)
        if fstart > 0 {
            let lnid = lsp_resolve_scoped_var_node(az, doc_path, line1, fstart, word)
            if lnid >= 0 {
                start_ln1 = fstart
                end_ln1 = fbounds.get(2)
            }
        }
    }
    res.push(1)
    res.push(start_ln1)
    res.push(end_ln1)
    res.push(member_mode)
    res.push(wpos)
    res.push(word.len())
    return res
}

fn lsp_next_sig_tok_kind(ts: TokenStream, idx: i64) -> i64 {
    mut j = idx + 1
    while j < ts.count {
        let k = ts.kinds.get(j)
        if k != TK_NEWLINE() && k != TK_EOF() { return k }
        j = j + 1
    }
    return TK_EOF()
}

fn lsp_scan_interp_ident_matches(source: str, ln1: i64, col1: i64, tlen: i64, word: str, member_mode: i64,
                                 out_lines0: List<i64>, out_cols0: List<i64>, out_writes: List<i64>) {
    let ln0 = ln1 - 1
    let line = lsp_get_line_text(source, ln0)
    if line == "" { return }
    let start_c = col1 - 1
    mut end_c = start_c + tlen
    if start_c < 0 || start_c >= line.len() { return }
    if end_c > line.len() { end_c = line.len() }
    if lsp_str_find(line.slice(start_c, end_c), lsp_lbrace(), 0) < 0 { return }

    mut p = start_c
    while p < end_c {
        let b = line.byte_at(p)
        if b == 92 && p + 1 < end_c { p = p + 2; continue }
        if b == 123 {
            mut q = p + 1
            mut depth = 1
            mut in_q = false
            while q < end_c && depth > 0 {
                let qb = line.byte_at(q)
                if in_q {
                    if qb == 92 && q + 1 < end_c { q = q + 2; continue }
                    if qb == 34 { in_q = false }
                } else {
                    if qb == 34 { in_q = true }
                    else if qb == 123 { depth = depth + 1 }
                    else if qb == 125 { depth = depth - 1; if depth == 0 { break } }
                }
                q = q + 1
            }
            if q > p + 1 && q <= end_c {
                let inner = line.slice(p + 1, q)
                mut ilx = Lexer(inner, "<interp>")
                ilx.recover_mode = true
                let its = ilx.tokenize()
                mut prev_ik = 0
                mut ii = 0
                while ii < its.count {
                    let ik = its.kinds.get(ii)
                    if ik != TK_NEWLINE() && ik != TK_EOF() {
                        if ik == TK_IDENT() && its.vals.get(ii) == word {
                            let is_dot = (prev_ik == TK_DOT() || prev_ik == TK_QDOT() || prev_ik == TK_CASCADE())
                            mut ok = false
                            if member_mode == 0 && !is_dot { ok = true }
                            else if member_mode == 1 && is_dot { ok = true }
                            if ok {
                                out_lines0.push(ln0)
                                out_cols0.push((p + 1) + (its.cols.get(ii) - 1))
                                out_writes.push(0)
                            }
                        }
                        prev_ik = ik
                    }
                    ii = ii + 1
                }
                p = q + 1
                continue
            }
        }
        p = p + 1
    }
}

fn lsp_collect_ident_occurrences(source: str, word: str, start_ln1: i64, end_ln1: i64, member_mode: i64,
                                 out_lines0: List<i64>, out_cols0: List<i64>, out_writes: List<i64>) {
    if source == "" || word == "" { return }
    mut lx = Lexer(source, "<occ>")
    lx.recover_mode = true
    let ts = lx.tokenize()
    mut prev_sig = 0
    mut i = 0
    while i < ts.count {
        let k = ts.kinds.get(i)
        if k == TK_EOF() { break }
        if k == TK_NEWLINE() { i = i + 1; continue }
        let ln1 = ts.lines.get(i)
        let col1 = ts.cols.get(i)
        let tlen = ts.lens.get(i)
        if ln1 >= start_ln1 && ln1 <= end_ln1 {
            if k == TK_STR() {
                lsp_scan_interp_ident_matches(source, ln1, col1, tlen, word, member_mode, out_lines0, out_cols0, out_writes)
            } else if k == TK_IDENT() && ts.vals.get(i) == word {
                let is_dot_prev = (prev_sig == TK_DOT() || prev_sig == TK_QDOT() || prev_sig == TK_CASCADE())
                let next_sig = lsp_next_sig_tok_kind(ts, i)
                let is_decl_ctx = (prev_sig == TK_LET() || prev_sig == TK_MUT() || prev_sig == TK_CONST() || prev_sig == TK_FOR() || prev_sig == TK_FN() || prev_sig == TK_CLASS() || prev_sig == TK_STRUCT() || prev_sig == TK_ENUM() || prev_sig == TK_TRAIT() || prev_sig == TK_TYPE())
                mut ok = false
                if member_mode == 0 {
                    if !is_dot_prev { ok = true }
                } else {
                    if is_dot_prev || is_decl_ctx || next_sig == TK_COLON() { ok = true }
                }
                if ok {
                    mut is_write = 0
                    if is_decl_ctx || next_sig == TK_COLON() || (next_sig >= 101 && next_sig <= 106) {
                        is_write = 1
                    }
                    out_lines0.push(ln1 - 1)
                    out_cols0.push(col1 - 1)
                    out_writes.push(is_write)
                }
            }
        }
        prev_sig = k
        i = i + 1
    }
}

pub fn lsp_build_document_highlight_json(source: str, az: Analyzer, doc_path: str, line0: i64, char0: i64) -> str {
    let sc = lsp_resolve_symbol_scope(source, az, doc_path, line0, char0)
    if sc.get(0) == 0 { return "[]" }
    let word = lsp_word_at(source, line0, char0)
    let wlen = sc.get(5)
    let lines0 = List<i64>()
    let cols0 = List<i64>()
    let writes = List<i64>()
    lsp_collect_ident_occurrences(source, word, sc.get(1), sc.get(2), sc.get(3), lines0, cols0, writes)

    let jb = JsonBuf()
    jb.lbrack()
    mut i = 0
    while i < lines0.len() {
        if i > 0 { jb.comma() }
        jb.lbrace()
        let c0 = cols0.get(i)
        lsp_emit_range_obj(jb, lines0.get(i), c0, c0 + wlen)
        mut hkind = 2
        if writes.get(i) == 1 { hkind = 3 }
        jb.kv_int("kind", hkind, false)
        jb.rbrace()
        i = i + 1
    }
    jb.rbrack()
    return jb.finish()
}

pub fn lsp_build_references_json(source: str, az: Analyzer, doc_path: str, line0: i64, char0: i64,
                                   include_decl: bool, path_docs: Map<str, str>) -> str {
    let sc = lsp_resolve_symbol_scope(source, az, doc_path, line0, char0)
    if sc.get(0) == 0 { return "[]" }
    let word = lsp_word_at(source, line0, char0)
    let start_ln1 = sc.get(1)
    let end_ln1 = sc.get(2)
    let member_mode = sc.get(3)
    let wlen = sc.get(5)

    let jb = JsonBuf()
    jb.lbrack()
    mut first = true

    // Current document
    let lines0 = List<i64>()
    let cols0 = List<i64>()
    let writes = List<i64>()
    lsp_collect_ident_occurrences(source, word, start_ln1, end_ln1, member_mode, lines0, cols0, writes)
    mut i = 0
    while i < lines0.len() {
        if include_decl || writes.get(i) == 0 {
            if !first { jb.comma() }
            first = false
            lsp_emit_location_obj(jb, doc_path, lines0.get(i), cols0.get(i), wlen)
        }
        i = i + 1
    }

    // Other open workspace files if top-level/member symbol
    if start_ln1 == 1 && end_ln1 == 1000000 {
        let pkeys = path_docs.keys()
        mut pi = 0
        while pi < pkeys.len() {
            let ppath = pkeys.get(pi)
            if ppath != doc_path {
                let psrc = path_docs.get(ppath)
                let plines0 = List<i64>()
                let pcols0 = List<i64>()
                let pwrites = List<i64>()
                lsp_collect_ident_occurrences(psrc, word, 1, 1000000, member_mode, plines0, pcols0, pwrites)
                mut pj = 0
                while pj < plines0.len() {
                    if include_decl || pwrites.get(pj) == 0 {
                        if !first { jb.comma() }
                        first = false
                        lsp_emit_location_obj(jb, ppath, plines0.get(pj), pcols0.get(pj), wlen)
                    }
                    pj = pj + 1
                }
            }
            pi = pi + 1
        }
    }

    jb.rbrack()
    return jb.finish()
}

pub fn lsp_build_prepare_rename_json(source: str, az: Analyzer, doc_path: str, line0: i64, char0: i64) -> str {
    let sc = lsp_resolve_symbol_scope(source, az, doc_path, line0, char0)
    if sc.get(0) == 0 { return "null" }
    let word = lsp_word_at(source, line0, char0)
    if lsp_is_primitive_type(word) || lsp_is_container_type(word) || lsp_is_static_runtime(word) || lsp_is_builtin_fn(word) {
        if sc.get(1) == 1 && sc.get(2) == 1000000 && sc.get(3) == 0 {
            return "null"
        }
    }
    let wpos = sc.get(4)
    let wlen = sc.get(5)
    let jb = JsonBuf()
    jb.lbrace()
    lsp_emit_range_obj(jb, line0, wpos, wpos + wlen)
    jb.kv_str("placeholder", word, false)
    jb.rbrace()
    return jb.finish()
}

pub fn lsp_build_rename_json(source: str, az: Analyzer, doc_path: str, line0: i64, char0: i64,
                               new_name: str, path_docs: Map<str, str>) -> str {
    if !lsp_is_valid_ident_name(new_name) { return "null" }
    let sc = lsp_resolve_symbol_scope(source, az, doc_path, line0, char0)
    if sc.get(0) == 0 { return "null" }
    let word = lsp_word_at(source, line0, char0)
    let start_ln1 = sc.get(1)
    let end_ln1 = sc.get(2)
    let member_mode = sc.get(3)
    let wlen = sc.get(5)

    let jb = JsonBuf()
    jb.lbrace()
    jb.key("changes")
    jb.lbrace()
    mut first_file = true

    // Current document edits
    let lines0 = List<i64>()
    let cols0 = List<i64>()
    let writes = List<i64>()
    lsp_collect_ident_occurrences(source, word, start_ln1, end_ln1, member_mode, lines0, cols0, writes)
    if lines0.len() > 0 {
        first_file = false
        jb.key(lsp_path_to_uri(doc_path))
        jb.lbrack()
        mut i = 0
        while i < lines0.len() {
            if i > 0 { jb.comma() }
            jb.lbrace()
            let c0 = cols0.get(i)
            lsp_emit_range_obj(jb, lines0.get(i), c0, c0 + wlen)
            jb.kv_str("newText", new_name, false)
            jb.rbrace()
            i = i + 1
        }
        jb.rbrack()
    }

    // Other open workspace files if top-level/member symbol
    if start_ln1 == 1 && end_ln1 == 1000000 {
        let pkeys = path_docs.keys()
        mut pi = 0
        while pi < pkeys.len() {
            let ppath = pkeys.get(pi)
            if ppath != doc_path {
                let psrc = path_docs.get(ppath)
                let plines0 = List<i64>()
                let pcols0 = List<i64>()
                let pwrites = List<i64>()
                lsp_collect_ident_occurrences(psrc, word, 1, 1000000, member_mode, plines0, pcols0, pwrites)
                if plines0.len() > 0 {
                    if !first_file { jb.comma() }
                    first_file = false
                    jb.key(lsp_path_to_uri(ppath))
                    jb.lbrack()
                    mut pj = 0
                    while pj < plines0.len() {
                        if pj > 0 { jb.comma() }
                        jb.lbrace()
                        let pc0 = pcols0.get(pj)
                        lsp_emit_range_obj(jb, plines0.get(pj), pc0, pc0 + wlen)
                        jb.kv_str("newText", new_name, false)
                        jb.rbrace()
                        pj = pj + 1
                    }
                    jb.rbrack()
                }
            }
            pi = pi + 1
        }
    }

    jb.rbrace()
    jb.rbrace()
    return jb.finish()
}

fn lsp_emit_folding_range(jb: JsonBuf, start_ln0: i64, end_ln0: i64, kind: str, first: bool) -> bool {
    if end_ln0 <= start_ln0 { return first }
    if !first { jb.comma() }
    jb.lbrace()
    jb.kv_int("startLine", start_ln0, true)
    jb.kv_int("endLine", end_ln0, false)
    if kind != "" { jb.kv_str("kind", kind, false) }
    jb.rbrace()
    return false
}

pub fn lsp_build_folding_range_json(source: str) -> str {
    let jb = JsonBuf()
    jb.lbrack()
    mut first = true

    // 1. Brace blocks from Lexer tokens (never tricked by strings/comments)
    mut lx = Lexer(source, "<fold>")
    lx.recover_mode = true
    let ts = lx.tokenize()
    let brace_stack = List<i64>()
    mut i = 0
    while i < ts.count {
        let k = ts.kinds.get(i)
        if k == TK_EOF() { break }
        let ln0 = ts.lines.get(i) - 1
        if k == TK_LBRACE() {
            brace_stack.push(ln0)
        } else if k == TK_RBRACE() {
            if brace_stack.len() > 0 {
                let st0 = brace_stack.pop()
                if ln0 > st0 {
                    first = lsp_emit_folding_range(jb, st0, ln0 - 1, "", first)
                }
            }
        }
        i = i + 1
    }

    // 2. Contiguous imports, block comments, line comment runs, and #region blocks
    let lines = source.replace("\r\n", "\n").split("\n")
    let line_cnt = lines.len()
    let region_stack = List<i64>()
    mut imp_start0 = -1
    mut imp_last0 = -1
    mut cmt_start0 = -1
    mut cmt_last0 = -1
    mut in_block_cmt = false
    mut block_cmt_start0 = -1

    mut ln0 = 0
    while ln0 < line_cnt {
        let line_txt = lines.get(ln0).trim()
        if in_block_cmt {
            if lsp_str_find(line_txt, "*/", 0) >= 0 {
                first = lsp_emit_folding_range(jb, block_cmt_start0, ln0, "comment", first)
                in_block_cmt = false
            }
            ln0 = ln0 + 1
            continue
        }
        if line_txt.starts_with("import ") || line_txt.starts_with("use ") {
            if imp_start0 < 0 || ln0 > imp_last0 + 1 {
                if imp_start0 >= 0 && imp_last0 > imp_start0 {
                    first = lsp_emit_folding_range(jb, imp_start0, imp_last0, "imports", first)
                }
                imp_start0 = ln0
            }
            imp_last0 = ln0
        }
        if line_txt.starts_with("// region") || line_txt.starts_with("// #region") || line_txt.starts_with("//#region") {
            region_stack.push(ln0)
        } else if line_txt.starts_with("// endregion") || line_txt.starts_with("// #endregion") || line_txt.starts_with("//#endregion") {
            if region_stack.len() > 0 {
                let rs0 = region_stack.pop()
                first = lsp_emit_folding_range(jb, rs0, ln0, "region", first)
            }
        } else if line_txt.starts_with("/*") {
            if lsp_str_find(line_txt, "*/", 2) < 0 {
                in_block_cmt = true
                block_cmt_start0 = ln0
            }
        } else if line_txt.starts_with("//") {
            if cmt_start0 < 0 || ln0 > cmt_last0 + 1 {
                if cmt_start0 >= 0 && cmt_last0 > cmt_start0 {
                    first = lsp_emit_folding_range(jb, cmt_start0, cmt_last0, "comment", first)
                }
                cmt_start0 = ln0
            }
            cmt_last0 = ln0
        }
        ln0 = ln0 + 1
    }
    if imp_start0 >= 0 && imp_last0 > imp_start0 {
        first = lsp_emit_folding_range(jb, imp_start0, imp_last0, "imports", first)
    }
    if cmt_start0 >= 0 && cmt_last0 > cmt_start0 {
        first = lsp_emit_folding_range(jb, cmt_start0, cmt_last0, "comment", first)
    }

    jb.rbrack()
    return jb.finish()
}
