// Aerix Native LSP — Builtin Documentation, URI Helpers, & Language Catalog

import "./json.arx"

pub fn lsp_hex_upper(v: i64) -> i64 {
    if v < 10 { return 48 + v }
    return 65 + (v - 10)
}

pub fn lsp_hex_val(b: i64) -> i64 {
    if b >= 48 && b <= 57 { return b - 48 }
    if b >= 65 && b <= 70 { return b - 55 }
    if b >= 97 && b <= 102 { return b - 87 }
    return -1
}

pub fn lsp_uri_to_path(uri: str) -> str {
    mut raw = uri
    if raw.starts_with("file:///") {
        raw = raw.slice(8, raw.len())
        if raw.len() >= 2 {
            // Check Windows drive letter like C:/ vs POSIX path
            let is_win_drive = raw.len() >= 3 && raw.byte_at(1) == 58
            let is_enc_drive = raw.len() >= 5 && raw.byte_at(1) == 37 && raw.byte_at(2) == 51 && (raw.byte_at(3) == 65 || raw.byte_at(3) == 97)
            if !is_win_drive && !is_enc_drive {
                raw = "/" + raw
            }
        }
    } else if raw.starts_with("file://") {
        raw = raw.slice(7, raw.len())
    }

    let bb = ByteBuffer()
    let n = raw.len()
    mut i = 0
    while i < n {
        let b = raw.byte_at(i)
        if b == 37 && i + 2 < n {
            let h0 = lsp_hex_val(raw.byte_at(i + 1))
            let h1 = lsp_hex_val(raw.byte_at(i + 2))
            if h0 >= 0 && h1 >= 0 {
                bb.write_u8(h0 * 16 + h1)
                i = i + 3
                continue
            }
        }
        bb.write_u8(b)
        i = i + 1
    }
    let decoded = bb.to_str()
    bb.free()
    return decoded.replace("\\", "/")
}

pub fn lsp_path_to_uri(path: str) -> str {
    let norm = path.replace("\\", "/")
    let bb = ByteBuffer()
    bb.write_str("file://")
    if !norm.starts_with("/") {
        bb.write_u8(47)
    }
    let n = norm.len()
    mut i = 0
    while i < n {
        let b = norm.byte_at(i)
        if b == 32 {
            bb.write_str("%20")
        } else if b == 58 && i == 1 {
            bb.write_str("%3A")
        } else {
            bb.write_u8(b)
        }
        i = i + 1
    }
    let out = bb.to_str()
    bb.free()
    return out
}

pub fn lsp_str_find(s: str, sub: str, start: i64 = 0) -> i64 {
    let n = s.len()
    let m = sub.len()
    if m == 0 { return start }
    if m > n { return -1 }
    mut i = start
    if i < 0 { i = 0 }
    while i <= n - m {
        mut match_ok = true
        mut j = 0
        while j < m {
            if s.byte_at(i + j) != sub.byte_at(j) {
                match_ok = false
                break
            }
            j = j + 1
        }
        if match_ok { return i }
        i = i + 1
    }
    return -1
}

pub fn lsp_is_ident_char(b: i64) -> bool {
    if b >= 65 && b <= 90 { return true }
    if b >= 97 && b <= 122 { return true }
    if b >= 48 && b <= 57 { return true }
    return b == 95
}

pub fn lsp_is_keyword(w: str) -> bool {
    return w == "fn" || w == "let" || w == "mut" || w == "const" || w == "class" || w == "struct" ||
           w == "enum" || w == "trait" || w == "type" || w == "init" || w == "drop" || w == "if" ||
           w == "else" || w == "elif" || w == "match" || w == "for" || w == "in" || w == "while" ||
           w == "loop" || w == "break" || w == "continue" || w == "return" || w == "spawn" ||
           w == "try" || w == "catch" || w == "finally" || w == "throw" || w == "self" || w == "super" ||
           w == "pub" || w == "priv" || w == "prot" || w == "static" || w == "virtual" || w == "override" ||
           w == "abstract" || w == "new" || w == "delete" || w == "extends" || w == "implements" ||
           w == "prop" || w == "op" || w == "extend" || w == "guard" || w == "defer" || w == "unsafe" ||
           w == "sizeof" || w == "as" || w == "use" || w == "import" || w == "from" || w == "cinclude" ||
           w == "cextern" || w == "true" || w == "false" || w == "null" || w == "get" || w == "set"
}

pub fn lsp_is_primitive_type(w: str) -> bool {
    return w == "i8" || w == "i16" || w == "i32" || w == "i64" || w == "int" ||
           w == "u8" || w == "u16" || w == "u32" || w == "u64" || w == "uint" ||
           w == "usize" || w == "isize" || w == "f32" || w == "f64" || w == "float" ||
           w == "f32x4" || w == "f64x2" || w == "bool" || w == "char" || w == "str" || w == "void"
}

pub fn lsp_is_container_type(w: str) -> bool {
    return w == "List" || w == "Map" || w == "Set" || w == "Stack" || w == "Queue" ||
           w == "Deque" || w == "ByteBuffer" || w == "String" || w == "Channel" || w == "LinearArena"
}

pub fn lsp_is_static_runtime(w: str) -> bool {
    return w == "File" || w == "Directory" || w == "Env" || w == "Process" || w == "Math" || w == "Random"
}

pub fn lsp_is_builtin_fn(w: str) -> bool {
    return w == "println" || w == "print" || w == "eprintln" || w == "input" || w == "read_line" ||
           w == "to_string" || w == "chr" || w == "ord" || w == "len" || w == "parse_int" ||
           w == "parse_float" || w == "panic" || w == "abort" || w == "exit" || w == "assert" ||
           w == "assert_eq" || w == "typeof" || w == "sqrt" || w == "sin" || w == "cos" || w == "tan" ||
           w == "pow" || w == "floor" || w == "ceil" || w == "round" || w == "log" || w == "exp" ||
           w == "abs" || w == "min" || w == "max" || w == "enumerate" || w == "arx_free" ||
           w == "arx_channel_new" || w == "arx_channel_send" || w == "arx_channel_recv" ||
           w == "arx_channel_close" || w == "arx_channel_free" || w == "arx_thread_join" ||
           w == "arx_sleep_ms" || w == "arx_time_now" || w == "arx_prng_seed" ||
           w == "arx_prng_next_i64" || w == "arx_prng_next_f64"
}

pub fn lsp_keyword_list() -> List<str> {
    let ks = List<str>()
    ks.push("fn"); ks.push("let"); ks.push("mut"); ks.push("const")
    ks.push("class"); ks.push("struct"); ks.push("enum"); ks.push("trait")
    ks.push("init"); ks.push("drop"); ks.push("prop"); ks.push("op"); ks.push("extend")
    ks.push("if"); ks.push("else"); ks.push("elif"); ks.push("match")
    ks.push("for"); ks.push("in"); ks.push("while"); ks.push("loop")
    ks.push("break"); ks.push("continue"); ks.push("return")
    ks.push("guard"); ks.push("defer"); ks.push("spawn")
    ks.push("try"); ks.push("catch"); ks.push("finally"); ks.push("throw")
    ks.push("pub"); ks.push("priv"); ks.push("prot"); ks.push("static")
    ks.push("virtual"); ks.push("override"); ks.push("abstract")
    ks.push("extends"); ks.push("implements"); ks.push("self"); ks.push("super")
    ks.push("new"); ks.push("as"); ks.push("sizeof"); ks.push("unsafe")
    ks.push("import"); ks.push("from"); ks.push("use")
    ks.push("cinclude"); ks.push("cextern")
    ks.push("true"); ks.push("false"); ks.push("null")
    return ks
}

pub fn lsp_type_list() -> List<str> {
    let ts = List<str>()
    ts.push("i8"); ts.push("i16"); ts.push("i32"); ts.push("i64"); ts.push("int")
    ts.push("u8"); ts.push("u16"); ts.push("u32"); ts.push("u64"); ts.push("uint")
    ts.push("usize"); ts.push("isize")
    ts.push("f32"); ts.push("f64"); ts.push("float"); ts.push("f32x4"); ts.push("f64x2")
    ts.push("bool"); ts.push("char"); ts.push("str"); ts.push("void")
    ts.push("List"); ts.push("Map"); ts.push("Set"); ts.push("Stack"); ts.push("Queue"); ts.push("Deque")
    ts.push("ByteBuffer"); ts.push("String"); ts.push("Channel"); ts.push("LinearArena")
    ts.push("File"); ts.push("Directory"); ts.push("Env"); ts.push("Process"); ts.push("Math"); ts.push("Random")
    return ts
}

pub fn lsp_builtin_fn_list() -> List<str> {
    let bs = List<str>()
    bs.push("println"); bs.push("print"); bs.push("eprintln")
    bs.push("input"); bs.push("read_line"); bs.push("to_string")
    bs.push("parse_int"); bs.push("parse_float"); bs.push("chr"); bs.push("ord"); bs.push("len")
    bs.push("abs"); bs.push("min"); bs.push("max")
    bs.push("sqrt"); bs.push("sin"); bs.push("cos"); bs.push("tan")
    bs.push("pow"); bs.push("floor"); bs.push("ceil"); bs.push("round"); bs.push("log"); bs.push("exp")
    bs.push("assert"); bs.push("assert_eq"); bs.push("panic"); bs.push("abort"); bs.push("exit")
    bs.push("typeof"); bs.push("enumerate"); bs.push("arx_free")
