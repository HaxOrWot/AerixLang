    ks.push("guard"); ks.push("defer"); ks.push("spawn")
    ks.push("try"); ks.push("catch"); ks.push("finally"); ks.push("throw")
    ks.push("pub"); ks.push("priv"); ks.push("prot"); ks.push("static")
    ks.push("virtual"); ks.push("override"); ks.push("abstract")
    ks.push("extends"); ks.push("implements"); ks.push("self"); ks.push("super")
