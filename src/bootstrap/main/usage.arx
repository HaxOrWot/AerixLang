import "./mod.arx"

fn resolve_bin_name() -> str {
    let a0 = bpath_normalize(Env.arg(0))
    if a0.ends_with("arxc.exe") || a0.ends_with("arxc") {
        return "arxc"
    }
    return "arx"
}

fn print_usage() {
    let bin = resolve_bin_name()
    println("Aerix Native Systems Programming Language Toolchain (" + bin + ")")
    println("Version: 3.0.0-rc.1 (Release Candidate 1) - x86_64-windows")
    println("")
    println("Usage:")
    println("  " + bin + " <command> [arguments...] [options]")
    println("  " + bin + " <file.arx> [-o <out>]          (Shorthand build)")
    println("")
    println("Core Commands:")
    println("  build        Compile an Aerix program into a standalone native binary")
    println("  run          Compile and immediately execute an Aerix program")
    println("  emit-c       Transpile Aerix source code into standalone ANSI C99")
    println("  check        Parse, validate, and type-check without code generation")
    println("  fmt          Format Aerix source files in-place or check formatting")
    println("  test         Discover and execute unit and integration test suites")
    println("")
    println("Developer & IDE Tooling:")
    println("  lsp          Start the Language Server Protocol (LSP) JSON-RPC daemon")
    println("  doc          Generate static HTML API documentation from doc-comments")
    println("  repl         Start the interactive Aerix REPL shell")
    println("")
    println("Version & Toolchain Management:")
    println("  vm           Manage multiple compiler toolchains and release channels")
    println("  install      Download & install a toolchain version (alias: " + bin + " vm install)")
    println("  use          Switch active toolchain version (alias: " + bin + " vm use)")
    println("  versions     List installed toolchains (alias: " + bin + " vm list)")
    println("  current      Show active toolchain version info (alias: " + bin + " vm status)")
    println("  update       Check for and install updates from GitHub (alias: " + bin + " upgrade)")
    println("")
    println("Package Management:")
    println("  pkg          Community package manager & capability security scanner")
    println("  add          Audit and install a package (alias: " + bin + " pkg install)")
    println("")
    println("Information & Help:")
    println("  version      Show compiler version and release channel")
    println("  help         Show general help or help for a specific command")
    println("")
    println("Run '" + bin + " <command> --help' or '" + bin + " help <command>' for detailed command options.")
}

fn print_build_usage() {
    let bin = resolve_bin_name()
    println("Aerix Build Driver (" + bin + " build)")
    println("Compiles Aerix source files (.arx) into standalone native executables.")
    println("")
    println("Usage:")
    println("  " + bin + " build <file.arx> [-o <out>] [options]")
    println("")
    println("Options:")
    println("  -o, --output <path>    Specify output executable name or destination path")
    println("                         (defaults to input filename with .exe on Windows)")
    println("  --backend=native|c     Code generation backend (default: native; zero GCC)")
    println("  --c, --backend=c       Compile using C99/GCC transpiler pipeline")
    println("  -v, --verbose          Print verbose backend status and diagnostics")
    println("  --debug                Build with debug symbols (-g) and runtime safety bounds")
    println("  --release              Build with -O3 -flto -s for production performance")
    println("  -O0, -O1, -O2, -O3     Optimization level (default: -O2)")
    println("  --gui, --windows       Target Windows GUI subsystem (no console window);")
    println("  --no-console           automatically enabled when Window.Gui module is imported")
    println("  --emit-c               Keep intermediate generated C99 source file")
    println("  -h, --help             Show this help message")
    println("")
    println("Examples:")
    println("  " + bin + " build main.arx")
    println("  " + bin + " build main.arx -o app.exe")
    println("  " + bin + " build main.arx --release -o app.exe")
    println("  " + bin + " build main.arx --c")
    println("  " + bin + " build SnakeGame.arx -o SnakeGame.exe")
    println("  " + bin + " build app.arx --gui -o app.exe")
    println("  " + bin + " build benchmark.arx -O3 --emit-c")
}

fn print_run_usage() {
    let bin = resolve_bin_name()
    println("Aerix Execution Runner (" + bin + " run)")
    println("Compiles and immediately executes an Aerix program in a fast temporary build pipeline.")
    println("")
    println("Usage:")
    println("  " + bin + " run <file.arx> [options] [-- <program-args...>]")
    println("")
    println("Options:")
    println("  --backend=native|c     Code generation backend (default: native; zero GCC)")
    println("  --c, --backend=c       Run using C99/GCC transpiler pipeline")
    println("  -v, --verbose          Print verbose backend status and diagnostics")
    println("  --debug                Run with debug symbols and bounds checks enabled")
    println("  --release              Run with full optimization (-O3 -flto)")
    println("  -O0, -O1, -O2, -O3     Optimization level for JIT/run (default: -O2)")
    println("  -- <args...>           Pass all arguments after '--' directly to program via Env.args()")
    println("  -h, --help             Show this help message")
    println("")
    println("Examples:")
    println("  " + bin + " run hello.arx")
    println("  " + bin + " run hello.arx --native")
    println("  " + bin + " run server.arx -- -p 8080 --debug")
    println("  " + bin + " run script.arx -- foo bar baz")
}

fn print_fmt_usage() {
    let bin = resolve_bin_name()
    println("Aerix Source Code Formatter (" + bin + " fmt)")
    println("Enforces canonical code formatting across files and directories.")
    println("")
    println("Usage:")
    println("  " + bin + " fmt [target] [options]")
    println("")
    println("Arguments:")
    println("  [target]               File or directory to format (default: current directory)")
    println("")
    println("Options:")
    println("  -c, --check            Check formatting without rewriting files (exit 1 if unformatted)")
    println("  -h, --help             Show this help message")
    println("")
    println("Examples:")
    println("  " + bin + " fmt main.arx")
    println("  " + bin + " fmt src/")
    println("  " + bin + " fmt --check src/")
}

fn print_test_usage() {
    let bin = resolve_bin_name()
    println("Aerix Test Runner (" + bin + " test)")
    println("Discovers and runs test suites matching 'test_*.arx' or '*_test.arx'.")
    println("")
    println("Usage:")
    println("  " + bin + " test [target] [options]")
    println("")
    println("Arguments:")
    println("  [target]               File or directory containing tests (default: current directory)")
    println("")
    println("Options:")
    println("  --backend=native|c     Code generation backend (default: native; zero GCC)")
    println("  --c, --backend=c       Run tests with C99/GCC transpiler pipeline")
    println("  -v, --verbose          Print verbose test execution status")
    println("  -O0, -O1, -O2, -O3     Optimization level for test builds (default: -O0)")
    println("  --debug                Compile tests with debug symbols and runtime bounds checks")
    println("  -h, --help             Show this help message")
    println("")
    println("Examples:")
    println("  " + bin + " test")
    println("  " + bin + " test --native")
    println("  " + bin + " test tests/ --native")
    println("  " + bin + " test test_math.arx")
}

fn print_emit_c_usage() {
    let bin = resolve_bin_name()
    println("Aerix C99 Transpiler (" + bin + " emit-c)")
    println("Transpiles Aerix source code into clean, standalone ANSI C99 code without linking.")
    println("")
    println("Usage:")
    println("  " + bin + " emit-c <file.arx> [-o <out.c>]")
    println("")
    println("Options:")
    println("  -o, --output <path>    Output C file path (defaults to <file>.c or stdout)")
    println("  -h, --help             Show this help message")
    println("")
    println("Examples:")
    println("  " + bin + " emit-c main.arx -o main.c")
    println("  " + bin + " emit-c src/bootstrap/main.arx -o src/bootstrap/seed/arxc.c")
}

