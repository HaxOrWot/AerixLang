fn print_vm_usage() {
    let bin = resolve_bin_name()
    println("Aerix Version Manager (alias: " + bin + " toolchain)")
    println("Install, cache, and switch between Aerix versions (starting from v1.1.3b)")
    println("")
    println("Usage:")
    println("  " + bin + " vm [status]                  Show active version and toolchain store info")
    println("  " + bin + " vm list | ls                 List locally installed/cached versions")
    println("  " + bin + " vm list-remote [--all]       List available GitHub releases (>= 1.1.3b)")
    println("      [--beta|--pre|--stable]      Filter remote list by release channel")
    println("  " + bin + " vm install <ver|channel>     Download & install version (or latest/beta/pre/stable)")
    println("      [--no-use] [--force] [--all] [--no-ide]")
    println("  " + bin + " vm use <ver|channel>         Switch active toolchain (instant offline if cached)")
    println("  " + bin + " vm remove <ver> [--force]    Delete a cached toolchain version")
    println("  " + bin + " vm sync                      Snapshot current active toolchain into local cache")
    println("  " + bin + " install <ver>                Shorthand for '" + bin + " vm install <ver>'")
    println("  " + bin + " use <ver>                    Shorthand for '" + bin + " vm use <ver>'")
    println("  " + bin + " versions                     Shorthand for '" + bin + " vm list'")
    println("  " + bin + " current                      Shorthand for '" + bin + " vm status'")
}

fn print_update_usage() {
    let bin = resolve_bin_name()
    println("Aerix Toolchain Updater (alias: " + bin + " upgrade)")
    println("Usage:")
    println("  " + bin + " update [options]")
    println("  " + bin + " upgrade [options]")
    println("")
    println("Options:")
    println("  -c, --check     Check GitHub for the latest stable release without installing")
    println("      --status    Alias for --check (shows installed version, last check & status)")
    println("  -f, --force     Reinstall the latest stable release even if already up to date")
    println("  -v, --verbose   Show release notes from the latest stable release")
    println("      --notes     Alias for --verbose")
    println("      --no-ide    Skip refreshing VS Code / Antigravity extension packages")
    println("  -h, --help      Show this help message")
}

