// Aerix LLVM IR Backend — Pipeline Entry Point
// Orchestrates the full LLVM IR emission process.

import "./mod.arx"
import "../../middle/paths.arx"


extend LLVMEmitter {

    // Drive the full LLVM IR emission in order:
    // 1. Module header + target triple
    // 2. Runtime function declarations
    // 3. Struct type definitions
    // 4. Global variable declarations
    // 5. String constants (collected lazily, flushed at start)
    // 6. All function bodies
    pub fn emit_llvm() -> str {
        // We do a two-pass approach:
        // Pass 1: collect string constants (emit bodies to a temp buffer)
        // Pass 2: assemble final output
        // For simplicity, do single pass and emit strings first from a pre-scan.

        // 1. Emit module header
        self.wl("; Aerix LLVM IR — generated by arxc v3.4.0-beta.1")
        self.wl("target triple = \"x86_64-w64-windows-gnu\"")
        self.wl("target datalayout = \"e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128\"")
        self.wln()

        // 2. Runtime declarations
        self.ll_emit_runtime_decls()

        // 3. Emit all functions (this also collects string constants into self.str_consts)
        // We need to buffer function output, then prepend strings.
        // Use a second buffer trick: emit bodies to a temp ByteBuffer.
        let saved_out = self.out
        self.out = ByteBuffer()
        self.ll_emit_all()
        let fn_text = self.out.to_str()
        self.out.free()
        self.out = saved_out

        // 4. Flush collected string constants
        mut si = 0
        while si < self.str_consts.len() {
            self.wl(self.str_consts.get(si))
            si = si + 1
        }
        if self.str_consts.len() > 0 { self.wln() }

        // 5. Append function bodies
        self.w(fn_text)

        let result = self.out.to_str()
        self.out.free()
        return result
    }

    // Emit all extern declarations for runtime functions used by codegen.
    priv fn ll_emit_runtime_decls() {
        self.wl("; === Runtime Function Declarations ===")
        // Memory
        self.wl("declare ptr @arx_alloc(i64)")
        self.wl("declare void @arx_free(ptr)")
        // TLS Arena
        self.wl("declare void @arx_tls_arena_init()")
        self.wl("declare ptr @arx_tls_arena_get()")
        self.wl("declare ptr @arx_tls_arena_alloc(ptr, i64)")
        // Print
        self.wl("declare void @arx_print_str(ptr)")
        self.wl("declare void @arx_println_str(ptr)")
        self.wl("declare void @arx_print_i64(i64)")
        self.wl("declare void @arx_println_i64(i64)")
        self.wl("declare void @arx_print_f64(double)")
        self.wl("declare void @arx_println_f64(double)")
        self.wl("declare void @arx_print_bool(i1)")
        self.wl("declare void @arx_println_bool(i1)")
        self.wl("declare void @arx_eprintln_str(ptr)")
        // Args
        self.wl("declare void @arx_init_args(i32, ptr)")
        self.wl("declare void @arx_init_args_ll(i32, ptr)")
        self.wl("declare ptr @arx_args_get(i64)")
        self.wl("declare i64 @arx_args_count()")
        self.wl("declare ptr @arx_args_list()")
        // String ops
        self.wl("declare i64 @arx_str_len(ptr)")
        self.wl("declare ptr @arx_str_concat(ptr, ptr)")
        self.wl("declare i32 @arx_str_compare(ptr, ptr)")
        self.wl("declare ptr @arx_str_replace(ptr, ptr, ptr)")
        self.wl("declare ptr @arx_str_repeat(ptr, i64)")
        self.wl("declare ptr @arx_str_to_upper(ptr)")
        self.wl("declare ptr @arx_str_to_lower(ptr)")
        self.wl("declare ptr @arx_str_trim(ptr)")
        self.wl("declare ptr @arx_str_trim_start(ptr)")
        self.wl("declare ptr @arx_str_trim_end(ptr)")
        self.wl("declare i1 @arx_str_contains(ptr, ptr)")
        self.wl("declare i1 @arx_str_starts_with(ptr, ptr)")
        self.wl("declare i1 @arx_str_ends_with(ptr, ptr)")
        self.wl("declare i64 @arx_str_find(ptr, ptr)")
        self.wl("declare i8 @arx_str_byte_at(ptr, i64)")
        self.wl("declare ptr @__arx_bstr_slice(ptr, i64, i64)")
        self.wl("declare ptr @arx_str_split(ptr, ptr)")
        self.wl("declare ptr @arx_str_lines(ptr)")
        self.wl("declare i64 @arx_str_to_i64(ptr)")
        self.wl("declare double @arx_str_to_f64(ptr)")
        self.wl("declare ptr @arx_str_pad_left(ptr, i64, ptr)")
        self.wl("declare ptr @arx_str_pad_right(ptr, i64, ptr)")
        // Type conversions
        self.wl("declare ptr @arx_cast_i64_to_str(i64)")
        self.wl("declare ptr @arx_cast_u64_to_str(i64)")
        self.wl("declare ptr @arx_cast_f64_to_str(double)")
        self.wl("declare ptr @arx_cast_bool_to_str(i1)")
        self.wl("declare i64 @arx_cast_to_i64(ptr)")
        self.wl("declare double @arx_cast_to_f64(ptr)")
        self.wl("declare i1 @arx_cast_to_bool(ptr)")
        // Error handling
        self.wl("declare void @arx_panic(ptr, ptr, i64)")
        self.wl("declare void @arx_throw(ptr, i64)")
        // Math
        self.wl("declare double @sqrt(double)")
        self.wl("declare double @fabs(double)")
        self.wl("declare double @sin(double)")
        self.wl("declare double @cos(double)")
        self.wl("declare double @tan(double)")
        self.wl("declare double @floor(double)")
        self.wl("declare double @ceil(double)")
        self.wl("declare double @round(double)")
        self.wl("declare double @log(double)")
        self.wl("declare double @log2(double)")
        self.wl("declare double @log10(double)")
        self.wl("declare double @exp(double)")
        self.wl("declare double @pow(double, double)")
        self.wl("declare i64 @llabs(i64)")
        // IO
        self.wl("declare ptr @arx_readln()")
        self.wl("declare ptr @arx_input(ptr)")
        // List ops (generic — declared as taking ptr handle)
        self.wl("declare ptr @arx_list_new(i64)")
        self.wl("declare void @arx_list_push(ptr, i64)")
        self.wl("declare i64 @arx_list_pop(ptr)")
        self.wl("declare i64 @arx_list_get(ptr, i64)")
        self.wl("declare void @arx_list_set(ptr, i64, i64)")
        self.wl("declare i64 @arx_list_len(ptr)")
        self.wl("declare void @arx_list_clear(ptr)")
        self.wl("declare void @arx_list_free(ptr)")
        // Map ops
        self.wl("declare ptr @arx_map_new(i64)")
        self.wl("declare void @arx_map_insert(ptr, i64, i64)")
        self.wl("declare i64 @arx_map_get(ptr, i64)")
        self.wl("declare i1 @arx_map_has(ptr, i64)")
        self.wl("declare i64 @arx_map_len(ptr)")
        self.wl("declare void @arx_map_remove(ptr, i64)")
        self.wl("declare void @arx_map_free(ptr)")
        // Env
        self.wl("declare ptr @arx_env_get(ptr)")
        self.wl("declare i1 @arx_env_set(ptr, ptr)")
        self.wl("declare void @arx_env_exit(i32)")
        self.wl("declare ptr @arx_env_cwd()")
        self.wl("declare ptr @arx_os_name()")
        // File
        self.wl("declare i1 @arx_file_exists(ptr)")
        self.wl("declare ptr @arx_file_read_to_string(ptr)")
        self.wl("declare i1 @arx_file_write_string(ptr, ptr)")
        self.wl("declare i1 @arx_file_remove(ptr)")
        self.wl("declare i1 @arx_file_copy(ptr, ptr)")
        // Dir
        self.wl("declare i1 @arx_dir_exists(ptr)")
        self.wl("declare i1 @arx_dir_create(ptr)")
        // Process
        self.wl("declare i64 @arx_proc_execute(ptr)")
        self.wl("declare ptr @arx_proc_run_capture(ptr)")
        // Helper
        self.wl("declare ptr @__arx_byte_chr(i64)")
        // Built-in class static method wrappers
        self.wl("declare i64 @Arx_Env_arg_count()")
        self.wl("declare ptr @Arx_Env_arg(i64)")
        self.wl("declare ptr @Arx_Env_get(ptr)")
        self.wl("declare i1 @Arx_Env_set(ptr, ptr)")
        self.wl("declare i64 @Arx_Env_args()")
        self.wl("declare ptr @Arx_Env_cwd()")
        self.wl("declare void @Arx_Env_exit(i64)")
        self.wl("declare ptr @Arx_Env_os_name()")
        self.wl("declare i1 @Arx_Directory_exists(ptr)")
        self.wl("declare i1 @Arx_Directory_create(ptr)")
        self.wl("declare i64 @Arx_Directory_list_files(ptr)")
        self.wl("declare i64 @Arx_Directory_list_dirs(ptr)")
        self.wl("declare i1 @Arx_File_exists(ptr)")
        self.wl("declare ptr @Arx_File_read_to_string(ptr)")
        self.wl("declare i1 @Arx_File_write_string(ptr, ptr)")
        self.wl("declare i1 @Arx_File_remove(ptr)")
        self.wl("declare i1 @Arx_File_copy(ptr, ptr)")
        // LLVM intrinsics
        self.wl("declare void @llvm.memset.p0.i64(ptr nocapture writeonly, i8, i64, i1 immarg)")
        self.wln()

        // Emit extern function wrappers
        self.ll_emit_extern_wrappers()
    }

    // Emit extern wrapper declarations for user-declared @[cextern] functions.
    priv fn ll_emit_extern_wrappers() {
        mut fi = 0
        while fi < self.fn_count {
            let fid = self.fn_nodes.get(fi)
            let raw_name = self.sa.get(fid)
            if self.fn_externs.has_key(raw_name) {
                let full_ext = self.fn_externs.get(raw_name)
                let parts = full_ext.split("::")
                mut sym = raw_name
                if parts.len() >= 2 { sym = parts.get(1) }
                let rt = btype_norm(self.sb.get(fid))
                let ret_ll = ll_type(rt)
                let pg = self.la.get(fid)
                let bb = ByteBuffer()
                bb.write_str("declare ")
                bb.write_str(ret_ll)
                bb.write_str(" @")
                bb.write_str(sym)
                bb.write_str("(")
                if pg >= 0 {
                    let pcnt = self.child_count(pg)
                    mut pi = 0
                    while pi < pcnt {
                        let pid = self.child_at(pg, pi)
                        let pt = btype_norm(self.sb.get(pid))
                        if pi > 0 { bb.write_str(", ") }
                        bb.write_str(ll_type(pt))
                        pi = pi + 1
                    }
                }
                bb.write_str(")")
                self.wl(bb.to_str())
                bb.free()
            }
            fi = fi + 1
        }
        if self.fn_count > 0 { self.wln() }
    }
}
