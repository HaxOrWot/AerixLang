// ==============================================================================
// Aerix Native Backend: Peephole Instruction Optimizer
// Eliminates redundant self-moves, dead reloads, and redundant stack roundtrips.
// ==============================================================================

import "../x64.arx"

pub class PeepholeOptimizer {
    pub optimizations_applied: i64

    init() {
        self.optimizations_applied = 0
    }

    pub fn run(asmb: X64Asm) -> i64 {
        let n = asmb.code.len()
        let label_set = Map<i64, i64>()
        mut li = 0
        while li < asmb.label_addrs.len() {
            let laddr = asmb.label_addrs.get(li)
            if laddr >= 0 {
                label_set.insert(laddr, 1)
            }
            li = li + 1
        }

        let fix_set = Map<i64, i64>()
        mut fi = 0
        while fi < asmb.fix_pos.len() {
            let fpos = asmb.fix_pos.get(fi)
            fix_set.insert(fpos, 1)
            fi = fi + 1
        }

        mut i = 0
        mut count = 0

        while i + 2 < n {
            let b0 = asmb.code.get(i)
            let b1 = asmb.code.get(i + 1)
            let b2 = asmb.code.get(i + 2)

            // Pattern 1: Redundant 3-byte self-moves: MOV reg, reg
            // 48 89 C0: mov rax, rax
            // 48 89 C9: mov rcx, rcx
            // 48 89 D2: mov rdx, rdx
            // 48 89 DB: mov rbx, rbx
            // 48 89 F6: mov rsi, rsi
            // 48 89 FF: mov rdi, rdi
            // 48 8B C0: mov rax, rax
            if b0 == 0x48 && (b1 == 0x89 || b1 == 0x8B) {
                if b2 == 0xC0 || b2 == 0xC9 || b2 == 0xD2 || b2 == 0xDB || b2 == 0xF6 || b2 == 0xFF {
                    if !fix_set.has_key(i) && !fix_set.has_key(i + 1) && !fix_set.has_key(i + 2) {
                        asmb.code.set(i, 0x90)
                        asmb.code.set(i + 1, 0x90)
                        asmb.code.set(i + 2, 0x90)
                        count = count + 1
                        i = i + 3
                        continue
                    }
                }
            }

            // Pattern 2: 8-bit displacement store followed by immediate reload
            // Store:  48 89 45 <disp8>  (mov [rbp + disp8], rax)
            // Reload: 48 8B 45 <disp8>  (mov rax, [rbp + disp8])
            if i + 7 < n {
                if b0 == 0x48 && b1 == 0x89 && b2 == 0x45 {
                    let disp = asmb.code.get(i + 3)
                    let r0 = asmb.code.get(i + 4)
                    let r1 = asmb.code.get(i + 5)
                    let r2 = asmb.code.get(i + 6)
                    let r3 = asmb.code.get(i + 7)
                    if r0 == 0x48 && r1 == 0x8B && r2 == 0x45 && r3 == disp {
                        // Ensure reload instruction is not targeted by a branch or fixup
                        if !label_set.has_key(i + 4) && !fix_set.has_key(i + 4) {
                            asmb.code.set(i + 4, 0x90)
                            asmb.code.set(i + 5, 0x90)
                            asmb.code.set(i + 6, 0x90)
                            asmb.code.set(i + 7, 0x90)
                            count = count + 1
                            i = i + 8
                            continue
                        }
                    }
                }
            }

            // Pattern 3: 32-bit displacement store followed by immediate reload
            // Store:  48 89 85 <d0 d1 d2 d3> (7 bytes)
            // Reload: 48 8B 85 <d0 d1 d2 d3> (7 bytes)
            if i + 13 < n {
                if b0 == 0x48 && b1 == 0x89 && b2 == 0x85 {
                    let d0 = asmb.code.get(i + 3)
                    let d1 = asmb.code.get(i + 4)
                    let d2 = asmb.code.get(i + 5)
                    let d3 = asmb.code.get(i + 6)
                    let r0 = asmb.code.get(i + 7)
                    let r1 = asmb.code.get(i + 8)
                    let r2 = asmb.code.get(i + 9)
                    let rd0 = asmb.code.get(i + 10)
                    let rd1 = asmb.code.get(i + 11)
                    let rd2 = asmb.code.get(i + 12)
                    let rd3 = asmb.code.get(i + 13)
                    if r0 == 0x48 && r1 == 0x8B && r2 == 0x85 && rd0 == d0 && rd1 == d1 && rd2 == d2 && rd3 == d3 {
                        if !label_set.has_key(i + 7) && !fix_set.has_key(i + 7) {
                            asmb.code.set(i + 7, 0x90)
                            asmb.code.set(i + 8, 0x90)
                            asmb.code.set(i + 9, 0x90)
                            asmb.code.set(i + 10, 0x90)
                            asmb.code.set(i + 11, 0x90)
                            asmb.code.set(i + 12, 0x90)
                            asmb.code.set(i + 13, 0x90)
                            count = count + 1
                            i = i + 14
                            continue
                        }
                    }
                }
            }

            i = i + 1
        }

        self.optimizations_applied = count
        return count
    }
}
