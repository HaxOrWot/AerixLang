// Aerix Native x86-64 Runtime Emitter (zero C/GCC dependencies; uses only kernel32.dll + msvcrt.dll)

import "./x64.arx"
import "./pe.arx"

pub class NativeRt {
    pub asm: X64Asm
    pub pe: PeBuilder
    pub labels: Map<str, i64>

    // Imported OS slots
    pub imp_exit_process: i64
    pub imp_set_cp: i64
    pub imp_get_env: i64
    pub imp_set_env: i64
    pub imp_get_cwd: i64
    pub imp_get_attrs: i64
    pub imp_create_dir: i64
    pub imp_delete_file: i64
    pub imp_copy_file: i64
    pub imp_get_cmd: i64
    pub imp_sleep: i64
    pub imp_tick: i64
    pub imp_create_proc: i64
    pub imp_wait_obj: i64
    pub imp_get_exit: i64
    pub imp_close_handle: i64

    pub imp_malloc: i64
    pub imp_calloc: i64
    pub imp_realloc: i64
    pub imp_free: i64
    pub imp_strlen: i64
    pub imp_memcpy: i64
    pub imp_memcmp: i64
    pub imp_memset: i64
    pub imp_strcmp: i64
    pub imp_strstr: i64
    pub imp_strtoi64: i64
    pub imp_strtod: i64
    pub imp_puts: i64
    pub imp_printf: i64
    pub imp_fprintf: i64
    pub imp_snprintf: i64
    pub imp_fflush: i64
    pub imp_iob_func: i64
    pub imp_fopen: i64
    pub imp_fread: i64
    pub imp_fwrite: i64
    pub imp_fseek: i64
    pub imp_ftell: i64
    pub imp_fclose: i64
    pub imp_system: i64
    pub imp_pow: i64
    pub imp_sqrt: i64
    pub imp_sin: i64
    pub imp_cos: i64
    pub imp_tan: i64
    pub imp_floor: i64
    pub imp_ceil: i64
    pub imp_fabs: i64
    pub imp_fmod: i64
    pub imp_log: i64

    // Static string offsets in .rdata
    pub s_empty: i64
    pub s_true: i64
    pub s_false: i64
    pub s_pct_s: i64
    pub s_pct_lld: i64
    pub s_pct_g: i64
    pub s_pct_s_nl: i64
    pub s_rb: i64
    pub s_wb: i64
    pub s_windows: i64

    // Labels for user startup
    pub lbl_global_init: i64
    pub lbl_user_main: i64
    pub env_buf_off: i64

    init(asm: X64Asm, pe: PeBuilder) {
        self.asm = asm
        self.pe = pe
        self.labels = Map<str, i64>()

        self.imp_exit_process = pe.add_import("kernel32.dll", "ExitProcess")
        self.imp_set_cp = pe.add_import("kernel32.dll", "SetConsoleOutputCP")
        self.imp_get_env = pe.add_import("kernel32.dll", "GetEnvironmentVariableA")
        self.imp_set_env = pe.add_import("kernel32.dll", "SetEnvironmentVariableA")
        self.imp_get_cwd = pe.add_import("kernel32.dll", "GetCurrentDirectoryA")
        self.imp_get_attrs = pe.add_import("kernel32.dll", "GetFileAttributesA")
        self.imp_create_dir = pe.add_import("kernel32.dll", "CreateDirectoryA")
        self.imp_delete_file = pe.add_import("kernel32.dll", "DeleteFileA")
        self.imp_copy_file = pe.add_import("kernel32.dll", "CopyFileA")
        self.imp_get_cmd = pe.add_import("kernel32.dll", "GetCommandLineA")
        self.imp_sleep = pe.add_import("kernel32.dll", "Sleep")
        self.imp_tick = pe.add_import("kernel32.dll", "GetTickCount64")
        self.imp_create_proc = pe.add_import("kernel32.dll", "CreateProcessA")
        self.imp_wait_obj = pe.add_import("kernel32.dll", "WaitForSingleObject")
        self.imp_get_exit = pe.add_import("kernel32.dll", "GetExitCodeProcess")
        self.imp_close_handle = pe.add_import("kernel32.dll", "CloseHandle")

        self.imp_malloc = pe.add_import("msvcrt.dll", "malloc")
        self.imp_calloc = pe.add_import("msvcrt.dll", "calloc")
        self.imp_realloc = pe.add_import("msvcrt.dll", "realloc")
        self.imp_free = pe.add_import("msvcrt.dll", "free")
        self.imp_strlen = pe.add_import("msvcrt.dll", "strlen")
        self.imp_memcpy = pe.add_import("msvcrt.dll", "memcpy")
        self.imp_memcmp = pe.add_import("msvcrt.dll", "memcmp")
        self.imp_memset = pe.add_import("msvcrt.dll", "memset")
        self.imp_strcmp = pe.add_import("msvcrt.dll", "strcmp")
        self.imp_strstr = pe.add_import("msvcrt.dll", "strstr")
        self.imp_strtoi64 = pe.add_import("msvcrt.dll", "_strtoi64")
        self.imp_strtod = pe.add_import("msvcrt.dll", "strtod")
        self.imp_puts = pe.add_import("msvcrt.dll", "puts")
        self.imp_printf = pe.add_import("msvcrt.dll", "printf")
        self.imp_fprintf = pe.add_import("msvcrt.dll", "fprintf")
        self.imp_snprintf = pe.add_import("msvcrt.dll", "_snprintf")
        self.imp_fflush = pe.add_import("msvcrt.dll", "fflush")
        self.imp_iob_func = pe.add_import("msvcrt.dll", "__iob_func")
        self.imp_fopen = pe.add_import("msvcrt.dll", "fopen")
        self.imp_fread = pe.add_import("msvcrt.dll", "fread")
        self.imp_fwrite = pe.add_import("msvcrt.dll", "fwrite")
        self.imp_fseek = pe.add_import("msvcrt.dll", "fseek")
        self.imp_ftell = pe.add_import("msvcrt.dll", "ftell")
        self.imp_fclose = pe.add_import("msvcrt.dll", "fclose")
        self.imp_system = pe.add_import("msvcrt.dll", "system")
        self.imp_pow = pe.add_import("msvcrt.dll", "pow")
        self.imp_sqrt = pe.add_import("msvcrt.dll", "sqrt")
        self.imp_sin = pe.add_import("msvcrt.dll", "sin")
        self.imp_cos = pe.add_import("msvcrt.dll", "cos")
        self.imp_tan = pe.add_import("msvcrt.dll", "tan")
        self.imp_floor = pe.add_import("msvcrt.dll", "floor")
        self.imp_ceil = pe.add_import("msvcrt.dll", "ceil")
        self.imp_fabs = pe.add_import("msvcrt.dll", "fabs")
        self.imp_fmod = pe.add_import("msvcrt.dll", "fmod")
        self.imp_log = pe.add_import("msvcrt.dll", "log")

        self.s_empty = pe.add_rdata_cstr("")
        self.s_true = pe.add_rdata_cstr("true")
        self.s_false = pe.add_rdata_cstr("false")
        self.s_pct_s = pe.add_rdata_cstr("%s")
        self.s_pct_lld = pe.add_rdata_cstr("%lld")
        self.s_pct_g = pe.add_rdata_cstr("%g")
        self.s_pct_s_nl = pe.add_rdata_cstr("%s\n")
        self.s_rb = pe.add_rdata_cstr("rb")
        self.s_wb = pe.add_rdata_cstr("wb")
        self.s_windows = pe.add_rdata_cstr("windows")

        self.env_buf_off = pe.alloc_data_bytes(4096)
        self.lbl_global_init = asm.new_label()
        self.lbl_user_main = asm.new_label()
    }

    pub fn lbl(name: str) -> i64 {
        if self.labels.has_key(name) {
            return self.labels.get(name)
        }
        let id = self.asm.new_label()
        self.labels.insert(name, id)
        return id
    }

    priv fn begin_fn(name: str, frame_bytes: i64) {
        let id = self.lbl(name)
        self.asm.bind_label(id)
        self.asm.push_r(REG_RBP())
        self.asm.mov_rr(REG_RBP(), REG_RSP())
        self.asm.sub_ri32(REG_RSP(), frame_bytes)
    }

    priv fn end_fn() {
        self.asm.mov_rr(REG_RSP(), REG_RBP())
        self.asm.pop_r(REG_RBP())
        self.asm.ret()
    }

    pub fn emit_all() {
        // 0. Program Entry Point (RVA 0x1000)
        self.asm.push_r(REG_RBP())
        self.asm.mov_rr(REG_RBP(), REG_RSP())
        self.asm.sub_ri32(REG_RSP(), 48)
        self.asm.mov_ri32_sext(REG_RCX(), 65001)
        self.asm.call_rip_iat(self.imp_set_cp)
        self.asm.call_rel32(self.lbl_global_init)
        self.asm.call_rel32(self.lbl_user_main)
        self.asm.mov_rr(REG_RCX(), REG_RAX())
        self.asm.call_rip_iat(self.imp_exit_process)
        self.end_fn()

        self.emit_io_and_fmt()
        self.emit_strings()
        self.emit_list()
        self.emit_map()
        self.emit_bytebuf()
        self.emit_os_fs_env()
    }

    priv fn emit_io_and_fmt() {
        let a = self.asm
        // __rt_println_str(rcx = str)
        self.begin_fn("__rt_println_str", 48)
        let l_nonnull = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_NE(), l_nonnull)
        a.lea_rip_rdata(REG_RCX(), self.s_empty)
        a.bind_label(l_nonnull)
        a.call_rip_iat(self.imp_puts)
        a.mov_ri32_sext(REG_RCX(), 0)
        a.call_rip_iat(self.imp_fflush)
        self.end_fn()

        // __rt_print_str(rcx = str)
        self.begin_fn("__rt_print_str", 48)
        let l_pn = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_NE(), l_pn)
        a.lea_rip_rdata(REG_RCX(), self.s_empty)
        a.bind_label(l_pn)
        a.mov_rr(REG_RDX(), REG_RCX())
        a.lea_rip_rdata(REG_RCX(), self.s_pct_s)
        a.call_rip_iat(self.imp_printf)
        a.mov_ri32_sext(REG_RCX(), 0)
        a.call_rip_iat(self.imp_fflush)
        self.end_fn()

        // __rt_eprintln_str(rcx = str) -> fprintf(__iob_func() + 96, "%s\n", rcx)
        self.begin_fn("__rt_eprintln_str", 64)
        let l_en = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_NE(), l_en)
        a.lea_rip_rdata(REG_RCX(), self.s_empty)
        a.bind_label(l_en)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.call_rip_iat(self.imp_iob_func)
        a.add_ri32(REG_RAX(), 96)
        a.mov_mr64(REG_RBP(), -16, REG_RAX())
        a.mov_rr(REG_RCX(), REG_RAX())
        a.lea_rip_rdata(REG_RDX(), self.s_pct_s_nl)
        a.mov_rm64(REG_R8(), REG_RBP(), -8)
        a.call_rip_iat(self.imp_fprintf)
        a.mov_rm64(REG_RCX(), REG_RBP(), -16)
        a.call_rip_iat(self.imp_fflush)
        self.end_fn()

        // __rt_i64_to_str(rcx = n) -> str
        self.begin_fn("__rt_i64_to_str", 64)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_ri32_sext(REG_RCX(), 32)
        a.call_rip_iat(self.imp_malloc)
        a.mov_mr64(REG_RBP(), -16, REG_RAX())
        a.mov_rr(REG_RCX(), REG_RAX())
        a.mov_ri32_sext(REG_RDX(), 32)
        a.lea_rip_rdata(REG_R8(), self.s_pct_lld)
        a.mov_rm64(REG_R9(), REG_RBP(), -8)
        a.call_rip_iat(self.imp_snprintf)
        a.mov_rm64(REG_RAX(), REG_RBP(), -16)
        self.end_fn()

        // __rt_f64_to_str(rcx = raw bits of f64) -> str
        self.begin_fn("__rt_f64_to_str", 64)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_ri32_sext(REG_RCX(), 48)
        a.call_rip_iat(self.imp_malloc)
        a.mov_mr64(REG_RBP(), -16, REG_RAX())
        a.mov_rr(REG_RCX(), REG_RAX())
        a.mov_ri32_sext(REG_RDX(), 48)
        a.lea_rip_rdata(REG_R8(), self.s_pct_g)
        a.mov_rm64(REG_R9(), REG_RBP(), -8)
        a.movq_xmm_r(3, REG_R9())
        a.call_rip_iat(self.imp_snprintf)
        a.mov_rm64(REG_RAX(), REG_RBP(), -16)
        self.end_fn()

        // __rt_bool_to_str(rcx = bool) -> str
        self.begin_fn("__rt_bool_to_str", 32)
        let l_bf = a.new_label()
        let l_bd = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_bf)
        a.lea_rip_rdata(REG_RAX(), self.s_true)
        a.jmp_rel32(l_bd)
        a.bind_label(l_bf)
        a.lea_rip_rdata(REG_RAX(), self.s_false)
        a.bind_label(l_bd)
        self.end_fn()

        // __rt_char_to_str(rcx = ch) -> str
        self.begin_fn("__rt_char_to_str", 48)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_ri32_sext(REG_RCX(), 2)
        a.call_rip_iat(self.imp_malloc)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_mr8(REG_RAX(), 0, REG_RCX())
        a.mov_ri32_sext(REG_RCX(), 0)
        a.mov_mr8(REG_RAX(), 1, REG_RCX())
        self.end_fn()
    }

    priv fn emit_strings() {
        let a = self.asm
        // __rt_str_len(rcx = s) -> i64
        self.begin_fn("__rt_str_len", 48)
        let l_ln = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_NE(), l_ln)
        a.mov_ri32_sext(REG_RAX(), 0)
        self.end_fn()
        a.bind_label(l_ln)
        a.call_rip_iat(self.imp_strlen)
        self.end_fn()

        // __rt_str_concat(rcx = a, rdx = b) -> str
        self.begin_fn("__rt_str_concat", 80)
        let l_ca = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_NE(), l_ca)
        a.lea_rip_rdata(REG_RCX(), self.s_empty)
        a.bind_label(l_ca)
        let l_cb = a.new_label()
        a.test_rr(REG_RDX(), REG_RDX())
        a.jcc_rel32(CC_NE(), l_cb)
        a.lea_rip_rdata(REG_RDX(), self.s_empty)
        a.bind_label(l_cb)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())   // sa
        a.mov_mr64(REG_RBP(), -16, REG_RDX())  // sb
        a.call_rip_iat(self.imp_strlen)
        a.mov_mr64(REG_RBP(), -24, REG_RAX())  // la
        a.mov_rm64(REG_RCX(), REG_RBP(), -16)
        a.call_rip_iat(self.imp_strlen)
        a.mov_mr64(REG_RBP(), -32, REG_RAX())  // lb
        a.mov_rm64(REG_RCX(), REG_RBP(), -24)
        a.add_rr(REG_RCX(), REG_RAX())
        a.add_ri32(REG_RCX(), 1)
        a.call_rip_iat(self.imp_malloc)
        a.mov_mr64(REG_RBP(), -40, REG_RAX())  // buf
        a.mov_rr(REG_RCX(), REG_RAX())
        a.mov_rm64(REG_RDX(), REG_RBP(), -8)
        a.mov_rm64(REG_R8(), REG_RBP(), -24)
        a.call_rip_iat(self.imp_memcpy)
        a.mov_rm64(REG_RCX(), REG_RBP(), -40)
        a.mov_rm64(REG_R8(), REG_RBP(), -24)
        a.add_rr(REG_RCX(), REG_R8())
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.mov_rm64(REG_R8(), REG_RBP(), -32)
        a.call_rip_iat(self.imp_memcpy)
        a.mov_rm64(REG_RAX(), REG_RBP(), -40)
        a.mov_rm64(REG_RCX(), REG_RBP(), -24)
        a.mov_rm64(REG_RDX(), REG_RBP(), -32)
        a.add_rr(REG_RCX(), REG_RDX())
        a.add_rr(REG_RCX(), REG_RAX())
        a.mov_ri32_sext(REG_RDX(), 0)
        a.mov_mr8(REG_RCX(), 0, REG_RDX())
        self.end_fn()

        // __rt_str_eq(rcx = a, rdx = b) -> 0/1
        self.begin_fn("__rt_str_eq", 48)
        let l_ea = a.new_label()
        a.cmp_rr(REG_RCX(), REG_RDX())
        a.jcc_rel32(CC_NE(), l_ea)
        a.mov_ri32_sext(REG_RAX(), 1)
        self.end_fn()
        a.bind_label(l_ea)
        let l_eb = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_NE(), l_eb)
        a.lea_rip_rdata(REG_RCX(), self.s_empty)
        a.bind_label(l_eb)
        let l_ec = a.new_label()
        a.test_rr(REG_RDX(), REG_RDX())
        a.jcc_rel32(CC_NE(), l_ec)
        a.lea_rip_rdata(REG_RDX(), self.s_empty)
        a.bind_label(l_ec)
        a.call_rip_iat(self.imp_strcmp)
        a.cmp_ri32(REG_RAX(), 0)
        a.setcc_u8(CC_E(), REG_RAX())
        self.end_fn()

        // __rt_str_byte_at(rcx = s, rdx = idx) -> i64
        self.begin_fn("__rt_str_byte_at", 48)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_mr64(REG_RBP(), -16, REG_RDX())
        a.call_rel32(self.lbl("__rt_str_len"))
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.cmp_ri32(REG_RDX(), 0)
        let l_oob = a.new_label()
        a.jcc_rel32(CC_L(), l_oob)
        a.cmp_rr(REG_RDX(), REG_RAX())
        a.jcc_rel32(CC_GE(), l_oob)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.add_rr(REG_RCX(), REG_RDX())
        a.movzx_rm8(REG_RAX(), REG_RCX(), 0)
        self.end_fn()
        a.bind_label(l_oob)
        a.mov_ri32_sext(REG_RAX(), 0)
        self.end_fn()

        // __rt_str_slice(rcx = s, rdx = st, r8 = ed) -> str
        self.begin_fn("__rt_str_slice", 80)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())   // s
        a.mov_mr64(REG_RBP(), -16, REG_RDX())  // st
        a.mov_mr64(REG_RBP(), -24, REG_R8())   // ed
        a.call_rel32(self.lbl("__rt_str_len"))
        a.mov_mr64(REG_RBP(), -32, REG_RAX())  // len
        a.mov_rm64(REG_RCX(), REG_RBP(), -16)
        let l_s0 = a.new_label()
        a.cmp_ri32(REG_RCX(), 0)
        a.jcc_rel32(CC_GE(), l_s0)
        a.mov_ri32_sext(REG_RCX(), 0)
        a.bind_label(l_s0)
        let l_s1 = a.new_label()
        a.cmp_rr(REG_RCX(), REG_RAX())
        a.jcc_rel32(CC_LE(), l_s1)
        a.mov_rr(REG_RCX(), REG_RAX())
        a.bind_label(l_s1)
        a.mov_mr64(REG_RBP(), -16, REG_RCX())
        a.mov_rm64(REG_RDX(), REG_RBP(), -24)
        let l_e0 = a.new_label()
        a.cmp_rr(REG_RDX(), REG_RAX())
        a.jcc_rel32(CC_LE(), l_e0)
        a.mov_rr(REG_RDX(), REG_RAX())
        a.bind_label(l_e0)
        let l_e1 = a.new_label()
        a.cmp_rr(REG_RDX(), REG_RCX())
        a.jcc_rel32(CC_GE(), l_e1)
        a.mov_rr(REG_RDX(), REG_RCX())
        a.bind_label(l_e1)
        a.sub_rr(REG_RDX(), REG_RCX())
        a.mov_mr64(REG_RBP(), -40, REG_RDX())  // out_len
        a.mov_rr(REG_RCX(), REG_RDX())
        a.add_ri32(REG_RCX(), 1)
        a.call_rip_iat(self.imp_malloc)
        a.mov_mr64(REG_RBP(), -48, REG_RAX())
        a.mov_rm64(REG_R8(), REG_RBP(), -40)
        let l_cp = a.new_label()
        a.cmp_ri32(REG_R8(), 0)
        a.jcc_rel32(CC_LE(), l_cp)
        a.mov_rr(REG_RCX(), REG_RAX())
        a.mov_rm64(REG_RDX(), REG_RBP(), -8)
        a.mov_rm64(REG_R9(), REG_RBP(), -16)
        a.add_rr(REG_RDX(), REG_R9())
        a.call_rip_iat(self.imp_memcpy)
        a.mov_rm64(REG_RAX(), REG_RBP(), -48)
        a.bind_label(l_cp)
        a.mov_rm64(REG_RCX(), REG_RBP(), -40)
        a.add_rr(REG_RCX(), REG_RAX())
        a.mov_ri32_sext(REG_RDX(), 0)
        a.mov_mr8(REG_RCX(), 0, REG_RDX())
        self.end_fn()

        // __rt_str_contains(rcx = s, rdx = sub) -> 0/1
        self.begin_fn("__rt_str_contains", 48)
        let l_cf = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_cf)
        a.test_rr(REG_RDX(), REG_RDX())
        a.jcc_rel32(CC_E(), l_cf)
        a.call_rip_iat(self.imp_strstr)
        a.test_rr(REG_RAX(), REG_RAX())
        a.setcc_u8(CC_NE(), REG_RAX())
        self.end_fn()
        a.bind_label(l_cf)
        a.mov_ri32_sext(REG_RAX(), 0)
        self.end_fn()

        // __rt_str_starts_with(rcx = s, rdx = prefix) -> 0/1
        self.begin_fn("__rt_str_starts_with", 64)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_mr64(REG_RBP(), -16, REG_RDX())
        a.call_rel32(self.lbl("__rt_str_len"))
        a.mov_mr64(REG_RBP(), -24, REG_RAX()) // ls
        a.mov_rm64(REG_RCX(), REG_RBP(), -16)
        a.call_rel32(self.lbl("__rt_str_len"))
        a.mov_mr64(REG_RBP(), -32, REG_RAX()) // lp
        a.mov_rm64(REG_RCX(), REG_RBP(), -24)
        a.cmp_rr(REG_RCX(), REG_RAX())
        let l_sw_f = a.new_label()
        a.jcc_rel32(CC_L(), l_sw_f)
        a.test_rr(REG_RAX(), REG_RAX())
        let l_sw_t = a.new_label()
        a.jcc_rel32(CC_E(), l_sw_t)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.mov_rr(REG_R8(), REG_RAX())
        a.call_rip_iat(self.imp_memcmp)
        a.cmp_ri32(REG_RAX(), 0)
        a.setcc_u8(CC_E(), REG_RAX())
        self.end_fn()
        a.bind_label(l_sw_t)
        a.mov_ri32_sext(REG_RAX(), 1)
        self.end_fn()
        a.bind_label(l_sw_f)
        a.mov_ri32_sext(REG_RAX(), 0)
        self.end_fn()

        // __rt_str_ends_with(rcx = s, rdx = suffix) -> 0/1
        self.begin_fn("__rt_str_ends_with", 64)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_mr64(REG_RBP(), -16, REG_RDX())
        a.call_rel32(self.lbl("__rt_str_len"))
        a.mov_mr64(REG_RBP(), -24, REG_RAX()) // ls
        a.mov_rm64(REG_RCX(), REG_RBP(), -16)
        a.call_rel32(self.lbl("__rt_str_len"))
        a.mov_mr64(REG_RBP(), -32, REG_RAX()) // lx
        a.mov_rm64(REG_RCX(), REG_RBP(), -24)
        a.cmp_rr(REG_RCX(), REG_RAX())
        let l_ew_f = a.new_label()
        a.jcc_rel32(CC_L(), l_ew_f)
        a.test_rr(REG_RAX(), REG_RAX())
        let l_ew_t = a.new_label()
        a.jcc_rel32(CC_E(), l_ew_t)
        a.sub_rr(REG_RCX(), REG_RAX())
        a.mov_rm64(REG_R10(), REG_RBP(), -8)
        a.add_rr(REG_RCX(), REG_R10())
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.mov_rr(REG_R8(), REG_RAX())
        a.call_rip_iat(self.imp_memcmp)
        a.cmp_ri32(REG_RAX(), 0)
        a.setcc_u8(CC_E(), REG_RAX())
        self.end_fn()
        a.bind_label(l_ew_t)
        a.mov_ri32_sext(REG_RAX(), 1)
        self.end_fn()
        a.bind_label(l_ew_f)
        a.mov_ri32_sext(REG_RAX(), 0)
        self.end_fn()

        // __rt_str_trim(rcx = s) -> str
        self.begin_fn("__rt_str_trim", 64)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.call_rel32(self.lbl("__rt_str_len"))
        a.mov_mr64(REG_RBP(), -16, REG_RAX()) // ed = len
        a.mov_ri32_sext(REG_RCX(), 0)         // st = 0
        let l_t1 = a.new_label()
        let l_t1_done = a.new_label()
        a.bind_label(l_t1)
        a.cmp_rr(REG_RCX(), REG_RAX())
        a.jcc_rel32(CC_GE(), l_t1_done)
        a.mov_rm64(REG_RDX(), REG_RBP(), -8)
        a.add_rr(REG_RDX(), REG_RCX())
        a.movzx_rm8(REG_R8(), REG_RDX(), 0)
        a.cmp_ri32(REG_R8(), 32)
        a.jcc_rel32(CC_A(), l_t1_done)
        a.add_ri32(REG_RCX(), 1)
        a.jmp_rel32(l_t1)
        a.bind_label(l_t1_done)
        a.mov_mr64(REG_RBP(), -24, REG_RCX()) // st
        let l_t2 = a.new_label()
        let l_t2_done = a.new_label()
        a.bind_label(l_t2)
        a.mov_rm64(REG_RAX(), REG_RBP(), -16) // ed
        a.cmp_rr(REG_RAX(), REG_RCX())
        a.jcc_rel32(CC_LE(), l_t2_done)
        a.sub_ri32(REG_RAX(), 1)
        a.mov_rm64(REG_RDX(), REG_RBP(), -8)
        a.add_rr(REG_RDX(), REG_RAX())
        a.movzx_rm8(REG_R8(), REG_RDX(), 0)
        a.cmp_ri32(REG_R8(), 32)
        a.jcc_rel32(CC_A(), l_t2_done)
        a.mov_mr64(REG_RBP(), -16, REG_RAX())
        a.jmp_rel32(l_t2)
        a.bind_label(l_t2_done)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_rm64(REG_RDX(), REG_RBP(), -24)
        a.mov_rm64(REG_R8(), REG_RBP(), -16)
        a.call_rel32(self.lbl("__rt_str_slice"))
        self.end_fn()

        // __rt_str_upper(rcx = s) -> str  &  __rt_str_lower(rcx = s) -> str
        self.emit_str_case("__rt_str_upper", true)
        self.emit_str_case("__rt_str_lower", false)

        // __rt_str_to_i64(rcx = s) -> i64
        self.begin_fn("__rt_str_to_i64", 48)
        let l_ti_ok = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_NE(), l_ti_ok)
        a.mov_ri32_sext(REG_RAX(), 0)
        self.end_fn()
        a.bind_label(l_ti_ok)
        a.mov_ri32_sext(REG_RDX(), 0)
        a.mov_ri32_sext(REG_R8(), 10)
        a.call_rip_iat(self.imp_strtoi64)
        self.end_fn()

        // __rt_str_to_f64(rcx = s) -> xmm0
        self.begin_fn("__rt_str_to_f64", 48)
        let l_tf_ok = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_NE(), l_tf_ok)
        a.mov_ri32_sext(REG_RAX(), 0)
        a.movq_xmm_r(0, REG_RAX())
        self.end_fn()
        a.bind_label(l_tf_ok)
        a.mov_ri32_sext(REG_RDX(), 0)
        a.call_rip_iat(self.imp_strtod)
        self.end_fn()

        // __rt_str_replace(rcx = s, rdx = old, r8 = new) -> str
        self.emit_str_replace()

        // __rt_str_split(rcx = s, rdx = sep) -> List ptr
        self.emit_str_split()

        // __rt_str_repeat(rcx = s, rdx = count) -> str
        self.begin_fn("__rt_str_repeat", 64)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_mr64(REG_RBP(), -16, REG_RDX())
        let l_rep_z = a.new_label()
        a.cmp_ri32(REG_RDX(), 0)
        a.jcc_rel32(CC_LE(), l_rep_z)
        a.call_rel32(self.lbl("__rt_str_len"))
        a.mov_mr64(REG_RBP(), -24, REG_RAX()) // ls
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.imul_rr(REG_RAX(), REG_RDX())
        a.mov_mr64(REG_RBP(), -32, REG_RAX()) // total
        a.mov_rr(REG_RCX(), REG_RAX())
        a.add_ri32(REG_RCX(), 1)
        a.call_rip_iat(self.imp_malloc)
        a.mov_mr64(REG_RBP(), -40, REG_RAX()) // buf
        a.mov_ri32_sext(REG_RCX(), 0)
        a.mov_mr64(REG_RBP(), -48, REG_RCX()) // i
        let l_rl = a.new_label()
        let l_rld = a.new_label()
        a.bind_label(l_rl)
        a.mov_rm64(REG_RCX(), REG_RBP(), -48)
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.cmp_rr(REG_RCX(), REG_RDX())
        a.jcc_rel32(CC_GE(), l_rld)
        a.mov_rm64(REG_R8(), REG_RBP(), -24) // ls
        a.imul_rr(REG_RCX(), REG_R8())
        a.mov_rm64(REG_RAX(), REG_RBP(), -40)
        a.add_rr(REG_RCX(), REG_RAX())
        a.mov_rm64(REG_RDX(), REG_RBP(), -8)
        a.call_rip_iat(self.imp_memcpy)
        a.mov_rm64(REG_RCX(), REG_RBP(), -48)
        a.add_ri32(REG_RCX(), 1)
        a.mov_mr64(REG_RBP(), -48, REG_RCX())
        a.jmp_rel32(l_rl)
        a.bind_label(l_rld)
        a.mov_rm64(REG_RAX(), REG_RBP(), -40)
        a.mov_rm64(REG_RCX(), REG_RBP(), -32)
        a.add_rr(REG_RCX(), REG_RAX())
        a.mov_ri32_sext(REG_RDX(), 0)
        a.mov_mr8(REG_RCX(), 0, REG_RDX())
        self.end_fn()
        a.bind_label(l_rep_z)
        a.lea_rip_rdata(REG_RAX(), self.s_empty)
        self.end_fn()
    }

    priv fn emit_str_case(name: str, to_upper: bool) {
        let a = self.asm
        self.begin_fn(name, 64)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.call_rel32(self.lbl("__rt_str_len"))
        a.mov_mr64(REG_RBP(), -16, REG_RAX())
        a.mov_rr(REG_RCX(), REG_RAX())
        a.add_ri32(REG_RCX(), 1)
        a.call_rip_iat(self.imp_malloc)
        a.mov_mr64(REG_RBP(), -24, REG_RAX())
        a.mov_ri32_sext(REG_RCX(), 0)
        let l_lp = a.new_label()
        let l_dn = a.new_label()
        a.bind_label(l_lp)
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.cmp_rr(REG_RCX(), REG_RDX())
        a.jcc_rel32(CC_GE(), l_dn)
        a.mov_rm64(REG_R8(), REG_RBP(), -8)
        a.add_rr(REG_R8(), REG_RCX())
        a.movzx_rm8(REG_R9(), REG_R8(), 0)
        let l_skip = a.new_label()
        if to_upper {
            a.cmp_ri32(REG_R9(), 97)
            a.jcc_rel32(CC_L(), l_skip)
            a.cmp_ri32(REG_R9(), 122)
            a.jcc_rel32(CC_G(), l_skip)
            a.sub_ri32(REG_R9(), 32)
        } else {
            a.cmp_ri32(REG_R9(), 65)
            a.jcc_rel32(CC_L(), l_skip)
            a.cmp_ri32(REG_R9(), 90)
            a.jcc_rel32(CC_G(), l_skip)
            a.add_ri32(REG_R9(), 32)
        }
        a.bind_label(l_skip)
        a.mov_rm64(REG_R8(), REG_RBP(), -24)
        a.add_rr(REG_R8(), REG_RCX())
        a.mov_mr8(REG_R8(), 0, REG_R9())
        a.add_ri32(REG_RCX(), 1)
        a.jmp_rel32(l_lp)
        a.bind_label(l_dn)
        a.mov_rm64(REG_RAX(), REG_RBP(), -24)
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.add_rr(REG_RDX(), REG_RAX())
        a.mov_ri32_sext(REG_RCX(), 0)
        a.mov_mr8(REG_RDX(), 0, REG_RCX())
        self.end_fn()
    }

    priv fn emit_str_replace() {
        let a = self.asm
        // Uses ByteBuffer internally! __rt_str_replace(rcx = s, rdx = old, r8 = new)
        self.begin_fn("__rt_str_replace", 96)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())   // s
        a.mov_mr64(REG_RBP(), -16, REG_RDX())  // old
        a.mov_mr64(REG_RBP(), -24, REG_R8())   // new
        a.mov_rr(REG_RCX(), REG_RDX())
        a.call_rel32(self.lbl("__rt_str_len"))
        a.mov_mr64(REG_RBP(), -32, REG_RAX())  // old_len
        let l_ok = a.new_label()
        a.cmp_ri32(REG_RAX(), 0)
        a.jcc_rel32(CC_G(), l_ok)
        a.mov_rm64(REG_RAX(), REG_RBP(), -8)
        self.end_fn()
        a.bind_label(l_ok)
        a.call_rel32(self.lbl("__rt_bb_new"))
        a.mov_mr64(REG_RBP(), -40, REG_RAX())  // bb
        a.mov_rm64(REG_RAX(), REG_RBP(), -8)
        a.mov_mr64(REG_RBP(), -48, REG_RAX())  // cur ptr
        let l_lp = a.new_label()
        let l_tail = a.new_label()
        a.bind_label(l_lp)
        a.mov_rm64(REG_RCX(), REG_RBP(), -48)
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.call_rip_iat(self.imp_strstr)
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_E(), l_tail)
        a.mov_mr64(REG_RBP(), -56, REG_RAX())  // hit ptr
        // Write prefix bytes [cur..hit) into bb
        a.mov_rm64(REG_RCX(), REG_RBP(), -48)
        a.mov_rr(REG_RDX(), REG_RAX())
        a.sub_rr(REG_RDX(), REG_RCX())         // prefix_len
        a.mov_mr64(REG_RBP(), -64, REG_RDX())
        let l_wloop = a.new_label()
        let l_wdone = a.new_label()
        a.mov_ri32_sext(REG_RCX(), 0)
        a.mov_mr64(REG_RBP(), -72, REG_RCX())
        a.bind_label(l_wloop)
        a.mov_rm64(REG_RCX(), REG_RBP(), -72)
        a.mov_rm64(REG_RDX(), REG_RBP(), -64)
        a.cmp_rr(REG_RCX(), REG_RDX())
        a.jcc_rel32(CC_GE(), l_wdone)
        a.mov_rm64(REG_R8(), REG_RBP(), -48)
        a.add_rr(REG_R8(), REG_RCX())
        a.movzx_rm8(REG_RDX(), REG_R8(), 0)
        a.mov_rm64(REG_RCX(), REG_RBP(), -40)
        a.call_rel32(self.lbl("__rt_bb_write_u8"))
        a.mov_rm64(REG_RCX(), REG_RBP(), -72)
        a.add_ri32(REG_RCX(), 1)
        a.mov_mr64(REG_RBP(), -72, REG_RCX())
        a.jmp_rel32(l_wloop)
        a.bind_label(l_wdone)
        // Write new_str
        a.mov_rm64(REG_RCX(), REG_RBP(), -40)
        a.mov_rm64(REG_RDX(), REG_RBP(), -24)
        a.call_rel32(self.lbl("__rt_bb_write_str"))
        // cur = hit + old_len
        a.mov_rm64(REG_RAX(), REG_RBP(), -56)
        a.mov_rm64(REG_RCX(), REG_RBP(), -32)
        a.add_rr(REG_RAX(), REG_RCX())
        a.mov_mr64(REG_RBP(), -48, REG_RAX())
        a.jmp_rel32(l_lp)
        a.bind_label(l_tail)
        a.mov_rm64(REG_RCX(), REG_RBP(), -40)
        a.mov_rm64(REG_RDX(), REG_RBP(), -48)
        a.call_rel32(self.lbl("__rt_bb_write_str"))
        a.mov_rm64(REG_RCX(), REG_RBP(), -40)
        a.call_rel32(self.lbl("__rt_bb_to_str"))
        a.mov_mr64(REG_RBP(), -80, REG_RAX())
        a.mov_rm64(REG_RCX(), REG_RBP(), -40)
        a.call_rel32(self.lbl("__rt_bb_free"))
        a.mov_rm64(REG_RAX(), REG_RBP(), -80)
        self.end_fn()
    }

    priv fn emit_str_split() {
        let a = self.asm
        // __rt_str_split(rcx = s, rdx = sep) -> List ptr
        self.begin_fn("__rt_str_split", 80)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_mr64(REG_RBP(), -16, REG_RDX())
        a.call_rel32(self.lbl("__rt_list_new"))
        a.mov_mr64(REG_RBP(), -24, REG_RAX()) // list
        a.mov_rm64(REG_RCX(), REG_RBP(), -16)
        a.call_rel32(self.lbl("__rt_str_len"))
        a.mov_mr64(REG_RBP(), -32, REG_RAX()) // sep_len
        let l_sp_ok = a.new_label()
        a.cmp_ri32(REG_RAX(), 0)
        a.jcc_rel32(CC_G(), l_sp_ok)
        a.mov_rm64(REG_RCX(), REG_RBP(), -24)
        a.mov_rm64(REG_RDX(), REG_RBP(), -8)
        a.call_rel32(self.lbl("__rt_list_push"))
        a.mov_rm64(REG_RAX(), REG_RBP(), -24)
        self.end_fn()
        a.bind_label(l_sp_ok)
        a.mov_rm64(REG_RAX(), REG_RBP(), -8)
        a.mov_mr64(REG_RBP(), -40, REG_RAX()) // cur
        let l_lp = a.new_label()
        let l_dn = a.new_label()
        a.bind_label(l_lp)
        a.mov_rm64(REG_RCX(), REG_RBP(), -40)
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.call_rip_iat(self.imp_strstr)
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_E(), l_dn)
        a.mov_mr64(REG_RBP(), -48, REG_RAX()) // hit
        a.mov_rm64(REG_RCX(), REG_RBP(), -40)
        a.mov_ri32_sext(REG_RDX(), 0)
        a.mov_rr(REG_R8(), REG_RAX())
        a.sub_rr(REG_R8(), REG_RCX())
        a.call_rel32(self.lbl("__rt_str_slice"))
        a.mov_rm64(REG_RCX(), REG_RBP(), -24)
        a.mov_rr(REG_RDX(), REG_RAX())
        a.call_rel32(self.lbl("__rt_list_push"))
        a.mov_rm64(REG_RAX(), REG_RBP(), -48)
        a.mov_rm64(REG_RCX(), REG_RBP(), -32)
        a.add_rr(REG_RAX(), REG_RCX())
        a.mov_mr64(REG_RBP(), -40, REG_RAX())
        a.jmp_rel32(l_lp)
        a.bind_label(l_dn)
        a.mov_rm64(REG_RCX(), REG_RBP(), -40)
        a.call_rel32(self.lbl("__rt_str_len"))
        a.mov_rm64(REG_RCX(), REG_RBP(), -40)
        a.mov_ri32_sext(REG_RDX(), 0)
        a.mov_rr(REG_R8(), REG_RAX())
        a.call_rel32(self.lbl("__rt_str_slice"))
        a.mov_rm64(REG_RCX(), REG_RBP(), -24)
        a.mov_rr(REG_RDX(), REG_RAX())
        a.call_rel32(self.lbl("__rt_list_push"))
        a.mov_rm64(REG_RAX(), REG_RBP(), -24)
        self.end_fn()
    }

    priv fn emit_list() {
        let a = self.asm
        // List struct (24B): [0]=data ptr, [8]=len, [16]=cap
        // __rt_list_new() -> ptr
        self.begin_fn("__rt_list_new", 48)
        a.mov_ri32_sext(REG_RCX(), 1)
        a.mov_ri32_sext(REG_RDX(), 24)
        a.call_rip_iat(self.imp_calloc)
        self.end_fn()

        // __rt_list_push(rcx = list, rdx = val)
        self.begin_fn("__rt_list_push", 64)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_mr64(REG_RBP(), -16, REG_RDX())
        a.mov_rm64(REG_R8(), REG_RCX(), 8)   // len
        a.mov_rm64(REG_R9(), REG_RCX(), 16)  // cap
        let l_fit = a.new_label()
        a.cmp_rr(REG_R8(), REG_R9())
        a.jcc_rel32(CC_L(), l_fit)
        let l_nc = a.new_label()
        a.cmp_ri32(REG_R9(), 0)
        a.jcc_rel32(CC_G(), l_nc)
        a.mov_ri32_sext(REG_R9(), 8)
        let l_nc_done = a.new_label()
        a.jmp_rel32(l_nc_done)
        a.bind_label(l_nc)
        a.add_rr(REG_R9(), REG_R9())
        a.bind_label(l_nc_done)
        a.mov_mr64(REG_RBP(), -24, REG_R9()) // new_cap
        a.mov_rm64(REG_RCX(), REG_RCX(), 0)  // old data
        a.mov_rm64(REG_RDX(), REG_RBP(), -24)
        a.add_rr(REG_RDX(), REG_RDX())
        a.add_rr(REG_RDX(), REG_RDX())
        a.add_rr(REG_RDX(), REG_RDX())
        a.call_rip_iat(self.imp_realloc)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_mr64(REG_RCX(), 0, REG_RAX())
        a.mov_rm64(REG_R9(), REG_RBP(), -24)
        a.mov_mr64(REG_RCX(), 16, REG_R9())
        a.bind_label(l_fit)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_rm64(REG_RAX(), REG_RCX(), 0)   // data
        a.mov_rm64(REG_R8(), REG_RCX(), 8)    // len
        a.mov_rr(REG_R10(), REG_R8())
        a.add_rr(REG_R10(), REG_R10())
        a.add_rr(REG_R10(), REG_R10())
        a.add_rr(REG_R10(), REG_R10())        // len * 8
        a.add_rr(REG_RAX(), REG_R10())
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.mov_mr64(REG_RAX(), 0, REG_RDX())
        a.add_ri32(REG_R8(), 1)
        a.mov_mr64(REG_RCX(), 8, REG_R8())
        self.end_fn()

        // __rt_list_pop(rcx = list) -> val
        self.begin_fn("__rt_list_pop", 32)
        a.mov_rm64(REG_R8(), REG_RCX(), 8)
        let l_pe = a.new_label()
        a.cmp_ri32(REG_R8(), 0)
        a.jcc_rel32(CC_LE(), l_pe)
        a.sub_ri32(REG_R8(), 1)
        a.mov_mr64(REG_RCX(), 8, REG_R8())
        a.mov_rm64(REG_RDX(), REG_RCX(), 0)
        a.add_rr(REG_R8(), REG_R8())
        a.add_rr(REG_R8(), REG_R8())
        a.add_rr(REG_R8(), REG_R8())
        a.add_rr(REG_RDX(), REG_R8())
        a.mov_rm64(REG_RAX(), REG_RDX(), 0)
        self.end_fn()
        a.bind_label(l_pe)
        a.mov_ri32_sext(REG_RAX(), 0)
        self.end_fn()

        // __rt_list_get(rcx = list, rdx = idx) -> val
        self.begin_fn("__rt_list_get", 32)
        let l_go = a.new_label()
        a.cmp_ri32(REG_RDX(), 0)
        a.jcc_rel32(CC_L(), l_go)
        a.mov_rm64(REG_R8(), REG_RCX(), 8)
        a.cmp_rr(REG_RDX(), REG_R8())
        a.jcc_rel32(CC_GE(), l_go)
        a.mov_rm64(REG_RAX(), REG_RCX(), 0)
        a.add_rr(REG_RDX(), REG_RDX())
        a.add_rr(REG_RDX(), REG_RDX())
        a.add_rr(REG_RDX(), REG_RDX())
        a.add_rr(REG_RAX(), REG_RDX())
        a.mov_rm64(REG_RAX(), REG_RAX(), 0)
        self.end_fn()
        a.bind_label(l_go)
        a.mov_ri32_sext(REG_RAX(), 0)
        self.end_fn()

        // __rt_list_set(rcx = list, rdx = idx, r8 = val)
        self.begin_fn("__rt_list_set", 32)
        let l_so = a.new_label()
        a.cmp_ri32(REG_RDX(), 0)
        a.jcc_rel32(CC_L(), l_so)
        a.mov_rm64(REG_R9(), REG_RCX(), 8)
        a.cmp_rr(REG_RDX(), REG_R9())
        a.jcc_rel32(CC_GE(), l_so)
        a.mov_rm64(REG_RAX(), REG_RCX(), 0)
        a.add_rr(REG_RDX(), REG_RDX())
        a.add_rr(REG_RDX(), REG_RDX())
        a.add_rr(REG_RDX(), REG_RDX())
        a.add_rr(REG_RAX(), REG_RDX())
        a.mov_mr64(REG_RAX(), 0, REG_R8())
        a.bind_label(l_so)
        self.end_fn()

        // __rt_list_len(rcx = list) -> i64
        self.begin_fn("__rt_list_len", 32)
        a.mov_rm64(REG_RAX(), REG_RCX(), 8)
        self.end_fn()

        // __rt_list_clear(rcx = list)
        self.begin_fn("__rt_list_clear", 32)
        a.mov_ri32_sext(REG_RAX(), 0)
        a.mov_mr64(REG_RCX(), 8, REG_RAX())
        self.end_fn()

        // __rt_list_contains(rcx = list, rdx = val, r8 = is_str) -> 0/1
        self.begin_fn("__rt_list_contains", 64)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_mr64(REG_RBP(), -16, REG_RDX())
        a.mov_mr64(REG_RBP(), -24, REG_R8())
        a.mov_ri32_sext(REG_RCX(), 0)
        a.mov_mr64(REG_RBP(), -32, REG_RCX())
        let l_cl = a.new_label()
        let l_cf = a.new_label()
        let l_ct = a.new_label()
        a.bind_label(l_cl)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_rm64(REG_R8(), REG_RCX(), 8)
        a.mov_rm64(REG_RDX(), REG_RBP(), -32)
        a.cmp_rr(REG_RDX(), REG_R8())
        a.jcc_rel32(CC_GE(), l_cf)
        a.call_rel32(self.lbl("__rt_list_get"))
        a.mov_rm64(REG_R8(), REG_RBP(), -24)
        let l_cint = a.new_label()
        a.test_rr(REG_R8(), REG_R8())
        a.jcc_rel32(CC_E(), l_cint)
        a.mov_rr(REG_RCX(), REG_RAX())
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.call_rel32(self.lbl("__rt_str_eq"))
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_NE(), l_ct)
        let l_cnext = a.new_label()
        a.jmp_rel32(l_cnext)
        a.bind_label(l_cint)
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.cmp_rr(REG_RAX(), REG_RDX())
        a.jcc_rel32(CC_E(), l_ct)
        a.bind_label(l_cnext)
        a.mov_rm64(REG_RDX(), REG_RBP(), -32)
        a.add_ri32(REG_RDX(), 1)
        a.mov_mr64(REG_RBP(), -32, REG_RDX())
        a.jmp_rel32(l_cl)
        a.bind_label(l_ct)
        a.mov_ri32_sext(REG_RAX(), 1)
        self.end_fn()
        a.bind_label(l_cf)
        a.mov_ri32_sext(REG_RAX(), 0)
        self.end_fn()

        // __rt_list_join(rcx = list, rdx = sep) -> str
        self.begin_fn("__rt_list_join", 64)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_mr64(REG_RBP(), -16, REG_RDX())
        a.call_rel32(self.lbl("__rt_bb_new"))
        a.mov_mr64(REG_RBP(), -24, REG_RAX()) // bb
        a.mov_ri32_sext(REG_RCX(), 0)
        a.mov_mr64(REG_RBP(), -32, REG_RCX()) // i
        let l_jl = a.new_label()
        let l_jd = a.new_label()
        a.bind_label(l_jl)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_rm64(REG_R8(), REG_RCX(), 8)
        a.mov_rm64(REG_RDX(), REG_RBP(), -32)
        a.cmp_rr(REG_RDX(), REG_R8())
        a.jcc_rel32(CC_GE(), l_jd)
        let l_jns = a.new_label()
        a.cmp_ri32(REG_RDX(), 0)
        a.jcc_rel32(CC_E(), l_jns)
        a.mov_rm64(REG_RCX(), REG_RBP(), -24)
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.call_rel32(self.lbl("__rt_bb_write_str"))
        a.bind_label(l_jns)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_rm64(REG_RDX(), REG_RBP(), -32)
        a.call_rel32(self.lbl("__rt_list_get"))
        a.mov_rm64(REG_RCX(), REG_RBP(), -24)
        a.mov_rr(REG_RDX(), REG_RAX())
        a.call_rel32(self.lbl("__rt_bb_write_str"))
        a.mov_rm64(REG_RCX(), REG_RBP(), -32)
        a.add_ri32(REG_RCX(), 1)
        a.mov_mr64(REG_RBP(), -32, REG_RCX())
        a.jmp_rel32(l_jl)
        a.bind_label(l_jd)
        a.mov_rm64(REG_RCX(), REG_RBP(), -24)
        a.call_rel32(self.lbl("__rt_bb_to_str"))
        a.mov_mr64(REG_RBP(), -40, REG_RAX())
        a.mov_rm64(REG_RCX(), REG_RBP(), -24)
        a.call_rel32(self.lbl("__rt_bb_free"))
        a.mov_rm64(REG_RAX(), REG_RBP(), -40)
        self.end_fn()
    }

    priv fn emit_map() {
        let a = self.asm
        // Map struct (32B): [0]=keys ptr, [8]=vals ptr, [16]=len, [24]=cap
        // __rt_map_new() -> ptr
        self.begin_fn("__rt_map_new", 48)
        a.mov_ri32_sext(REG_RCX(), 1)
        a.mov_ri32_sext(REG_RDX(), 32)
        a.call_rip_iat(self.imp_calloc)
        self.end_fn()

        // __rt_map_find(rcx = map, rdx = key, r8 = key_is_str) -> index or -1
        self.begin_fn("__rt_map_find", 64)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_mr64(REG_RBP(), -16, REG_RDX())
        a.mov_mr64(REG_RBP(), -24, REG_R8())
        a.mov_ri32_sext(REG_RCX(), 0)
        a.mov_mr64(REG_RBP(), -32, REG_RCX())
        let l_fl = a.new_label()
        let l_nf = a.new_label()
        a.bind_label(l_fl)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_rm64(REG_R8(), REG_RCX(), 16) // len
        a.mov_rm64(REG_RDX(), REG_RBP(), -32)
        a.cmp_rr(REG_RDX(), REG_R8())
        a.jcc_rel32(CC_GE(), l_nf)
        a.mov_rm64(REG_RAX(), REG_RCX(), 0)  // keys
        a.add_rr(REG_RDX(), REG_RDX())
        a.add_rr(REG_RDX(), REG_RDX())
        a.add_rr(REG_RDX(), REG_RDX())
        a.add_rr(REG_RAX(), REG_RDX())
        a.mov_rm64(REG_RAX(), REG_RAX(), 0)  // keys[i]
        a.mov_rm64(REG_R9(), REG_RBP(), -24)
        let l_fi = a.new_label()
        let l_match = a.new_label()
        let l_next = a.new_label()
        a.test_rr(REG_R9(), REG_R9())
        a.jcc_rel32(CC_E(), l_fi)
        a.mov_rr(REG_RCX(), REG_RAX())
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.call_rel32(self.lbl("__rt_str_eq"))
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_NE(), l_match)
        a.jmp_rel32(l_next)
        a.bind_label(l_fi)
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.cmp_rr(REG_RAX(), REG_RDX())
        a.jcc_rel32(CC_E(), l_match)
        a.bind_label(l_next)
        a.mov_rm64(REG_RCX(), REG_RBP(), -32)
        a.add_ri32(REG_RCX(), 1)
        a.mov_mr64(REG_RBP(), -32, REG_RCX())
        a.jmp_rel32(l_fl)
        a.bind_label(l_match)
        a.mov_rm64(REG_RAX(), REG_RBP(), -32)
        self.end_fn()
        a.bind_label(l_nf)
        a.mov_ri32_sext(REG_RAX(), -1)
        self.end_fn()

        // __rt_map_insert(rcx = map, rdx = key, r8 = val, r9 = key_is_str)
        self.begin_fn("__rt_map_insert", 80)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_mr64(REG_RBP(), -16, REG_RDX())
        a.mov_mr64(REG_RBP(), -24, REG_R8())
        a.mov_mr64(REG_RBP(), -32, REG_R9())
        a.mov_rr(REG_R8(), REG_R9())
        a.call_rel32(self.lbl("__rt_map_find"))
        let l_ins_new = a.new_label()
        a.cmp_ri32(REG_RAX(), 0)
        a.jcc_rel32(CC_L(), l_ins_new)
        // Update existing slot idx = RAX
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_rm64(REG_RDX(), REG_RCX(), 8) // vals
        a.add_rr(REG_RAX(), REG_RAX())
        a.add_rr(REG_RAX(), REG_RAX())
        a.add_rr(REG_RAX(), REG_RAX())
        a.add_rr(REG_RDX(), REG_RAX())
        a.mov_rm64(REG_R8(), REG_RBP(), -24)
        a.mov_mr64(REG_RDX(), 0, REG_R8())
        self.end_fn()
        a.bind_label(l_ins_new)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_rm64(REG_R8(), REG_RCX(), 16) // len
        a.mov_rm64(REG_R9(), REG_RCX(), 24) // cap
        let l_mfit = a.new_label()
        a.cmp_rr(REG_R8(), REG_R9())
        a.jcc_rel32(CC_L(), l_mfit)
        let l_mc = a.new_label()
        a.cmp_ri32(REG_R9(), 0)
        a.jcc_rel32(CC_G(), l_mc)
        a.mov_ri32_sext(REG_R9(), 8)
        let l_mcd = a.new_label()
        a.jmp_rel32(l_mcd)
        a.bind_label(l_mc)
        a.add_rr(REG_R9(), REG_R9())
        a.bind_label(l_mcd)
        a.mov_mr64(REG_RBP(), -40, REG_R9())
        a.mov_rr(REG_RDX(), REG_R9())
        a.add_rr(REG_RDX(), REG_RDX())
        a.add_rr(REG_RDX(), REG_RDX())
        a.add_rr(REG_RDX(), REG_RDX())
        a.mov_mr64(REG_RBP(), -48, REG_RDX())
        a.mov_rm64(REG_RCX(), REG_RCX(), 0)
        a.call_rip_iat(self.imp_realloc)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_mr64(REG_RCX(), 0, REG_RAX())
        a.mov_rm64(REG_RCX(), REG_RCX(), 8)
        a.mov_rm64(REG_RDX(), REG_RBP(), -48)
        a.call_rip_iat(self.imp_realloc)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_mr64(REG_RCX(), 8, REG_RAX())
        a.mov_rm64(REG_R9(), REG_RBP(), -40)
        a.mov_mr64(REG_RCX(), 24, REG_R9())
        a.bind_label(l_mfit)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_rm64(REG_R8(), REG_RCX(), 16)
        a.mov_rr(REG_R10(), REG_R8())
        a.add_rr(REG_R10(), REG_R10())
        a.add_rr(REG_R10(), REG_R10())
        a.add_rr(REG_R10(), REG_R10())
        a.mov_rm64(REG_RAX(), REG_RCX(), 0)
        a.add_rr(REG_RAX(), REG_R10())
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.mov_mr64(REG_RAX(), 0, REG_RDX())
        a.mov_rm64(REG_RAX(), REG_RCX(), 8)
        a.add_rr(REG_RAX(), REG_R10())
        a.mov_rm64(REG_RDX(), REG_RBP(), -24)
        a.mov_mr64(REG_RAX(), 0, REG_RDX())
        a.add_ri32(REG_R8(), 1)
        a.mov_mr64(REG_RCX(), 16, REG_R8())
        self.end_fn()

        // __rt_map_get(rcx = map, rdx = key, r8 = key_is_str) -> val or 0
        self.begin_fn("__rt_map_get", 48)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.call_rel32(self.lbl("__rt_map_find"))
        let l_mgz = a.new_label()
        a.cmp_ri32(REG_RAX(), 0)
        a.jcc_rel32(CC_L(), l_mgz)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_rm64(REG_RDX(), REG_RCX(), 8)
        a.add_rr(REG_RAX(), REG_RAX())
        a.add_rr(REG_RAX(), REG_RAX())
        a.add_rr(REG_RAX(), REG_RAX())
        a.add_rr(REG_RDX(), REG_RAX())
        a.mov_rm64(REG_RAX(), REG_RDX(), 0)
        self.end_fn()
        a.bind_label(l_mgz)
        a.mov_ri32_sext(REG_RAX(), 0)
        self.end_fn()

        // __rt_map_has_key(rcx = map, rdx = key, r8 = key_is_str) -> 0/1
        self.begin_fn("__rt_map_has_key", 48)
        a.call_rel32(self.lbl("__rt_map_find"))
        a.cmp_ri32(REG_RAX(), 0)
        a.setcc_u8(CC_GE(), REG_RAX())
        self.end_fn()

        // __rt_map_len(rcx = map) -> i64
        self.begin_fn("__rt_map_len", 32)
        a.mov_rm64(REG_RAX(), REG_RCX(), 16)
        self.end_fn()

        // __rt_map_keys(rcx = map) -> List ptr
        self.begin_fn("__rt_map_keys", 64)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.call_rel32(self.lbl("__rt_list_new"))
        a.mov_mr64(REG_RBP(), -16, REG_RAX())
        a.mov_ri32_sext(REG_RCX(), 0)
        a.mov_mr64(REG_RBP(), -24, REG_RCX())
        let l_kl = a.new_label()
        let l_kd = a.new_label()
        a.bind_label(l_kl)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_rm64(REG_R8(), REG_RCX(), 16)
        a.mov_rm64(REG_RDX(), REG_RBP(), -24)
        a.cmp_rr(REG_RDX(), REG_R8())
        a.jcc_rel32(CC_GE(), l_kd)
        a.mov_rm64(REG_RAX(), REG_RCX(), 0)
        a.add_rr(REG_RDX(), REG_RDX())
        a.add_rr(REG_RDX(), REG_RDX())
        a.add_rr(REG_RDX(), REG_RDX())
        a.add_rr(REG_RAX(), REG_RDX())
        a.mov_rm64(REG_RDX(), REG_RAX(), 0)
        a.mov_rm64(REG_RCX(), REG_RBP(), -16)
        a.call_rel32(self.lbl("__rt_list_push"))
        a.mov_rm64(REG_RCX(), REG_RBP(), -24)
        a.add_ri32(REG_RCX(), 1)
        a.mov_mr64(REG_RBP(), -24, REG_RCX())
        a.jmp_rel32(l_kl)
        a.bind_label(l_kd)
        a.mov_rm64(REG_RAX(), REG_RBP(), -16)
        self.end_fn()
    }

    priv fn emit_bytebuf() {
        let a = self.asm
        // ByteBuffer struct (32B): [0]=data, [8]=len, [16]=cap, [24]=pos
        self.begin_fn("__rt_bb_new", 48)
        a.mov_ri32_sext(REG_RCX(), 1)
        a.mov_ri32_sext(REG_RDX(), 32)
        a.call_rip_iat(self.imp_calloc)
        self.end_fn()

        // __rt_bb_write_u8(rcx = bb, rdx = byte)
        self.begin_fn("__rt_bb_write_u8", 64)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_mr64(REG_RBP(), -16, REG_RDX())
        a.mov_rm64(REG_R8(), REG_RCX(), 8)  // len
        a.mov_rm64(REG_R9(), REG_RCX(), 16) // cap
        let l_bfit = a.new_label()
        a.cmp_rr(REG_R8(), REG_R9())
        a.jcc_rel32(CC_L(), l_bfit)
        let l_bc = a.new_label()
        a.cmp_ri32(REG_R9(), 0)
        a.jcc_rel32(CC_G(), l_bc)
        a.mov_ri32_sext(REG_R9(), 256)
        let l_bcd = a.new_label()
        a.jmp_rel32(l_bcd)
        a.bind_label(l_bc)
        a.add_rr(REG_R9(), REG_R9())
        a.bind_label(l_bcd)
        a.mov_mr64(REG_RBP(), -24, REG_R9())
        a.mov_rm64(REG_RCX(), REG_RCX(), 0)
        a.mov_rr(REG_RDX(), REG_R9())
        a.call_rip_iat(self.imp_realloc)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_mr64(REG_RCX(), 0, REG_RAX())
        a.mov_rm64(REG_R9(), REG_RBP(), -24)
        a.mov_mr64(REG_RCX(), 16, REG_R9())
        a.bind_label(l_bfit)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_rm64(REG_RAX(), REG_RCX(), 0)
        a.mov_rm64(REG_R8(), REG_RCX(), 8)
        a.add_rr(REG_RAX(), REG_R8())
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.mov_mr8(REG_RAX(), 0, REG_RDX())
        a.add_ri32(REG_R8(), 1)
        a.mov_mr64(REG_RCX(), 8, REG_R8())
        self.end_fn()

        // __rt_bb_write_str(rcx = bb, rdx = s)
        self.begin_fn("__rt_bb_write_str", 64)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_mr64(REG_RBP(), -16, REG_RDX())
        a.mov_rr(REG_RCX(), REG_RDX())
        a.call_rel32(self.lbl("__rt_str_len"))
        a.mov_mr64(REG_RBP(), -24, REG_RAX())
        a.mov_ri32_sext(REG_RCX(), 0)
        a.mov_mr64(REG_RBP(), -32, REG_RCX())
        let l_bsl = a.new_label()
        let l_bsd = a.new_label()
        a.bind_label(l_bsl)
        a.mov_rm64(REG_RCX(), REG_RBP(), -32)
        a.mov_rm64(REG_RDX(), REG_RBP(), -24)
        a.cmp_rr(REG_RCX(), REG_RDX())
        a.jcc_rel32(CC_GE(), l_bsd)
        a.mov_rm64(REG_R8(), REG_RBP(), -16)
        a.add_rr(REG_R8(), REG_RCX())
        a.movzx_rm8(REG_RDX(), REG_R8(), 0)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.call_rel32(self.lbl("__rt_bb_write_u8"))
        a.mov_rm64(REG_RCX(), REG_RBP(), -32)
        a.add_ri32(REG_RCX(), 1)
        a.mov_mr64(REG_RBP(), -32, REG_RCX())
        a.jmp_rel32(l_bsl)
        a.bind_label(l_bsd)
        self.end_fn()

        // __rt_bb_to_str(rcx = bb) -> str
        self.begin_fn("__rt_bb_to_str", 64)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_rm64(REG_RDX(), REG_RCX(), 8) // len
        a.mov_mr64(REG_RBP(), -16, REG_RDX())
        a.mov_rr(REG_RCX(), REG_RDX())
        a.add_ri32(REG_RCX(), 1)
        a.call_rip_iat(self.imp_malloc)
        a.mov_mr64(REG_RBP(), -24, REG_RAX())
        a.mov_rm64(REG_R8(), REG_RBP(), -16)
        let l_bt_cp = a.new_label()
        a.cmp_ri32(REG_R8(), 0)
        a.jcc_rel32(CC_LE(), l_bt_cp)
        a.mov_rr(REG_RCX(), REG_RAX())
        a.mov_rm64(REG_R9(), REG_RBP(), -8)
        a.mov_rm64(REG_RDX(), REG_R9(), 0)
        a.call_rip_iat(self.imp_memcpy)
        a.mov_rm64(REG_RAX(), REG_RBP(), -24)
        a.bind_label(l_bt_cp)
        a.mov_rm64(REG_R8(), REG_RBP(), -16)
        a.add_rr(REG_R8(), REG_RAX())
        a.mov_ri32_sext(REG_RDX(), 0)
        a.mov_mr8(REG_R8(), 0, REG_RDX())
        self.end_fn()

        // __rt_bb_read_u8 / write_i32_le / read_i32_le / write_f64_le / seek / pos / len / reset / free
        self.begin_fn("__rt_bb_read_u8", 32)
        a.mov_rm64(REG_R8(), REG_RCX(), 24)
        a.mov_rm64(REG_RDX(), REG_RCX(), 0)
        a.add_rr(REG_RDX(), REG_R8())
        a.movzx_rm8(REG_RAX(), REG_RDX(), 0)
        a.add_ri32(REG_R8(), 1)
        a.mov_mr64(REG_RCX(), 24, REG_R8())
        self.end_fn()

        self.begin_fn("__rt_bb_write_i32_le", 48)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_mr64(REG_RBP(), -16, REG_RDX())
        a.mov_ri32_sext(REG_R8(), 0)
        a.mov_mr64(REG_RBP(), -24, REG_R8())
        let l_i32 = a.new_label()
        let l_i32d = a.new_label()
        a.bind_label(l_i32)
        a.mov_rm64(REG_R8(), REG_RBP(), -24)
        a.cmp_ri32(REG_R8(), 4)
        a.jcc_rel32(CC_GE(), l_i32d)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.call_rel32(self.lbl("__rt_bb_write_u8"))
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.mov_ri32_sext(REG_RCX(), 8)
        a.shr_cl(REG_RDX())
        a.mov_mr64(REG_RBP(), -16, REG_RDX())
        a.mov_rm64(REG_R8(), REG_RBP(), -24)
        a.add_ri32(REG_R8(), 1)
        a.mov_mr64(REG_RBP(), -24, REG_R8())
        a.jmp_rel32(l_i32)
        a.bind_label(l_i32d)
        self.end_fn()

        self.begin_fn("__rt_bb_write_f64_le", 48)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_mr64(REG_RBP(), -16, REG_RDX())
        a.mov_ri32_sext(REG_R8(), 0)
        a.mov_mr64(REG_RBP(), -24, REG_R8())
        let l_f64 = a.new_label()
        let l_f64d = a.new_label()
        a.bind_label(l_f64)
        a.mov_rm64(REG_R8(), REG_RBP(), -24)
        a.cmp_ri32(REG_R8(), 8)
        a.jcc_rel32(CC_GE(), l_f64d)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.call_rel32(self.lbl("__rt_bb_write_u8"))
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.mov_ri32_sext(REG_RCX(), 8)
        a.shr_cl(REG_RDX())
        a.mov_mr64(REG_RBP(), -16, REG_RDX())
        a.mov_rm64(REG_R8(), REG_RBP(), -24)
        a.add_ri32(REG_R8(), 1)
        a.mov_mr64(REG_RBP(), -24, REG_R8())
        a.jmp_rel32(l_f64)
        a.bind_label(l_f64d)
        self.end_fn()

        self.begin_fn("__rt_bb_seek", 32)
        a.mov_mr64(REG_RCX(), 24, REG_RDX())
        self.end_fn()

        self.begin_fn("__rt_bb_len", 32)
        a.mov_rm64(REG_RAX(), REG_RCX(), 8)
        self.end_fn()

        self.begin_fn("__rt_bb_pos", 32)
        a.mov_rm64(REG_RAX(), REG_RCX(), 24)
        self.end_fn()

        self.begin_fn("__rt_bb_reset", 32)
        a.mov_ri32_sext(REG_RDX(), 0)
        a.mov_mr64(REG_RCX(), 24, REG_RDX())
        self.end_fn()

        self.begin_fn("__rt_bb_free", 48)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_rm64(REG_RCX(), REG_RCX(), 0)
        let l_bfd = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_bfd)
        a.call_rip_iat(self.imp_free)
        a.bind_label(l_bfd)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.call_rip_iat(self.imp_free)
        self.end_fn()

        // __rt_bin_write_file(rcx = bb, rdx = path) -> 1/0
        self.begin_fn("__rt_bin_write_file", 64)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_rr(REG_RCX(), REG_RDX())
        a.lea_rip_rdata(REG_RDX(), self.s_wb)
        a.call_rip_iat(self.imp_fopen)
        let l_bwf = a.new_label()
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_E(), l_bwf)
        a.mov_mr64(REG_RBP(), -16, REG_RAX()) // FILE*
        a.mov_rm64(REG_R10(), REG_RBP(), -8)  // bb
        a.mov_rm64(REG_RCX(), REG_R10(), 0)   // data
        a.mov_ri32_sext(REG_RDX(), 1)
        a.mov_rm64(REG_R8(), REG_R10(), 8)    // len
        a.mov_rr(REG_R9(), REG_RAX())
        a.call_rip_iat(self.imp_fwrite)
        a.mov_rm64(REG_RCX(), REG_RBP(), -16)
        a.call_rip_iat(self.imp_fclose)
        a.mov_ri32_sext(REG_RAX(), 1)
        self.end_fn()
        a.bind_label(l_bwf)
        a.mov_ri32_sext(REG_RAX(), 0)
        self.end_fn()
    }

    priv fn emit_os_fs_env() {
        let a = self.asm
        // File.exists(rcx = path) -> 0/1
        self.begin_fn("__rt_file_exists", 48)
        a.call_rip_iat(self.imp_get_attrs)
        a.mov_ri32_sext(REG_RCX(), -1)
        a.cmp_rr(REG_RAX(), REG_RCX())
        a.setcc_u8(CC_NE(), REG_RAX())
        self.end_fn()

        // File.read_to_string(rcx = path) -> str
        self.begin_fn("__rt_file_read", 64)
        a.lea_rip_rdata(REG_RDX(), self.s_rb)
        a.call_rip_iat(self.imp_fopen)
        let l_fr_f = a.new_label()
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_E(), l_fr_f)
        a.mov_mr64(REG_RBP(), -8, REG_RAX())
        a.mov_rr(REG_RCX(), REG_RAX())
        a.mov_ri32_sext(REG_RDX(), 0)
        a.mov_ri32_sext(REG_R8(), 2) // SEEK_END
        a.call_rip_iat(self.imp_fseek)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.call_rip_iat(self.imp_ftell)
        a.mov_mr64(REG_RBP(), -16, REG_RAX()) // size
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_ri32_sext(REG_RDX(), 0)
        a.mov_ri32_sext(REG_R8(), 0) // SEEK_SET
        a.call_rip_iat(self.imp_fseek)
        a.mov_rm64(REG_RCX(), REG_RBP(), -16)
        a.add_ri32(REG_RCX(), 1)
        a.call_rip_iat(self.imp_malloc)
        a.mov_mr64(REG_RBP(), -24, REG_RAX()) // buf
        a.mov_rr(REG_RCX(), REG_RAX())
        a.mov_ri32_sext(REG_RDX(), 1)
        a.mov_rm64(REG_R8(), REG_RBP(), -16)
        a.mov_rm64(REG_R9(), REG_RBP(), -8)
        a.call_rip_iat(self.imp_fread)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.call_rip_iat(self.imp_fclose)
        a.mov_rm64(REG_RAX(), REG_RBP(), -24)
        a.mov_rm64(REG_RCX(), REG_RBP(), -16)
        a.add_rr(REG_RCX(), REG_RAX())
        a.mov_ri32_sext(REG_RDX(), 0)
        a.mov_mr8(REG_RCX(), 0, REG_RDX())
        self.end_fn()
        a.bind_label(l_fr_f)
        a.lea_rip_rdata(REG_RAX(), self.s_empty)
        self.end_fn()

        // File.write_string(rcx = path, rdx = text) -> 0/1
        self.begin_fn("__rt_file_write", 64)
        a.mov_mr64(REG_RBP(), -8, REG_RDX())
        a.lea_rip_rdata(REG_RDX(), self.s_wb)
        a.call_rip_iat(self.imp_fopen)
        let l_fw_f = a.new_label()
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_E(), l_fw_f)
        a.mov_mr64(REG_RBP(), -16, REG_RAX())
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.call_rel32(self.lbl("__rt_str_len"))
        a.mov_rr(REG_R8(), REG_RAX())
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_ri32_sext(REG_RDX(), 1)
        a.mov_rm64(REG_R9(), REG_RBP(), -16)
        a.call_rip_iat(self.imp_fwrite)
        a.mov_rm64(REG_RCX(), REG_RBP(), -16)
        a.call_rip_iat(self.imp_fclose)
        a.mov_ri32_sext(REG_RAX(), 1)
        self.end_fn()
        a.bind_label(l_fw_f)
        a.mov_ri32_sext(REG_RAX(), 0)
        self.end_fn()

        // File.remove(rcx = path) -> bool
        self.begin_fn("__rt_file_remove", 48)
        a.call_rip_iat(self.imp_delete_file)
        a.cmp_ri32(REG_RAX(), 0)
        a.setcc_u8(CC_NE(), REG_RAX())
        self.end_fn()

        // File.copy(rcx = src, rdx = dst) -> bool
        self.begin_fn("__rt_file_copy", 48)
        a.mov_ri32_sext(REG_R8(), 0)
        a.call_rip_iat(self.imp_copy_file)
        a.cmp_ri32(REG_RAX(), 0)
        a.setcc_u8(CC_NE(), REG_RAX())
        self.end_fn()

        // Directory.create(rcx = path) -> bool
        self.begin_fn("__rt_dir_create", 48)
        a.mov_ri32_sext(REG_RDX(), 0)
        a.call_rip_iat(self.imp_create_dir)
        a.cmp_ri32(REG_RAX(), 0)
        a.setcc_u8(CC_NE(), REG_RAX())
        self.end_fn()

        // Env.get(rcx = key) -> str
        self.begin_fn("__rt_env_get", 48)
        a.lea_rip_data(REG_RDX(), self.env_buf_off)
        a.mov_ri32_sext(REG_R8(), 4096)
        a.call_rip_iat(self.imp_get_env)
        let l_eg = a.new_label()
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_NE(), l_eg)
        a.lea_rip_rdata(REG_RAX(), self.s_empty)
        self.end_fn()
        a.bind_label(l_eg)
        a.lea_rip_data(REG_RAX(), self.env_buf_off)
        self.end_fn()

        // Env.cwd() -> str
        self.begin_fn("__rt_env_cwd", 48)
        a.mov_ri32_sext(REG_RCX(), 4096)
        a.call_rip_iat(self.imp_malloc)
        a.mov_mr64(REG_RBP(), -8, REG_RAX())
        a.mov_ri32_sext(REG_RCX(), 4096)
        a.mov_rr(REG_RDX(), REG_RAX())
        a.call_rip_iat(self.imp_get_cwd)
        a.mov_rm64(REG_RAX(), REG_RBP(), -8)
        self.end_fn()

        // Env.os_name() -> "windows"
        self.begin_fn("__rt_env_os", 32)
        a.lea_rip_rdata(REG_RAX(), self.s_windows)
        self.end_fn()

        // Env.exit(rcx = code)
        self.begin_fn("__rt_env_exit", 48)
        a.call_rip_iat(self.imp_exit_process)
        self.end_fn()

        // Process.execute(rcx = cmd) -> i64 (CreateProcessA with system fallback)
        self.begin_fn("__rt_proc_exec", 160)
        a.mov_mr64(REG_RBP(), -8, REG_RCX()) // cmdline
        let l_pe_ok = a.new_label()
        let l_pe_fb = a.new_label()
        let l_pe_done = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_NE(), l_pe_ok)
        a.mov_ri32_sext(REG_RAX(), -1)
        a.jmp_rel32(l_pe_done)
        a.bind_label(l_pe_ok)
        // mutable_cmd = malloc(strlen(cmd) + 1)
        a.call_rip_iat(self.imp_strlen)
        a.add_ri32(REG_RAX(), 1)
        a.mov_mr64(REG_RBP(), -16, REG_RAX()) // clen+1
        a.mov_rr(REG_RCX(), REG_RAX())
        a.call_rip_iat(self.imp_malloc)
        a.mov_mr64(REG_RBP(), -24, REG_RAX()) // mut_cmd
        a.mov_rr(REG_RCX(), REG_RAX())
        a.mov_rm64(REG_RDX(), REG_RBP(), -8)
        a.mov_rm64(REG_R8(), REG_RBP(), -16)
        a.call_rip_iat(self.imp_memcpy)
        // si = calloc(1, 128), *(u32*)si = 104
        a.mov_ri32_sext(REG_RCX(), 1)
        a.mov_ri32_sext(REG_RDX(), 128)
        a.call_rip_iat(self.imp_calloc)
        a.mov_mr64(REG_RBP(), -32, REG_RAX()) // si
        a.mov_ri32_sext(REG_RCX(), 104)
        a.mov_mr64(REG_RAX(), 0, REG_RCX())
        // pi = calloc(1, 32) ([24] also holds exit_code dword)
        a.mov_ri32_sext(REG_RCX(), 1)
        a.mov_ri32_sext(REG_RDX(), 32)
        a.call_rip_iat(self.imp_calloc)
        a.mov_mr64(REG_RBP(), -40, REG_RAX()) // pi
        // CreateProcessA(0, mut_cmd, 0, 0, 1, 0, 0, 0, si, pi)
        a.mov_mr64(REG_RSP(), 72, REG_RAX())
        a.mov_rm64(REG_RCX(), REG_RBP(), -32)
        a.mov_mr64(REG_RSP(), 64, REG_RCX())
        a.mov_ri32_sext(REG_RAX(), 0)
        a.mov_mr64(REG_RSP(), 56, REG_RAX())
        a.mov_mr64(REG_RSP(), 48, REG_RAX())
        a.mov_mr64(REG_RSP(), 40, REG_RAX())
        a.mov_ri32_sext(REG_RCX(), 1)
        a.mov_mr64(REG_RSP(), 32, REG_RCX())
        a.mov_ri32_sext(REG_RCX(), 0)
        a.mov_rm64(REG_RDX(), REG_RBP(), -24)
        a.mov_ri32_sext(REG_R8(), 0)
        a.mov_ri32_sext(REG_R9(), 0)
        a.call_rip_iat(self.imp_create_proc)
        a.mov_mr64(REG_RBP(), -48, REG_RAX()) // ok
        a.mov_rm64(REG_RCX(), REG_RBP(), -24)
        a.call_rip_iat(self.imp_free)
        a.mov_rm64(REG_RAX(), REG_RBP(), -48)
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_E(), l_pe_fb)
        // WaitForSingleObject(pi->hProcess, INFINITE)
        a.mov_rm64(REG_RAX(), REG_RBP(), -40)
        a.mov_rm64(REG_RCX(), REG_RAX(), 0)
        a.mov_ri32_sext(REG_RDX(), -1)
        a.call_rip_iat(self.imp_wait_obj)
        // GetExitCodeProcess(pi->hProcess, pi + 24)
        a.mov_rm64(REG_RAX(), REG_RBP(), -40)
        a.mov_rm64(REG_RCX(), REG_RAX(), 0)
        a.mov_rr(REG_RDX(), REG_RAX())
        a.add_ri32(REG_RDX(), 24)
        a.call_rip_iat(self.imp_get_exit)
        // exit_code = *(i32*)(pi + 24) zero-extended
        a.mov_rm64(REG_RAX(), REG_RBP(), -40)
        a.mov_rm64(REG_RAX(), REG_RAX(), 24)
        a.mov_mr64(REG_RBP(), -48, REG_RAX())
        // CloseHandle(hProcess), CloseHandle(hThread), free(si), free(pi)
        a.mov_rm64(REG_RAX(), REG_RBP(), -40)
        a.mov_rm64(REG_RCX(), REG_RAX(), 0)
        a.call_rip_iat(self.imp_close_handle)
        a.mov_rm64(REG_RAX(), REG_RBP(), -40)
        a.mov_rm64(REG_RCX(), REG_RAX(), 8)
        a.call_rip_iat(self.imp_close_handle)
        a.mov_rm64(REG_RCX(), REG_RBP(), -32)
        a.call_rip_iat(self.imp_free)
        a.mov_rm64(REG_RCX(), REG_RBP(), -40)
        a.call_rip_iat(self.imp_free)
        a.mov_rm64(REG_RAX(), REG_RBP(), -48)
        a.jmp_rel32(l_pe_done)
        // Fallback: free(si), free(pi), call system(cmdline)
        a.bind_label(l_pe_fb)
        a.mov_rm64(REG_RCX(), REG_RBP(), -32)
        a.call_rip_iat(self.imp_free)
        a.mov_rm64(REG_RCX(), REG_RBP(), -40)
        a.call_rip_iat(self.imp_free)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.call_rip_iat(self.imp_system)
        a.movsxd(REG_RAX(), REG_RAX())
        a.bind_label(l_pe_done)
        self.end_fn()

        // Env.args() -> List<str> parsed from GetCommandLineA()
        self.emit_env_args()
    }

    priv fn emit_env_args() {
        let a = self.asm
        // Parse GetCommandLineA() handling "..." quoted tokens and whitespace
        self.begin_fn("__rt_env_args", 80)
        a.call_rel32(self.lbl("__rt_list_new"))
        a.mov_mr64(REG_RBP(), -8, REG_RAX()) // list
        a.call_rip_iat(self.imp_get_cmd)
        a.mov_mr64(REG_RBP(), -16, REG_RAX()) // p
        let l_al = a.new_label()
        let l_ad = a.new_label()
        a.bind_label(l_al)
        // Skip whitespace
        a.mov_rm64(REG_RCX(), REG_RBP(), -16)
        a.movzx_rm8(REG_RAX(), REG_RCX(), 0)
        a.cmp_ri32(REG_RAX(), 0)
        a.jcc_rel32(CC_E(), l_ad)
        let l_skp = a.new_label()
        a.cmp_ri32(REG_RAX(), 32)
        a.jcc_rel32(CC_A(), l_skp)
        a.add_ri32(REG_RCX(), 1)
        a.mov_mr64(REG_RBP(), -16, REG_RCX())
        a.jmp_rel32(l_al)
        a.bind_label(l_skp)
        // Check quote vs bare token
        let l_bare = a.new_label()
        a.cmp_ri32(REG_RAX(), 34) // '"'
        a.jcc_rel32(CC_NE(), l_bare)
        a.add_ri32(REG_RCX(), 1)
        a.mov_mr64(REG_RBP(), -24, REG_RCX()) // start
        let l_q2 = a.new_label()
        let l_q2d = a.new_label()
        a.bind_label(l_q2)
        a.movzx_rm8(REG_RAX(), REG_RCX(), 0)
        a.cmp_ri32(REG_RAX(), 0)
        a.jcc_rel32(CC_E(), l_q2d)
        a.cmp_ri32(REG_RAX(), 34)
        a.jcc_rel32(CC_E(), l_q2d)
        a.add_ri32(REG_RCX(), 1)
        a.jmp_rel32(l_q2)
        a.bind_label(l_q2d)
        a.mov_mr64(REG_RBP(), -32, REG_RCX()) // end
        let l_qa = a.new_label()
        a.movzx_rm8(REG_RAX(), REG_RCX(), 0)
        a.cmp_ri32(REG_RAX(), 34)
        a.jcc_rel32(CC_NE(), l_qa)
        a.add_ri32(REG_RCX(), 1)
        a.bind_label(l_qa)
        a.mov_mr64(REG_RBP(), -16, REG_RCX())
        let l_push_tok = a.new_label()
        a.jmp_rel32(l_push_tok)
        a.bind_label(l_bare)
        a.mov_mr64(REG_RBP(), -24, REG_RCX())
        let l_b2 = a.new_label()
        let l_b2d = a.new_label()
        a.bind_label(l_b2)
        a.movzx_rm8(REG_RAX(), REG_RCX(), 0)
        a.cmp_ri32(REG_RAX(), 32)
        a.jcc_rel32(CC_LE(), l_b2d)
        a.add_ri32(REG_RCX(), 1)
        a.jmp_rel32(l_b2)
        a.bind_label(l_b2d)
        a.mov_mr64(REG_RBP(), -32, REG_RCX())
        a.mov_mr64(REG_RBP(), -16, REG_RCX())
        a.bind_label(l_push_tok)
        a.mov_rm64(REG_RCX(), REG_RBP(), -24)
        a.mov_ri32_sext(REG_RDX(), 0)
        a.mov_rm64(REG_R8(), REG_RBP(), -32)
        a.sub_rr(REG_R8(), REG_RCX())
        a.call_rel32(self.lbl("__rt_str_slice"))
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_rr(REG_RDX(), REG_RAX())
        a.call_rel32(self.lbl("__rt_list_push"))
        a.jmp_rel32(l_al)
        a.bind_label(l_ad)
        a.mov_rm64(REG_RAX(), REG_RBP(), -8)
        self.end_fn()

        // Env.arg_count() -> i64
        self.begin_fn("__rt_env_arg_count", 32)
        a.call_rel32(self.lbl("__rt_env_args"))
        a.mov_rr(REG_RCX(), REG_RAX())
        a.call_rel32(self.lbl("__rt_list_len"))
        self.end_fn()
    }
}
