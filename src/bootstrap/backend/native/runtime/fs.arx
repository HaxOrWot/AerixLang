import "./mod.arx"

extend NativeRt {
    priv fn emit_os_fs_env() {
        let a = self.asmb
        // File.exists(rcx = path) -> 0/1
        self.begin_fn("__rt_file_exists", 48)
        let l_fe_no = a.new_label()
        let l_fe_done = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_fe_no)
        a.call_rip_iat(self.imp_get_attrs)
        a.movsxd(REG_RAX(), REG_RAX())
        a.cmp_ri32(REG_RAX(), -1)
        a.jcc_rel32(CC_E(), l_fe_no)
        a.mov_rr(REG_RCX(), REG_RAX())
        a.mov_ri32_sext(REG_RDX(), 16)
        a.and_rr(REG_RCX(), REG_RDX())
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_NE(), l_fe_no)
        a.mov_ri32_sext(REG_RAX(), 1)
        a.jmp_rel32(l_fe_done)
        a.bind_label(l_fe_no)
        a.mov_ri32_sext(REG_RAX(), 0)
        a.bind_label(l_fe_done)
        self.end_fn()

        // Directory.exists(rcx = path) -> 0/1
        self.begin_fn("__rt_dir_exists", 48)
        let l_de_no = a.new_label()
        let l_de_done = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_de_no)
        a.call_rip_iat(self.imp_get_attrs)
        a.movsxd(REG_RAX(), REG_RAX())
        a.cmp_ri32(REG_RAX(), -1)
        a.jcc_rel32(CC_E(), l_de_no)
        a.mov_ri32_sext(REG_RCX(), 16)
        a.and_rr(REG_RAX(), REG_RCX())
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_E(), l_de_no)
        a.mov_ri32_sext(REG_RAX(), 1)
        a.jmp_rel32(l_de_done)
        a.bind_label(l_de_no)
        a.mov_ri32_sext(REG_RAX(), 0)
        a.bind_label(l_de_done)
        self.end_fn()

        // File.read_to_string(rcx = path) -> str
        self.begin_fn("__rt_file_read", 64)
        let l_fr_f = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_fr_f)
        a.lea_rip_rdata(REG_RDX(), self.s_rb)
        a.call_rip_iat(self.imp_fopen)
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_E(), l_fr_f)
        a.mov_mr64(REG_RBP(), -8, REG_RAX())
        a.mov_rr(REG_RCX(), REG_RAX())
        a.mov_ri32_sext(REG_RDX(), 0)
        a.mov_ri32_sext(REG_R8(), 2) // SEEK_END
        a.call_rip_iat(self.imp_fseek)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.call_rip_iat(self.imp_ftell)
        a.mov_mr64(REG_RBP(), -16, REG_RAX()) // size
        let l_fr_err = a.new_label()
        a.cmp_ri32(REG_RAX(), 0)
        a.jcc_rel32(CC_L(), l_fr_err)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_ri32_sext(REG_RDX(), 0)
        a.mov_ri32_sext(REG_R8(), 0) // SEEK_SET
        a.call_rip_iat(self.imp_fseek)
        a.mov_rm64(REG_RCX(), REG_RBP(), -16)
        a.add_ri32(REG_RCX(), 1)
        a.call_rel32(self.lbl("__rt_arc_alloc"))
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_E(), l_fr_err)
        a.mov_mr64(REG_RBP(), -24, REG_RAX()) // buf
        a.mov_rr(REG_RCX(), REG_RAX())
        a.mov_ri32_sext(REG_RDX(), 1)
        a.mov_rm64(REG_R8(), REG_RBP(), -16)
        a.mov_rm64(REG_R9(), REG_RBP(), -8)
        a.call_rip_iat(self.imp_fread)
        a.mov_mr64(REG_RBP(), -32, REG_RAX()) // nread
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.call_rip_iat(self.imp_fclose)
        a.mov_rm64(REG_RAX(), REG_RBP(), -24)
        a.mov_rm64(REG_RCX(), REG_RBP(), -32)
        a.add_rr(REG_RCX(), REG_RAX())
        a.mov_ri32_sext(REG_RDX(), 0)
        a.mov_mr8(REG_RCX(), 0, REG_RDX())
        self.end_fn()
        a.bind_label(l_fr_err)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.call_rip_iat(self.imp_fclose)
        a.bind_label(l_fr_f)
        a.lea_rip_rdata(REG_RAX(), self.s_empty)
        self.end_fn()

        // File.write_string(rcx = path, rdx = text) -> 0/1
        self.begin_fn("__rt_file_write", 64)
        let l_fw_f = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_fw_f)
        a.mov_mr64(REG_RBP(), -8, REG_RDX())
        a.lea_rip_rdata(REG_RDX(), self.s_wb)
        a.call_rip_iat(self.imp_fopen)
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_E(), l_fw_f)
        a.mov_mr64(REG_RBP(), -16, REG_RAX())
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.call_rel32(self.lbl("__rt_str_len"))
        a.mov_mr64(REG_RBP(), -24, REG_RAX()) // len
        let l_fw_empty = a.new_label()
        a.cmp_ri32(REG_RAX(), 0)
        a.jcc_rel32(CC_LE(), l_fw_empty)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_ri32_sext(REG_RDX(), 1)
        a.mov_rm64(REG_R8(), REG_RBP(), -24)
        a.mov_rm64(REG_R9(), REG_RBP(), -16)
        a.call_rip_iat(self.imp_fwrite)
        a.mov_rm64(REG_RCX(), REG_RBP(), -24)
        a.cmp_rr(REG_RAX(), REG_RCX())
        let l_fw_err = a.new_label()
        a.jcc_rel32(CC_NE(), l_fw_err)
        a.bind_label(l_fw_empty)
        a.mov_rm64(REG_RCX(), REG_RBP(), -16)
        a.call_rip_iat(self.imp_fclose)
        a.mov_ri32_sext(REG_RAX(), 1)
        self.end_fn()
        a.bind_label(l_fw_err)
        a.mov_rm64(REG_RCX(), REG_RBP(), -16)
        a.call_rip_iat(self.imp_fclose)
        a.bind_label(l_fw_f)
        a.mov_ri32_sext(REG_RAX(), 0)
        self.end_fn()

        // File.append_string(rcx = path, rdx = text) -> 0/1
        self.begin_fn("__rt_file_append", 64)
        let l_fa_f = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_fa_f)
        a.mov_mr64(REG_RBP(), -8, REG_RDX())
        a.lea_rip_rdata(REG_RDX(), self.s_ab)
        a.call_rip_iat(self.imp_fopen)
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_E(), l_fa_f)
        a.mov_mr64(REG_RBP(), -16, REG_RAX())
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.call_rel32(self.lbl("__rt_str_len"))
        a.mov_mr64(REG_RBP(), -24, REG_RAX()) // len
        let l_fa_empty = a.new_label()
        a.cmp_ri32(REG_RAX(), 0)
        a.jcc_rel32(CC_LE(), l_fa_empty)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_ri32_sext(REG_RDX(), 1)
        a.mov_rm64(REG_R8(), REG_RBP(), -24)
        a.mov_rm64(REG_R9(), REG_RBP(), -16)
        a.call_rip_iat(self.imp_fwrite)
        a.mov_rm64(REG_RCX(), REG_RBP(), -24)
        a.cmp_rr(REG_RAX(), REG_RCX())
        let l_fa_err = a.new_label()
        a.jcc_rel32(CC_NE(), l_fa_err)
        a.bind_label(l_fa_empty)
        a.mov_rm64(REG_RCX(), REG_RBP(), -16)
        a.call_rip_iat(self.imp_fclose)
        a.mov_ri32_sext(REG_RAX(), 1)
        self.end_fn()
        a.bind_label(l_fa_err)
        a.mov_rm64(REG_RCX(), REG_RBP(), -16)
        a.call_rip_iat(self.imp_fclose)
        a.bind_label(l_fa_f)
        a.mov_ri32_sext(REG_RAX(), 0)
        self.end_fn()

        // File.remove(rcx = path) -> bool
        self.begin_fn("__rt_file_remove", 48)
        let l_rm_fail = a.new_label()
        let l_rm_done = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_rm_fail)
        a.call_rip_iat(self.imp_delete_file)
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_E(), l_rm_fail)
        a.mov_ri32_sext(REG_RAX(), 1)
        a.jmp_rel32(l_rm_done)
        a.bind_label(l_rm_fail)
        a.mov_ri32_sext(REG_RAX(), 0)
        a.bind_label(l_rm_done)
        self.end_fn()

        // File.copy(rcx = src, rdx = dst) -> bool
        self.begin_fn("__rt_file_copy", 48)
        let l_cp_fail = a.new_label()
        let l_cp_done = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_cp_fail)
        a.test_rr(REG_RDX(), REG_RDX())
        a.jcc_rel32(CC_E(), l_cp_fail)
        a.mov_ri32_sext(REG_R8(), 0)
        a.call_rip_iat(self.imp_copy_file)
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_E(), l_cp_fail)
        a.mov_ri32_sext(REG_RAX(), 1)
        a.jmp_rel32(l_cp_done)
        a.bind_label(l_cp_fail)
        a.mov_ri32_sext(REG_RAX(), 0)
        a.bind_label(l_cp_done)
        self.end_fn()

        // Directory.create(rcx = path) -> bool
        self.begin_fn("__rt_dir_create", 48)
        let l_dc_fail = a.new_label()
        let l_dc_ok = a.new_label()
        let l_dc_done = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_dc_fail)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.call_rel32(self.lbl("__rt_dir_exists"))
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_NE(), l_dc_ok)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_ri32_sext(REG_RDX(), 0)
        a.call_rip_iat(self.imp_create_dir)
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_NE(), l_dc_ok)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.call_rel32(self.lbl("__rt_dir_exists"))
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_NE(), l_dc_ok)
        a.bind_label(l_dc_fail)
        a.mov_ri32_sext(REG_RAX(), 0)
        a.jmp_rel32(l_dc_done)
        a.bind_label(l_dc_ok)
        a.mov_ri32_sext(REG_RAX(), 1)
        a.bind_label(l_dc_done)
        self.end_fn()

        // Directory.remove(rcx = path) -> bool
        self.begin_fn("__rt_dir_remove", 48)
        let l_dr_fail = a.new_label()
        let l_dr_done = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_dr_fail)
        a.call_rip_iat(self.imp_remove_dir)
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_E(), l_dr_fail)
        a.mov_ri32_sext(REG_RAX(), 1)
        a.jmp_rel32(l_dr_done)
        a.bind_label(l_dr_fail)
        a.mov_ri32_sext(REG_RAX(), 0)
        a.bind_label(l_dr_done)
        self.end_fn()

        // Env.get(rcx = key) -> str
        self.begin_fn("__rt_env_get", 48)
        let l_eg_ok = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_NE(), l_eg_ok)
        a.lea_rip_rdata(REG_RAX(), self.s_empty)
        self.end_fn()
        a.bind_label(l_eg_ok)
        a.lea_rip_data(REG_RDX(), self.env_buf_off)
        a.mov_ri32_sext(REG_R8(), 4096)
        a.call_rip_iat(self.imp_get_env)
        let l_eg = a.new_label()
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_NE(), l_eg)
        a.lea_rip_rdata(REG_RAX(), self.s_empty)
        self.end_fn()
        a.bind_label(l_eg)
        a.lea_rip_data(REG_RCX(), self.env_buf_off)
        a.call_rel32(self.lbl("__rt_str_dup"))
        self.end_fn()

        // Env.set(rcx = key, rdx = val) -> bool
        self.begin_fn("__rt_env_set", 48)
        let l_es_key_ok = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_NE(), l_es_key_ok)
        a.mov_ri32_sext(REG_RAX(), 0)
        self.end_fn()
        a.bind_label(l_es_key_ok)
        let l_es_val_ok = a.new_label()
        a.test_rr(REG_RDX(), REG_RDX())
        a.jcc_rel32(CC_NE(), l_es_val_ok)
        a.lea_rip_rdata(REG_RDX(), self.s_empty)
        a.bind_label(l_es_val_ok)
        a.call_rip_iat(self.imp_set_env)
        a.cmp_ri32(REG_RAX(), 0)
        a.setcc_u8(CC_NE(), REG_RAX())
        self.end_fn()

        // arx_env_set alias
        self.begin_fn("arx_env_set", 48)
        a.call_rel32(self.lbl("__rt_env_set"))
        self.end_fn()

        // Env.cwd() -> str
        self.begin_fn("__rt_env_cwd", 48)
        a.mov_ri32_sext(REG_RCX(), 4096)
        a.call_rel32(self.lbl("__rt_arc_alloc"))
        a.mov_mr64(REG_RBP(), -8, REG_RAX())
        a.mov_ri32_sext(REG_RCX(), 4096)
        a.mov_rr(REG_RDX(), REG_RAX())
        a.call_rip_iat(self.imp_get_cwd)
        a.mov_rm64(REG_RAX(), REG_RBP(), -8)
        self.end_fn()

        // Env.os_name() -> "windows"
        self.begin_fn("__rt_env_os", 32)
        a.lea_rip_rdata(REG_RAX(), self.s_windows)
        self.end_fn()

        // Env.exit(rcx = code)
        self.begin_fn("__rt_env_exit", 48)
        a.call_rip_iat(self.imp_exit_process)
        self.end_fn()

        // Process.execute(rcx = cmd) -> i64 (CreateProcessA with system fallback)
        self.begin_fn("__rt_proc_exec", 160)
        a.mov_mr64(REG_RBP(), -8, REG_RCX()) // cmdline
        let l_pe_ok = a.new_label()
        let l_pe_fb = a.new_label()
        let l_pe_done = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_NE(), l_pe_ok)
        a.mov_ri32_sext(REG_RAX(), -1)
        a.jmp_rel32(l_pe_done)
        a.bind_label(l_pe_ok)
        // mutable_cmd = malloc(strlen(cmd) + 1)
        a.call_rip_iat(self.imp_strlen)
        a.add_ri32(REG_RAX(), 1)
        a.mov_mr64(REG_RBP(), -16, REG_RAX()) // clen+1
        a.mov_rr(REG_RCX(), REG_RAX())
        a.call_rip_iat(self.imp_malloc)
        a.mov_mr64(REG_RBP(), -24, REG_RAX()) // mut_cmd
        a.mov_rr(REG_RCX(), REG_RAX())
        a.mov_rm64(REG_RDX(), REG_RBP(), -8)
        a.mov_rm64(REG_R8(), REG_RBP(), -16)
        a.call_rip_iat(self.imp_memcpy)
        // si = calloc(1, 128), *(u32*)si = 104
        a.mov_ri32_sext(REG_RCX(), 1)
        a.mov_ri32_sext(REG_RDX(), 128)
        a.call_rip_iat(self.imp_calloc)
        a.mov_mr64(REG_RBP(), -32, REG_RAX()) // si
        a.mov_ri32_sext(REG_RCX(), 104)
        a.mov_mr64(REG_RAX(), 0, REG_RCX())
        // si->dwFlags = STARTF_USESTDHANDLES (256) at offset 60
        a.mov_ri32_sext(REG_RCX(), 256)
        a.mov_mr32(REG_RAX(), 60, REG_RCX())
        // si->hStdInput = GetStdHandle(-10) at offset 80
        a.mov_ri32_sext(REG_RCX(), -10)
        a.call_rip_iat(self.imp_get_std_handle)
        a.mov_rm64(REG_RCX(), REG_RBP(), -32)
        a.mov_mr64(REG_RCX(), 80, REG_RAX())
        // si->hStdOutput = GetStdHandle(-11) at offset 88
        a.mov_ri32_sext(REG_RCX(), -11)
        a.call_rip_iat(self.imp_get_std_handle)
        a.mov_rm64(REG_RCX(), REG_RBP(), -32)
        a.mov_mr64(REG_RCX(), 88, REG_RAX())
        // si->hStdError = GetStdHandle(-12) at offset 96
        a.mov_ri32_sext(REG_RCX(), -12)
        a.call_rip_iat(self.imp_get_std_handle)
        a.mov_rm64(REG_RCX(), REG_RBP(), -32)
        a.mov_mr64(REG_RCX(), 96, REG_RAX())
        // pi = calloc(1, 32) ([24] also holds exit_code dword)
        a.mov_ri32_sext(REG_RCX(), 1)
        a.mov_ri32_sext(REG_RDX(), 32)
        a.call_rip_iat(self.imp_calloc)
        a.mov_mr64(REG_RBP(), -40, REG_RAX()) // pi
        // CreateProcessA(0, mut_cmd, 0, 0, 1, 0, 0, 0, si, pi)
        a.mov_mr64(REG_RSP(), 72, REG_RAX())
        a.mov_rm64(REG_RCX(), REG_RBP(), -32)
        a.mov_mr64(REG_RSP(), 64, REG_RCX())
        a.mov_ri32_sext(REG_RAX(), 0)
        a.mov_mr64(REG_RSP(), 56, REG_RAX())
        a.mov_mr64(REG_RSP(), 48, REG_RAX())
        a.mov_mr64(REG_RSP(), 40, REG_RAX())
        a.mov_ri32_sext(REG_RCX(), 1)
        a.mov_mr64(REG_RSP(), 32, REG_RCX())
        a.mov_ri32_sext(REG_RCX(), 0)
        a.mov_rm64(REG_RDX(), REG_RBP(), -24)
        a.mov_ri32_sext(REG_R8(), 0)
        a.mov_ri32_sext(REG_R9(), 0)
        a.call_rip_iat(self.imp_create_proc)
        a.mov_mr64(REG_RBP(), -48, REG_RAX()) // ok
        a.mov_rm64(REG_RCX(), REG_RBP(), -24)
        a.call_rip_iat(self.imp_free)
        a.mov_rm64(REG_RAX(), REG_RBP(), -48)
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_E(), l_pe_fb)
        // WaitForSingleObject(pi->hProcess, INFINITE)
        a.mov_rm64(REG_RAX(), REG_RBP(), -40)
        a.mov_rm64(REG_RCX(), REG_RAX(), 0)
        a.mov_ri32_sext(REG_RDX(), -1)
        a.call_rip_iat(self.imp_wait_obj)
        // GetExitCodeProcess(pi->hProcess, pi + 24)
        a.mov_rm64(REG_RAX(), REG_RBP(), -40)
        a.mov_rm64(REG_RCX(), REG_RAX(), 0)
        a.mov_rr(REG_RDX(), REG_RAX())
        a.add_ri32(REG_RDX(), 24)
        a.call_rip_iat(self.imp_get_exit)
        // exit_code = *(i32*)(pi + 24) zero-extended
        a.mov_rm64(REG_RAX(), REG_RBP(), -40)
        a.mov_rm64(REG_RAX(), REG_RAX(), 24)
        a.mov_ri64(REG_RDX(), 4294967295)
        a.and_rr(REG_RAX(), REG_RDX())
        a.mov_mr64(REG_RBP(), -48, REG_RAX())
        // CloseHandle(hProcess), CloseHandle(hThread), free(si), free(pi)
        a.mov_rm64(REG_RAX(), REG_RBP(), -40)
        a.mov_rm64(REG_RCX(), REG_RAX(), 0)
        a.call_rip_iat(self.imp_close_handle)
        a.mov_rm64(REG_RAX(), REG_RBP(), -40)
        a.mov_rm64(REG_RCX(), REG_RAX(), 8)
        a.call_rip_iat(self.imp_close_handle)
        a.mov_rm64(REG_RCX(), REG_RBP(), -32)
        a.call_rip_iat(self.imp_free)
        a.mov_rm64(REG_RCX(), REG_RBP(), -40)
        a.call_rip_iat(self.imp_free)
        a.mov_rm64(REG_RAX(), REG_RBP(), -48)
        a.jmp_rel32(l_pe_done)
        // Fallback: free(si), free(pi), call system(cmdline)
        a.bind_label(l_pe_fb)
        a.mov_rm64(REG_RCX(), REG_RBP(), -32)
        a.call_rip_iat(self.imp_free)
        a.mov_rm64(REG_RCX(), REG_RBP(), -40)
        a.call_rip_iat(self.imp_free)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.call_rip_iat(self.imp_system)
        a.movsxd(REG_RAX(), REG_RAX())
        a.bind_label(l_pe_done)
        self.end_fn()

        // Path.exists(rcx = path) -> bool
        self.begin_fn("__rt_path_exists", 48)
        let l_pxe_no = a.new_label()
        let l_pxe_done = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_pxe_no)
        a.call_rip_iat(self.imp_get_attrs)
        a.movsxd(REG_RAX(), REG_RAX())
        a.cmp_ri32(REG_RAX(), -1)
        a.jcc_rel32(CC_E(), l_pxe_no)
        a.mov_ri32_sext(REG_RAX(), 1)
        a.jmp_rel32(l_pxe_done)
        a.bind_label(l_pxe_no)
        a.mov_ri32_sext(REG_RAX(), 0)
        a.bind_label(l_pxe_done)
        self.end_fn()

        // Path.join(rcx = a, rdx = b) -> str
        self.begin_fn("__rt_path_join", 96)
        let l_pj_a_ok = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_NE(), l_pj_a_ok)
        a.mov_rr(REG_RCX(), REG_RDX())
        a.call_rel32(self.lbl("__rt_str_dup"))
        self.end_fn()
        a.bind_label(l_pj_a_ok)
        let l_pj_b_ok = a.new_label()
        a.test_rr(REG_RDX(), REG_RDX())
        a.jcc_rel32(CC_NE(), l_pj_b_ok)
        a.call_rel32(self.lbl("__rt_str_dup"))
        self.end_fn()
        a.bind_label(l_pj_b_ok)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_mr64(REG_RBP(), -16, REG_RDX())
        a.call_rip_iat(self.imp_strlen)
        a.mov_mr64(REG_RBP(), -24, REG_RAX()) // la
        let l_pj_chk_sep = a.new_label()
        let l_pj_has_sep = a.new_label()
        a.cmp_ri32(REG_RAX(), 0)
        a.jcc_rel32(CC_LE(), l_pj_chk_sep)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.add_rr(REG_RCX(), REG_RAX())
        a.movzx_rm8(REG_RAX(), REG_RCX(), -1)
        a.cmp_ri32(REG_RAX(), 47) // '/'
        a.jcc_rel32(CC_E(), l_pj_has_sep)
        a.cmp_ri32(REG_RAX(), 92) // '\'
        a.jcc_rel32(CC_E(), l_pj_has_sep)
        a.bind_label(l_pj_chk_sep)
        // No separator: a + "\" + b
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.lea_rip_rdata(REG_RDX(), self.s_backslash)
        a.call_rel32(self.lbl("__rt_str_concat"))
        a.mov_rr(REG_RCX(), REG_RAX())
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.call_rel32(self.lbl("__rt_str_concat"))
        self.end_fn()
        a.bind_label(l_pj_has_sep)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_rm64(REG_RDX(), REG_RBP(), -16)
        a.call_rel32(self.lbl("__rt_str_concat"))
        self.end_fn()

        // Path.basename(rcx = p) -> str
        self.begin_fn("__rt_path_basename", 80)
        let l_pb_ok = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_NE(), l_pb_ok)
        a.lea_rip_rdata(REG_RAX(), self.s_empty)
        self.end_fn()
        a.bind_label(l_pb_ok)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.call_rip_iat(self.imp_strlen)
        a.mov_mr64(REG_RBP(), -16, REG_RAX()) // len
        a.mov_rr(REG_RCX(), REG_RAX())        // i = len
        let l_pb_loop = a.new_label()
        let l_pb_found = a.new_label()
        let l_pb_nofound = a.new_label()
        a.bind_label(l_pb_loop)
        a.cmp_ri32(REG_RCX(), 0)
        a.jcc_rel32(CC_LE(), l_pb_nofound)
        a.mov_rm64(REG_RDX(), REG_RBP(), -8)
        a.add_rr(REG_RDX(), REG_RCX())
        a.movzx_rm8(REG_RAX(), REG_RDX(), -1)
        a.cmp_ri32(REG_RAX(), 47)
        a.jcc_rel32(CC_E(), l_pb_found)
        a.cmp_ri32(REG_RAX(), 92)
        a.jcc_rel32(CC_E(), l_pb_found)
        a.sub_ri32(REG_RCX(), 1)
        a.jmp_rel32(l_pb_loop)
        a.bind_label(l_pb_found)
        a.mov_rr(REG_RDX(), REG_RCX())
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_rm64(REG_R8(), REG_RBP(), -16)
        a.call_rel32(self.lbl("__rt_str_slice"))
        self.end_fn()
        a.bind_label(l_pb_nofound)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.call_rel32(self.lbl("__rt_str_dup"))
        self.end_fn()

        // Path.dirname(rcx = p) -> str
        self.begin_fn("__rt_path_dirname", 80)
        let l_pd_ok = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_NE(), l_pd_ok)
        a.lea_rip_rdata(REG_RAX(), self.s_dot)
        self.end_fn()
        a.bind_label(l_pd_ok)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.call_rip_iat(self.imp_strlen)
        a.mov_mr64(REG_RBP(), -16, REG_RAX())
        a.mov_rr(REG_RCX(), REG_RAX())
        let l_pd_loop = a.new_label()
        let l_pd_found = a.new_label()
        let l_pd_nofound = a.new_label()
        a.bind_label(l_pd_loop)
        a.cmp_ri32(REG_RCX(), 0)
        a.jcc_rel32(CC_LE(), l_pd_nofound)
        a.mov_rm64(REG_RDX(), REG_RBP(), -8)
        a.add_rr(REG_RDX(), REG_RCX())
        a.movzx_rm8(REG_RAX(), REG_RDX(), -1)
        a.cmp_ri32(REG_RAX(), 47)
        a.jcc_rel32(CC_E(), l_pd_found)
        a.cmp_ri32(REG_RAX(), 92)
        a.jcc_rel32(CC_E(), l_pd_found)
        a.sub_ri32(REG_RCX(), 1)
        a.jmp_rel32(l_pd_loop)
        a.bind_label(l_pd_found)
        a.sub_ri32(REG_RCX(), 1)
        a.mov_rr(REG_R8(), REG_RCX())
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_ri32_sext(REG_RDX(), 0)
        a.call_rel32(self.lbl("__rt_str_slice"))
        self.end_fn()
        a.bind_label(l_pd_nofound)
        a.lea_rip_rdata(REG_RAX(), self.s_dot)
        self.end_fn()

        // Path.extension(rcx = p) -> str
        self.begin_fn("__rt_path_extension", 80)
        let l_px_ok = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_NE(), l_px_ok)
        a.lea_rip_rdata(REG_RAX(), self.s_empty)
        self.end_fn()
        a.bind_label(l_px_ok)
        a.call_rel32(self.lbl("__rt_path_basename"))
        a.mov_mr64(REG_RBP(), -8, REG_RAX())
        a.mov_rr(REG_RCX(), REG_RAX())
        a.call_rip_iat(self.imp_strlen)
        a.mov_mr64(REG_RBP(), -16, REG_RAX())
        a.mov_rr(REG_RCX(), REG_RAX())
        let l_px_loop = a.new_label()
        let l_px_found = a.new_label()
        let l_px_nofound = a.new_label()
        a.bind_label(l_px_loop)
        a.cmp_ri32(REG_RCX(), 0)
        a.jcc_rel32(CC_LE(), l_px_nofound)
        a.mov_rm64(REG_RDX(), REG_RBP(), -8)
        a.add_rr(REG_RDX(), REG_RCX())
        a.movzx_rm8(REG_RAX(), REG_RDX(), -1)
        a.cmp_ri32(REG_RAX(), 46) // '.'
        a.jcc_rel32(CC_E(), l_px_found)
        a.sub_ri32(REG_RCX(), 1)
        a.jmp_rel32(l_px_loop)
        a.bind_label(l_px_found)
        a.mov_rr(REG_RDX(), REG_RCX())
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_rm64(REG_R8(), REG_RBP(), -16)
        a.call_rel32(self.lbl("__rt_str_slice"))
        self.end_fn()
        a.bind_label(l_px_nofound)
        a.lea_rip_rdata(REG_RAX(), self.s_empty)
        self.end_fn()

        // Env.args() -> List<str> parsed from GetCommandLineA()
        self.emit_env_args()
    }

}
