import "./mod.arx"

extend NativeRt {
    priv fn emit_memory() {
        let a = self.asmb

        // __rt_alloc(rcx = size: i64) -> rax: ptr
        self.begin_fn("__rt_alloc", 48)
        let l_sz_ok = a.new_label()
        a.cmp_ri32(REG_RCX(), 0)
        a.jcc_rel32(CC_G(), l_sz_ok)
        a.mov_ri32_sext(REG_RCX(), 8)
        a.bind_label(l_sz_ok)
        // 8-byte align: (size + 7) & ~7
        a.add_ri32(REG_RCX(), 7)
        a.mov_ri64(REG_RDX(), -8)
        a.and_rr(REG_RCX(), REG_RDX())
        a.call_rip_iat(self.imp_malloc)
        let l_alloc_ok = a.new_label()
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_NE(), l_alloc_ok)
        a.lea_rip_rdata(REG_RCX(), self.s_oom)
        a.call_rel32(self.lbl("__rt_eprintln_str"))
        a.mov_ri32_sext(REG_RCX(), 1)
        a.call_rip_iat(self.imp_exit_process)
        a.bind_label(l_alloc_ok)
        self.end_fn()

        // __rt_calloc(rcx = count: i64, rdx = size: i64) -> rax: ptr
        self.begin_fn("__rt_calloc", 48)
        let l_c_cnt_ok = a.new_label()
        a.cmp_ri32(REG_RCX(), 0)
        a.jcc_rel32(CC_G(), l_c_cnt_ok)
        a.mov_ri32_sext(REG_RCX(), 1)
        a.bind_label(l_c_cnt_ok)
        let l_c_sz_ok = a.new_label()
        a.cmp_ri32(REG_RDX(), 0)
        a.jcc_rel32(CC_G(), l_c_sz_ok)
        a.mov_ri32_sext(REG_RDX(), 8)
        a.bind_label(l_c_sz_ok)
        a.imul_rr(REG_RCX(), REG_RDX())
        // 8-byte align
        a.add_ri32(REG_RCX(), 7)
        a.mov_ri64(REG_RDX(), -8)
        a.and_rr(REG_RCX(), REG_RDX())
        a.mov_rr(REG_RDX(), REG_RCX())
        a.mov_ri32_sext(REG_RCX(), 1)
        a.call_rip_iat(self.imp_calloc)
        let l_calloc_ok = a.new_label()
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_NE(), l_calloc_ok)
        a.lea_rip_rdata(REG_RCX(), self.s_oom)
        a.call_rel32(self.lbl("__rt_eprintln_str"))
        a.mov_ri32_sext(REG_RCX(), 1)
        a.call_rip_iat(self.imp_exit_process)
        a.bind_label(l_calloc_ok)
        self.end_fn()

        // __rt_realloc(rcx = ptr: ptr, rdx = new_size: i64) -> rax: ptr
        self.begin_fn("__rt_realloc", 48)
        let l_r_nonnull = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_NE(), l_r_nonnull)
        a.mov_rr(REG_RCX(), REG_RDX())
        a.call_rel32(self.lbl("__rt_alloc"))
        self.end_fn()
        a.bind_label(l_r_nonnull)
        let l_r_sz_ok = a.new_label()
        a.cmp_ri32(REG_RDX(), 0)
        a.jcc_rel32(CC_G(), l_r_sz_ok)
        a.mov_ri32_sext(REG_RDX(), 8)
        a.bind_label(l_r_sz_ok)
        a.add_ri32(REG_RDX(), 7)
        a.mov_ri64(REG_RAX(), -8)
        a.and_rr(REG_RDX(), REG_RAX())
        a.call_rip_iat(self.imp_realloc)
        let l_realloc_ok = a.new_label()
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_NE(), l_realloc_ok)
        a.lea_rip_rdata(REG_RCX(), self.s_oom)
        a.call_rel32(self.lbl("__rt_eprintln_str"))
        a.mov_ri32_sext(REG_RCX(), 1)
        a.call_rip_iat(self.imp_exit_process)
        a.bind_label(l_realloc_ok)
        self.end_fn()

        // __rt_free(rcx = ptr: ptr) -> void
        self.begin_fn("__rt_free", 48)
        let l_f_null = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_f_null)
        a.call_rip_iat(self.imp_free)
        a.bind_label(l_f_null)
        self.end_fn()

        // __rt_arc_alloc(rcx = payload_size) -> rax: payload_ptr
        self.begin_fn("__rt_arc_alloc", 48)
        let l_arc_ok = a.new_label()
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.add_ri32(REG_RCX(), 16)
        a.call_rip_iat(self.imp_malloc)
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_NE(), l_arc_ok)
        a.lea_rip_rdata(REG_RCX(), self.s_oom)
        a.call_rel32(self.lbl("__rt_eprintln_str"))
        a.mov_ri32_sext(REG_RCX(), 1)
        a.call_rip_iat(self.imp_exit_process)
        a.bind_label(l_arc_ok)
        a.mov_ri64(REG_RDX(), 4703274488880312899)
        a.mov_mr64(REG_RAX(), 0, REG_RDX())
        a.mov_ri32_sext(REG_RDX(), 1)
        a.mov_mr64(REG_RAX(), 8, REG_RDX())
        a.add_ri32(REG_RAX(), 16)
        self.end_fn()

        // __rt_arc_retain(rcx = ptr) -> void
        self.begin_fn("__rt_arc_retain", 32)
        let l_ret_done = a.new_label()
        a.cmp_ri32(REG_RCX(), 65536)
        a.jcc_rel32(CC_B(), l_ret_done)
        a.mov_ri64(REG_RAX(), 4703274488880312899)
        a.mov_rm64(REG_RDX(), REG_RCX(), -16)
        a.cmp_rr(REG_RDX(), REG_RAX())
        a.jcc_rel32(CC_NE(), l_ret_done)
        a.lock_inc_m64(REG_RCX(), -8)
        a.bind_label(l_ret_done)
        self.end_fn()

        // __rt_arc_release(rcx = ptr) -> void
        self.begin_fn("__rt_arc_release", 48)
        let l_rel_done = a.new_label()
        a.cmp_ri32(REG_RCX(), 65536)
        a.jcc_rel32(CC_B(), l_rel_done)
        a.mov_ri64(REG_RAX(), 4703274488880312899)
        a.mov_rm64(REG_RDX(), REG_RCX(), -16)
        a.cmp_rr(REG_RDX(), REG_RAX())
        a.jcc_rel32(CC_NE(), l_rel_done)
        a.lock_dec_m64(REG_RCX(), -8)
        a.jcc_rel32(CC_NE(), l_rel_done)
        a.mov_ri32_sext(REG_RAX(), 0)
        a.mov_mr64(REG_RCX(), -16, REG_RAX())
        a.sub_ri32(REG_RCX(), 16)
        a.call_rip_iat(self.imp_free)
        a.bind_label(l_rel_done)
        self.end_fn()
    }

}
