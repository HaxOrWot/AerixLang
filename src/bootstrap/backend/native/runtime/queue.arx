import "./mod.arx"

extend NativeRt {
    priv fn emit_queue() {
        let a = self.asmb
        // Queue struct (40B): [0]=data ptr, [8]=head, [16]=tail, [24]=len, [32]=cap
        // __rt_queue_new() -> ptr
        self.begin_fn("__rt_queue_new", 48)
        a.mov_ri32_sext(REG_RCX(), 1)
        a.mov_ri32_sext(REG_RDX(), 40)
        a.call_rip_iat(self.imp_calloc)
        a.mov_mr64(REG_RBP(), -8, REG_RAX())
        a.mov_ri32_sext(REG_RCX(), 8)
        a.mov_ri32_sext(REG_RDX(), 8)
        a.call_rip_iat(self.imp_calloc)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_mr64(REG_RCX(), 0, REG_RAX())
        a.mov_ri32_sext(REG_RDX(), 8)
        a.mov_mr64(REG_RCX(), 32, REG_RDX())
        a.mov_rr(REG_RAX(), REG_RCX())
        self.end_fn()

        // __rt_queue_enqueue(rcx = queue, rdx = val)
        self.begin_fn("__rt_queue_enqueue", 80)
        let l_qret = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_qret)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_mr64(REG_RBP(), -16, REG_RDX())
        a.mov_rm64(REG_R8(), REG_RCX(), 24)
        a.mov_rm64(REG_R9(), REG_RCX(), 32)
        let l_q_fit = a.new_label()
        a.cmp_rr(REG_R8(), REG_R9())
        a.jcc_rel32(CC_L(), l_q_fit)
        a.mov_rr(REG_RDX(), REG_R9())
        a.add_rr(REG_RDX(), REG_RDX())
        a.mov_mr64(REG_RBP(), -24, REG_RDX())
        a.mov_ri32_sext(REG_RCX(), 8)
        a.call_rip_iat(self.imp_calloc)
        a.mov_mr64(REG_RBP(), -32, REG_RAX())
        a.mov_ri32_sext(REG_RAX(), 0)
        a.mov_mr64(REG_RBP(), -40, REG_RAX())
        let l_copy_loop = a.new_label()
        let l_copy_done = a.new_label()
        a.bind_label(l_copy_loop)
        a.mov_rm64(REG_RAX(), REG_RBP(), -40)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.mov_rm64(REG_RDX(), REG_RCX(), 24)
        a.cmp_rr(REG_RAX(), REG_RDX())
        a.jcc_rel32(CC_GE(), l_copy_done)
        a.mov_rm64(REG_R8(), REG_RCX(), 8)
        a.add_rr(REG_R8(), REG_RAX())
        a.mov_rm64(REG_R9(), REG_RCX(), 32)
        a.sub_ri32(REG_R9(), 1)
        a.and_rr(REG_R8(), REG_R9())
        a.mov_rm64(REG_RCX(), REG_RCX(), 0)
        a.add_rr(REG_R8(), REG_R8())
        a.add_rr(REG_R8(), REG_R8())
        a.add_rr(REG_R8(), REG_R8())
        a.add_rr(REG_RCX(), REG_R8())
        a.mov_rm64(REG_RDX(), REG_RCX(), 0)
        a.mov_rm64(REG_RCX(), REG_RBP(), -32)
        a.mov_rm64(REG_RAX(), REG_RBP(), -40)
        a.add_rr(REG_RAX(), REG_RAX())
        a.add_rr(REG_RAX(), REG_RAX())
        a.add_rr(REG_RAX(), REG_RAX())
        a.add_rr(REG_RCX(), REG_RAX())
        a.mov_mr64(REG_RCX(), 0, REG_RDX())
        a.mov_rm64(REG_RAX(), REG_RBP(), -40)
        a.add_ri32(REG_RAX(), 1)
        a.mov_mr64(REG_RBP(), -40, REG_RAX())
        a.jmp_rel32(l_copy_loop)
        a.bind_label(l_copy_done)
        a.mov_rm64(REG_RAX(), REG_RBP(), -8)
        a.mov_rm64(REG_RCX(), REG_RAX(), 0)
        a.call_rip_iat(self.imp_free)
        a.mov_rm64(REG_RAX(), REG_RBP(), -8)
        a.mov_rm64(REG_RCX(), REG_RBP(), -32)
        a.mov_mr64(REG_RAX(), 0, REG_RCX())
        a.mov_ri32_sext(REG_RCX(), 0)
        a.mov_mr64(REG_RAX(), 8, REG_RCX())
        a.mov_rm64(REG_RCX(), REG_RAX(), 24)
        a.mov_mr64(REG_RAX(), 16, REG_RCX())
        a.mov_rm64(REG_RCX(), REG_RBP(), -24)
        a.mov_mr64(REG_RAX(), 32, REG_RCX())
        a.bind_label(l_q_fit)
        a.mov_rm64(REG_RAX(), REG_RBP(), -8)
        a.mov_rm64(REG_RCX(), REG_RAX(), 16)
        a.mov_rm64(REG_RDX(), REG_RAX(), 32)
        a.sub_ri32(REG_RDX(), 1)
        a.and_rr(REG_RCX(), REG_RDX())
        a.mov_rm64(REG_R8(), REG_RAX(), 0)
        a.add_rr(REG_RCX(), REG_RCX())
        a.add_rr(REG_RCX(), REG_RCX())
        a.add_rr(REG_RCX(), REG_RCX())
        a.add_rr(REG_R8(), REG_RCX())
        a.mov_rm64(REG_R9(), REG_RBP(), -16)
        a.mov_mr64(REG_R8(), 0, REG_R9())
        a.mov_rm64(REG_RCX(), REG_RAX(), 16)
        a.add_ri32(REG_RCX(), 1)
        a.mov_mr64(REG_RAX(), 16, REG_RCX())
        a.mov_rm64(REG_RCX(), REG_RAX(), 24)
        a.add_ri32(REG_RCX(), 1)
        a.mov_mr64(REG_RAX(), 24, REG_RCX())
        a.bind_label(l_qret)
        self.end_fn()

        // __rt_queue_dequeue(rcx = queue) -> i64
        self.begin_fn("__rt_queue_dequeue", 48)
        let l_qdeq_err = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_qdeq_err)
        a.mov_rm64(REG_RDX(), REG_RCX(), 24)
        a.test_rr(REG_RDX(), REG_RDX())
        a.jcc_rel32(CC_E(), l_qdeq_err)
        a.mov_rm64(REG_R8(), REG_RCX(), 8)
        a.mov_rm64(REG_R9(), REG_RCX(), 32)
        a.sub_ri32(REG_R9(), 1)
        a.and_rr(REG_R8(), REG_R9())
        a.mov_rm64(REG_RAX(), REG_RCX(), 0)
        a.add_rr(REG_R8(), REG_R8())
        a.add_rr(REG_R8(), REG_R8())
        a.add_rr(REG_R8(), REG_R8())
        a.add_rr(REG_RAX(), REG_R8())
        a.mov_rm64(REG_RAX(), REG_RAX(), 0)
        a.mov_mr64(REG_RBP(), -8, REG_RAX())
        a.mov_rm64(REG_R8(), REG_RCX(), 8)
        a.add_ri32(REG_R8(), 1)
        a.and_rr(REG_R8(), REG_R9())
        a.mov_mr64(REG_RCX(), 8, REG_R8())
        a.mov_rm64(REG_R8(), REG_RCX(), 24)
        a.sub_ri32(REG_R8(), 1)
        a.mov_mr64(REG_RCX(), 24, REG_R8())
        a.mov_rm64(REG_RAX(), REG_RBP(), -8)
        self.end_fn()
        a.bind_label(l_qdeq_err)
        a.mov_ri32_sext(REG_RAX(), 0)
        self.end_fn()

        // __rt_queue_peek(rcx = queue) -> i64
        self.begin_fn("__rt_queue_peek", 32)
        let l_qpeek_err = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_qpeek_err)
        a.mov_rm64(REG_RDX(), REG_RCX(), 24)
        a.test_rr(REG_RDX(), REG_RDX())
        a.jcc_rel32(CC_E(), l_qpeek_err)
        a.mov_rm64(REG_R8(), REG_RCX(), 8)
        a.mov_rm64(REG_R9(), REG_RCX(), 32)
        a.sub_ri32(REG_R9(), 1)
        a.and_rr(REG_R8(), REG_R9())
        a.mov_rm64(REG_RAX(), REG_RCX(), 0)
        a.add_rr(REG_R8(), REG_R8())
        a.add_rr(REG_R8(), REG_R8())
        a.add_rr(REG_R8(), REG_R8())
        a.add_rr(REG_RAX(), REG_R8())
        a.mov_rm64(REG_RAX(), REG_RAX(), 0)
        self.end_fn()
        a.bind_label(l_qpeek_err)
        a.mov_ri32_sext(REG_RAX(), 0)
        self.end_fn()

        // __rt_queue_len(rcx = queue) -> i64
        self.begin_fn("__rt_queue_len", 32)
        let l_qlen_zero = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_qlen_zero)
        a.mov_rm64(REG_RAX(), REG_RCX(), 24)
        self.end_fn()
        a.bind_label(l_qlen_zero)
        a.mov_ri32_sext(REG_RAX(), 0)
        self.end_fn()

        // __rt_queue_is_empty(rcx = queue) -> 0/1
        self.begin_fn("__rt_queue_is_empty", 32)
        let l_qie_true = a.new_label()
        let l_qie_done = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_qie_true)
        a.mov_rm64(REG_RAX(), REG_RCX(), 24)
        a.test_rr(REG_RAX(), REG_RAX())
        a.jcc_rel32(CC_E(), l_qie_true)
        a.mov_ri32_sext(REG_RAX(), 0)
        a.jmp_rel32(l_qie_done)
        a.bind_label(l_qie_true)
        a.mov_ri32_sext(REG_RAX(), 1)
        a.bind_label(l_qie_done)
        self.end_fn()

        // __rt_queue_clear(rcx = queue)
        self.begin_fn("__rt_queue_clear", 32)
        let l_qc_null = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_qc_null)
        a.mov_ri32_sext(REG_RAX(), 0)
        a.mov_mr64(REG_RCX(), 8, REG_RAX())
        a.mov_mr64(REG_RCX(), 16, REG_RAX())
        a.mov_mr64(REG_RCX(), 24, REG_RAX())
        a.bind_label(l_qc_null)
        self.end_fn()

        // __rt_queue_free(rcx = queue)
        self.begin_fn("__rt_queue_free", 48)
        let l_qf_ret = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_qf_ret)
        a.mov_mr64(REG_RBP(), -8, REG_RCX())
        a.mov_rm64(REG_RCX(), REG_RCX(), 0)
        let l_qf_nd = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_qf_nd)
        a.call_rip_iat(self.imp_free)
        a.bind_label(l_qf_nd)
        a.mov_rm64(REG_RCX(), REG_RBP(), -8)
        a.call_rip_iat(self.imp_free)
        a.bind_label(l_qf_ret)
        self.end_fn()

        // __rt_stack_peek(rcx = list) -> val
        self.begin_fn("__rt_stack_peek", 32)
        let l_speek_err = a.new_label()
        a.test_rr(REG_RCX(), REG_RCX())
        a.jcc_rel32(CC_E(), l_speek_err)
        a.mov_rm64(REG_RDX(), REG_RCX(), 8)
        a.test_rr(REG_RDX(), REG_RDX())
        a.jcc_rel32(CC_E(), l_speek_err)
        a.sub_ri32(REG_RDX(), 1)
        a.mov_rm64(REG_RAX(), REG_RCX(), 0)
        a.add_rr(REG_RDX(), REG_RDX())
        a.add_rr(REG_RDX(), REG_RDX())
        a.add_rr(REG_RDX(), REG_RDX())
        a.add_rr(REG_RAX(), REG_RDX())
        a.mov_rm64(REG_RAX(), REG_RAX(), 0)
        self.end_fn()
        a.bind_label(l_speek_err)
        a.mov_ri32_sext(REG_RAX(), 0)
        self.end_fn()
    }

}
