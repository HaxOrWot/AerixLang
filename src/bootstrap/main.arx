fn resolve_updater_exe() -> str {
    let env_home = Env.get("AERIX_HOME")
    if env_home != "" {
        let p = bpath_join(bpath_normalize(env_home), "Uninstall.exe")
        if File.exists(p) { return p }
    }
    let self_exe = bpath_normalize(Env.arg(0))
    if self_exe != "" && self_exe != "." {
        let bin_dir = bpath_dirname(self_exe)
        let root_dir = bpath_dirname(bin_dir)
        let p2 = bpath_join(root_dir, "Uninstall.exe")
        if File.exists(p2) { return p2 }
    }
    if File.exists("C:/Aerix/Uninstall.exe") {
        return "C:/Aerix/Uninstall.exe"
    }
    return ""
}

fn maybe_trigger_bg_update() {
    if Env.os_name() != "windows" { return }
    let u = resolve_updater_exe()
    if u != "" {
        let win_u = u.replace("/", "\\")
        arx_autoupdate_bg_trigger(win_u)
    }
}

fn cmd_update(check_only: bool, force: bool, verbose: bool, no_ide: bool) -> i64 {
    if Env.os_name() != "windows" {
        eprintln("error: built-in self-updater currently supports Windows installations only.")
        return 1
    }
    let u = resolve_updater_exe()
    if u == "" {
        eprintln("error: Aerix updater (Uninstall.exe) was not found in this installation.")
        eprintln("  = help: install via AerixSetup-*.exe from https://github.com/HaxOrWot/AerixLang/releases")
        return 1
    }
    let win_u = u.replace("/", "\\")
    mut cmd = quote_shell_arg(win_u)
    if check_only {
        cmd = cmd + " --check-update"
    } else {
        cmd = cmd + " --update"
    }
    if force {
        cmd = cmd + " --force"
    }
    if verbose {
        cmd = cmd + " --verbose"
    }
    if no_ide {
        cmd = cmd + " --no-ide"
    }
    return Process.execute(cmd)
}

fn cmd_vm(cli_args: List<str>, cli_argc: i64, start_idx: i64, default_sub: str) -> i64 {
    if Env.os_name() != "windows" {
        eprintln("error: Aerix Version Manager currently supports Windows installations only.")
        return 1
    }
    mut sub = default_sub
    mut idx = start_idx
    if sub == "" {
        if idx >= cli_argc {
            sub = "status"
        } else {
            let candidate = cli_args.get(idx)
            if candidate == "--help" || candidate == "-h" || candidate == "help" {
                print_vm_usage()
                return 0
            }
            if !candidate.starts_with("-") {
                sub = candidate
                idx = idx + 1
            } else {
                sub = "status"
            }
        }
    }

    mut target = ""
    mut flag_force = false
    mut flag_all = false
    mut flag_no_use = false
    mut flag_no_ide = false
    mut flag_json = false
    mut channel = ""

    mut i = idx
    while i < cli_argc {
        let a = cli_args.get(i)
        if a == "--help" || a == "-h" {
            print_vm_usage()
            return 0
        } else if a == "--force" || a == "-f" {
            flag_force = true
        } else if a == "--all" || a == "-a" || a == "--allow-older" {
            flag_all = true
        } else if a == "--no-use" {
            flag_no_use = true
        } else if a == "--no-ide" || a == "--no-vscode" || a == "--no-antigravity" {
            flag_no_ide = true
        } else if a == "--json" {
            flag_json = true
        } else if a == "--beta" {
            channel = "beta"
        } else if a == "--pre" {
            channel = "pre"
        } else if a == "--stable" {
            channel = "stable"
        } else if a.starts_with("--channel=") {
            channel = a.slice(10, a.len())
        } else if !a.starts_with("-") && target == "" {
            target = a
        } else {
            eprintln("error: unknown argument '" + a + "' for 'arx vm " + sub + "'")
            eprintln("  = help: run 'arx vm --help' for supported options")
            return 1
        }
        i = i + 1
    }

    let u = resolve_updater_exe()
    if u == "" {
        eprintln("error: Aerix Version Manager host (Uninstall.exe) was not found in this installation.")
        eprintln("  = help: install via AerixSetup-*.exe from https://github.com/HaxOrWot/AerixLang/releases")
        return 1
    }
    let win_u = u.replace("/", "\\")
    mut cmd = quote_shell_arg(win_u)

    if sub == "status" {
        cmd = cmd + " --vm-status"
    } else if sub == "sync" || sub == "pin" {
        cmd = cmd + " --vm-sync"
    } else if sub == "list" || sub == "ls" {
        if flag_json {
            cmd = cmd + " --vm-list-json"
        } else {
            cmd = cmd + " --vm-list"
        }
    } else if sub == "list-remote" || sub == "ls-remote" || sub == "available" || sub == "remote" {
        if flag_json {
            cmd = cmd + " --vm-remote-json"
        } else {
            cmd = cmd + " --vm-remote"
        }
    } else if sub == "install" || sub == "add" {
        if target == "" {
            eprintln("error: missing version for 'arx vm install' (e.g. 'arx vm install 1.1.16b')")
            return 1
        }
        cmd = cmd + " " + quote_shell_arg("--vm-install=" + target)
    } else if sub == "use" || sub == "switch" || sub == "select" {
        if target == "" {
            eprintln("error: missing version for 'arx vm use' (e.g. 'arx vm use 1.1.3b')")
            return 1
        }
        cmd = cmd + " " + quote_shell_arg("--vm-use=" + target)
    } else if sub == "remove" || sub == "rm" || sub == "uninstall" || sub == "delete" {
        if target == "" {
            eprintln("error: missing version for 'arx vm remove'")
            return 1
        }
        cmd = cmd + " " + quote_shell_arg("--vm-remove=" + target)
    } else {
        eprintln("error: unknown version manager subcommand '" + sub + "'")
        print_vm_usage()
        return 1
    }

    if flag_force { cmd = cmd + " --force" }
    if flag_all { cmd = cmd + " --all" }
    if flag_no_use { cmd = cmd + " --no-use" }
    if flag_no_ide { cmd = cmd + " --no-ide" }
    if channel != "" { cmd = cmd + " --channel=" + channel }
    return Process.execute(cmd)
}

fn strip_arx_ext(p: str) -> str {
    if p.ends_with(".arx") {
        return p.slice(0, p.len() - 4)
    }
    return p
}

fn strip_exe_ext(p: str) -> str {
    if p.ends_with(".exe") {
        return p.slice(0, p.len() - 4)
    }
    return strip_arx_ext(p)
}

fn get_temp_dir() -> str {
    let t1 = Env.get("TEMP")
    if t1 != "" { return bpath_normalize(t1) }
    let t2 = Env.get("TMP")
    if t2 != "" { return bpath_normalize(t2) }
    let t3 = Env.get("TMPDIR")
    if t3 != "" { return bpath_normalize(t3) }
    return "/tmp"
}

fn quote_shell_arg(s: str) -> str {
    let q = "\""
    return q + s + q
}

fn diag_esc() -> str {
    let bb = ByteBuffer()
    bb.write_u8(27)
    let s = bb.to_str()
    bb.free()
    return s
}

fn diag_repeat(ch: str, n: i64) -> str {
    if n <= 0 { return "" }
    let bb = ByteBuffer()
    mut i = 0
    while i < n {
        bb.write_str(ch)
        i = i + 1
    }
    let s = bb.to_str()
    bb.free()
    return s
}

fn diag_get_line(src: str, line1: i64) -> str {
    if src == "" || line1 <= 0 { return "" }
    let norm = src.replace("\r\n", "\n").replace("\r", "\n")
    let lines = norm.split("\n")
    if line1 - 1 < lines.len() {
        return lines.get(line1 - 1)
    }
    return ""
}

fn print_compiler_diagnostics(az: Analyzer) {
    let use_color = (Env.get("NO_COLOR") == "")
    let esc = diag_esc()
    mut c_red = ""
    mut c_yel = ""
    mut c_blu = ""
    mut c_cyn = ""
    mut c_bld = ""
    mut c_rst = ""
    if use_color {
        c_red = esc + "[1;31m"
        c_yel = esc + "[1;33m"
        c_blu = esc + "[1;34m"
        c_cyn = esc + "[1;36m"
        c_bld = esc + "[1m"
        c_rst = esc + "[0m"
    }

    let file_cache = Map<str, str>()
    mut i = 0
    while i < az.err_count {
        let f = az.err_files.get(i)
        let ln = az.err_lines.get(i)
        let cl = az.err_cols.get(i)
        let msg = az.err_msgs.get(i)
        mut tlen = 1
        if i < az.err_lens.len() { tlen = az.err_lens.get(i) }
        if tlen < 1 { tlen = 1 }
        mut code = ""
        if i < az.err_codes.len() { code = az.err_codes.get(i) }
        mut hmsg = ""
        if i < az.err_helps.len() { hmsg = az.err_helps.get(i) }
        mut sev = 1
        if i < az.err_sevs.len() { sev = az.err_sevs.get(i) }

        mut sev_lbl = "error"
        mut c_sev = c_red
        if sev == 2 {
            sev_lbl = "warning"
            c_sev = c_yel
        }
        mut code_tag = ""
        if code != "" { code_tag = "[" + code + "]" }

        eprintln(c_sev + sev_lbl + code_tag + c_rst + c_bld + ": " + msg + c_rst)
        if f != "" {
            eprintln("  " + c_blu + "-->" + c_rst + " " + f + ":" + (ln as str) + ":" + (cl as str))
            if !file_cache.has_key(f) {
                if File.exists(f) {
                    file_cache.insert(f, File.read_to_string(f))
                } else {
                    file_cache.insert(f, "")
                }
            }
            let src = file_cache.get(f)
            let line_txt = diag_get_line(src, ln)
            if line_txt != "" {
                let ln_s = ln as str
                mut gw = ln_s.len()
                if gw < 2 { gw = 2 }
                let pad_g = diag_repeat(" ", gw)
                let pad_l = diag_repeat(" ", gw - ln_s.len())
                mut col0 = cl - 1
                if col0 < 0 { col0 = 0 }
                if col0 > line_txt.len() { col0 = line_txt.len() }
                let lead = diag_repeat(" ", col0)
                let carets = diag_repeat("^", tlen)
                eprintln(" " + pad_g + c_blu + "|" + c_rst)
                eprintln(" " + c_blu + pad_l + ln_s + " |" + c_rst + " " + line_txt)
                eprintln(" " + pad_g + c_blu + "|" + c_rst + " " + lead + c_sev + carets + c_rst)
            }
        }
        if hmsg != "" {
            eprintln("  " + c_cyn + "= help:" + c_rst + " " + hmsg)
        }
        eprintln("")
        i = i + 1
    }

    if az.has_errors > 0 {
        mut wnote = ""
        if az.warn_count > 0 {
            wnote = "; " + (az.warn_count as str) + " warning(s) emitted"
        }
        eprintln(c_red + "error" + c_rst + c_bld + ": aborting due to " + (az.has_errors as str) + " previous error(s)" + wnote + c_rst)
    } else if az.warn_count > 0 {
        eprintln(c_yel + "warning" + c_rst + c_bld + ": " + (az.warn_count as str) + " warning(s) emitted" + c_rst)
    }
}

fn compile_frontend(input_file: str) -> Analyzer {
    if !File.exists(input_file) {
        eprintln("error: source file not found: " + input_file)
        Env.exit(1)
    }
    mut parser = Parser(input_file)
    parser.recover_mode = true
    parser.load_resolved_file(input_file)
    mut az = Analyzer(parser)
    az.analyze()
    if az.err_count > 0 {
        print_compiler_diagnostics(az)
    }
    return az
}

fn emit_c_for_file(input_file: str) -> str {
    mut az = compile_frontend(input_file)
    if az.has_errors > 0 {
        Env.exit(1)
    }
    mut em = Emitter(az)
    return em.emit()
}

fn cmd_check(input_file: str) -> i64 {
    let az = compile_frontend(input_file)
    if az.has_errors > 0 {
        return 1
    }
    println("OK: " + input_file + " (" + (az.ncount as str) + " AST nodes, " + (az.fn_count as str) + " fns, " + (az.cls_count as str) + " classes)")
    return 0
}

fn cmd_emit_c(input_file: str, out_file: str) -> i64 {
    mut target = out_file
    if target == "" {
        target = strip_arx_ext(bpath_normalize(input_file)) + ".c"
    }
    let dir = bpath_dirname(target)
    if dir != "" && dir != "." {
        Directory.create(dir)
    }
    let c_src = emit_c_for_file(input_file)
    if !File.write_string(target, c_src) {
        eprintln("ERROR: Failed to write C file: " + target)
        return 1
    }
    return 0
}

fn emit_native_exe(input_file: str, exe_path: str) -> i64 {
    let dir = bpath_dirname(exe_path)
    if dir != "" && dir != "." {
        Directory.create(dir)
    }
    mut az = compile_frontend(input_file)
    if az.has_errors > 0 {
        return 1
    }
    mut ncg = NativeCodegen(az)
    if !ncg.compile(exe_path) {
        eprintln("ERROR: Failed to emit native PE32+ executable: " + exe_path)
        return 1
    }
    return 0
}

fn cmd_build(input_file: str, out_file: str, opt_flag: str, keep_c: bool, backend: str) -> i64 {
    let norm_in = bpath_normalize(input_file)
    mut exe_path = out_file
    if exe_path == "" {
        exe_path = strip_arx_ext(norm_in)
    }
    exe_path = ensure_exe_ext(bpath_normalize(exe_path))

    mut use_native = false
    if backend == "native" {
        use_native = true
    } else if backend == "c" || keep_c {
        use_native = false
    } else {
        use_native = false
    }

    if use_native {
        let rc = emit_native_exe(norm_in, exe_path)
        if rc == 0 {
            println("Built " + exe_path)
        }
        return rc
    }

    let c_path = strip_exe_ext(exe_path) + ".c"
    let c_src = emit_c_for_file(norm_in)
    return link_c_to_exe_from(c_src, c_path, exe_path, opt_flag, keep_c, norm_in)
}

fn cmd_run(input_file: str, opt_flag: str, backend: str, prog_args: List<str>, prog_argc: i64) -> i64 {
    let norm_in = bpath_normalize(input_file)
    let tmp_dir = bpath_join(get_temp_dir(), "aerix_boot_run")
    Directory.create(tmp_dir)
    let base = strip_arx_ext(bpath_basename(norm_in))
    let c_path = bpath_join(tmp_dir, base + ".c")
    let exe_path = ensure_exe_ext(bpath_join(tmp_dir, base))

    mut use_native = false
    if backend == "native" {
        use_native = true
    } else if backend == "c" {
        use_native = false
    } else {
        use_native = false
    }

    mut rc_link = 0
    if use_native {
        rc_link = emit_native_exe(norm_in, exe_path)
    } else {
        let c_src = emit_c_for_file(norm_in)
        rc_link = link_c_to_exe_from(c_src, c_path, exe_path, opt_flag, false, norm_in)
    }
    if rc_link != 0 {
        return rc_link
    }

    let bb = ByteBuffer()
    if Env.os_name() == "windows" {
        let win_exe = exe_path.replace("/", "\\")
        bb.write_str(quote_shell_arg(win_exe))
    } else {
        bb.write_str(quote_shell_arg(exe_path))
    }
    mut i = 0
    while i < prog_argc {
        bb.write_u8(32)
        bb.write_str(quote_shell_arg(prog_args.get(i)))
        i = i + 1
    }
    let run_cmd = bb.to_str()
    bb.free()

    let rc = Process.execute(run_cmd)
    File.remove(exe_path)
    if rc == -1 {
        eprintln("error: failed to execute compiled binary '" + exe_path + "'. If Windows Defender or antivirus blocked temp execution, try 'arx build \"" + input_file + "\"' and run the built .exe directly.")
    } else if rc >= 3221225472 {
        eprintln("error: compiled program crashed or failed to initialize (Windows status code " + (rc as str) + ").")
    }
    return rc
}

fn main() -> i64 {
    let cli_args = Env.args()
    let cli_argc = Env.arg_count()
    if cli_argc <= 1 {
        print_usage()
        return 0
    }

    let first = cli_args.get(1)
    if first == "version" || first == "--version" || first == "-v" {
        if cli_argc >= 3 {
            let a2 = cli_args.get(2)
            if a2 == "--help" || a2 == "-h" {
                print_version_usage()
                return 0
            }
        }
        println("Aerix Self-Hosting Bootstrap Compiler (arxc) v1.1.16b")
        maybe_trigger_bg_update()
        return 0
    }
    if first == "help" || first == "--help" || first == "-h" {
        if cli_argc >= 3 {
            let sub = cli_args.get(2)
            if sub == "build" { print_build_usage(); return 0 }
            if sub == "run" { print_run_usage(); return 0 }
            if sub == "emit-c" { print_emit_c_usage(); return 0 }
            if sub == "check" { print_check_usage(); return 0 }
            if sub == "lsp" { print_lsp_usage(); return 0 }
            if sub == "vm" || sub == "toolchain" { print_vm_usage(); return 0 }
            if sub == "update" || sub == "upgrade" { print_update_usage(); return 0 }
            if sub == "version" { print_version_usage(); return 0 }
        }
        print_usage()
        return 0
    }
    if first == "lsp" {
        if cli_argc >= 3 {
            let a2 = cli_args.get(2)
            if a2 == "--help" || a2 == "-h" {
                print_lsp_usage()
                return 0
            }
        }
        return run_lsp_server()
    }
    if first == "vm" || first == "toolchain" {
        return cmd_vm(cli_args, cli_argc, 2, "")
    }
    if first == "install" {
        return cmd_vm(cli_args, cli_argc, 2, "install")
    }
    if first == "use" || first == "switch" {
        return cmd_vm(cli_args, cli_argc, 2, "use")
    }
    if first == "versions" || first == "toolchains" {
        return cmd_vm(cli_args, cli_argc, 2, "list")
    }
    if first == "current" {
        return cmd_vm(cli_args, cli_argc, 2, "status")
    }
    if first == "update" || first == "upgrade" {
        mut upd_check = false
        mut upd_force = false
        mut upd_verbose = false
        mut upd_no_ide = false
        mut ui = 2
        while ui < cli_argc {
            let ua = cli_args.get(ui)
            if ua == "--help" || ua == "-h" {
                print_update_usage()
                return 0
            } else if ua == "--check" || ua == "-c" || ua == "--status" {
                upd_check = true
            } else if ua == "--force" || ua == "-f" {
                upd_force = true
            } else if ua == "--verbose" || ua == "-v" || ua == "--notes" {
                upd_verbose = true
            } else if ua == "--no-ide" || ua == "--no-vscode" || ua == "--no-antigravity" {
                upd_no_ide = true
            } else {
                eprintln("error: unknown option '" + ua + "' for 'arx " + first + "'")
                eprintln("  = help: run 'arx " + first + " --help' to see supported options")
                return 1
            }
            ui = ui + 1
        }
        return cmd_update(upd_check, upd_force, upd_verbose, upd_no_ide)
    }

    mut mode = ""
    mut start_i = 2
    if first == "build" || first == "run" || first == "emit-c" || first == "check" {
        mode = first
    } else {
        mode = "auto"
        start_i = 1
    }

    mut input_file = ""
    mut out_file = ""
    mut opt_flag = "-O2"
    mut keep_c = false
    mut backend = "auto"
    let prog_args = List<str>()
    mut prog_argc = 0
    mut after_dashdash = false

    mut i = start_i
    while i < cli_argc {
        let a = cli_args.get(i)
        if after_dashdash {
            prog_args.push(a)
            prog_argc = prog_argc + 1
        } else if a == "--" {
            after_dashdash = true
        } else if a == "-o" || a == "--output" {
            if i + 1 < cli_argc {
                i = i + 1
                out_file = cli_args.get(i)
            }
        } else if a == "--emit-c" {
            keep_c = true
        } else if a == "--backend=c" {
            backend = "c"
        } else if a == "--backend=native" {
            backend = "native"
        } else if a == "-O0" || a == "-O1" || a == "-O2" || a == "-O3" {
            opt_flag = a
        } else if a == "--gui" || a == "--windows" || a == "--no-console" || a == "-mwindows" {
            // Flag accepted for windowed GUI subsystem mode
        } else if a == "--help" || a == "-h" {
            if mode == "build" { print_build_usage(); return 0 }
            if mode == "run" { print_run_usage(); return 0 }
            if mode == "emit-c" { print_emit_c_usage(); return 0 }
            if mode == "check" { print_check_usage(); return 0 }
            print_usage()
            return 0
        } else if input_file == "" {
            input_file = a
        } else {
            prog_args.push(a)
            prog_argc = prog_argc + 1
        }
        i = i + 1
    }

    if input_file == "" {
        eprintln("ERROR: No input .arx file provided.")
        print_usage()
        return 1
    }

    maybe_trigger_bg_update()

    if mode == "check" {
        return cmd_check(input_file)
    }
    if mode == "emit-c" {
        return cmd_emit_c(input_file, out_file)
    }
    if mode == "build" {
        return cmd_build(input_file, out_file, opt_flag, keep_c, backend)
    }
    if mode == "run" {
        return cmd_run(input_file, opt_flag, backend, prog_args, prog_argc)
    }

    // "auto" mode: if -o specified, build executable; otherwise compile & run
    if out_file != "" {
        return cmd_build(input_file, out_file, opt_flag, keep_c, backend)
    }
    return cmd_run(input_file, opt_flag, backend, prog_args, prog_argc)
}
