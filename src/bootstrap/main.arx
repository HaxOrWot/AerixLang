// Aerix Bootstrap Compiler — Self-Hosting CLI Driver (arxc)
// Supports: build, run, emit-c, check, version, help, and direct `<file.arx> [-o <out>]`.

import "./frontend/ast.arx"
import "./frontend/parser.arx"
import "./middle/paths.arx"
import "./middle/types.arx"
import "./middle/analyzer.arx"
import "./backend/emitter.arx"
import "./backend/linker.arx"
import "./backend/native/codegen.arx"
import "./lsp/server.arx"

fn print_usage() {
    println("Aerix Native Systems Programming Language Toolchain (arx / arxc)")
    println("Version: 1.1.16b (Beta Channel)")
    println("")
    println("Usage:")
    println("  arx <command> [arguments...] [options]")
    println("  arx <file.arx> [-o <out>]          (Shorthand build)")
    println("")
    println("Core Commands:")
    println("  build        Compile an Aerix program into a standalone native binary")
    println("  run          Compile and immediately execute an Aerix program")
    println("  emit-c       Transpile Aerix source code into standalone ANSI C99")
    println("  check        Parse, validate, and type-check without code generation")
    println("")
    println("Developer & IDE Tooling:")
    println("  lsp          Start the Language Server Protocol (LSP) JSON-RPC daemon")
    println("")
    println("Version & Toolchain Management:")
    println("  vm           Manage multiple compiler toolchains and release channels")
    println("  install      Download & install a toolchain version (alias: arx vm install)")
    println("  use          Switch active toolchain version (alias: arx vm use)")
    println("  versions     List installed toolchains (alias: arx vm list)")
    println("  current      Show active toolchain version info (alias: arx vm status)")
    println("  update       Check for and install updates from GitHub (alias: arx upgrade)")
    println("")
    println("Information & Help:")
    println("  version      Show compiler version and release channel")
    println("  help         Show general help or help for a specific command")
    println("")
    println("Run 'arx <command> --help' or 'arx help <command>' for detailed options on any command.")
}

fn print_build_usage() {
    println("Aerix Build Driver (arx build)")
    println("Compiles Aerix source files (.arx) into standalone native executables.")
    println("")
    println("Usage:")
    println("  arx build <file.arx> [-o <out>] [options]")
    println("")
    println("Options:")
    println("  -o, --output <path>    Specify output executable name or destination path")
    println("                         (defaults to input filename with .exe on Windows)")
    println("  -O0, -O1, -O2, -O3     Optimization level (default: -O2)")
    println("  --gui, --windows       Target Windows GUI subsystem (no console window);")
    println("  --no-console           automatically enabled when Window.Gui module is imported")
    println("  --emit-c               Keep intermediate generated C99 source file")
    println("  --backend=c|native     Code generation backend (default: c with GCC)")
    println("  -h, --help             Show this help message")
    println("")
    println("Examples:")
    println("  arx build main.arx")
    println("  arx build SnakeGame.arx -o SnakeGame.exe")
    println("  arx build app.arx --gui -o app.exe")
    println("  arx build benchmark.arx -O3 --emit-c")
}

