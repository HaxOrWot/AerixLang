// Aerix Bootstrap Compiler — Self-Hosting CLI Driver (arxc)
// Supports: build, run, emit-c, check, version, help, and direct `<file.arx> [-o <out>]`.

import "./frontend/ast.arx"
import "./frontend/parser.arx"
import "./middle/paths.arx"
import "./middle/types.arx"
import "./middle/analyzer.arx"
import "./middle/docgen.arx"
import "./backend/emitter.arx"
import "./backend/linker.arx"
import "./backend/native/codegen.arx"
import "./lsp/features.arx"
import "./lsp/server.arx"

fn resolve_bin_name() -> str {
    let a0 = bpath_normalize(Env.arg(0))
    if a0.ends_with("arxc.exe") || a0.ends_with("arxc") {
        return "arxc"
    }
    return "arx"
}

fn print_usage() {
    let bin = resolve_bin_name()
    println("Aerix Native Systems Programming Language Toolchain (" + bin + ")")
    println("Version: 2.2.25-stable (Stable Channel) - x86_64-windows")
    println("")
    println("Usage:")
    println("  " + bin + " <command> [arguments...] [options]")
    println("  " + bin + " <file.arx> [-o <out>]          (Shorthand build)")
    println("")
    println("Core Commands:")
    println("  build        Compile an Aerix program into a standalone native binary")
    println("  run          Compile and immediately execute an Aerix program")
    println("  emit-c       Transpile Aerix source code into standalone ANSI C99")
    println("  check        Parse, validate, and type-check without code generation")
    println("  fmt          Format Aerix source files in-place or check formatting")
    println("  test         Discover and execute unit and integration test suites")
    println("")
    println("Developer & IDE Tooling:")
    println("  lsp          Start the Language Server Protocol (LSP) JSON-RPC daemon")
    println("  doc          Generate static HTML API documentation from doc-comments")
    println("  repl         Start the interactive Aerix REPL shell")
    println("")
    println("Version & Toolchain Management:")
    println("  vm           Manage multiple compiler toolchains and release channels")
    println("  install      Download & install a toolchain version (alias: " + bin + " vm install)")
    println("  use          Switch active toolchain version (alias: " + bin + " vm use)")
    println("  versions     List installed toolchains (alias: " + bin + " vm list)")
    println("  current      Show active toolchain version info (alias: " + bin + " vm status)")
    println("  update       Check for and install updates from GitHub (alias: " + bin + " upgrade)")
    println("")
    println("Information & Help:")
    println("  version      Show compiler version and release channel")
    println("  help         Show general help or help for a specific command")
    println("")
    println("Common Options:")
    println("  -o, --output <path>    Specify output executable name or destination path")
    println("  --backend=native|c     Code generation backend (default: native; zero GCC)")
    println("  --c, --backend=c       Compile with C99/GCC transpiler pipeline")
    println("  --debug                Build with debug symbols (-g) and runtime safety bounds")
    println("  --release              Build with full optimizations (-O3 -flto -s)")
    println("  -O0, -O1, -O2, -O3     Optimization level (default: -O2)")
    println("  --gui, --windows       Target Windows GUI subsystem (no console window)")
    println("  --emit-c               Keep intermediate generated C99 source file")
    println("  -v, --verbose          Show verbose backend status information")
    println("  -h, --help             Show help for any command (e.g. '" + bin + " build --help')")
    println("  --version              Show compiler version information")
    println("")
    println("Run '" + bin + " <command> --help' or '" + bin + " help <command>' for detailed command options.")
}

