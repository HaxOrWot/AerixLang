// Aerix Bootstrap Compiler — Pure-Aerix Path & Toolchain Locator Helpers
// Cross-platform Windows / POSIX path normalization and stdlib/module lookup.

pub fn bpath_is_sep(b: i64) -> bool {
    return b == 47 || b == 92
}

pub fn bpath_is_abs(p: str) -> bool {
    let n = p.len()
    if n >= 1 && bpath_is_sep(p.byte_at(0)) {
        return true
    }
    if n >= 3 && p.byte_at(1) == 58 && bpath_is_sep(p.byte_at(2)) {
        return true
    }
    return false
}

pub fn bpath_normalize(raw: str) -> str {
    let slash_s = raw.replace("\\", "/")
    let n = slash_s.len()
    if n == 0 { return "." }

    mut prefix = ""
    mut start_idx = 0
    if n >= 3 && slash_s.byte_at(1) == 58 && slash_s.byte_at(2) == 47 {
        prefix = slash_s.slice(0, 3)
        start_idx = 3
    } else if n >= 1 && slash_s.byte_at(0) == 47 {
        prefix = "/"
        start_idx = 1
    }

    let segs = List<str>()
    mut seg_count = 0
    mut i = start_idx
    mut seg_start = start_idx
    while i <= n {
        mut is_end = false
        if i == n {
            is_end = true
        } else if slash_s.byte_at(i) == 47 {
            is_end = true
        }
        if is_end {
            if i > seg_start {
                let part = slash_s.slice(seg_start, i)
                if part == "." {
                    // skip
                } else if part == ".." {
                    if can_pop_seg(segs, seg_count) {
                        segs.pop()
                        seg_count = seg_count - 1
                    } else if prefix == "" {
                        segs.push("..")
                        seg_count = seg_count + 1
                    }
                } else {
                    segs.push(part)
                    seg_count = seg_count + 1
                }
            }
            seg_start = i + 1
        }
        i = i + 1
    }

    let bb = ByteBuffer()
    bb.write_str(prefix)
    mut j = 0
    while j < seg_count {
        if j > 0 { bb.write_u8(47) }
        bb.write_str(segs.get(j))
        j = j + 1
    }
    let res = bb.to_str()
    bb.free()
    if res == "" { return "." }
    return res
}

pub fn bpath_dirname(p: str) -> str {
    let norm = p.replace("\\", "/")
    mut n = norm.len()
    while n > 1 && norm.byte_at(n - 1) == 47 {
        n = n - 1
    }
    mut i = n
    while i > 0 {
        if norm.byte_at(i - 1) == 47 {
            if i == 1 { return "/" }
            if i == 3 && norm.byte_at(1) == 58 { return norm.slice(0, 3) }
            return norm.slice(0, i - 1)
        }
        i = i - 1
    }
    return "."
}

pub fn bpath_basename(p: str) -> str {
    let norm = p.replace("\\", "/")
    mut n = norm.len()
    while n > 1 && norm.byte_at(n - 1) == 47 {
        n = n - 1
    }
    mut i = n
    while i > 0 {
        if norm.byte_at(i - 1) == 47 {
            return norm.slice(i, n)
        }
        i = i - 1
    }
    return norm.slice(0, n)
}

pub fn bpath_join(a: str, b: str) -> str {
    if b == "" { return bpath_normalize(a) }
    if bpath_is_abs(b) { return bpath_normalize(b) }
    if a == "" || a == "." { return bpath_normalize(b) }
    return bpath_normalize(a + "/" + b)
}

pub fn str_ends_with_arx(s: str) -> bool {
    return s.ends_with(".arx")
}

pub fn can_pop_seg(segs: List<str>, cnt: i64) -> bool {
    if cnt <= 0 { return false }
    return segs.get(cnt - 1) != ".."
}

pub fn sort_str_list(items: List<str>, count: i64) {
    mut i = 1
    while i < count {
        let key = items.get(i)
        mut j = i - 1
        while j >= 0 {
            if items.get(j) <= key { break }
            items.set(j + 1, items.get(j))
            j = j - 1
        }
        items.set(j + 1, key)
        i = i + 1
    }
}

pub fn find_stdlib_dir() -> str {
    let env_std = Env.get("AERIX_STDLIB_PATH")
    if env_std != "" && File.exists(bpath_join(env_std, "aerix_rt.h")) {
        return bpath_normalize(env_std)
    }
    let env_std2 = Env.get("AERIX_STDLIB")
    if env_std2 != "" && File.exists(bpath_join(env_std2, "aerix_rt.h")) {
        return bpath_normalize(env_std2)
    }
    let env_home = Env.get("AERIX_HOME")
    if env_home != "" {
        let cand_home = bpath_join(env_home, "stdlib")
        if File.exists(bpath_join(cand_home, "aerix_rt.h")) { return cand_home }
    }
    let cwd = bpath_normalize(Env.cwd())
    let cands = List<str>()
    cands.push(bpath_join(cwd, "stdlib"))
    cands.push(bpath_join(cwd, "../stdlib"))
    cands.push("C:/Aerix/stdlib")
    let local_app = Env.get("LOCALAPPDATA")
    if local_app != "" {
        cands.push(bpath_join(local_app, "Programs/Aerix/stdlib"))
    }
    let exe_path = Env.arg(0)
    if exe_path != "" {
        let exe_dir = bpath_dirname(exe_path)
        cands.push(bpath_join(exe_dir, "stdlib"))
        cands.push(bpath_join(exe_dir, "../stdlib"))
        cands.push(bpath_join(exe_dir, "../../stdlib"))
        cands.push(bpath_join(exe_dir, "../../../stdlib"))
    }
    mut i = 0
    while i < cands.len() {
        let cand = cands.get(i)
        if File.exists(bpath_join(cand, "aerix_rt.h")) {
            return cand
        }
        i = i + 1
    }
    return bpath_join(cwd, "stdlib")
}

pub fn find_module_dir(mod_name: str, entry_dir: str) -> str {
    let norm_name = mod_name.replace(".", "/")
    let env_mp = Env.get("AERIX_MODULE_PATH")
    if env_mp != "" {
        let cand_env = bpath_join(env_mp, norm_name)
        if Directory.exists(cand_env) { return cand_env }
        if File.exists(cand_env + ".arx") { return cand_env + ".arx" }
    }
    let env_home = Env.get("AERIX_HOME")
    if env_home != "" {
        let cand_home = bpath_join(bpath_join(env_home, "modules"), norm_name)
        if Directory.exists(cand_home) { return cand_home }
        if File.exists(cand_home + ".arx") { return cand_home + ".arx" }
    }
    let cands = List<str>()
    let cwd = bpath_normalize(Env.cwd())
    cands.push(bpath_join(entry_dir, "modules/" + norm_name))
    cands.push(bpath_join(entry_dir, "../modules/" + norm_name))
    cands.push(bpath_join(entry_dir, "../../modules/" + norm_name))
    cands.push(bpath_join(cwd, "modules/" + norm_name))
    cands.push(bpath_join(cwd, "../modules/" + norm_name))
    cands.push("C:/Aerix/modules/" + norm_name)
    cands.push(bpath_join(entry_dir, norm_name))
    cands.push(bpath_join(cwd, norm_name))
    let local_app = Env.get("LOCALAPPDATA")
    if local_app != "" {
        cands.push(bpath_join(local_app, "Programs/Aerix/modules/" + norm_name))
    }
    let exe_path = Env.arg(0)
    if exe_path != "" {
        let exe_dir = bpath_dirname(exe_path)
        cands.push(bpath_join(exe_dir, "modules/" + norm_name))
        cands.push(bpath_join(exe_dir, "../modules/" + norm_name))
        cands.push(bpath_join(exe_dir, "../../modules/" + norm_name))
        cands.push(bpath_join(exe_dir, "../../../modules/" + norm_name))
    }

    // Capitalized and casing variants (e.g. 'Window/gui' -> 'Window/Gui')
    let parts = norm_name.split("/")
    if parts.len() > 1 {
        let p0 = parts.get(0)
        let p1 = parts.get(1)
        let p0_cap = p0.slice(0, 1).to_upper() + p0.slice(1, p0.len())
        let p1_cap = p1.slice(0, 1).to_upper() + p1.slice(1, p1.len())
        let p1_low = p1.slice(0, 1).to_lower() + p1.slice(1, p1.len())
        let p1_upp = p1.to_upper()
        let alts = List<str>()
        alts.push(p0_cap + "/" + p1_cap)
        alts.push(p0_cap + "/" + p1_low)
        alts.push(p0_cap + "/" + p1_upp)
        alts.push(p0.to_lower() + "/" + p1_low)
        mut ai = 0
        while ai < alts.len() {
            let alt = alts.get(ai)
            cands.push("C:/Aerix/modules/" + alt)
            cands.push(bpath_join(entry_dir, "modules/" + alt))
            cands.push(bpath_join(cwd, "modules/" + alt))
            cands.push(bpath_join(entry_dir, alt))
            cands.push(bpath_join(cwd, alt))
            ai = ai + 1
        }
    } else if norm_name.len() > 0 {
        let ch0 = norm_name.byte_at(0)
        if ch0 >= 97 && ch0 <= 122 {
            let alt_name = norm_name.slice(0, 1).to_upper() + norm_name.slice(1, norm_name.len())
            cands.push("C:/Aerix/modules/" + alt_name)
            cands.push(bpath_join(entry_dir, "modules/" + alt_name))
            cands.push(bpath_join(cwd, "modules/" + alt_name))
            cands.push(bpath_join(entry_dir, alt_name))
            cands.push(bpath_join(cwd, alt_name))
            if local_app != "" {
                cands.push(bpath_join(local_app, "Programs/Aerix/modules/" + alt_name))
            }
        }
    }

    mut i = 0
    while i < cands.len() {
        let c = cands.get(i)
        if Directory.exists(c) { return c }
        if File.exists(c + ".arx") { return c + ".arx" }
        i = i + 1
    }
    return ""
}
