import "./mod.arx"

extend Parser {

    pub fn add_explicit_module(mod_name: str) {
        if mod_name == "" { return }
        if !self.file_explicit_modules.has_key(mod_name) {
            self.file_explicit_modules.insert(mod_name, 1)
            self.explicit_mod_list.push(mod_name)
        }
    }

    // --- Module & File Loading ---

    pub fn load_resolved_file(file_path: str) {
        mut resolved = bpath_normalize(file_path)
        if !self.virtual_docs.has_key(resolved) && !File.exists(resolved) && !str_ends_with_arx(resolved) {
            let with_ext = resolved + ".arx"
            if self.virtual_docs.has_key(with_ext) || File.exists(with_ext) {
                resolved = with_ext
            }
        }
        if self.loaded_files.has_key(resolved) {
            return
        }
        if self.virtual_docs.has_key(resolved) {
            self.loaded_files.insert(resolved, 1)
            self.load_source(self.virtual_docs.get(resolved), resolved)
            return
        }
        if !File.exists(resolved) {
            let msg = "cannot find imported source file '" + resolved + "'"
            let help_msg = "verify the relative path from '" + self.cur_dir + "' or check that the file ends with '.arx'"
            if self.recover_mode {
                self.record_err_full(self.cur_line(), self.cur_col(), self.cur_len(), "E0104", msg, help_msg, 1)
                return
            }
            self.fail(msg)
        }
        self.loaded_files.insert(resolved, 1)

        let source = File.read_to_string(resolved)
        self.load_source(source, resolved)
    }

    pub fn load_file(file_path: str) {
        mut resolved = file_path
        if !bpath_is_abs(resolved) {
            resolved = bpath_join(self.cur_dir, file_path)
        }
        if !File.exists(resolved) && !resolved.ends_with(".arx") && File.exists(resolved + ".arx") {
            resolved = resolved + ".arx"
        }
        if !File.exists(resolved) {
            let mdir = find_module_dir(file_path, self.entry_dir)
            if mdir != "" {
                self.load_module(file_path)
                return
            }
        }
        self.load_resolved_file(resolved)
    }

    pub fn load_source(source: str, filename: str) {
        let norm_name = bpath_normalize(filename)
        if !self.loaded_files.has_key(norm_name) {
            self.loaded_files.insert(norm_name, 1)
        }
        mut lx = Lexer(source, norm_name)
        lx.recover_mode = self.recover_mode
        let ts = lx.tokenize()
        if self.recover_mode && lx.err_count > 0 {
            mut li = 0
            while li < lx.err_count {
                if self.err_count < 64 {
                    self.err_files.push(norm_name)
                    self.err_lines.push(lx.err_lines.get(li))
                    self.err_cols.push(lx.err_cols.get(li))
                    self.err_lens.push(lx.err_lens.get(li))
                    self.err_codes.push(lx.err_codes.get(li))
                    self.err_msgs.push(lx.err_msgs.get(li))
                    self.err_helps.push(lx.err_helps.get(li))
                    self.err_sevs.push(1)
                    self.err_count = self.err_count + 1
                }
                li = li + 1
            }
        }

        // Save outer parser token stream state
        let s_kinds = self.tok_kinds
        let s_vals = self.tok_vals
        let s_lines = self.tok_lines
        let s_cols = self.tok_cols
        let s_lens = self.tok_lens
        let s_tcount = self.tok_count
        let s_pos = self.pos
        let s_file = self.cur_file
        let s_dir = self.cur_dir
        let s_last_err = self.last_err_pos

        self.tok_kinds = ts.kinds
        self.tok_vals = ts.vals
        self.tok_lines = ts.lines
        self.tok_cols = ts.cols
        self.tok_lens = ts.lens
        self.tok_count = ts.count
        self.pos = 0
        self.cur_file = norm_name
        self.cur_dir = bpath_dirname(norm_name)
        self.last_err_pos = -1

        self.parse_program_unit()

        // Restore outer state
        self.tok_kinds = s_kinds
        self.tok_vals = s_vals
        self.tok_lines = s_lines
        self.tok_cols = s_cols
        self.tok_lens = s_lens
        self.tok_count = s_tcount
        self.pos = s_pos
        self.cur_file = s_file
        self.cur_dir = s_dir
        self.last_err_pos = s_last_err
    }

    priv fn collect_dir_arx(dir_path: str, out_files: List<str>, count_box: List<i64>) {
        let files = Directory.list_files(dir_path)
        let f_count = files.len()
        mut i = 0
        while i < f_count {
            let fnm = files.get(i)
            if str_ends_with_arx(fnm) {
                out_files.push(bpath_join(dir_path, fnm))
                count_box.set(0, count_box.get(0) + 1)
            }
            i = i + 1
        }
        let subdirs = Directory.list_dirs(dir_path)
        let d_count = subdirs.len()
        mut d = 0
        while d < d_count {
            self.collect_dir_arx(bpath_join(dir_path, subdirs.get(d)), out_files, count_box)
            d = d + 1
        }
    }

    priv fn load_module(mod_name: str) {
        if self.loaded_mods.has_key(mod_name) {
            return
        }
        let mod_dir = find_module_dir(mod_name, self.entry_dir)
        if mod_dir == "" {
            let msg = "module '" + mod_name + "' not found"
            let help_msg = "check module spelling, install via 'arx pkg install " + mod_name + "', or use a relative file path like import \"./mod.arx\""
            if self.recover_mode {
                mut err_ln = self.cur_line()
                mut err_cl = self.cur_col()
                if self.pos > 0 && self.pos - 1 < self.tok_cols.len() {
                    err_ln = self.tok_lines.get(self.pos - 1)
                    err_cl = self.tok_cols.get(self.pos - 1)
                }
                self.record_err_full(err_ln, err_cl, mod_name.len(), "E0104", msg, help_msg, 1)
                return
            }
            self.fail(msg)
        }
        self.loaded_mods.insert(mod_name, 1)
        let dotted_norm = mod_name.replace("/", ".")
        self.loaded_mods.insert(dotted_norm, 1)

        if File.exists(mod_dir) && str_ends_with_arx(mod_dir) {
            let norm_md = bpath_normalize(mod_dir)
            self.file_to_mod.insert(norm_md, dotted_norm)
            self.load_resolved_file(mod_dir)
            return
        }

        // Module 2.5: If explicit mod.arx or src/mod.arx exists, load it first
        let mod_entry = bpath_normalize(mod_dir + "/mod.arx")
        if File.exists(mod_entry) {
            self.file_to_mod.insert(mod_entry, dotted_norm)
            self.load_resolved_file(mod_entry)
        }
        let mod_src_entry = bpath_normalize(mod_dir + "/src/mod.arx")
        if File.exists(mod_src_entry) {
            self.file_to_mod.insert(mod_src_entry, dotted_norm)
            self.load_resolved_file(mod_src_entry)
        }

        // Automatic Module & Submodule Sync:
        // Automatically collect and load all .arx files and submodules in scan_dir (preferring src/ if present)
        mut scan_dir = mod_dir
        let cand_src = bpath_normalize(mod_dir + "/src")
        if Directory.exists(cand_src) {
            scan_dir = cand_src
        }

        let arx_files = List<str>()
        let count_box = List<i64>()
        count_box.push(0)
        self.collect_dir_arx(scan_dir, arx_files, count_box)
        let total = count_box.get(0)
        sort_str_list(arx_files, total)

        mut i = 0
        while i < total {
            let af = bpath_normalize(arx_files.get(i))
            self.file_to_mod.insert(af, dotted_norm)
            if !self.loaded_files.has_key(af) {
                self.load_resolved_file(af)
            }
            i = i + 1
        }

        // Automatic Submodule Registry:
        // Automatically discover all subdirectories recursively and register them as submodules
        self.register_submodules_recursive(scan_dir, dotted_norm)
    }

    priv fn register_submodules_recursive(dir_path: str, pfx_dotted: str) {
        let subdirs = Directory.list_dirs(dir_path)
        mut sdi = 0
        while sdi < subdirs.len() {
            let sname = subdirs.get(sdi)
            let sub_dotted = pfx_dotted + "." + sname
            let sub_slash = pfx_dotted.replace(".", "/") + "/" + sname
            self.loaded_mods.insert(sub_dotted, 1)
            self.loaded_mods.insert(sub_slash, 1)
            self.loaded_mods.insert(sname, 1)
            self.mod_aliases.insert(sub_dotted, sub_dotted)
            self.mod_aliases.insert(sub_slash, sub_dotted)
            self.mod_aliases.insert(sname, sub_dotted)
            if sname.len() > 0 {
                let cap_sub = sname.slice(0, 1).to_upper() + sname.slice(1, sname.len())
                let low_sub = sname.slice(0, 1).to_lower() + sname.slice(1, sname.len())
                self.mod_aliases.insert(cap_sub, sub_dotted)
                self.mod_aliases.insert(low_sub, sub_dotted)
                self.mod_aliases.insert(pfx_dotted + "." + cap_sub, sub_dotted)
                self.mod_aliases.insert(pfx_dotted + "." + low_sub, sub_dotted)
            }
            let child_dir = bpath_join(dir_path, sname)
            self.register_submodules_recursive(child_dir, sub_dotted)
            sdi = sdi + 1
        }
    }

    priv fn register_imported_item(parent_mod: str, orig_nm: str, alias_nm: str) {
        if alias_nm != "" && alias_nm != orig_nm {
            self.item_aliases.insert(alias_nm, orig_nm)
        }
        let full_sub = parent_mod + "." + orig_nm
        if self.loaded_mods.has_key(full_sub) || self.mod_aliases.has_key(full_sub) {
            self.mod_aliases.insert(orig_nm, full_sub)
            self.loaded_mods.insert(orig_nm, 1)
            if alias_nm != "" {
                self.mod_aliases.insert(alias_nm, full_sub)
                self.loaded_mods.insert(alias_nm, 1)
            }
            for k in self.mod_aliases.keys() {
                if k.starts_with(full_sub + ".") {
                    let sub_rest = k.slice(full_sub.len() + 1, k.len())
                    self.mod_aliases.insert(orig_nm + "." + sub_rest, k)
                    if alias_nm != "" {
                        self.mod_aliases.insert(alias_nm + "." + sub_rest, k)
                    }
                }
            }
        }
    }

    priv fn str_has_dot(s: str) -> bool {
        let n = s.len()
        mut i = 0
        while i < n {
            if s.byte_at(i) == 46 { return true }
            i = i + 1
        }
        return false
    }

    priv fn str_last_dot_seg(s: str) -> str {
        let n = s.len()
        mut i = n
        while i > 0 {
            if s.byte_at(i - 1) == 46 {
                return s.slice(i, n)
            }
            i = i - 1
        }
        return s
    }

}
