// Aerix Bootstrap Compiler — Token Definitions & Stream
// Uses integer constants and flat TokenStream arrays for O(1) zero-copy indexing.

pub fn TK_EOF() -> i64 { return 0 }
pub fn TK_NEWLINE() -> i64 { return 1 }
pub fn TK_INT() -> i64 { return 2 }
pub fn TK_FLOAT() -> i64 { return 3 }
pub fn TK_STR() -> i64 { return 4 }
pub fn TK_STR_INTERP() -> i64 { return 5 }
pub fn TK_CHAR() -> i64 { return 6 }
pub fn TK_BOOL() -> i64 { return 7 }
pub fn TK_NULL() -> i64 { return 8 }
pub fn TK_IDENT() -> i64 { return 9 }
pub fn TK_LABEL() -> i64 { return 10 }

// Keywords (20..69)
pub fn TK_FN() -> i64 { return 20 }
pub fn TK_LET() -> i64 { return 21 }
pub fn TK_MUT() -> i64 { return 22 }
pub fn TK_CONST() -> i64 { return 23 }
pub fn TK_CLASS() -> i64 { return 24 }
pub fn TK_STRUCT() -> i64 { return 25 }
pub fn TK_ENUM() -> i64 { return 26 }
pub fn TK_TRAIT() -> i64 { return 27 }
pub fn TK_TYPE() -> i64 { return 28 }
pub fn TK_INIT() -> i64 { return 29 }
pub fn TK_DROP() -> i64 { return 30 }
pub fn TK_IF() -> i64 { return 31 }
pub fn TK_ELSE() -> i64 { return 32 }
pub fn TK_MATCH() -> i64 { return 33 }
pub fn TK_FOR() -> i64 { return 34 }
pub fn TK_IN() -> i64 { return 35 }
pub fn TK_WHILE() -> i64 { return 36 }
pub fn TK_LOOP() -> i64 { return 37 }
pub fn TK_BREAK() -> i64 { return 38 }
pub fn TK_CONTINUE() -> i64 { return 39 }
pub fn TK_RETURN() -> i64 { return 40 }
pub fn TK_SPAWN() -> i64 { return 41 }
pub fn TK_TRY() -> i64 { return 42 }
pub fn TK_CATCH() -> i64 { return 43 }
pub fn TK_FINALLY() -> i64 { return 44 }
pub fn TK_THROW() -> i64 { return 45 }
pub fn TK_SELF() -> i64 { return 46 }
pub fn TK_SUPER() -> i64 { return 47 }
pub fn TK_PUB() -> i64 { return 48 }
pub fn TK_PRIV() -> i64 { return 49 }
pub fn TK_PROT() -> i64 { return 50 }
pub fn TK_STATIC() -> i64 { return 51 }
pub fn TK_VIRTUAL() -> i64 { return 52 }
pub fn TK_OVERRIDE() -> i64 { return 53 }
pub fn TK_ABSTRACT() -> i64 { return 54 }
pub fn TK_NEW() -> i64 { return 55 }
pub fn TK_DELETE() -> i64 { return 56 }
pub fn TK_EXTENDS() -> i64 { return 57 }
pub fn TK_IMPLEMENTS() -> i64 { return 58 }
pub fn TK_PROP() -> i64 { return 59 }
pub fn TK_OP() -> i64 { return 60 }
pub fn TK_EXTEND() -> i64 { return 61 }
pub fn TK_GUARD() -> i64 { return 62 }
pub fn TK_DEFER() -> i64 { return 63 }
pub fn TK_UNSAFE() -> i64 { return 64 }
pub fn TK_SIZEOF() -> i64 { return 65 }
pub fn TK_AS() -> i64 { return 66 }
pub fn TK_USE() -> i64 { return 67 }
pub fn TK_IMPORT() -> i64 { return 68 }
pub fn TK_FROM() -> i64 { return 69 }
pub fn TK_CINCLUDE() -> i64 { return 70 }
pub fn TK_CEXTERN() -> i64 { return 71 }

// Operators & Delimiters (80..135)
pub fn TK_PLUS() -> i64 { return 80 }
pub fn TK_MINUS() -> i64 { return 81 }
pub fn TK_STAR() -> i64 { return 82 }
pub fn TK_SLASH() -> i64 { return 83 }
pub fn TK_PERCENT() -> i64 { return 84 }
pub fn TK_POWER() -> i64 { return 85 }
pub fn TK_EQ_EQ() -> i64 { return 86 }
pub fn TK_NOT_EQ() -> i64 { return 87 }
pub fn TK_LT() -> i64 { return 88 }
pub fn TK_LTE() -> i64 { return 89 }
pub fn TK_GT() -> i64 { return 90 }
pub fn TK_GTE() -> i64 { return 91 }
pub fn TK_AND_AND() -> i64 { return 92 }
pub fn TK_OR_OR() -> i64 { return 93 }
pub fn TK_NOT() -> i64 { return 94 }
pub fn TK_AMP() -> i64 { return 95 }
pub fn TK_PIPE_CHAR() -> i64 { return 96 }
pub fn TK_CARET() -> i64 { return 97 }
pub fn TK_TILDE() -> i64 { return 98 }
pub fn TK_LSHIFT() -> i64 { return 99 }
pub fn TK_RSHIFT() -> i64 { return 100 }
pub fn TK_EQUALS() -> i64 { return 101 }
pub fn TK_PLUS_EQ() -> i64 { return 102 }
pub fn TK_MINUS_EQ() -> i64 { return 103 }
pub fn TK_STAR_EQ() -> i64 { return 104 }
pub fn TK_SLASH_EQ() -> i64 { return 105 }
pub fn TK_PERCENT_EQ() -> i64 { return 106 }
pub fn TK_PIPE() -> i64 { return 107 }
pub fn TK_CASCADE() -> i64 { return 108 }
pub fn TK_ARROW() -> i64 { return 109 }
pub fn TK_FAT_ARROW() -> i64 { return 110 }
pub fn TK_DOT_DOT() -> i64 { return 111 }
pub fn TK_DOT_DOT_EQ() -> i64 { return 112 }
pub fn TK_QUESTION() -> i64 { return 113 }
pub fn TK_QQ() -> i64 { return 114 }
pub fn TK_QDOT() -> i64 { return 115 }
pub fn TK_DOT() -> i64 { return 116 }
