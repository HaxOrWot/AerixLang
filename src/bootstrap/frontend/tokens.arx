pub fn TK_RPAREN() -> i64 { return 118 }
pub fn TK_LBRACE() -> i64 { return 119 }
pub fn TK_RBRACE() -> i64 { return 120 }
pub fn TK_LBRACKET() -> i64 { return 121 }
pub fn TK_RBRACKET() -> i64 { return 122 }
pub fn TK_COMMA() -> i64 { return 123 }
pub fn TK_COLON() -> i64 { return 124 }
pub fn TK_SEMICOLON() -> i64 { return 125 }
pub fn TK_HASH() -> i64 { return 126 }

pub fn is_alpha_byte(b: i64) -> bool {
    if b >= 65 && b <= 90 { return true }
    if b >= 97 && b <= 122 { return true }
    if b == 95 { return true }
    return false
}

pub fn is_digit_byte(b: i64) -> bool {
    return b >= 48 && b <= 57
}

pub fn is_hex_byte(b: i64) -> bool {
    if b >= 48 && b <= 57 { return true }
    if b >= 65 && b <= 70 { return true }
    if b >= 97 && b <= 102 { return true }
    return false
}

pub fn is_alnum_byte(b: i64) -> bool {
    return is_alpha_byte(b) || is_digit_byte(b)
}

pub fn lookup_keyword(word: str) -> i64 {
    match word {
        "fn" => { return TK_FN() }
        "let" => { return TK_LET() }
        "mut" => { return TK_MUT() }
        "const" => { return TK_CONST() }
        "class" => { return TK_CLASS() }
        "struct" => { return TK_STRUCT() }
        "enum" => { return TK_ENUM() }
        "trait" => { return TK_TRAIT() }
        "type" => { return TK_TYPE() }
        "init" => { return TK_INIT() }
        "drop" => { return TK_DROP() }
        "if" => { return TK_IF() }
        "else" => { return TK_ELSE() }
        "match" => { return TK_MATCH() }
        "for" => { return TK_FOR() }
        "in" => { return TK_IN() }
        "while" => { return TK_WHILE() }
        "loop" => { return TK_LOOP() }
        "break" => { return TK_BREAK() }
        "continue" => { return TK_CONTINUE() }
        "return" => { return TK_RETURN() }
        "spawn" => { return TK_SPAWN() }
        "try" => { return TK_TRY() }
        "catch" => { return TK_CATCH() }
        "finally" => { return TK_FINALLY() }
        "throw" => { return TK_THROW() }
        "self" => { return TK_SELF() }
        "super" => { return TK_SUPER() }
        "pub" => { return TK_PUB() }
        "priv" => { return TK_PRIV() }
        "prot" => { return TK_PROT() }
        "static" => { return TK_STATIC() }
        "virtual" => { return TK_VIRTUAL() }
        "override" => { return TK_OVERRIDE() }
        "abstract" => { return TK_ABSTRACT() }
        "new" => { return TK_NEW() }
        "delete" => { return TK_DELETE() }
        "extends" => { return TK_EXTENDS() }
        "implements" => { return TK_IMPLEMENTS() }
        "prop" => { return TK_PROP() }
        "op" => { return TK_OP() }
        "extend" => { return TK_EXTEND() }
        "guard" => { return TK_GUARD() }
        "defer" => { return TK_DEFER() }
        "unsafe" => { return TK_UNSAFE() }
        "sizeof" => { return TK_SIZEOF() }
        "as" => { return TK_AS() }
        "use" => { return TK_USE() }
        "import" => { return TK_IMPORT() }
        "from" => { return TK_FROM() }
        "cinclude" => { return TK_CINCLUDE() }
        "cextern" => { return TK_CEXTERN() }
        "true" => { return TK_BOOL() }
        "false" => { return TK_BOOL() }
        "null" => { return TK_NULL() }
        _ => { return TK_IDENT() }
    }
    return TK_IDENT()
}

pub fn can_terminate_stmt(kind: i64) -> bool {
    if kind == TK_IDENT() || kind == TK_INT() || kind == TK_FLOAT() { return true }
    if kind == TK_STR() || kind == TK_STR_INTERP() || kind == TK_CHAR() { return true }
    if kind == TK_BOOL() || kind == TK_NULL() || kind == TK_SELF() || kind == TK_SUPER() { return true }
    if kind == TK_BREAK() || kind == TK_CONTINUE() || kind == TK_RETURN() { return true }
    if kind == TK_RPAREN() || kind == TK_RBRACE() || kind == TK_RBRACKET() { return true }
    return false
}
