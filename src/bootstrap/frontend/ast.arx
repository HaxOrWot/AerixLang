// Aerix Bootstrap Compiler — Flat Abstract Syntax Tree (AST) Node Definitions
// Every AST node lives in parallel index-based arena arrays inside the Parser.
// Node kinds are grouped into: Declarations (1..19), Statements (20..49), Expressions (50..89).

// Declarations (1..19)
pub fn NK_GROUP() -> i64 { return 1 }            // Top-level compilation unit / module node
pub fn NK_FN_DEF() -> i64 { return 2 }           // Function definition (`fn name(...) -> RetType { ... }`)
pub fn NK_PARAM() -> i64 { return 3 }            // Function parameter declaration
pub fn NK_CLASS_DEF() -> i64 { return 4 }        // Class or struct definition (`class Name { ... }`)
pub fn NK_FIELD_DEF() -> i64 { return 5 }        // Class or struct member field
pub fn NK_INIT_DEF() -> i64 { return 6 }         // Constructor definition (`init(...) { ... }`)
pub fn NK_DROP_DEF() -> i64 { return 7 }         // Destructor definition (`drop { ... }`)
pub fn NK_ENUM_DEF() -> i64 { return 8 }         // Enumeration definition (`enum Name { ... }`)
pub fn NK_ENUM_VAR() -> i64 { return 9 }         // Enumeration variant member
pub fn NK_EXTEND_DEF() -> i64 { return 10 }      // Extension block (`extend Type { ... }`)
pub fn NK_CINCLUDE() -> i64 { return 11 }        // C header include directive (`cinclude "header.h"`)
pub fn NK_CEXTERN() -> i64 { return 12 }         // C extern symbol binding (`cextern fn ...`)
pub fn NK_VAR_DECL_GLOBAL() -> i64 { return 13 } // Top-level global variable declaration

// Statements (20..49)
pub fn NK_BLOCK() -> i64 { return 20 }           // Statement block (`{ ... }`)
pub fn NK_VAR_DECL() -> i64 { return 21 }        // Local variable declaration (`let [mut] name: Type = expr;`)
pub fn NK_ASSIGN() -> i64 { return 22 }          // Assignment statement (`target = expr;` or compound)
pub fn NK_IF() -> i64 { return 23 }              // Conditional branching statement (`if cond { ... } else { ... }`)
pub fn NK_WHILE() -> i64 { return 24 }           // While loop statement (`while cond { ... }`)
pub fn NK_FOR() -> i64 { return 25 }             // For-in loop statement (`for item in iterable { ... }`)
pub fn NK_LOOP() -> i64 { return 26 }            // Infinite loop statement (`loop { ... }`)
pub fn NK_BREAK() -> i64 { return 27 }           // Loop break statement (`break;`)
pub fn NK_CONTINUE() -> i64 { return 28 }        // Loop continue statement (`continue;`)
pub fn NK_RETURN() -> i64 { return 29 }          // Function return statement (`return expr;`)
pub fn NK_MATCH() -> i64 { return 30 }           // Pattern match statement (`match expr { ... }`)
pub fn NK_MATCH_CASE() -> i64 { return 31 }      // Pattern match branch arm (`pattern => { ... }`)
pub fn NK_DEFER() -> i64 { return 32 }           // Scope-exit deferred statement (`defer stmt;`)
pub fn NK_GUARD() -> i64 { return 33 }           // Guard statement (`guard cond else { ... }`)
pub fn NK_TRY_CATCH() -> i64 { return 34 }       // Exception handling block (`try { ... } catch e { ... }`)
pub fn NK_THROW() -> i64 { return 35 }           // Exception throw statement (`throw expr;`)
pub fn NK_EXPR_STMT() -> i64 { return 36 }       // Evaluated expression statement (`expr;`)
pub fn NK_TUPLE_DESTR() -> i64 { return 37 }     // Tuple destructuring statement (`let (a, b) = pair;`)

// Expressions (50..89)
pub fn NK_INT_LIT() -> i64 { return 50 }         // Integer literal (decimal, hex, binary, or octal)
pub fn NK_FLOAT_LIT() -> i64 { return 51 }       // Floating-point numeric literal
pub fn NK_STR_LIT() -> i64 { return 52 }         // Static string literal
pub fn NK_STR_INTERP() -> i64 { return 53 }      // Interpolated string expression (`"hello {name}"`)
pub fn NK_CHAR_LIT() -> i64 { return 54 }        // Character literal (`'c'`)
pub fn NK_BOOL_LIT() -> i64 { return 55 }        // Boolean literal (`true` or `false`)
pub fn NK_NULL_LIT() -> i64 { return 56 }        // Null literal (`null`)
pub fn NK_IDENT() -> i64 { return 57 }           // Identifier reference (`name`)
pub fn NK_BIN_OP() -> i64 { return 58 }          // Binary operator expression (`lhs + rhs`)
pub fn NK_UNARY_OP() -> i64 { return 59 }        // Unary operator expression (`!expr`, `-expr`, `&expr`)
pub fn NK_CALL() -> i64 { return 60 }            // Function call expression (`callee(arg1, arg2)`)
pub fn NK_MEMBER() -> i64 { return 61 }          // Member access expression (`object.field`)
pub fn NK_INDEX() -> i64 { return 62 }           // Array or map index expression (`container[idx]`)
pub fn NK_RANGE() -> i64 { return 63 }           // Range expression (`start..end` or `start..=end`)
pub fn NK_CAST() -> i64 { return 64 }            // Type cast expression (`expr as TargetType`)
pub fn NK_SIZEOF() -> i64 { return 65 }          // Size-of type inspection (`sizeof(Type)`)
pub fn NK_FIXED_ARR() -> i64 { return 66 }       // Fixed-size array literal (`[elem1, elem2]`)
pub fn NK_FIXED_REPEAT() -> i64 { return 67 }    // Array fill repeat literal (`[val; count]`)
pub fn NK_TUPLE_LIT() -> i64 { return 68 }       // Tuple literal expression (`(a, b, c)`)
pub fn NK_PIPELINE() -> i64 { return 69 }        // Pipeline operator expression (`val |> fn()`)
pub fn NK_CASCADE() -> i64 { return 70 }         // Method cascade operator expression (`obj ~> method()`)
pub fn NK_NEW() -> i64 { return 71 }             // Heap instantiation expression (`new ClassName(...)`)
pub fn NK_GENERIC_CALL() -> i64 { return 72 }    // Generic function call (`func<T>(...)`)
pub fn NK_NAMED_ARG() -> i64 { return 73 }       // Named function argument (`name: value`)

// Modifier / Flag bitmasks encoded in int_a
pub fn FLAG_PUB() -> i64 { return 1 }            // Public visibility modifier (`pub`)
pub fn FLAG_STATIC() -> i64 { return 2 }         // Static member flag (`static`)
pub fn FLAG_MUT() -> i64 { return 4 }            // Mutable variable or parameter flag (`mut`)
pub fn FLAG_INCLUSIVE() -> i64 { return 8 }      // Inclusive range flag (`..=`)
pub fn FLAG_PACKED() -> i64 { return 16 }        // Packed struct layout flag
pub fn FLAG_STRUCT() -> i64 { return 32 }        // Value struct type flag (vs reference class)

// Check if a specific bit flag is set in the flags bitmask.
pub fn has_flag(flags: i64, bit: i64) -> bool {
    if bit <= 0 { return false }
    return (flags / bit) % 2 == 1
}
