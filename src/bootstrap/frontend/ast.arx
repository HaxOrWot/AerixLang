// Aerix Bootstrap Compiler — Flat AST Node Definitions
// Every AST node lives in parallel index-based arena arrays inside Parser.

// Declarations (1..19)
pub fn NK_GROUP() -> i64 { return 1 }
pub fn NK_FN_DEF() -> i64 { return 2 }
pub fn NK_PARAM() -> i64 { return 3 }
pub fn NK_CLASS_DEF() -> i64 { return 4 }
pub fn NK_FIELD_DEF() -> i64 { return 5 }
pub fn NK_INIT_DEF() -> i64 { return 6 }
pub fn NK_DROP_DEF() -> i64 { return 7 }
pub fn NK_ENUM_DEF() -> i64 { return 8 }
pub fn NK_ENUM_VAR() -> i64 { return 9 }
pub fn NK_EXTEND_DEF() -> i64 { return 10 }
pub fn NK_CINCLUDE() -> i64 { return 11 }
pub fn NK_CEXTERN() -> i64 { return 12 }
pub fn NK_VAR_DECL_GLOBAL() -> i64 { return 13 }

