#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "app.manifest"

IDI_APP_ICON    ICON    "../assets/aerix.ico"
IDI_FILE_ICON   ICON    "../assets/aerix_file.ico"
IDB_WIZARD_SIDE BITMAP  "../assets/wizard_side.bmp"
IDB_WIZARD_BAN  BITMAP  "../assets/wizard_banner.bmp"

IDR_LICENSE     RCDATA  "../../LICENSE"
IDR_PAYLOAD     RCDATA  "../build/payload.bin"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,1,0,0
 PRODUCTVERSION  1,1,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS__WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "HaxOrWot"
            VALUE "FileDescription",  "Aerix 1.1.0-stable Setup"
            VALUE "FileVersion",      "1.1.0-stable"
            VALUE "InternalName",     "AerixSetup"
            VALUE "OriginalFilename", "AerixSetup-1.1.0-stable.exe"
            VALUE "ProductName",      "Aerix"
            VALUE "ProductVersion",   "1.1.0-stable"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
