{
  "name": "Aerix",
  "version": "1.1.16b",
  "publisher": "HaxOrWot",
  "default_install_dir": "%LOCALAPPDATA%\\Programs\\Aerix",
  "binaries": [
    "bin\\arx.exe",
    "bin\\arxc.exe"
  ],
  "environment": {
    "AERIX_HOME": "{app}",
    "AERIX_STDLIB": "{app}\\stdlib",
    "AERIX_STDLIB_PATH": "{app}\\stdlib",
    "AERIX_MODULE_PATH": "{app}\\modules",
    "PATH_APPEND": "{app}\\bin"
  },
  "payload_files": [
    { "source": "src\\bootstrap\\seed\\arxc.c (compiled)", "dest": "bin\\arx.exe" },
    { "source": "src\\bootstrap\\seed\\arxc.c (compiled)", "dest": "bin\\arxc.exe" },
    { "source": "stdlib\\aerix_rt.h", "dest": "stdlib\\aerix_rt.h" },
    { "source": "modules\\*", "dest": "modules\\*" },
    { "source": "editors\\vscode-aerix\\aerix-1.1.16b.vsix", "dest": "editors\\aerix-1.1.16b.vsix" },
    { "source": "editors\\vscode-aerix\\*", "dest": "editors\\extension\\*" },
    { "source": "AerixInstaller\\assets\\aerix.ico", "dest": "assets\\aerix.ico" },
    { "source": "AerixInstaller\\assets\\aerix_file.ico", "dest": "assets\\aerix_file.ico" },
    { "source": "README.md", "dest": "docs\\README.md" },
    { "source": "USER.md", "dest": "docs\\USER.md" },
    { "source": "GUIDE.md", "dest": "docs\\GUIDE.md" },
    { "source": "LICENSE", "dest": "LICENSE" }
  ]
}
