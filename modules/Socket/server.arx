// ==============================================================================
// Aerix Standard Library: Socket::Server
// Object-Oriented TCP Server Listener and Client Socket Acceptor
//
// Overview:
//   Provides the `TcpServer` class for binding a listening socket to a local
//   port, setting queue backlog, and synchronously accepting incoming client
//   connections.
//
// Usage:
//   import "Socket/server.arx"
//   import "Socket/core.arx"
//
//   let server = TcpServer();
//   if server.listen(8080, 10) {
//       println("Server listening on port 8080...");
//       let client_fd = server.acceptClient();
//       // handle client_fd...
//       server.close();
//   }
// ==============================================================================

import "./constants.arx"
import "./core.arx"

/// High-level TCP server listener wrapper.
pub class TcpServer {
    pub sock: i64
    pub is_listening: bool
    pub port: i64

    init() {
        self.sock = INVALID_SOCKET()
        self.is_listening = false
        self.port = 0
    }

    /// Binds the server to `0.0.0.0` on specified port and begins listening for incoming connections.
    ///
    /// Parameters:
    ///   `port`   : Local TCP port number to bind.
    ///   `backlog`: Maximum length of the queue of pending connections.
    /// Returns:
    ///   `true` if successfully bound and listening, `false` otherwise.
    pub fn listen(port: i64, backlog: i64) -> bool {
        if port < 0 || port > 65535 {
            return false
        }
        self.sock = createTcpSocket()
        if self.sock == INVALID_SOCKET() {
            return false
        }
        let addr_buf = makeSockAddrIn("0.0.0.0", port)
        if bind(self.sock, addr_buf, 16) == SOCKET_ERROR() {
            self.close()
            return false
        }
        mut bl = backlog
        if bl <= 0 {
            bl = 128
        }
        if listen(self.sock, bl) == SOCKET_ERROR() {
            self.close()
            return false
        }
        self.port = port
        self.is_listening = true
        return true
    }

    /// Synchronously waits for and accepts an incoming connection from a client.
    ///
    /// Returns:
    ///   New client socket descriptor handle, or `INVALID_SOCKET()` on error.
    pub fn acceptClient() -> i64 {
        if !self.is_listening {
            return INVALID_SOCKET()
        }
        return accept(self.sock, 0, 0)
    }

    /// Returns `true` if the server socket is currently bound and listening.
    pub fn isListening() -> bool {
        return self.is_listening
    }

    /// Shuts down the listening server and releases OS socket resources.
    pub fn close() -> void {
        if self.sock != INVALID_SOCKET() {
            closesocket(self.sock)
            self.sock = INVALID_SOCKET()
        }
        self.is_listening = false
    }
}
