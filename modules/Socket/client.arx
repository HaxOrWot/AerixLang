// ==============================================================================
// Aerix Standard Library: Socket::Client
// Object-Oriented TCP Client and Network Stream Wrapper
//
// Overview:
//   Provides a high-level `TcpClient` class for connecting to remote TCP servers,
//   sending textual and binary payloads, receiving stream chunks, and safe teardown.
//
// Usage:
//   import "Socket/client.arx"
//
//   let client = TcpClient();
//   if client.connect("127.0.0.1", 8080) {
//       client.sendStr("PING\r\n");
//       let reply = client.recvStr(1024);
//       println("Received: " + reply);
//       client.close();
//   }
// ==============================================================================

import "./constants.arx"
import "./core.arx"

/// High-level TCP client connection wrapper.
pub class TcpClient {
    pub sock: i64
    pub connected: bool

    init() {
        self.sock = INVALID_SOCKET()
        self.connected = false
    }

    /// Connects to a remote host on specified port.
    ///
    /// Parameters:
    ///   `ip`  : Destination IPv4 address string (e.g., "192.168.1.1").
    ///   `port`: Remote port number.
    /// Returns:
    ///   `true` if connection succeeded, `false` otherwise.
    pub fn connect(ip: str, port: i64) -> bool {
        self.sock = createTcpSocket()
        if self.sock == INVALID_SOCKET() {
            return false
        }
        let addr_buf = makeSockAddrIn(ip, port)
        let res = connect(self.sock, addr_buf, 16)
        if res == SOCKET_ERROR() {
            self.close()
            return false
        }
        self.connected = true
        return true
    }

    /// Sends a string payload over the connected socket.
    ///
    /// Parameters:
    ///   `data`: String to transmit.
    /// Returns:
    ///   Number of bytes sent, or `-1` on error.
    pub fn sendStr(data: str) -> i64 {
        if !self.connected {
            return -1
        }
        return send(self.sock, data, data.len(), 0)
    }

    /// Receives up to `max_bytes` from the connected socket stream.
    ///
    /// Parameters:
    ///   `max_bytes`: Buffer size limit.
    /// Returns:
    ///   String containing data read from stream, or `""` on disconnect or error.
    pub fn recvStr(max_bytes: i64) -> str {
        if !self.connected {
            return ""
        }
        let buf = " ".repeat(max_bytes)
        let bytes_read = recv(self.sock, buf, max_bytes, 0)
        if bytes_read <= 0 {
            return ""
        }
        return buf.slice(0, bytes_read)
    }

    /// Closes the socket connection and releases OS socket resources.
    pub fn close() -> void {
        if self.sock != INVALID_SOCKET() {
            closesocket(self.sock)
            self.sock = INVALID_SOCKET()
        }
        self.connected = false
    }

    /// Checks if the client socket is currently active and marked connected.
    pub fn isConnected() -> bool {
        return self.connected
    }
}

/// Convenience helper to perform a one-shot TCP request and response exchange.
///
/// Parameters:
///   `host`   : Target IPv4 address.
///   `port`   : Target port number.
///   `request`: String payload to transmit.
/// Returns:
///   Response string received from remote server, or `""` on failure.
pub fn tcpRequest(host: str, port: i64, request: str) -> str {
    let client = TcpClient()
    if !client.connect(host, port) {
        return ""
    }
    client.sendStr(request)
    let resp = client.recvStr(4096)
    client.close()
    return resp
}
