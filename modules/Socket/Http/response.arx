// ==============================================================================
// Aerix Standard Library: Socket::Http::Response
// Structured HTTP 1.1 Response Model and Header Parser
//
// Overview:
//   Represents an HTTP 1.1 server response, parsing status codes, status text,
//   headers, and payload body from raw RFC 7230 socket text streams.
//
// Usage:
//   import "Socket/Http/response.arx"
//
//   let resp = HttpResponse();
//   resp.parse(raw_http_stream);
//   if resp.isOk() {
//       println("Success: " + resp.body);
//   }
// ==============================================================================

/// Encapsulates a parsed HTTP 1.1 response message.
pub class HttpResponse {
    pub statusCode: i64
    pub statusText: str
    pub body: str
    pub raw: str

    init() {
        self.statusCode = 0
        self.statusText = ""
        self.body = ""
        self.raw = ""
    }

    /// Checks if the response status code is exactly 200 OK.
    pub fn isOk() -> bool {
        return self.statusCode == 200
    }

    /// Checks if the response indicates success (2xx HTTP status code: 200..299).
    pub fn isSuccess() -> bool {
        return self.statusCode >= 200 && self.statusCode < 300
    }

    /// Parses raw HTTP stream text into status code, status message, and body.
    ///
    /// Parameters:
    ///   `raw_data`: Full response text received over socket.
    pub fn parse(raw_data: str) -> void {
        self.raw = raw_data
        let double_crlf = "\r\n\r\n"
        let sep_idx = raw_data.find(double_crlf)
        mut header_section = raw_data
        if sep_idx >= 0 {
            header_section = raw_data.slice(0, sep_idx)
            self.body = raw_data.slice(sep_idx + 4, raw_data.len())
        }

        let lines = header_section.split("\r\n")
        if lines.len() > 0 {
            let status_line = lines.get(0)
            let parts = status_line.split(" ")
            if parts.len() >= 2 {
                self.statusCode = parts.get(1).to_i64()
            }
            if parts.len() >= 3 {
                self.statusText = parts.get(2)
            }
        }
    }
}
