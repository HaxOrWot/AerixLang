// ==============================================================================
// Aerix Standard Library: Socket::Http::Client
// Lightweight Native HTTP 1.1 Client with GET, POST, PUT, DELETE, and HEAD Verbs
//
// Overview:
//   Synchronous HTTP client implementation built on top of native TCP streams.
//   Handles URL host and path parsing, automatic Content-Length headers, and
//   structured response generation.
//
// Usage:
//   import "Socket/Http/client.arx"
//
//   let res = httpGet("http://127.0.0.1:8080/api/status");
//   if res.isSuccess() {
//       println("Response: " + res.body);
//   }
// ==============================================================================

import "../client.arx"
import "./response.arx"

/// Parses a URL into a tuple containing `(host, port, path)`.
///
/// Parameters:
///   `raw_url`: URL string (e.g. "http://example.com:8080/path/to/resource").
/// Returns:
///   3-element tuple `(host, port, path)` with defaults `port = 80` and `path = "/"`.
pub fn parseHostAndPath(raw_url: str) -> (str, i64, str) {
    mut u = raw_url
    if u.starts_with("http://") {
        u = u.slice(7, u.len())
    }
    let slash_pos = u.find("/")
    mut host_port = u
    mut path = "/"
    if slash_pos >= 0 {
        host_port = u.slice(0, slash_pos)
        path = u.slice(slash_pos, u.len())
    }
    let colon_pos = host_port.find(":")
    mut host = host_port
    mut port = 80
    if colon_pos >= 0 {
        host = host_port.slice(0, colon_pos)
        let p_str = host_port.slice(colon_pos + 1, host_port.len())
        port = p_str.to_i64()
        if port <= 0 || port > 65535 {
            port = 80
        }
    }
    return (host, port, path)
}

/// Executes a synchronous HTTP GET request.
///
/// Parameters:
///   `url`: Target HTTP URL.
/// Returns:
///   Parsed `HttpResponse` object.
pub fn httpGet(url: str) -> HttpResponse {
    let resp = HttpResponse()
    let parsed = parseHostAndPath(url)
    let host = parsed.f0
    let port = parsed.f1
    let path = parsed.f2

    let req = "GET " + path + " HTTP/1.1\r\nHost: " + host + "\r\nUser-Agent: AerixLang/1.2.23b\r\nConnection: close\r\n\r\n"
    let raw_resp = tcpRequest(host, port, req)
    resp.parse(raw_resp)
    return resp
}

/// Executes a synchronous HTTP POST request with payload body and Content-Type header.
///
/// Parameters:
///   `url`        : Target HTTP URL.
///   `body`       : Request payload body string.
///   `contentType`: MIME type string (e.g. "application/json" or "text/plain").
/// Returns:
///   Parsed `HttpResponse` object.
pub fn httpPost(url: str, body: str, contentType: str) -> HttpResponse {
    let resp = HttpResponse()
    let parsed = parseHostAndPath(url)
    let host = parsed.f0
    let port = parsed.f1
    let path = parsed.f2

    let len_str = body.len() as str
    let req = "POST " + path + " HTTP/1.1\r\nHost: " + host + "\r\nUser-Agent: AerixLang/1.2.23b\r\nContent-Type: " + contentType + "\r\nContent-Length: " + len_str + "\r\nConnection: close\r\n\r\n" + body
    let raw_resp = tcpRequest(host, port, req)
    resp.parse(raw_resp)
    return resp
}

/// Executes a synchronous HTTP PUT request.
///
/// Parameters:
///   `url`        : Target HTTP URL.
///   `body`       : Request payload body string.
///   `contentType`: MIME type string.
pub fn httpPut(url: str, body: str, contentType: str) -> HttpResponse {
    let resp = HttpResponse()
    let parsed = parseHostAndPath(url)
    let host = parsed.f0
    let port = parsed.f1
    let path = parsed.f2

    let len_str = body.len() as str
    let req = "PUT " + path + " HTTP/1.1\r\nHost: " + host + "\r\nUser-Agent: AerixLang/1.2.23b\r\nContent-Type: " + contentType + "\r\nContent-Length: " + len_str + "\r\nConnection: close\r\n\r\n" + body
    let raw_resp = tcpRequest(host, port, req)
    resp.parse(raw_resp)
    return resp
}

/// Executes a synchronous HTTP DELETE request.
///
/// Parameters:
///   `url`: Target HTTP URL.
pub fn httpDelete(url: str) -> HttpResponse {
    let resp = HttpResponse()
    let parsed = parseHostAndPath(url)
    let host = parsed.f0
    let port = parsed.f1
    let path = parsed.f2

    let req = "DELETE " + path + " HTTP/1.1\r\nHost: " + host + "\r\nUser-Agent: AerixLang/1.2.23b\r\nConnection: close\r\n\r\n"
    let raw_resp = tcpRequest(host, port, req)
    resp.parse(raw_resp)
    return resp
}

/// Executes a synchronous HTTP HEAD request (headers only).
///
/// Parameters:
///   `url`: Target HTTP URL.
pub fn httpHead(url: str) -> HttpResponse {
    let resp = HttpResponse()
    let parsed = parseHostAndPath(url)
    let host = parsed.f0
    let port = parsed.f1
    let path = parsed.f2

    let req = "HEAD " + path + " HTTP/1.1\r\nHost: " + host + "\r\nUser-Agent: AerixLang/1.2.23b\r\nConnection: close\r\n\r\n"
    let raw_resp = tcpRequest(host, port, req)
    resp.parse(raw_resp)
    return resp
}
