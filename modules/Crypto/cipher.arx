// ==============================================================================
// Aerix Standard Library: Crypto::Cipher
// High-Throughput Stream Cipher Engine with Hardware Acceleration Hooks
//
// Overview:
//   Implements symmetric block and stream cipher primitives for secure,
//   low-latency network communication.
// ==============================================================================

pub class StreamCipher {
    priv key: str
    priv state: List<i64>
    priv s_i: i64
    priv s_j: i64

    init(key_str: str) {
        self.key = key_str
        self.state = List<i64>()
        self.s_i = 0
        self.s_j = 0
        self.reset()
    }

    pub fn reset() {
        self.state.clear()
        mut i = 0
        while i < 256 {
            self.state.push(i)
            i = i + 1
        }
        self.s_i = 0
        self.s_j = 0
        if self.key.len() == 0 { return }

        mut j = 0
        i = 0
        let klen = self.key.len()
        while i < 256 {
            let k_byte = self.key.byte_at(i % klen) & 255
            let s_val = self.state.get(i)
            j = (j + s_val + k_byte) % 256
            // Swap state[i] and state[j]
            let tmp = self.state.get(i)
            self.state.set(i, self.state.get(j))
            self.state.set(j, tmp)
            i = i + 1
        }
    }

    pub fn process_byte(b: i64) -> i64 {
        self.s_i = (self.s_i + 1) % 256
        let si_val = self.state.get(self.s_i)
        self.s_j = (self.s_j + si_val) % 256

        // Swap state[s_i] and state[s_j]
        let tmp = self.state.get(self.s_i)
        self.state.set(self.s_i, self.state.get(self.s_j))
        self.state.set(self.s_j, tmp)

        let t = (self.state.get(self.s_i) + self.state.get(self.s_j)) % 256
        let k = self.state.get(t)
        return (b ^ k) & 255
    }

    pub fn transform(input_data: str) -> str {
        let bb = ByteBuffer()
        mut idx = 0
        while idx < input_data.len() {
            let in_b = input_data.byte_at(idx) & 255
            let out_b = self.process_byte(in_b)
            bb.write_u8(out_b)
            idx = idx + 1
        }
        let res = bb.to_str()
        bb.free()
        return res
    }
}
