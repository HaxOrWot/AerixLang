// ==============================================================================
// Aerix Standard Library: Str
// High-Performance String Utilities & Ergonomics
// ==============================================================================

pub fn len(s: str) -> i64 {
    return s.len()
}

pub fn is_empty(s: str) -> bool {
    return s.len() == 0
}

pub fn char_at(s: str, idx: i64) -> str {
    if idx < 0 || idx >= s.len() { return "" }
    return s.slice(idx, idx + 1)
}

pub fn index_of(s: str, sub: str) -> i64 {
    return s.index_of(sub)
}

pub fn contains(s: str, sub: str) -> bool {
    return s.contains(sub)
}

pub fn starts_with(s: str, prefix: str) -> bool {
    return s.starts_with(prefix)
}

pub fn ends_with(s: str, suffix: str) -> bool {
    return s.ends_with(suffix)
}

pub fn trim_start(s: str) -> str {
    let slen = s.len()
    mut start = 0
    while start < slen {
        let b = s.byte_at(start)
        if b > 32 { break }
        start = start + 1
    }
    if start == 0 { return s }
    if start >= slen { return "" }
    return s.slice(start, slen)
}

pub fn trim_end(s: str) -> str {
    let slen = s.len()
    mut end = slen
    while end > 0 {
        let b = s.byte_at(end - 1)
        if b > 32 { break }
        end = end - 1
    }
    if end == slen { return s }
    if end <= 0 { return "" }
    return s.slice(0, end)
}

pub fn trim(s: str) -> str {
    return trim_end(trim_start(s))
}

pub fn repeat(s: str, count: i64) -> str {
    if count <= 0 || s.len() == 0 { return "" }
    if count == 1 { return s }
    let bb = ByteBuffer()
    mut i = 0
    while i < count {
        bb.write_str(s)
        i = i + 1
    }
    let res = bb.to_str()
    bb.free()
    return res
}

pub fn pad_left(s: str, total_len: i64, pad: str) -> str {
    if s.len() >= total_len || pad.len() == 0 { return s }
    let needed = total_len - s.len()
    let bb = ByteBuffer()
    mut written = 0
    while written < needed {
        bb.write_str(pad)
        written = written + pad.len()
    }
    let pstr = bb.to_str()
    bb.free()
    if pstr.len() > needed {
        return pstr.slice(0, needed) + s
    }
    return pstr + s
}

pub fn pad_right(s: str, total_len: i64, pad: str) -> str {
    if s.len() >= total_len || pad.len() == 0 { return s }
    let needed = total_len - s.len()
    let bb = ByteBuffer()
    mut written = 0
    while written < needed {
        bb.write_str(pad)
        written = written + pad.len()
    }
    let pstr = bb.to_str()
    bb.free()
    if pstr.len() > needed {
        return s + pstr.slice(0, needed)
    }
    return s + pstr
}

pub fn to_upper(s: str) -> str {
    let slen = s.len()
    if slen == 0 { return "" }
    let bb = ByteBuffer()
    mut i = 0
    while i < slen {
        let b = s.byte_at(i)
        if b >= 97 && b <= 122 { // 'a'..'z'
            bb.write_u8(b - 32)
        } else {
            bb.write_u8(b)
        }
        i = i + 1
    }
    let res = bb.to_str()
    bb.free()
    return res
}

pub fn to_lower(s: str) -> str {
    let slen = s.len()
    if slen == 0 { return "" }
    let bb = ByteBuffer()
    mut i = 0
    while i < slen {
        let b = s.byte_at(i)
        if b >= 65 && b <= 90 { // 'A'..'Z'
            bb.write_u8(b + 32)
        } else {
            bb.write_u8(b)
        }
        i = i + 1
    }
    let res = bb.to_str()
    bb.free()
    return res
}

pub fn split(s: str, sep: str) -> List<str> {
    return s.split(sep)
}

pub fn replace(s: str, target: str, rep: str) -> str {
    if target.len() == 0 { return s }
    let parts = s.split(target)
    if parts.len() <= 1 { return s }
    let bb = ByteBuffer()
    mut i = 0
    while i < parts.len() {
        if i > 0 { bb.write_str(rep) }
        bb.write_str(parts.get(i))
        i = i + 1
    }
    let res = bb.to_str()
    bb.free()
    return res
}
