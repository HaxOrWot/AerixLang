// ==============================================================================
// Aerix Standard Library: Random::Sequences
// Sequence Operations on Slices: Random Choice and In-Place Shuffling
//
// Overview:
//   Provides sequence sampling utilities: selecting a random element from a
//   slice, and in-place random permutations via the Fisher-Yates (Knuth)
//   shuffling algorithm for integers, floating-point numbers, and strings.
//
// Usage:
//   import "Random/sequences.arx"
//
//   let items = [10, 20, 30, 40];
//   let picked = choice(&items);
//   shuffle(&mut items);
// ==============================================================================

fn _seq_randint(a: i64, b: i64) -> i64 {
    if a >= b {
        return a;
    }
    let span: i64 = b - a + 1;
    mut r: i64 = arx_prng_next_i64();
    if r < 0 {
        r = 0 - r;
    }
    return a + (r % span);
}

/// Selects a pseudo-random element uniformly from a slice of 64-bit integers.
/// Returns `0` if the slice is empty.
pub fn choice(s: &[i64]) -> i64 {
    if s.len == 0 {
        return 0;
    }
    let idx: i64 = _seq_randint(0, s.len - 1);
    return s[idx];
}

/// Selects a pseudo-random element uniformly from a slice of 64-bit floats.
/// Returns `0.0` if the slice is empty.
pub fn choiceF64(s: &[f64]) -> f64 {
    if s.len == 0 {
        return 0.0;
    }
    let idx: i64 = _seq_randint(0, s.len - 1);
    return s[idx];
}

/// Selects a pseudo-random string element uniformly from a slice of strings.
/// Returns `""` if the slice is empty.
pub fn choiceStr(s: &[str]) -> str {
    if s.len == 0 {
        return "";
    }
    let idx: i64 = _seq_randint(0, s.len - 1);
    return s[idx];
}

/// Shuffles an integer slice in-place using the Fisher-Yates algorithm.
/// Guarantees an unbiased, uniform permutation of all elements in O(N) time.
pub fn shuffle(s: &mut [i64]) {
    let n: i64 = s.len;
    if n <= 1 {
        return;
    }
    for i in 0..(n - 1) {
        let j: i64 = _seq_randint(i, n - 1);
        let tmp: i64 = s[i];
        s[i] = s[j];
        s[j] = tmp;
    }
}

/// Shuffles a 64-bit float slice in-place using the Fisher-Yates algorithm.
pub fn shuffleF64(s: &mut [f64]) {
    let n: i64 = s.len;
    if n <= 1 {
        return;
    }
    for i in 0..(n - 1) {
        let j: i64 = _seq_randint(i, n - 1);
        let tmp: f64 = s[i];
        s[i] = s[j];
        s[j] = tmp;
    }
}

/// Shuffles a string slice in-place using the Fisher-Yates algorithm.
pub fn shuffleStr(s: &mut [str]) {
    let n: i64 = s.len;
    if n <= 1 {
        return;
    }
    for i in 0..(n - 1) {
        let j: i64 = _seq_randint(i, n - 1);
        let tmp: str = s[i];
        s[i] = s[j];
        s[j] = tmp;
    }
}
