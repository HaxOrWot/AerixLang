// ==============================================================================
// Aerix Standard Library: Random::Distributions
// Continuous Probability Distributions: Gaussian, Exponential, Triangular, Pareto
//
// Overview:
//   Provides statistical sampling across continuous probability distributions.
//   Includes the Box-Muller transform for normal/Gaussian variates, log-normal
//   transformations, exponential decay distributions, triangular distributions,
//   and power-law Pareto/Weibull models.
//
// Usage:
//   import "Random/distributions.arx"
//
//   let sample = gauss(0.0, 1.0);        // Standard normal (mean=0, std=1)
//   let delay = expoVariate(1.5);        // Exponential arrival rate λ=1.5
//   let est = triangular(10.0, 50.0, 20.0);
// ==============================================================================

import "./core.arx"
import "../Math/exponential.arx"
import "../Math/advanced.arx"
import "../Math/trigonometry.arx"

/// Generates a normal (Gaussian) random variate with mean `mu` and standard deviation `sigma`
/// using the Box-Muller polar transformation.
///
/// Parameters:
///   `mu`   : Distribution mean (center).
///   `sigma`: Standard deviation (spread).
pub fn gauss(mu: f64, sigma: f64) -> f64 {
    mut u1: f64 = random();
    while u1 <= 0.000000000000001 {
        u1 = random();
    }
    let u2: f64 = random();
    let z0: f64 = sqrt(0.0 - 2.0 * ln(u1)) * cos(6.283185307179586 * u2);
    return mu + z0 * sigma;
}

/// Alias for `gauss(mu, sigma)`.
pub fn normalVariate(mu: f64, sigma: f64) -> f64 {
    return gauss(mu, sigma);
}

/// Generates a log-normal random variate where the natural logarithm is normally distributed
/// with mean `mu` and standard deviation `sigma`.
pub fn logNormVariate(mu: f64, sigma: f64) -> f64 {
    return exp(gauss(mu, sigma));
}

/// Generates an exponentially distributed random variate with rate parameter `lambd`.
/// Useful for simulating arrival times in Poisson processes.
///
/// Parameters:
///   `lambd`: Rate parameter λ (must be > 0.0).
pub fn expoVariate(lambd: f64) -> f64 {
    if lambd <= 0.0 {
        return 0.0;
    }
    mut u: f64 = random();
    while u <= 0.000000000000001 {
        u = random();
    }
    return (0.0 - ln(u)) / lambd;
}

/// Generates a triangular continuous distribution bounded by `low` and `high`, peaking at `mode`.
///
/// Parameters:
///   `low` : Minimum bound (`low < high`).
///   `high`: Maximum bound.
///   `mode`: Peak location (`low <= mode <= high`).
pub fn triangular(low: f64, high: f64, mode: f64) -> f64 {
    if low >= high {
        return low;
    }
    mut m = mode;
    if m < low { m = low; }
    if m > high { m = high; }
    let u = random();
    let c = (m - low) / (high - low);
    if u <= c {
        return low + sqrt(u * (high - low) * (m - low));
    }
    return high - sqrt((1.0 - u) * (high - low) * (high - m));
}

/// Generates a Pareto distribution variate (power-law distribution) with shape parameter `alpha`.
///
/// Parameters:
///   `alpha`: Shape parameter α (> 0.0).
pub fn pareto(alpha: f64) -> f64 {
    let u = random();
    if alpha <= 0.0 || u <= 0.0 || u >= 1.0 {
        return 1.0;
    }
    return 1.0 / pow(1.0 - u, 1.0 / alpha);
}

/// Generates a Weibull distribution variate with scale parameter `alpha` and shape parameter `beta`.
///
/// Parameters:
///   `alpha`: Scale parameter α (> 0.0).
///   `beta` : Shape parameter β (> 0.0).
pub fn weibull(alpha: f64, beta: f64) -> f64 {
    let u = random();
    if alpha <= 0.0 || beta <= 0.0 || u <= 0.000000000000001 || u >= 1.0 {
        return 0.0;
    }
    return alpha * pow(0.0 - ln(1.0 - u), 1.0 / beta);
}
