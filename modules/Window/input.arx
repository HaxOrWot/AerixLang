// ==============================================================================
// Aerix Standard Library: Window::Input
// Mouse cursor positioning, keyboard state detection, and virtual key codes.
// ==============================================================================

#[extern("user32.dll", "GetAsyncKeyState")]
pub fn get_async_key_state(vKey: i64) -> i64;

#[extern("user32.dll", "SetCursorPos")]
pub fn set_cursor_pos(x: i64, y: i64) -> i32;

#[extern("user32.dll", "GetCursorPos")]
pub fn get_cursor_pos(lp_point: str) -> i32;

// Check if a virtual key or mouse button is currently held down
pub fn is_key_down(vk_code: i64) -> bool {
    let state = get_async_key_state(vk_code);
    return (state & 0x8000) != 0;
}

// Move mouse cursor to (x, y) coordinates
pub fn set_mouse_position(x: i64, y: i64) -> bool {
    return set_cursor_pos(x, y) != 0;
}

// Get current mouse cursor (x, y) coordinates
pub fn get_mouse_position() -> (i64, i64) {
    let buf = " ".repeat(8);
    let ok = get_cursor_pos(buf);
    if ok == 0 {
        return (0, 0);
    }
    let b0 = buf.byte_at(0);
    let b1 = buf.byte_at(1);
    let b2 = buf.byte_at(2);
    let b3 = buf.byte_at(3);
    let x = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);

    let b4 = buf.byte_at(4);
    let b5 = buf.byte_at(5);
    let b6 = buf.byte_at(6);
    let b7 = buf.byte_at(7);
    let y = b4 | (b5 << 8) | (b6 << 16) | (b7 << 24);

    return (x, y);
}

// Standard Virtual Key Codes
pub fn VK_LBUTTON() -> i64 { return 1; }
pub fn VK_RBUTTON() -> i64 { return 2; }
pub fn VK_MBUTTON() -> i64 { return 4; }
pub fn VK_BACKSPACE() -> i64 { return 8; }
pub fn VK_TAB() -> i64 { return 9; }
pub fn VK_RETURN() -> i64 { return 13; }
pub fn VK_SHIFT() -> i64 { return 16; }
pub fn VK_CONTROL() -> i64 { return 17; }
pub fn VK_ALT() -> i64 { return 18; }
pub fn VK_ESCAPE() -> i64 { return 27; }
pub fn VK_SPACE() -> i64 { return 32; }
pub fn VK_LEFT() -> i64 { return 37; }
pub fn VK_UP() -> i64 { return 38; }
pub fn VK_RIGHT() -> i64 { return 39; }
pub fn VK_DOWN() -> i64 { return 40; }
