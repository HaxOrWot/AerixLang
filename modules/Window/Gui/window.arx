// ==============================================================================
// Aerix Standard Library: Window::Gui::Window
// Native Windows OS GUI Window Management Primitives & Event Loop
// ==============================================================================

cextern fn arx_gui_create_window(title: str, width: i64, height: i64) -> i64;
cextern fn arx_gui_show_window(hwnd: i64) -> bool;
cextern fn arx_gui_hide_window(hwnd: i64) -> bool;
cextern fn arx_gui_destroy_window(hwnd: i64) -> bool;
cextern fn arx_gui_is_window_visible(hwnd: i64) -> bool;
cextern fn arx_gui_poll_events() -> bool;

#[extern("user32.dll", "CreateWindowExA")]
pub fn win32_create_window_ex(ex_style: i64, class_name: str, window_name: str, style: i64, x: i64, y: i64, width: i64, height: i64, parent: i64, menu: i64, instance: i64, param: i64) -> i64;

#[extern("user32.dll", "EnableWindow")]
pub fn win32_enable_window(hwnd: i64, enable: i32) -> i32;

#[extern("user32.dll", "SetWindowTextA")]
pub fn win32_set_window_text(hwnd: i64, title: str) -> i32;

#[extern("user32.dll", "MoveWindow")]
pub fn win32_move_window(hwnd: i64, x: i64, y: i64, width: i64, height: i64, repaint: i32) -> i32;

#[extern("user32.dll", "ShowWindow")]
pub fn win32_show_window_cmd(hwnd: i64, cmd: i32) -> i32;

#[extern("user32.dll", "SetForegroundWindow")]
pub fn win32_set_foreground_window(hwnd: i64) -> i32;

// Window Styles & Constants
pub let WS_OVERLAPPED_WINDOW: i64 = 13565952;
pub let WS_POPUP_WINDOW: i64 = 2156396544;
pub let WS_VISIBLE_FLAG: i64 = 268435456;
pub let SW_SHOW_NORMAL: i64 = 1;
pub let SW_SHOW_CMD: i64 = 5;
pub let SW_HIDE_CMD: i64 = 0;
pub let SW_MINIMIZE_CMD: i64 = 6;
pub let SW_MAXIMIZE_CMD: i64 = 3;
pub let SW_RESTORE_CMD: i64 = 9;
pub let PM_REMOVE: i64 = 1;

pub fn createWindow(title: str, width: i64, height: i64) -> i64 {
    return arx_gui_create_window(title, width, height);
}

pub fn showWindow(hwnd: i64, cmd: i64) -> bool {
    return arx_gui_show_window(hwnd);
}

pub fn hideWindow(hwnd: i64) -> bool {
    return arx_gui_hide_window(hwnd);
}

pub fn setWindowTitle(hwnd: i64, title: str) -> bool {
    let res = win32_set_window_text(hwnd, title);
    return res != 0;
}

pub fn destroyWindow(hwnd: i64) -> bool {
    return arx_gui_destroy_window(hwnd);
}

pub fn moveWindow(hwnd: i64, x: i64, y: i64, width: i64, height: i64) -> bool {
    let res = win32_move_window(hwnd, x, y, width, height, 1);
    return res != 0;
}

pub fn isWindowVisible(hwnd: i64) -> bool {
    return arx_gui_is_window_visible(hwnd);
}

// Pumps all pending Windows OS messages; returns false if WM_QUIT received
pub fn pollEvents() -> bool {
    return arx_gui_poll_events();
}

pub class AppWindow {
    pub hwnd: i64
    pub title: str
    pub width: i64
    pub height: i64
    pub is_open: bool

    init(title: str, width: i64, height: i64) {
        self.title = title
        self.width = width
        self.height = height
        self.hwnd = createWindow(title, width, height)
        self.is_open = self.hwnd != 0
    }

    pub fn show() -> void {
        if self.hwnd != 0 {
            showWindow(self.hwnd, SW_SHOW_CMD)
        }
    }

    pub fn hide() -> void {
        if self.hwnd != 0 {
            hideWindow(self.hwnd)
        }
    }

    pub fn setTitle(new_title: str) -> void {
        self.title = new_title
        if self.hwnd != 0 {
            setWindowTitle(self.hwnd, new_title)
        }
    }

    pub fn resize(w: i64, h: i64) -> void {
        self.width = w
        self.height = h
        if self.hwnd != 0 {
            moveWindow(self.hwnd, 100, 100, w, h)
        }
    }

    pub fn poll() -> bool {
        return pollEvents()
    }

    pub fn setFocus() -> void {
        if self.hwnd != 0 {
            win32_set_foreground_window(self.hwnd)
        }
    }

    pub fn minimize() -> void {
        if self.hwnd != 0 {
            win32_show_window_cmd(self.hwnd, SW_MINIMIZE_CMD as i32)
        }
    }

    pub fn maximize() -> void {
        if self.hwnd != 0 {
            win32_show_window_cmd(self.hwnd, SW_MAXIMIZE_CMD as i32)
        }
    }

    pub fn restore() -> void {
        if self.hwnd != 0 {
            win32_show_window_cmd(self.hwnd, SW_RESTORE_CMD as i32)
        }
    }

    pub fn isOpen() -> bool {
        return self.is_open && isWindowVisible(self.hwnd)
    }

    pub fn close() -> void {
        if self.hwnd != 0 {
            destroyWindow(self.hwnd)
            self.hwnd = 0
            self.is_open = false
        }
    }
}
