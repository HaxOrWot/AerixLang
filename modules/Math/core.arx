// ==============================================================================
// Aerix Standard Modules: Math::Core
// Fundamental mathematical constants, basic arithmetic, rounding, and interpolation.
// ==============================================================================

pub fn PI() -> f64 {
    return 3.141592653589793;
}

pub fn E() -> f64 {
    return 2.718281828459045;
}

pub fn TAU() -> f64 {
    return 6.283185307179586;
}

pub fn SQRT2() -> f64 {
    return 1.4142135623730951;
}

pub fn LN2() -> f64 {
    return 0.6931471805599453;
}

pub fn LN10() -> f64 {
    return 2.302585092994046;
}

pub fn INF() -> f64 {
    return 1.0 / 0.0;
}

pub fn abs(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0 - x;
    }
    return x;
}

pub fn abs_i64(x: i64) -> i64 {
    if x < 0 {
        return 0 - x;
    }
    return x;
}

pub fn min(a: f64, b: f64) -> f64 {
    if a < b {
        return a;
    }
    return b;
}

pub fn min_i64(a: i64, b: i64) -> i64 {
    if a < b {
        return a;
    }
    return b;
}

pub fn max(a: f64, b: f64) -> f64 {
    if a > b {
        return a;
    }
    return b;
}

pub fn max_i64(a: i64, b: i64) -> i64 {
    if a > b {
        return a;
    }
    return b;
}

pub fn clamp(val: f64, low: f64, high: f64) -> f64 {
    if val < low {
        return low;
    }
    if val > high {
        return high;
    }
    return val;
}

pub fn clamp_i64(val: i64, low: i64, high: i64) -> i64 {
    if val < low {
        return low;
    }
    if val > high {
        return high;
    }
    return val;
}

pub fn sign(x: f64) -> f64 {
    if x > 0.0 {
        return 1.0;
    }
    if x < 0.0 {
        return 0.0 - 1.0;
    }
    return 0.0;
}

pub fn is_even(n: i64) -> bool {
    return n % 2 == 0;
}

pub fn is_odd(n: i64) -> bool {
    return n % 2 != 0;
}

pub fn floor(x: f64) -> f64 {
    let i: i64 = x as i64;
    let fi: f64 = i as f64;
    if x < 0.0 && x != fi {
        return (i - 1) as f64;
    }
    return fi;
}

pub fn ceil(x: f64) -> f64 {
    let i: i64 = x as i64;
    let fi: f64 = i as f64;
    if x > 0.0 && x != fi {
        return (i + 1) as f64;
    }
    return fi;
}

pub fn trunc(x: f64) -> f64 {
    let i: i64 = x as i64;
    return i as f64;
}

pub fn round(x: f64) -> f64 {
    if x >= 0.0 {
        return floor(x + 0.5);
    }
    return ceil(x - 0.5);
}

pub fn fract(x: f64) -> f64 {
    return x - trunc(x);
}

pub fn lerp(a: f64, b: f64, t: f64) -> f64 {
    return a + (b - a) * t;
}

pub fn smoothstep(edge0: f64, edge1: f64, x: f64) -> f64 {
    let t: f64 = clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}
