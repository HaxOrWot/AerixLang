// ==============================================================================
// Aerix Standard Modules: Math::Core
// Fundamental mathematical constants, basic arithmetic, rounding, and interpolation.
// ==============================================================================

pub fn PI() -> f64 {
    return 3.141592653589793;
}

pub fn E() -> f64 {
    return 2.718281828459045;
}

pub fn TAU() -> f64 {
    return 6.283185307179586;
}

pub fn SQRT2() -> f64 {
    return 1.4142135623730951;
}

pub fn LN2() -> f64 {
    return 0.6931471805599453;
}

pub fn LN10() -> f64 {
    return 2.302585092994046;
}

pub fn INF() -> f64 {
    return 1.0 / 0.0;
}

pub fn abs(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0 - x;
    }
    return x;
}

pub fn absI64(x: i64) -> i64 {
    if x < 0 {
        return 0 - x;
    }
    return x;
}

pub fn min(a: f64, b: f64) -> f64 {
    if a < b {
        return a;
    }
    return b;
}

pub fn minI64(a: i64, b: i64) -> i64 {
    if a < b {
        return a;
    }
    return b;
}

pub fn max(a: f64, b: f64) -> f64 {
    if a > b {
        return a;
    }
    return b;
}

pub fn maxI64(a: i64, b: i64) -> i64 {
    if a > b {
        return a;
    }
    return b;
}

pub fn clamp(val: f64, low: f64, high: f64) -> f64 {
    if val < low {
        return low;
    }
    if val > high {
        return high;
    }
    return val;
}

pub fn clampI64(val: i64, low: i64, high: i64) -> i64 {
    if val < low {
        return low;
    }
    if val > high {
        return high;
    }
    return val;
}

pub fn sign(x: f64) -> f64 {
    if x > 0.0 {
        return 1.0;
    }
    if x < 0.0 {
        return 0.0 - 1.0;
    }
    return 0.0;
}

pub fn isEven(n: i64) -> bool {
    return n % 2 == 0;
}

pub fn isOdd(n: i64) -> bool {
    return n % 2 != 0;
}

pub fn approxEqual(a: f64, b: f64, epsilon: f64) -> bool {
    return abs(a - b) <= epsilon;
}

pub fn floor(x: f64) -> f64 {
    let i: i64 = x as i64;
    let fi: f64 = i as f64;
    if x < 0.0 && x != fi {
        return (i - 1) as f64;
    }
    return fi;
}

pub fn ceil(x: f64) -> f64 {
    let i: i64 = x as i64;
    let fi: f64 = i as f64;
    if x > 0.0 && x != fi {
        return (i + 1) as f64;
    }
    return fi;
}

pub fn trunc(x: f64) -> f64 {
    let i: i64 = x as i64;
    return i as f64;
}

pub fn round(x: f64) -> f64 {
    if x >= 0.0 {
        return floor(x + 0.5);
    }
    return ceil(x - 0.5);
}

pub fn fract(x: f64) -> f64 {
    return x - trunc(x);
}

pub fn lerp(a: f64, b: f64, t: f64) -> f64 {
    return a + (b - a) * t;
}

pub fn inverseLerp(a: f64, b: f64, val: f64) -> f64 {
    if a == b {
        return 0.0;
    }
    return clamp((val - a) / (b - a), 0.0, 1.0);
}

pub fn remap(inMin: f64, inMax: f64, outMin: f64, outMax: f64, val: f64) -> f64 {
    let t = inverseLerp(inMin, inMax, val);
    return lerp(outMin, outMax, t);
}

pub fn roundTo(val: f64, decimals: i64) -> f64 {
    if decimals <= 0 {
        return round(val);
    }
    mut factor: f64 = 1.0;
    mut i = 0;
    while i < decimals {
        factor = factor * 10.0;
        i = i + 1;
    }
    return round(val * factor) / factor;
}

pub fn dist2D(x1: f64, y1: f64, x2: f64, y2: f64) -> f64 {
    let dx = x2 - x1;
    let dy = y2 - y1;
    let sum = dx * dx + dy * dy;
    if sum <= 0.0 {
        return 0.0;
    }
    mut guess = sum / 2.0;
    if guess == 0.0 { guess = 1.0; }
    for i in 0..20 {
        guess = (guess + sum / guess) / 2.0;
    }
    return guess;
}

pub fn dist3D(x1: f64, y1: f64, z1: f64, x2: f64, y2: f64, z2: f64) -> f64 {
    let dx = x2 - x1;
    let dy = y2 - y1;
    let dz = z2 - z1;
    let sum = dx * dx + dy * dy + dz * dz;
    if sum <= 0.0 {
        return 0.0;
    }
    mut guess = sum / 2.0;
    if guess == 0.0 { guess = 1.0; }
    for i in 0..20 {
        guess = (guess + sum / guess) / 2.0;
    }
    return guess;
}

pub fn smoothstep(edge0: f64, edge1: f64, x: f64) -> f64 {
    let t: f64 = clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}
