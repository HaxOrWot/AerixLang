// ==============================================================================
// Aerix Standard Modules: Math::Trigonometry
// Pure Aerix implementations of trigonometric algorithms via polynomial expansions.
// ==============================================================================

pub fn sin(x: f64) -> f64 {
    let pi: f64 = 3.141592653589793;
    let tau: f64 = 6.283185307179586;

    mut rad: f64 = x;
    while rad > pi {
        rad = rad - tau;
    }
    while rad < 0.0 - pi {
        rad = rad + tau;
    }

    let r2: f64 = rad * rad;
    mut term: f64 = rad;
    mut sum: f64 = rad;

    term = 0.0 - term * r2 / 6.0;
    sum = sum + term;

    term = 0.0 - term * r2 / 20.0;
    sum = sum + term;

    term = 0.0 - term * r2 / 42.0;
    sum = sum + term;

    term = 0.0 - term * r2 / 72.0;
    sum = sum + term;

    term = 0.0 - term * r2 / 110.0;
    sum = sum + term;

    term = 0.0 - term * r2 / 156.0;
    sum = sum + term;

    return sum;
}

pub fn cos(x: f64) -> f64 {
    let pi: f64 = 3.141592653589793;
    let tau: f64 = 6.283185307179586;

    mut rad: f64 = x;
    while rad > pi {
        rad = rad - tau;
    }
    while rad < 0.0 - pi {
        rad = rad + tau;
    }

    let r2: f64 = rad * rad;
    mut term: f64 = 1.0;
    mut sum: f64 = 1.0;

    term = 0.0 - term * r2 / 2.0;
    sum = sum + term;

    term = 0.0 - term * r2 / 12.0;
    sum = sum + term;

    term = 0.0 - term * r2 / 30.0;
    sum = sum + term;

    term = 0.0 - term * r2 / 56.0;
    sum = sum + term;

    term = 0.0 - term * r2 / 90.0;
    sum = sum + term;

    term = 0.0 - term * r2 / 132.0;
    sum = sum + term;

    return sum;
}

pub fn tan(x: f64) -> f64 {
    let c: f64 = cos(x);
    if c == 0.0 {
        return 1.0 / 0.0;
    }
    return sin(x) / c;
}

pub fn cot(x: f64) -> f64 {
    let s: f64 = sin(x);
    if s == 0.0 {
        return 1.0 / 0.0;
    }
    return cos(x) / s;
}

pub fn sec(x: f64) -> f64 {
    let c: f64 = cos(x);
    if c == 0.0 {
        return 1.0 / 0.0;
    }
    return 1.0 / c;
}

pub fn csc(x: f64) -> f64 {
    let s: f64 = sin(x);
    if s == 0.0 {
        return 1.0 / 0.0;
    }
    return 1.0 / s;
}

pub fn atan(x: f64) -> f64 {
    let pi: f64 = 3.141592653589793;
    if x == 0.0 {
        return 0.0;
    }
    if x < 0.0 {
        return 0.0 - atan(0.0 - x);
    }
    if x > 1.0 {
        return (pi / 2.0) - atan(1.0 / x);
    }
    // High-precision polynomial approximation for |x| <= 1
    let x2 = x * x;
    mut term = x;
    mut sum = x;
    mut denom = 3.0;
    mut sign = 0.0 - 1.0;
    for i in 0..15 {
        term = term * x2;
        sum = sum + sign * (term / denom);
        denom = denom + 2.0;
        sign = 0.0 - sign;
    }
    return sum;
}

pub fn atan2(y: f64, x: f64) -> f64 {
    let pi: f64 = 3.141592653589793;
    if x > 0.0 {
        return atan(y / x);
    }
    if x < 0.0 && y >= 0.0 {
        return atan(y / x) + pi;
    }
    if x < 0.0 && y < 0.0 {
        return atan(y / x) - pi;
    }
    if x == 0.0 && y > 0.0 {
        return pi / 2.0;
    }
    if x == 0.0 && y < 0.0 {
        return 0.0 - (pi / 2.0);
    }
    return 0.0;
}

pub fn asin(x: f64) -> f64 {
    let pi: f64 = 3.141592653589793;
    if x > 1.0 || x < 0.0 - 1.0 {
        return 0.0;
    }
    if x == 1.0 {
        return pi / 2.0;
    }
    if x == 0.0 - 1.0 {
        return 0.0 - (pi / 2.0);
    }
    let denom_sq = 1.0 - x * x;
    mut guess = denom_sq / 2.0;
    if guess == 0.0 { guess = 1.0; }
    for i in 0..20 {
        guess = (guess + denom_sq / guess) / 2.0;
    }
    return atan(x / guess);
}

pub fn acos(x: f64) -> f64 {
    let pi: f64 = 3.141592653589793;
    return (pi / 2.0) - asin(x);
}
