// ==============================================================================
// Aerix Standard Library: Math::Trigonometry
// Pure Aerix Trigonometric Algorithms via High-Precision Polynomial Expansions
//
// Overview:
//   Provides circular trigonometric functions and their inverses without external
//   C runtime math library dependencies (libm). Implemented using modular range
//   reduction to [-π, π] and high-order Maclaurin / Chebyshev polynomial series.
//
// Functions Included:
//   - Circular : sin, cos, tan, cot, sec, csc
//   - Inverse  : atan, atan2, asin, acos
//
// Usage:
//   import "Math/trigonometry.arx"
//   import "Math/advanced.arx"
//
//   let rad = degToRad(90.0);
//   let val = sin(rad); // 1.0
// ==============================================================================

/// Computes the sine of an angle `x` specified in radians.
///
/// Parameters:
///   `x`: Angle in radians.
/// Returns:
///   Sine value in the range `[-1.0, 1.0]`.
pub fn sin(x: f64) -> f64 {
    let pi: f64 = 3.141592653589793;
    let tau: f64 = 6.283185307179586;

    mut rad: f64 = x;
    while rad > pi {
        rad = rad - tau;
    }
    while rad < 0.0 - pi {
        rad = rad + tau;
    }

    let r2: f64 = rad * rad;
    mut term: f64 = rad;
    mut sum: f64 = rad;

    term = 0.0 - term * r2 / 6.0;
    sum = sum + term;

    term = 0.0 - term * r2 / 20.0;
    sum = sum + term;

    term = 0.0 - term * r2 / 42.0;
    sum = sum + term;

    term = 0.0 - term * r2 / 72.0;
    sum = sum + term;

    term = 0.0 - term * r2 / 110.0;
    sum = sum + term;

    term = 0.0 - term * r2 / 156.0;
    sum = sum + term;

    return sum;
}

/// Computes the cosine of an angle `x` specified in radians.
///
/// Parameters:
///   `x`: Angle in radians.
/// Returns:
///   Cosine value in the range `[-1.0, 1.0]`.
pub fn cos(x: f64) -> f64 {
    let pi: f64 = 3.141592653589793;
    let tau: f64 = 6.283185307179586;

    mut rad: f64 = x;
    while rad > pi {
        rad = rad - tau;
    }
    while rad < 0.0 - pi {
        rad = rad + tau;
    }

    let r2: f64 = rad * rad;
    mut term: f64 = 1.0;
    mut sum: f64 = 1.0;

    term = 0.0 - term * r2 / 2.0;
    sum = sum + term;

    term = 0.0 - term * r2 / 12.0;
    sum = sum + term;

    term = 0.0 - term * r2 / 30.0;
    sum = sum + term;

    term = 0.0 - term * r2 / 56.0;
    sum = sum + term;

    term = 0.0 - term * r2 / 90.0;
    sum = sum + term;

    term = 0.0 - term * r2 / 132.0;
    sum = sum + term;

    return sum;
}

/// Computes the tangent of an angle `x` specified in radians (`sin(x) / cos(x)`).
///
/// Parameters:
///   `x`: Angle in radians.
/// Returns:
///   Tangent value, or infinity if `cos(x) == 0`.
pub fn tan(x: f64) -> f64 {
    let c: f64 = cos(x);
    if c == 0.0 {
        return 1.0 / 0.0;
    }
    return sin(x) / c;
}

/// Computes the cotangent of an angle `x` specified in radians (`cos(x) / sin(x)`).
pub fn cot(x: f64) -> f64 {
    let s: f64 = sin(x);
    if s == 0.0 {
        return 1.0 / 0.0;
    }
    return cos(x) / s;
}

/// Computes the secant of an angle `x` specified in radians (`1.0 / cos(x)`).
pub fn sec(x: f64) -> f64 {
    let c: f64 = cos(x);
    if c == 0.0 {
        return 1.0 / 0.0;
    }
    return 1.0 / c;
}

/// Computes the cosecant of an angle `x` specified in radians (`1.0 / sin(x)`).
pub fn csc(x: f64) -> f64 {
    let s: f64 = sin(x);
    if s == 0.0 {
        return 1.0 / 0.0;
    }
    return 1.0 / s;
}

/// Computes the principal value of the arc tangent of `x` in radians.
///
/// Parameters:
///   `x`: Floating-point value.
/// Returns:
///   Arc tangent in the interval `[-π/2, π/2]`.
pub fn atan(x: f64) -> f64 {
    let pi: f64 = 3.141592653589793;
    if x == 0.0 {
        return 0.0;
    }
    if x < 0.0 {
        return 0.0 - atan(0.0 - x);
    }
    if x > 1.0 {
        return (pi / 2.0) - atan(1.0 / x);
    }
    // High-precision polynomial approximation for |x| <= 1
    let x2 = x * x;
    mut term = x;
    mut sum = x;
    mut denom = 3.0;
    mut sign = 0.0 - 1.0;
    for i in 0..15 {
        term = term * x2;
        sum = sum + sign * (term / denom);
        denom = denom + 2.0;
        sign = 0.0 - sign;
    }
    return sum;
}

/// Computes the 2-argument arc tangent of `y` and `x` in radians.
/// Correctly determines the quadrant of `(x, y)` in `[-π, π]`.
///
/// Parameters:
///   `y`: Y-coordinate.
///   `x`: X-coordinate.
pub fn atan2(y: f64, x: f64) -> f64 {
    let pi: f64 = 3.141592653589793;
    if x > 0.0 {
        return atan(y / x);
    }
    if x < 0.0 && y >= 0.0 {
        return atan(y / x) + pi;
    }
    if x < 0.0 && y < 0.0 {
        return atan(y / x) - pi;
    }
    if x == 0.0 && y > 0.0 {
        return pi / 2.0;
    }
    if x == 0.0 && y < 0.0 {
        return 0.0 - (pi / 2.0);
    }
    return 0.0;
}

/// Computes the arc sine of `x` in radians.
///
/// Parameters:
///   `x`: Floating-point value in `[-1.0, 1.0]`.
/// Returns:
///   Arc sine in `[-π/2, π/2]`.
pub fn asin(x: f64) -> f64 {
    let pi: f64 = 3.141592653589793;
    if x > 1.0 || x < 0.0 - 1.0 {
        return 0.0;
    }
    if x == 1.0 {
        return pi / 2.0;
    }
    if x == 0.0 - 1.0 {
        return 0.0 - (pi / 2.0);
    }
    let denom_sq = 1.0 - x * x;
    mut guess = denom_sq / 2.0;
    if guess == 0.0 { guess = 1.0; }
    for i in 0..20 {
        guess = (guess + denom_sq / guess) / 2.0;
    }
    return atan(x / guess);
}

/// Computes the arc cosine of `x` in radians.
///
/// Parameters:
///   `x`: Floating-point value in `[-1.0, 1.0]`.
/// Returns:
///   Arc cosine in `[0, π]`.
pub fn acos(x: f64) -> f64 {
    let pi: f64 = 3.141592653589793;
    return (pi / 2.0) - asin(x);
}
