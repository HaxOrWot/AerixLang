// ==============================================================================
// Aerix Standard Library: Math::Advanced
// Advanced Numerical Algorithms: Roots, Combinatorics, and Number Theory
//
// Overview:
//   Provides advanced mathematical algorithms including square roots and cube roots
//   via Newton-Raphson approximation, integer exponentiation by squaring,
//   combinatorics (permutations and combinations), angular degree/radian conversion,
//   Euclidean GCD/LCM, and deterministic prime number testing.
//
// Usage:
//   import "Math/advanced.arx"
//
//   let r = sqrt(144.0);         // 12.0
//   let ways = nCr(10, 3);       // 120
//   let prime = isPrime(997);    // true
// ==============================================================================

import "./exponential.arx"

/// Computes the square root of a non-negative floating-point number using Newton-Raphson iteration.
///
/// Parameters:
///   `x`: Non-negative real number.
/// Returns:
///   `√x`, or `0.0` if `x <= 0.0`.
pub fn sqrt(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0;
    }
    mut guess: f64 = x / 2.0;
    if guess == 0.0 {
        guess = 1.0;
    }
    for i in 0..25 {
        guess = (guess + x / guess) / 2.0;
    }
    return guess;
}

/// Computes the cube root of a floating-point number (preserves negative signs).
///
/// Parameters:
///   `x`: Real number.
/// Returns:
///   `∛x` computed via Newton-Raphson iteration.
pub fn cbrt(x: f64) -> f64 {
    if x == 0.0 {
        return 0.0;
    }
    mut sign_mult: f64 = 1.0;
    mut val: f64 = x;
    if val < 0.0 {
        sign_mult = 0.0 - 1.0;
        val = 0.0 - val;
    }
    mut guess: f64 = val / 3.0;
    if guess == 0.0 {
        guess = 1.0;
    }
    for i in 0..30 {
        guess = (2.0 * guess + val / (guess * guess)) / 3.0;
    }
    return guess * sign_mult;
}

/// Computes the length of the hypotenuse of a right-angled triangle (`sqrt(a^2 + b^2)`).
pub fn hypot(a: f64, b: f64) -> f64 {
    return sqrt(a * a + b * b);
}

/// Computes `base` raised to an integer power `exp` using binary exponentiation (exponentiation by squaring).
///
/// Parameters:
///   `base`: Base value.
///   `exp` : Signed integer power.
pub fn pow(base: f64, exp: i64) -> f64 {
    if exp == 0 {
        return 1.0;
    }
    mut res: f64 = 1.0;
    mut n: i64 = exp;
    mut b: f64 = base;
    if n < 0 {
        b = 1.0 / b;
        n = 0 - n;
    }
    while n > 0 {
        if n % 2 == 1 {
            res = res * b;
        }
        b = b * b;
        n = n / 2;
    }
    return res;
}

/// Computes `base` raised to a floating-point `exponent` (`base^exponent`).
pub fn pow(base: f64, exponent: f64) -> f64 {
    if exponent == 0.0 {
        return 1.0;
    }
    if base <= 0.0 {
        return 0.0;
    }
    return exp(exponent * ln(base));
}

/// Computes the factorial of a non-negative integer `n!` (`1 * 2 * ... * n`).
///
/// Parameters:
///   `n`: Integer in `[0, 20]` (larger integers exceed 64-bit limits).
pub fn factorial(n: i64) -> i64 {
    if n <= 1 {
        return 1;
    }
    mut res: i64 = 1;
    for i in 2..=n {
        res = res * i;
    }
    return res;
}

/// Computes the number of permutations `nPr = n! / (n - r)!`.
///
/// Parameters:
///   `n`: Total number of items (non-negative).
///   `r`: Number of chosen items (`0 <= r <= n`).
pub fn nPr(n: i64, r: i64) -> i64 {
    if n < 0 || r < 0 || r > n {
        return 0;
    }
    mut res: i64 = 1;
    for i in (n - r + 1)..=n {
        res = res * i;
    }
    return res;
}

/// Computes the number of combinations (binomial coefficient) `nCr = n! / (r! * (n - r)!)`.
///
/// Parameters:
///   `n`: Total number of items (non-negative).
///   `r`: Number of chosen items (`0 <= r <= n`).
pub fn nCr(n: i64, r: i64) -> i64 {
    if n < 0 || r < 0 || r > n {
        return 0;
    }
    mut k: i64 = r;
    if k > n - k {
        k = n - k;
    }
    mut res: i64 = 1;
    for i in 1..=k {
        res = res * (n - k + i) / i;
    }
    return res;
}

/// Converts an angle from degrees to radians (`deg * π / 180`).
pub fn degToRad(deg: f64) -> f64 {
    return deg * (3.141592653589793 / 180.0);
}

/// Converts an angle from radians to degrees (`rad * 180 / π`).
pub fn radToDeg(rad: f64) -> f64 {
    return rad * (180.0 / 3.141592653589793);
}

/// Computes the Greatest Common Divisor (GCD) of two integers using the Euclidean algorithm.
pub fn gcd(a: i64, b: i64) -> i64 {
    mut x: i64 = a;
    mut y: i64 = b;
    if x < 0 {
        x = 0 - x;
    }
    if y < 0 {
        y = 0 - y;
    }
    while y != 0 {
        let t: i64 = y;
        y = x % y;
        x = t;
    }
    return x;
}

/// Computes the Least Common Multiple (LCM) of two integers (`|a * b| / gcd(a, b)`).
pub fn lcm(a: i64, b: i64) -> i64 {
    if a == 0 || b == 0 {
        return 0;
    }
    let g: i64 = gcd(a, b);
    let div: i64 = a / g;
    let prod: i64 = div * b;
    if prod < 0 {
        return 0 - prod;
    }
    return prod;
}

/// Determines whether an integer `n` is prime using 6k ± 1 trial division.
pub fn isPrime(n: i64) -> bool {
    if n <= 1 {
        return false;
    }
    if n <= 3 {
        return true;
    }
    if n % 2 == 0 || n % 3 == 0 {
        return false;
    }
    mut i: i64 = 5;
    while i * i <= n {
        if n % i == 0 || n % (i + 2) == 0 {
            return false;
        }
        i = i + 6;
    }
    return true;
}

/// Finds the smallest prime number strictly greater than `n`.
pub fn nextPrime(n: i64) -> i64 {
    mut cand: i64 = n + 1;
    while !isPrime(cand) {
        cand = cand + 1;
    }
    return cand;
}
