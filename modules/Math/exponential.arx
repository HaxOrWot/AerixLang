// ==============================================================================
// Aerix Standard Library: Math::Exponential
// Pure Aerix Implementations of Natural Exponentials and Logarithms
//
// Overview:
//   Implements exponential and logarithmic functions using Taylor series and
//   binary exponent reduction algorithms, eliminating external C runtime math
//   dependencies.
//
// Functions Included:
//   - exp     : Natural exponential (e^x)
//   - ln / log: Natural logarithm (base e)
//   - log10   : Common logarithm (base 10)
//   - log2    : Binary logarithm (base 2)
//   - powF64  : Generalized exponentiation (base^exp for real numbers)
//
// Usage:
//   import "Math/exponential.arx"
//
//   let e_squared = exp(2.0);
//   let half_decay = powF64(0.5, 3.5);
// ==============================================================================

/// Computes the exponential function e^x (Euler's constant raised to the power `x`).
///
/// Parameters:
///   `x`: Exponent value.
/// Returns:
///   `e^x` computed using power-series summation.
pub fn exp(x: f64) -> f64 {
    if x == 0.0 {
        return 1.0;
    }
    mut neg: bool = false;
    mut val: f64 = x;
    if val < 0.0 {
        neg = true;
        val = 0.0 - val;
    }

    mut term: f64 = 1.0;
    mut sum: f64 = 1.0;
    for i in 1..25 {
        term = term * val / (i as f64);
        sum = sum + term;
    }

    if neg {
        return 1.0 / sum;
    }
    return sum;
}

/// Alias for natural logarithm `ln(x)`.
pub fn log(x: f64) -> f64 {
    return ln(x);
}

/// Computes the natural logarithm (base e) of `x`.
///
/// Parameters:
///   `x`: Positive real number (`x > 0.0`).
/// Returns:
///   `ln(x)`, or `-INF` if `x <= 0.0`.
pub fn ln(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0 - (1.0 / 0.0);
    }
    if x == 1.0 {
        return 0.0;
    }

    mut m: f64 = x;
    mut k: i64 = 0;
    while m > 1.5 {
        m = m / 2.0;
        k = k + 1;
    }
    while m < 0.75 {
        m = m * 2.0;
        k = k - 1;
    }

    let y: f64 = (m - 1.0) / (m + 1.0);
    let y2: f64 = y * y;
    mut y_pow: f64 = y;
    mut sum: f64 = y;

    for i in 1..15 {
        y_pow = y_pow * y2;
        let denom: f64 = (2 * i + 1) as f64;
        sum = sum + y_pow / denom;
    }

    let ln2_const: f64 = 0.6931471805599453;
    return 2.0 * sum + (k as f64) * ln2_const;
}

/// Computes the base-10 logarithm of `x`.
pub fn log10(x: f64) -> f64 {
    let ln10_const: f64 = 2.302585092994046;
    return ln(x) / ln10_const;
}

/// Computes the base-2 logarithm of `x`.
pub fn log2(x: f64) -> f64 {
    let ln2_const: f64 = 0.6931471805599453;
    return ln(x) / ln2_const;
}

/// Computes `base` raised to the real power `exponent` (`base^exponent = exp(exponent * ln(base))`).
///
/// Parameters:
///   `base`    : Non-negative base.
///   `exponent`: Real exponent.
/// Returns:
///   `base^exponent`, or `1.0` if `exponent == 0.0`, or `0.0` if `base <= 0.0`.
pub fn powF64(base: f64, exponent: f64) -> f64 {
    if exponent == 0.0 {
        return 1.0;
    }
    if base <= 0.0 {
        return 0.0;
    }
    return exp(exponent * ln(base));
}
