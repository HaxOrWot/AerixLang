// ==============================================================================
// Aerix Standard Modules: Time::Core
// Time measurement, delays, and timestamp primitives.
// ==============================================================================

cextern fn arx_sleep_ms(ms: i64) -> void;

#[extern("kernel32.dll", "GetTickCount64")]
pub fn ticks() -> i64;

#[extern("kernel32.dll", "Sleep")]
pub fn win32Sleep(ms: i64) -> void;

pub fn now() -> f64 {
    return arx_time_now();
}

pub fn time() -> f64 {
    return arx_time_now();
}

pub fn epoch() -> f64 {
    return arx_time_now();
}

pub fn epochSecs() -> i64 {
    return arx_time_now() as i64;
}

pub fn epochMs() -> i64 {
    return (arx_time_now() * 1000.0) as i64;
}

pub fn sleep(ms: i64) -> void {
    arx_sleep_ms(ms);
}

pub fn sleepMs(ms: i64) -> void {
    arx_sleep_ms(ms);
}

pub fn sleepSecs(secs: f64) -> void {
    if secs <= 0.0 {
        return;
    }
    let ms = (secs * 1000.0) as i64;
    arx_sleep_ms(ms);
}
