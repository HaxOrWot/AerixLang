// ==============================================================================
// Aerix Standard Modules: Time::Core
// Time measurement, delays, and timestamp primitives.
// ==============================================================================

pub fn now() -> f64 {
    return arx_time_now();
}

pub fn time() -> f64 {
    return arx_time_now();
}

pub fn epoch() -> f64 {
    return arx_time_now();
}

pub fn sleep(ms: i64) -> void {
    arx_sleep(ms);
}
