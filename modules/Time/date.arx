// ==============================================================================
// Aerix Standard Modules: Time::Date
// Calendar calculations, local system time, DateTime struct, and duration formatting.
// ==============================================================================

#[extern("kernel32.dll", "GetLocalTime")]
pub fn get_local_time(lp_system_time: str) -> void;

pub class DateTime {
    pub year: i64
    pub month: i64
    pub day: i64
    pub hour: i64
    pub minute: i64
    pub second: i64
    pub millisecond: i64

    init() {
        self.year = 1970
        self.month = 1
        self.day = 1
        self.hour = 0
        self.minute = 0
        self.second = 0
        self.millisecond = 0
    }

    pub fn format_iso() -> str {
        mut m_str = self.month as str
        if self.month < 10 { m_str = "0" + m_str }

        mut d_str = self.day as str
        if self.day < 10 { d_str = "0" + d_str }

        mut h_str = self.hour as str
        if self.hour < 10 { h_str = "0" + h_str }

        mut min_str = self.minute as str
        if self.minute < 10 { min_str = "0" + min_str }

        mut s_str = self.second as str
        if self.second < 10 { s_str = "0" + s_str }

        return (self.year as str) + "-" + m_str + "-" + d_str + " " + h_str + ":" + min_str + ":" + s_str
    }
}

pub fn now_local() -> DateTime {
    let dt = DateTime()
    let buf = " ".repeat(16)
    get_local_time(buf)
    dt.year = buf.byte_at(0) + (buf.byte_at(1) << 8)
    dt.month = buf.byte_at(2) + (buf.byte_at(3) << 8)
    dt.day = buf.byte_at(6) + (buf.byte_at(7) << 8)
    dt.hour = buf.byte_at(8) + (buf.byte_at(9) << 8)
    dt.minute = buf.byte_at(10) + (buf.byte_at(11) << 8)
    dt.second = buf.byte_at(12) + (buf.byte_at(13) << 8)
    dt.millisecond = buf.byte_at(14) + (buf.byte_at(15) << 8)
    return dt
}

pub fn now_string() -> str {
    let dt = now_local()
    return dt.format_iso()
}

pub fn is_leap_year(year: i64) -> bool {
    if (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0) {
        return true
    }
    return false
}

pub fn days_in_month(year: i64, month: i64) -> i64 {
    if month == 2 {
        if is_leap_year(year) {
            return 29
        }
        return 28
    }
    if month == 4 || month == 6 || month == 9 || month == 11 {
        return 30
    }
    return 31
}

pub fn format_duration_ms(ms: i64) -> str {
    if ms < 0 {
        return "00:00.000"
    }
    let total_secs = ms / 1000
    let m = total_secs / 60
    let s = total_secs % 60
    let rem_ms = ms % 1000

    mut m_str = m as str
    if m < 10 { m_str = "0" + m_str }

    mut s_str = s as str
    if s < 10 { s_str = "0" + s_str }

    mut ms_str = rem_ms as str
    if rem_ms < 10 {
        ms_str = "00" + ms_str
    } else if rem_ms < 100 {
        ms_str = "0" + ms_str
    }

    return m_str + ":" + s_str + "." + ms_str
}
