// ==============================================================================
// Aerix Standard Library: Time::Date
// Gregorian Calendar Calculations, Local/UTC DateTime, and ISO Formatting
//
// Overview:
//   Provides a comprehensive date and time model including local system time
//   (via Windows GetLocalTime), UTC conversions, leap year verification, month
//   day counts, date arithmetic (addDays, addHours), weekday determination
//   using Zeller's congruence, and ISO 8601 formatting.
//
// Usage:
//   import "Time/date.arx"
//
//   let now = nowLocal();
//   println("Current time: " + now.formatIso());
//   if isWeekend(now) {
//       println("Enjoy the weekend!");
//   }
// ==============================================================================

#[extern("kernel32.dll", "GetLocalTime")]
pub fn get_local_time(lp_system_time: str) -> void;

#[extern("msvcrt.dll", "time")]
pub fn c_time(timer: i64) -> i64;

/// Encapsulates a calendar date and wall-clock time record.
pub class DateTime {
    pub year: i64
    pub month: i64
    pub day: i64
    pub hour: i64
    pub minute: i64
    pub second: i64
    pub millisecond: i64

    init() {
        self.year = 1970
        self.month = 1
        self.day = 1
        self.hour = 0
        self.minute = 0
        self.second = 0
        self.millisecond = 0
    }

    /// Formats the DateTime as an ISO 8601 string: `YYYY-MM-DD HH:MM:SS`.
    pub fn formatIso() -> str {
        mut m_str = self.month as str
        if self.month < 10 { m_str = "0" + m_str }

        mut d_str = self.day as str
        if self.day < 10 { d_str = "0" + d_str }

        mut h_str = self.hour as str
        if self.hour < 10 { h_str = "0" + h_str }

        mut min_str = self.minute as str
        if self.minute < 10 { min_str = "0" + min_str }

        mut s_str = self.second as str
        if self.second < 10 { s_str = "0" + s_str }

        return (self.year as str) + "-" + m_str + "-" + d_str + " " + h_str + ":" + min_str + ":" + s_str
    }

    /// Formats date components only: `YYYY-MM-DD`.
    pub fn formatDate() -> str {
        mut m_str = self.month as str
        if self.month < 10 { m_str = "0" + m_str }

        mut d_str = self.day as str
        if self.day < 10 { d_str = "0" + d_str }

        return (self.year as str) + "-" + m_str + "-" + d_str
    }

    /// Formats time components only: `HH:MM:SS`.
    pub fn formatTime() -> str {
        mut h_str = self.hour as str
        if self.hour < 10 { h_str = "0" + h_str }

        mut min_str = self.minute as str
        if self.minute < 10 { min_str = "0" + min_str }

        mut s_str = self.second as str
        if self.second < 10 { s_str = "0" + s_str }

        return h_str + ":" + min_str + ":" + s_str
    }
}

/// Retrieves the current system local date and time according to user time zone settings.
pub fn nowLocal() -> DateTime {
    let dt = DateTime()
    let buf = " ".repeat(16)
    get_local_time(buf)

    // Windows SYSTEMTIME layout:
    // wYear(0..1), wMonth(2..3), wDayOfWeek(4..5), wDay(6..7),
    // wHour(8..9), wMinute(10..11), wSecond(12..13), wMilliseconds(14..15)
    dt.year = (buf.byte_at(0) & 255) | ((buf.byte_at(1) & 255) << 8)
    dt.month = (buf.byte_at(2) & 255) | ((buf.byte_at(3) & 255) << 8)
    dt.day = (buf.byte_at(6) & 255) | ((buf.byte_at(7) & 255) << 8)
    dt.hour = (buf.byte_at(8) & 255) | ((buf.byte_at(9) & 255) << 8)
    dt.minute = (buf.byte_at(10) & 255) | ((buf.byte_at(11) & 255) << 8)
    dt.second = (buf.byte_at(12) & 255) | ((buf.byte_at(13) & 255) << 8)
    dt.millisecond = (buf.byte_at(14) & 255) | ((buf.byte_at(15) & 255) << 8)
    return dt
}

/// Tests whether the given Gregorian calendar year is a leap year (366 days).
///
/// Parameters:
///   `year`: Gregorian calendar year (e.g. 2024).
pub fn isLeapYear(year: i64) -> bool {
    if year % 400 == 0 { return true }
    if year % 100 == 0 { return false }
    return year % 4 == 0
}

/// Returns the number of days in the specified month of a given year (taking leap years into account).
///
/// Parameters:
///   `year` : Calendar year.
///   `month`: Month number (1 = January, ..., 12 = December).
pub fn daysInMonth(year: i64, month: i64) -> i64 {
    if month == 2 {
        if isLeapYear(year) { return 29 }
        return 28
    }
    if month == 4 || month == 6 || month == 9 || month == 11 {
        return 30
    }
    return 31
}

/// Retrieves the current date and time in Coordinated Universal Time (UTC).
pub fn nowUtc() -> DateTime {
    let dt = DateTime()
    let t = c_time(0)
    let total_secs = t
    dt.second = total_secs % 60
    let total_mins = total_secs / 60
    dt.minute = total_mins % 60
    let total_hours = total_mins / 60
    dt.hour = total_hours % 24
    let mut total_days = total_hours / 24

    mut y = 1970
    loop {
        mut diy = 365
        if isLeapYear(y) { diy = 366 }
        if total_days >= diy {
            total_days = total_days - diy
            y = y + 1
        } else {
            break
        }
    }
    dt.year = y

    mut m = 1
    while m <= 12 {
        let dim = daysInMonth(y, m)
        if total_days >= dim {
            total_days = total_days - dim
            m = m + 1
        } else {
            break
        }
    }
    dt.month = m
    dt.day = total_days + 1
    return dt
}

/// Computes a new DateTime by adding `days` to an existing DateTime instance.
pub fn addDays(dt: DateTime, days: i64) -> DateTime {
    let res = DateTime()
    res.year = dt.year
    res.month = dt.month
    res.day = dt.day + days
    res.hour = dt.hour
    res.minute = dt.minute
    res.second = dt.second
    res.millisecond = dt.millisecond
    while res.day > daysInMonth(res.year, res.month) {
        res.day = res.day - daysInMonth(res.year, res.month)
        res.month = res.month + 1
        if res.month > 12 {
            res.month = 1
            res.year = res.year + 1
        }
    }
    return res
}

/// Computes a new DateTime by adding `hours` to an existing DateTime instance.
pub fn addHours(dt: DateTime, hours: i64) -> DateTime {
    let extraDays = (dt.hour + hours) / 24
    let newHour = (dt.hour + hours) % 24
    let res = addDays(dt, extraDays)
    res.hour = newHour
    return res
}

/// Checks if a DateTime falls on a weekend (Saturday or Sunday) using Zeller's congruence.
pub fn isWeekend(dt: DateTime) -> bool {
    mut m = dt.month
    mut y = dt.year
    if m <= 2 {
        m = m + 12
        y = y - 1
    }
    let k = y % 100
    let j = y / 100
    let h = (dt.day + (13 * (m + 1)) / 5 + k + k / 4 + j / 4 + 5 * j) % 7
    return h == 0 || h == 1 // 0 = Saturday, 1 = Sunday
}
