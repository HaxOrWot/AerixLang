// ==============================================================================
// Aerix Standard Modules: Time::Stopwatch
// High-resolution interval stopwatch for benchmarking and timing.
// ==============================================================================

import "./core.arx"

pub class Stopwatch {
    pub start_time: i64
    pub accumulated_ms: i64
    pub running: bool

    init() {
        self.start_time = 0
        self.accumulated_ms = 0
        self.running = false
    }

    pub fn start() -> void {
        if !self.running {
            self.start_time = ticks()
            self.running = true
        }
    }

    pub fn stop() -> i64 {
        if self.running {
            let now_t = ticks()
            self.accumulated_ms = self.accumulated_ms + (now_t - self.start_time)
            self.running = false
        }
        return self.accumulated_ms
    }

    pub fn reset() -> void {
        self.start_time = 0
        self.accumulated_ms = 0
        self.running = false
    }

    pub fn restart() -> void {
        self.reset()
        self.start()
    }

    pub fn elapsed_ms() -> i64 {
        if self.running {
            let now_t = ticks()
            return self.accumulated_ms + (now_t - self.start_time)
        }
        return self.accumulated_ms
    }

    pub fn elapsed_secs() -> f64 {
        return (self.elapsed_ms() as f64) / 1000.0
    }

    pub fn is_running() -> bool {
        return self.running
    }
}
