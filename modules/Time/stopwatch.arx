// ==============================================================================
// Aerix Standard Modules: Time::Stopwatch
// High-resolution precision stopwatch for benchmarking and interval timing.
// ==============================================================================

import "./core.arx"

pub class Stopwatch {
    pub start_time: i64
    pub stop_time: i64
    pub running: bool

    init() {
        self.start_time = 0
        self.stop_time = 0
        self.running = false
    }

    pub fn start() -> void {
        self.start_time = ticks()
        self.running = true
    }

    pub fn stop() -> void {
        if self.running {
            self.stop_time = ticks()
            self.running = false
        }
    }

    pub fn reset() -> void {
        self.start_time = 0
        self.stop_time = 0
        self.running = false
    }

    pub fn restart() -> void {
        self.reset()
        self.start()
    }

    pub fn elapsedMs() -> i64 {
        if self.running {
            return ticks() - self.start_time
        }
        return self.stop_time - self.start_time
    }

    pub fn elapsedSec() -> f64 {
        let ms = self.elapsedMs()
        return (ms as f64) / 1000.0
    }

    pub fn elapsedSecs() -> f64 {
        return self.elapsedSec()
    }

    pub fn isRunning() -> bool {
        return self.running
    }
}
